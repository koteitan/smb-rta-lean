/-- one frame in control keeps the castle flag down and the fraction's low bits: the walk of `Theorems/FrameKeep.lean`, as a program -/
def keepCheckProg (sy : Syms) (romPath : String) (mode : String := "") : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let S0 := FrameKeep.spotOf sy m0
  let S := if mode == "castle" then { S0 with entry := 0, store := 0 } else S0
  let G := FrameKeep.guardK sy m0
  let E := PipeEntryRule.envOf m0
  let W := if mode == "castle" then (FrameKeep.watchOf sy).take 1 else FrameKeep.watchOf sy
  IO.println s!"the store of the fraction: {FrameKeep.spotCheck sy m0}; entry {S.entry}, store {S.store}, temps {S.temps}"
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => FrameKeep.searchOfK S G E W
  let t1 ← IO.monoMsNow
  let fp := (X.failPcs.toList.mergeSort fun a b => a.2 ≥ b.2).take 12
  IO.println s!"one frame: {X.steps} steps, {X.forks} forks, {X.fails} failures at {fp}, table {X.multi.size}; search {t1 - t0} ms"
  match X.firstFail with
  | some A => IO.println s!"first failure: pc {A.pc} a {A.a.v}/{A.a.k} x {A.x.v}/{A.x.k} y {A.y.v}/{A.y.k} p {A.p.v}/{A.p.k} s {A.s} k {A.k}"
  | none => pure ()
  (← IO.getStdout).flush
  let (t, _, _) := FrameKeep.tableOfK S G W X
  let inR := t.foldl (fun n A => if FrameKeep.inMove S0 A.pc then n + 1 else n) 0
  let mut byPc : Std.HashMap Nat Nat := {}
  for A in t do
    byPc := byPc.insert A.pc.toNat (byPc.getD A.pc.toNat 0 + 1)
  let top := (byPc.toList.mergeSort fun a b => a.2 ≥ b.2).take 15
  IO.println s!"table states in the move routine {inR}; most states at pcs {top}"
  (← IO.getStdout).flush
  if mode == "nocheck" then return 0
  let t2 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => FrameKeep.keepCheck S G E W
  IO.println s!"the check {ok}, {(← IO.monoMsNow) - t2} ms"
  return if ok then 0 else 1

/-- HurryFrame: the walk of the one frame that starts the hurry-up music, as a program. `nocheck`: the search only. -/
def musicCheckProg (sy : Syms) (romPath : String) (mode : String := "") : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := HurryMusic.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let P := HurryFrame.placesOf sy nm m0
  let G := HurryFrame.guardOf sy nm m0
  let GD := HurryFrame.guardD P G
  let E := PipeEntryRule.envOf m0
  let a := nm.ad "GameTimerDisplay"
  let spot := romByte m0 P.ldy == 0xAC && romByte m0 (P.ldy + 1) == a.toUInt8 && romByte m0 (P.ldy + 2) == (a >>> 8).toUInt8 &&
    romByte m0 P.lda == 0xAD && romByte m0 (P.lda + 1) == (a + 1).toUInt8 && romByte m0 (P.lda + 2) == ((a + 1) >>> 8).toUInt8
  IO.println s!"the loads of the digits: {spot}; ldy {P.ldy}, lda {P.lda}; the music's number {P.tro}; other loads {P.loads}; the digits routine {P.dmr}, the bytes it adds {P.mods}, the stores of dset {P.dset}"
  let u := 100
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => HurryFrame.searchOfM sy G GD E P u
  let t1 ← IO.monoMsNow
  let fp := (X.failPcs.toList.mergeSort fun a b => a.2 ≥ b.2).take 12
  IO.println s!"one frame: {X.steps} steps, {X.forks} forks, {X.fails} failures at {fp}, table {X.multi.size}; search {t1 - t0} ms"
  match X.firstFail with
  | some A =>
    let sh := fun (B : TaintRun.AS) (i : Nat) => s!"{(B.getK i).v}/{(B.getK i).k}"
    IO.println s!"first failure: pc {A.pc}; queue {sh A P.queue} buffer {sh A P.buffer} adder {sh A P.adder} digits {sh A P.d0} {sh A P.d1} {sh A P.d2}"
  | none => pure ()
  let (t, _, _) := HurryFrame.tableOfM sy G P X
  let tro := t.foldl (fun n A => if HurryFrame.troOn P A then n + 1 else n) 0
  IO.println s!"table states with the music queued {tro}"
  (← IO.getStdout).flush
  if mode == "nocheck" then return 0
  let t2 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => HurryFrame.musicCheck sy G GD E P u
  IO.println s!"the check {ok}, {(← IO.monoMsNow) - t2} ms"
  return if ok && spot then 0 else 1

/-- HurryFrame: the walk of the frames in control with the stores of the routine, the mode and the task cut (`HurryFrame.ctlCheckOf`), as a program -/
def hurryCtlCheckProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := HurryMusic.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let P := HurryFrame.placesOf sy nm m0
  let G := HurryFrame.guardOf sy nm m0
  let GD := HurryFrame.guardD P G
  let E := PipeEntryRule.envOf m0
  let fin := FrameKeep.knownAll (FrameKeep.guardK sy m0)
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => HurryFrame.searchOfMG sy G GD E P (HurryFrame.startsC G P) (FrameKeep.ctlI sy) fin
  let t1 ← IO.monoMsNow
  let fp := (X.failPcs.toList.mergeSort fun a b => a.2 ≥ b.2).take 12
  IO.println s!"one frame in control, the stores of the three bytes cut: {X.steps} steps, {X.forks} forks, {X.fails} failures at {fp}, table {X.multi.size}; search {t1 - t0} ms"
  (← IO.getStdout).flush
  let t2 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => HurryFrame.ctlCheckOf sy nm m0
  IO.println s!"the check {ok}, {(← IO.monoMsNow) - t2} ms"
  return if ok then 0 else 1

/-- the sets of `Theorems/PipeTransitionAll.lean`, found by running -/
def pipeAllSets (sy : Syms) (romPath : String) : IO (Machine × PipeTransitionAll.Names × List Nat × List Nat × List Nat) := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := PipeTransitionAll.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let R := PipeTransitionAll.computeR sy nm m0 48 43
  return (m0, nm, R, PipeTransitionAll.computeRvar sy nm m0 R 48, PipeTransitionAll.computeRE sy m0 91)

/-- what decides the length of the change into the bonus room, as a program -/
def pipeAllCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let (m0, nm, R, Rvar, RE) ← pipeAllSets sy romPath
  let e := PipeTransition.entry m0
  let len := fun c => PipeTransitionAll.lengthOf sy (PipeTransition.applyChange e c) 400 0
  let lag := (PipeTransitionAll.lagScenes sy nm e).map len
  let dec := (PipeTransitionAll.deciders nm).map len
  IO.println s!"bytes read from the entry: {RE.length}; from the state when the timer has run out: {R.length}, in which entries differ: {Rvar.length}"
  IO.println s!"entries run: {(PipeTransitionAll.entries sy nm m0).length}; lengths with six objects: {lag}; with HalfwayPage, WarpZoneControl, GameTimerExpiredFlag set: {dec}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => PipeTransitionAll.allCheck sy m0 nm R Rvar RE lag dec 48 43
  IO.println s!"the check: {ok} ({(← IO.monoMsNow) - t0} ms)"
  return if ok then 0 else 1

/-- every value of one byte at a time, from the state `start` frames after the entry, for the bytes the run reads: the bytes that change the length -/
def pipeAllBytes (sy : Syms) (romPath : String) (start n shard shards : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let base := PipeTransition.run (PipeTransition.entry m0) (PipeTransition.zeros start)
  let bytes := PipeTransitionAll.readSet n (PipeTransitionAll.norm base)
  for a in bytes do
    if a % shards != shard then continue
    let orig := base.ram.get! a
    let other := (List.range 256).filterMap fun v =>
      if v.toUInt8 == orig then none else
      let l := PipeTransitionAll.lengthOf sy (poke base a.toUInt16 v.toUInt8) (n + 400) 0
      if l == n then none else some (v, l)
    if !other.isEmpty then
      IO.println s!"byte {a}, value {orig}: {other.length} other values change the length; first {other.take 8}"
      flush
  return 0

/-- a movie's entry state against the assumptions of `every_entry` (the movie stays out of the theorem) -/
def pipeAllMovie (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let (m0, nm, R, Rvar, _) ← pipeAllSets sy romPath
  let T := PipeTransitionAll.cutOf m0 48
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut m := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek m sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    m := runFrame m inputs[k]!
    seen := seen || controllable sy m
    k := k + 1
  let t := PipeTransition.run m (PipeTransition.zeros 48)
  let v := PipeTransitionAll.phaseOf T nm t
  IO.println s!"entry on movie frame {k - 1}: control after {PipeTransitionAll.lengthOf sy m 400 0} frames; registers and fixed bytes at the cut: {PipeTransitionAll.cutOK nm (PipeTransitionAll.fixedOf R Rvar) T t}"
  IO.println s!"the run from there reads only R: {PipeTransitionAll.readsIn R (PipeTransition.run (PipeTransitionAll.track (PipeTransitionAll.norm t)) (PipeTransition.zeros 43))}"
  IO.println s!"bytes of Rvar that differ from the reference: {(Rvar.filter fun i => t.ram.get! i != v.ram.get! i).length} of {Rvar.length}; with the reference's values: control after {PipeTransitionAll.lengthOf sy (PipeTransitionAll.overlay Rvar v t) 400 0} frames"
  return 0

/-- the sets of `Theorems/SideTransitionAll.lean`, found by running -/
def sideAllSets (sy : Syms) (romPath : String) : IO (Machine × PipeTransitionAll.Names × List Nat × List Nat × List Nat) := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := SideTransitionAll.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let R := SideTransitionAll.computeR sy nm m0 160 122
  return (m0, nm, R, SideTransitionAll.computeRvar sy nm m0 R 160, SideTransitionAll.computeRE sy m0 282)

/-- what decides the change out of the side pipe, as a program -/
def sideAllCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let (m0, nm, R, Rvar, RE) ← sideAllSets sy romPath
  let n := SideTransitionAll.numsOf sy nm m0 160 122
  let e := SideTransition.entry m0
  let es := SideTransitionAll.entries sy nm (PipeTransition.run m0 SideTransition.onBlock) e
  IO.println s!"bytes read from the entry: {RE.length}; from the state when the timer has run out: {R.length}, in which entries differ: {Rvar.length}"
  IO.println s!"entries run: {es.length}; lengths: {es.map fun m => PipeTransitionAll.lengthOf sy m 800 0}"
  IO.println s!"screen not on the first page: {(SideTransitionAll.pageBefore sy nm).map fun c => PipeTransitionAll.lengthOf sy (SideTransitionAll.entryWith (SideTransition.pre m0) c) 800 0}; timer overwritten: {n.timerL.map fun v => (v, PipeTransitionAll.lengthOf sy (SideTransitionAll.timerAt nm e v) 800 0)}; six objects: {n.lagL}; time-up flag: {n.X}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideTransitionAll.allCheck sy m0 nm R Rvar RE n
  IO.println s!"the check: {ok} ({(← IO.monoMsNow) - t0} ms)"
  return if ok then 0 else 1

/-- one byte at a time, from the state `start` frames after the side pipe's entry, for the bytes the run reads: the bytes that change the length. With `few`, ten values
of each byte first, and all values only of a byte where one of them changes the length. -/
def sideAllBytes (sy : Syms) (romPath : String) (start n shard shards : Nat) (few : Bool) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let base := PipeTransition.run (SideTransition.entry m0) (PipeTransition.zeros start)
  let bytes := PipeTransitionAll.readSet n (PipeTransitionAll.norm base)
  for a in bytes do
    if a % shards != shard then continue
    let orig := base.ram.get! a
    let len := fun (v : Nat) => PipeTransitionAll.lengthOf sy (poke base a.toUInt16 v.toUInt8) (n + 400) 0
    let some' : List Nat := [0, 1, 2, 0x10, 0x40, 0x7F, 0x80, 0xFF, (orig + 1).toNat, (orig - 1).toNat]
    if few && !some'.any (fun v => v.toUInt8 != orig && len v != n) then continue
    let other := (List.range 256).filterMap fun v =>
      if v.toUInt8 == orig then none else
      let l := len v
      if l == n then none else some (v, l)
    if !other.isEmpty then
      let short := other.filter fun p => p.2 != 0 && p.2 < n
      IO.println s!"byte {a}, value {orig}: {other.length} other values change the length; shorter: {short.length}, first {short.take 8}; first {other.take 8}"
      flush
  return 0

/-- the frame before the side pipe's entry: every value of each byte the entry frame reads, one at a time; the bytes with a value that enters with another timer -/
def sideAllBefore (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := SideTransitionAll.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let p := SideTransition.pre m0
  let tm := fun (m : Machine) => peek m (nm.ad "ChangeAreaTimer")
  let tm0 := tm (PipeTransition.frame p SideTransition.walkIn)
  let bytes := flagged (PipeTransition.frame (PipeTransitionAll.track (PipeTransitionAll.norm p)) SideTransition.walkIn).trkRead
  IO.println s!"bytes the entry frame reads: {bytes.length}"
  for a in bytes do
    let orig := p.ram.get! a
    let others := (List.range 256).filter fun v => v.toUInt8 != orig
    let vals := others.filterMap fun v =>
      let q := poke p a.toUInt16 v.toUInt8
      let q' := PipeTransition.frame q SideTransition.walkIn
      if SideTransition.entersAt sy q SideTransition.walkIn && tm q' != tm0 then some (v, tm q') else none
    if !vals.isEmpty then
      IO.println s!"byte {a}, value {orig}: {vals.length} values enter with another timer; first {vals.take 4}"
      flush
  return 0

/-- a movie's side pipe entry against the assumptions of `SideTransitionAll.every_entry` (the movie stays out of the theorem) -/
def sideAllMovie (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let (m0, nm, R, Rvar, _) ← sideAllSets sy romPath
  let T := SideTransitionAll.cutOf m0 160
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut m := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek m sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    m := runFrame m inputs[k]!
    seen := seen || controllable sy m
    k := k + 1
  let t := PipeTransition.run m (PipeTransition.zeros 160)
  let v := PipeTransitionAll.phaseOf T nm t
  IO.println s!"entry on movie frame {k - 1}: control after {PipeTransitionAll.lengthOf sy m 800 0} frames; (H1) to (H4): {SideTransitionAll.assumptionsHold sy nm R Rvar T 160 122 m}"
  IO.println s!"the run from the cut reads only R: {PipeTransitionAll.readsIn R (PipeTransition.run (PipeTransitionAll.track (PipeTransitionAll.norm t)) (PipeTransition.zeros 122))}"
  IO.println s!"bytes of Rvar that differ from the reference: {(Rvar.filter fun i => t.ram.get! i != v.ram.get! i).length} of {Rvar.length}"
  return 0

/-- walking right from `m`: the machine before the frame that enters the side pipe -/
def sideWalkToEntry (sy : Syms) : Nat → Machine → Option Machine
  | 0, _ => none
  | n + 1, m =>
    if SideTransition.entersAt sy m SideTransition.walkIn then some m
    else sideWalkToEntry sy n (PipeTransition.frame m SideTransition.walkIn)

/-- real entries against the assumptions of `SideTransitionAll.every_entry`: `d < 21` more frames on the block or on the floor, then walking right until he enters -/
def sideAllReal (sy : Syms) (romPath : String) : IO UInt32 := do
  let (m0, nm, R, Rvar, _) ← sideAllSets sy romPath
  let T := SideTransitionAll.cutOf m0 160
  let o := PipeTransition.run m0 SideTransition.onBlock
  let s := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run s (PipeTransition.zeros d)]
  let results := (starts.filterMap (sideWalkToEntry sy 300)).map fun p =>
    let m := PipeTransition.frame p SideTransition.walkIn
    (SideTransition.xOf sy m - SidePipe.xLo sy, PipeTransitionAll.lengthOf sy m 800 0, SideTransitionAll.assumptionsHold sy nm R Rvar T 160 122 m)
  IO.println s!"of {starts.length} starts, real entries: {results.length}; length 282: {(results.filter (·.2.1 == 282)).length}; (H1) to (H4): {(results.filter (·.2.2)).length}; pixels: {(results.map (·.1)).eraseDups}"
  let e := SideTransition.entry m0
  let len := fun (c : PipeTransition.Change) => PipeTransitionAll.lengthOf sy (PipeTransition.applyChange e c) 800 0
  IO.println s!"the overwritten states of the vertical pipe's check on this entry: {((PipeTransitionAll.scenes sy nm e).map len).eraseDups}; screen moved at the end of the entry frame: {(PipeTransitionAll.pageScenes nm e).map len}; six objects: {(PipeTransitionAll.lagScenes sy nm e).map len}"
  return 0

/-- the number `left` of the change into the room on real frames: the movie's entry, the reference entry, the real entries; no input, random inputs without Start, random inputs -/
def pipeBoundCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := PipeChangeBound.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let e := PipeTransition.entry m0
  let lf := PipeChangeBound.leftOf sy nm sy.EngVerticalPipe (PipeChangeBound.tableOf sy nm e 48 43) 43
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let mut frames := 0
  let mut bad := 0
  let mut least := 100000
  let mut s : UInt64 := 4242
  for m in [e, t] ++ (PipeTransitionAll.realEntries sy m0 25 13).map (·.2) do
    if lf m != 91 then bad := bad + 1
    for kind in [0, 1, 2] do
      let mut c := m
      let mut j := 0
      let mut done := false
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let c2 := PipeTransition.frame c (if kind == 0 then 0 else if kind == 1 then r &&& 0xEF else r)
        if lf c > lf c2 + 1 then bad := bad + 1
        c := c2
        j := j + 1
        if controllable sy c then
          done := true
          if lf c != 0 then bad := bad + 1
          if j < least then least := j
      frames := frames + j
  IO.println s!"frames {frames}, frames where left falls by more than one or control with left not 0: {bad}, least frames to control {least}"
  return if bad == 0 then 0 else 1

/-- the side pipe's condition on one state and the number of frames left: the check, as a program, then real entries with no input, with random inputs without Start, with random inputs, with Start held -/
def sideBoundCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := SideChangeBound.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let e := SideTransition.entry m0
  let E := SideChangeBound.sideEnv nm e
  let V := SideChangeBound.refsOf nm e
  let tbl := SideChangeBound.tableFrom sy nm 122 (PipeTransition.run e (PipeTransition.zeros 160))
  let lf := PipeChangeBound.leftOf sy nm sy.EngSidePipe tbl 122
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let real := (starts.filterMap (sideWalkToEntry sy 300)).map fun p => PipeTransition.frame p SideTransition.walkIn
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideChangeBound.allCheck sy nm e (e :: real) 160 122
  IO.println s!"the check of one frame: {ok} ({(← IO.monoMsNow) - t0} ms)"
  let all := e :: t :: real
  IO.println s!"entries {all.length}; with the condition {(all.filter (SideChangeBound.entryOK E V 160)).length}"
  -- the overwritten states with a shorter change: the condition excludes them
  let snm := SideTransitionAll.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let p := SideTransition.pre m0
  let page := (SideTransitionAll.pageBefore sy snm).map fun c => SideTransitionAll.entryWith p c
  let zero := PipeTransition.frame (poke (SideTransition.atX sy p (SideTransition.zeroX sy)) (nm.ad "ChangeAreaTimer") 5) SideTransition.walkIn
  IO.println s!"shorter changes: {(zero :: page).map fun m => (PipeTransitionAll.lengthOf sy m 800 0, SideChangeBound.entryOK E V 160 m)} (length, condition)"
  let mut frames := 0
  let mut bad := 0
  let mut least := 100000
  let mut noCtl := 0
  let pn := PipeTransitionAll.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let mut laggy : List Nat := []
  let mut s : UInt64 := 4242
  for m in all do
    if lf m != 282 then bad := bad + 1
    for kind in [0, 1, 2, 3] do
      let mut c := m
      let mut j := 0
      let mut done := false
      let mut lg := 0
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let c2 := PipeTransition.frame c (if kind == 0 then 0 else if kind == 1 then r &&& 0xEF else if kind == 2 then r else 0x10)
        if lf c > lf c2 + 1 then bad := bad + 1
        if lf c > lf c2 && CastleToLevel.phaseOf pn c2 == CastleToLevel.phaseOf pn c then lg := lg + 1
        c := c2
        j := j + 1
        if controllable sy c then
          done := true
          if lf c != 0 then bad := bad + 1
          if j < least then least := j
      if !done then noCtl := noCtl + 1
      laggy := lg :: laggy
      frames := frames + j
  IO.println s!"frames {frames}, frames where left falls by more than one or control with left not 0: {bad}, least frames to control {least}, runs with no control in 1500 frames {noCtl}; frames in one run where the timers do not run and left falls: {laggy.eraseDups}"
  return if ok && bad == 0 then 0 else 1

/-- the frames from the first control in the room to the side pipe: the check, as a program, then the conditions on real frames: the movie, real entries with random inputs and pauses, a big Mario, runs to the right -/
def screenCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := ScreenPage.namesOf txt
  let r := SideTransition.pre m0
  let P := ScreenPage.placesOf sy nm m0 r
  let Z := ScreenPage.aidsOf sy nm m0
  let E := ScreenPage.envOf nm sy r
  let K := ScreenPage.knownOf nm
  let pauseI := ((nm.ad "GamePauseStatus") &&& 0x7FF).toNat
  -- the condition at the entry of the side pipe
  let nm2 := SideChangeBound.namesOf txt
  let nx2 := SideChangeEnd.namesOf txt
  let e := SideTransition.entry m0
  let V := SideChangeEnd.refs2 nm2 nx2 e
  let W := ScreenPage.entryW nm V
  let E2 := SideChangeBound.sideEnv nm2 e
  let ent := fun (c : Machine) => (ScreenPage.restOK nm V c, SideChangeBound.entryOK E2 V 160 c)
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => ScreenPage.searchOf P Z E r K
  let t1 ← IO.monoMsNow
  IO.println s!"the search: {X.steps} steps, {X.forks} forks, {X.fails} failures, {X.joins} joins, {X.done.size} keys, {X.ends.size} frame ends, {t1 - t0} ms"
  let ok ← IO.lazyPure fun _ => ScreenPage.roomCheck sy nm m0 160 V && ScreenPage.entryEnvOK sy nm m0 E2 V
  let t2 ← IO.monoMsNow
  let C ← IO.lazyPure fun _ => ScreenPage.cfgOf P Z E r K W
  IO.println s!"the check (roomCheck, entryEnvOK): {ok}, {t2 - t1} ms; table {C.t.size}; known bytes {K.length}; long timer {P.long}; bytes left to the entry {(ScreenPage.restIdx nm).length}"
  -- the frame ends with the pipe's routine: the bytes of the condition at the entry that the walk does not know
  let names := SideChangeBound.knownNames ++ SideChangeBound.recordNames ++ SideChangeEnd.extraNames
  let nameOf := fun (i : Nat) => (names.flatMap fun p => (List.range p.2.2).filterMap fun j =>
    if (((nx2.ad p.1).toNat + p.2.1 + j) &&& 0x7FF) == i then some s!"{p.1}+{p.2.1 + j}" else none).headD s!"{i}"
  let ends := (C.t.toList ++ ScreenPage.startsR r K).flatMap (ScreenPage.walkEnds C ScreenPage.fuelS)
  let ent2 := ends.filter fun B => (B.getK P.rtI).isK && (B.getK P.rtI).v == P.eng
  let miss := (ent2.flatMap fun B => V.flatMap fun v => v.2.filter fun i => !TaintRun.knownIs B (i, v.1.ram.get! i)).eraseDups
  IO.println s!"frame ends of the walk {ends.length}, with the pipe's routine {ent2.length}; bytes of the condition at the entry not known there ({miss.length}): {miss.map nameOf}; all of them left to the entry: {miss.all (ScreenPage.restIdx nm).contains}"
  flush
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  -- the movie, from its first control in the room
  let mut t := powerOn cart 0
  let mut k := 0
  let mut seenPipe := false
  while k < inputs.size && !(seenPipe && controllable sy t) do
    t := runFrame t inputs[k]!
    k := k + 1
    if (peek t sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then seenPipe := true
  IO.println s!"the movie: first control in the room on movie frame {k}, in the condition: {ScreenPage.roomOK E r K t}"
  let c0 := t
  let mut rm : ScreenPage.Report := {}
  while k < inputs.size && ScreenPage.roomOK E r K t do
    let (a, b) := ScreenPage.scanFrame P E r K pauseI t inputs[k]! rm ent
    rm := a
    t := b
    k := k + 1
  IO.println s!"the movie in the room: {rm.show}"
  let mut condBad := rm.condNo
  flush
  -- real entries into the room
  let reals := PipeTransitionAll.realEntries sy m0 25 13
  let rec toCtl (fu : Nat) (c : Machine) : Option Machine :=
    match fu with
    | 0 => none
    | fu' + 1 => if controllable sy c then some c else toCtl fu' (PipeTransition.frame c 0)
  let ctls0 := reals.filterMap fun q => toCtl 400 q.2
  IO.println s!"real entries into the room {reals.length}, first control {ctls0.length}, in the condition {(ctls0.filter (ScreenPage.roomOK E r K)).length}"
  -- other histories: random inputs on the pipe, then Down; and other values at the start of 1-1
  let mut s : UInt64 := 88172645463325252
  let mut hist : Array Machine := #[]
  let pokes : List (List (UInt16 × UInt8)) := [[], [(sy.NumberofLives, 0)], [(sy.NumberofLives, 8), (nm.ad "CoinTally", 57)], [(nm.ad "CoinTally", 99), (nm.ad "PlayerScoreDisplay", 9), (nm.ad "GameTimerDisplay", 2)],
    [(nm.ad "HalfwayPage", 0), (nm.ad "Hidden1UpFlag", 1)], [(nm.ad "FrameCounter", 77), (nm.ad "PseudoRandomBitReg", 200)]]
  for pk in pokes do
    let st := PipeTransition.standing (pk.foldl (fun c q => poke c q.1 q.2) m0)
    for _ in [0:12] do
      let mut c := st
      s := s ^^^ (s <<< 13)
      s := s ^^^ (s >>> 7)
      s := s ^^^ (s <<< 17)
      let wait := (s >>> 25).toNat % 120
      for _ in [0:wait] do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        c := PipeTransition.frame c ((s >>> 13).toUInt8 &&& 0xC3)
      let mut n := 0
      while n < 60 && (peek c sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe do
        c := PipeTransition.frame c 0x04
        n := n + 1
      if (peek c sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then
        match toCtl 400 c with
        | some q => hist := hist.push q
        | none => pure ()
  IO.println s!"other histories (random inputs on the pipe, other values at the start of 1-1): first control {hist.size}, in the condition {(hist.toList.filter (ScreenPage.roomOK E r K)).length}"
  flush
  -- the game timer near 100 at the first control: the hurrying music
  let hurry := (ctls0.take 3).map fun c => poke (poke (poke c (nm.ad "GameTimerDisplay") 1) ((nm.ad "GameTimerDisplay") + 1) 0) ((nm.ad "GameTimerDisplay") + 2) 2
  let mut rh : ScreenPage.Report := {}
  for c in hurry do
    let mut c1 := c
    let mut n := 0
    while n < 300 && ScreenPage.roomOK E r K c1 do
      let (a, b) := ScreenPage.scanFrame P E r K pauseI c1 0 rh ent
      rh := a
      c1 := b
      n := n + 1
  IO.println s!"the game timer near 100, written at the first control: {rh.show}"
  condBad := condBad + rh.condNo
  flush
  -- right of the pipe, written: he runs right past the screen, with pauses
  let mut rp : ScreenPage.Report := {}
  let mut far := 0
  let mut farPage := 0
  for c in (c0 :: ctls0.take 3) do
    for x in [212, 230, 250] do
      let mut c1 := poke (poke c sy.Player_X_Position x.toUInt8) sy.Player_Y_Position 0x70
      let mut n := 0
      while n < 400 && (ScreenPage.roomOK E r K c1) do
        let i : UInt8 := if n % 97 == 96 then 0x10 else if n % 40 < 8 then 0xC1 else 0x41
        let (a, b) := ScreenPage.scanFrame P E r K pauseI c1 (smbToPad i) rp ent
        rp := a
        c1 := b
        n := n + 1
        let px := 256 * (peek c1 sy.Player_PageLoc).toNat + (peek c1 sy.Player_X_Position).toNat
        if px > far then far := px
        if (peek c1 sy.Player_PageLoc).toNat > farPage then farPage := (peek c1 sy.Player_PageLoc).toNat
  IO.println s!"right of the pipe, written, holding Right and B with pauses: {rp.show}; the furthest pixel {far}, his page {farPage}"
  condBad := condBad + rp.condNo
  flush
  let ctls := ctls0 ++ hist.toList.filter (ScreenPage.roomOK E r K)
  -- random inputs with pauses, runs to the right, jumps
  let big := fun (c : Machine) => poke (poke c sy.PlayerSize 0) (nm.ad "PlayerStatus") 1
  let mut bad := 0
  for (name, starts) in [("small", c0 :: ctls), ("big", (c0 :: ctls.take 3).map big)] do
    let mut rr : ScreenPage.Report := {}
    for c in starts do
      if !ScreenPage.roomOK E r K c then bad := bad + 1
      for style in [0, 1, 2, 3, 4] do
        let mut c1 := c
        let mut n := 0
        let mut left := 0
        let mut hold : UInt8 := 0
        while n < 900 && ScreenPage.roomOK E r K c1 do
          if left == 0 then
            s := s ^^^ (s <<< 13)
            s := s ^^^ (s >>> 7)
            s := s ^^^ (s <<< 17)
            left := 1 + (s >>> 20).toNat % 40
            let bits := (s >>> 30).toUInt8
            hold := if style == 0 then bits else if style == 1 then bits &&& 0xEF else if style == 2 then (bits &&& 0xC0) ||| 0x01 else if style == 3 then bits &&& 0xD2 else (bits &&& 0x80) ||| 0x41
          let (a, b) := ScreenPage.scanFrame P E r K pauseI c1 (smbToPad hold) rr ent
          rr := a
          c1 := b
          n := n + 1
          left := left - 1
    IO.println s!"{name}, random inputs: {rr.show}"
    condBad := condBad + rr.condNo
    flush
  return if ok && bad == 0 && condBad == 0 then 0 else 1

/-! ## The sound routine as one step (`SoundWalk`): measurements -/

/-- run the machine until its `pc` is `pc`, at most `n` steps -/
def runToPc (m : Machine) (pc : UInt16) : Nat → Option Machine
  | 0 => none
  | n + 1 => if m.pc == pc then some m else runToPc (PipeTransitionAll.go step m).2 pc n

/-- run the machine until the return of a call: the stack pointer `s` and `pc` = `ret`; the number of steps -/
def runToRet (m : Machine) (s : UInt8) (ret : UInt16) : Nat → Nat → Option (Machine × Nat)
  | 0, _ => none
  | n + 1, k => if m.s == s && m.pc == ret then some (m, k) else runToRet (PipeTransitionAll.go step m).2 s ret n (k + 1)

/-- `n` steps of the machine -/
def runToPcN (m : Machine) : Nat → Machine
  | 0 => m
  | n + 1 => runToPcN (PipeTransitionAll.go step m).2 n

/-- the abstract state that knows all of a machine -/
def asOfM (m : Machine) : TaintRun.AS :=
  { a := TaintRun.AB.known m.a, x := TaintRun.AB.known m.x, y := TaintRun.AB.known m.y, s := m.s, p := TaintRun.AB.known m.p, pc := m.pc, ram := m.ram,
    kn := ByteArray.mk (Array.replicate 2048 0xFF), ppuCtrl := TaintRun.AB.known m.ppuCtrl, ppuMask := TaintRun.AB.known m.ppuMask, vb := m.vblank, nmi := m.nmiPending,
    lo := m.fdot, hi := m.fdot, padShift := TaintRun.AB.known m.padShift, strobe := m.padStrobe, dg := false, k := 0 }

/-- the machine at the entry of the sound routine on the frame after `m` -/
def atSound (sy : Syms) (m : Machine) : Option Machine := runToPc m sy.SoundEngine 200000

def soundCheck (sy : Syms) (romPath : String) (variant : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let ns := SoundWalk.namesOf text
  let SB := SoundWalk.soundBytes ns
  IO.println s!"sound bytes: {SB.length}"
  let e := SideTransition.entry m0
  let x := PipeTransition.run e (PipeTransition.zeros 200)
  let some mc := atSound sy x | IO.println "no call"; return 1
  let s0 := mc.s
  let ret : UInt16 := ((mc.ram.get! (0x100 + s0.toNat + 1)).toUInt16 ||| ((mc.ram.get! (0x100 + s0.toNat + 2)).toUInt16 <<< 8)) + 1
  IO.println s!"entry pc {hex4 mc.pc} s {hex2 s0} dot {mc.fdot} vblank {mc.vblank} nmi {mc.nmiPending}; return {hex4 ret}"
  let E : TaintRun.Env := { prg := mc.prg, mask := mc.prgMask, pad := TaintRun.AB.top, D := [] }
  let ops := (TaintRun.aRows E).toArray
  let A0 := asOfM mc
  let A1 : TaintRun.AS := { A0 with a := TaintRun.AB.top, x := TaintRun.AB.top, y := TaintRun.AB.top, p := TaintRun.AB.top }
  let A2 := SB.foldl (fun (A : TaintRun.AS) i => A.setK i TaintRun.AB.top) A1
  -- the variant: `known`, `ctz`, and `NAME=VV/KK` (the known bits of a byte)
  let toks := variant.splitOn ";"
  let hexB := fun (t : String) => (t.toList.foldl (fun v c => 16 * v + (hexDigit c).toNat) 0).toUInt8
  let start := toks.foldl (fun (A : TaintRun.AS) t =>
      match t.splitOn "=" with
      | [n, vk] => match vk.splitOn "/" with
        | [v, k] => A.setK ((ns.ad n) &&& 0x7FF).toNat ⟨hexB v, hexB k⟩
        | _ => A
      | _ => A) (if toks.contains "known" then A1 else A2)
  -- `flagrows`: the rows of the time with one bit of the sound's pause flag known to be 1
  if toks.contains "flagrows" then
    let nm := SideChangeBound.namesOf text
    let nx := SideChangeEnd.namesOf text
    let c := SideChangeEnd.timeCtx sy nm nx e 160 122
    let t1 ← IO.monoMsNow
    let r0 := SideChangeEnd.timeRows c nx e 160 122
    let ok0 := SideChangeEnd.chainOKD c r0 && SideChangeEnd.zeroCtl sy r0
    IO.println s!"rows of the time, flag 0: {ok0}, rows {r0.length}, states {r0.foldl (fun a r => a + r.R.length) 0}, table {r0.foldl (fun a r => a + r.t.size) 0} ({(← IO.monoMsNow) - t1} ms)"
    -- the steps of the search, as `rowsFromD` makes the rows
    let stepsOf := fun (R0 : List TaintRun.AS) => Id.run do
      let mut R := R0
      let mut n := 0
      for k in [0:122] do
        let core := R.any fun S => SideChangeEnd.coreFrame c.sy c.eng (SideChangeEnd.mOf S)
        let e2 : TaintRun.Env := if core then { c.E with pad := SideChangeEnd.noStartPad } else c.E
        let X := SideChangeEnd.xsearch e2 (TaintRun.aRows e2).toArray c.keep R
        n := n + X.steps
        R := SideChangeEnd.nextStatesD c.E (k == 121) X.ends.toList
      return n
    IO.println s!"steps of the search, flag 0: {stepsOf (SideChangeEnd.timeBase nx e 160)}, flag bit 01: {stepsOf (SideChangeEnd.timeBaseF nx e 160 1)}, flag bit 80: {stepsOf (SideChangeEnd.timeBaseF nx e 160 0x80)}"
    let tc ← IO.monoMsNow
    IO.println s!"flagCheck: {SideChangeEnd.flagCheck sy nm nx e 160 122} ({(← IO.monoMsNow) - tc} ms)"
    for b in TaintRun.bitList do
      let t2 ← IO.monoMsNow
      let r := SideChangeEnd.timeRowsF c nx e 160 122 b
      let ok := SideChangeEnd.chainOKD c r && SideChangeEnd.zeroCtl sy r
      IO.println s!"rows of the time, flag bit {hex2 b}: {ok}, rows {r.length}, states {r.foldl (fun a r => a + r.R.length) 0}, table {r.foldl (fun a r => a + r.t.size) 0} ({(← IO.monoMsNow) - t2} ms)"
      flush
    return 0
  -- `table`: the sound's bytes at the call on the frames after the exit, for the unpause sound with each count, and the walk from each
  if toks.contains "table" then
    let nx := SideChangeEnd.namesOf text
    let xT := PipeTransition.run e (PipeTransition.zeros 160)
    let mut tbl : Std.HashMap (List UInt8) Unit := {}
    let mut calls := 0
    let mut cmin := 1000000
    let mut cmax := 0
    for c in [0:44] do
      let m1 := if c == 0 then xT
        else if c == 43 then poke (poke xT (nx.ad "PauseSoundQueue") 2) (nx.ad "PauseModeFlag") 2
        else poke (poke (poke xT (nx.ad "PauseSoundBuffer") 2) (nx.ad "PauseModeFlag") 2) (ns.ad "Squ1_SfxLenCounter") c.toUInt8
      let mut m := m1
      for _ in [0:123] do
        match atSound sy m with
        | some mcall =>
          tbl := tbl.insert (SB.map fun i => mcall.ram.get! i) ()
          calls := calls + 1
          let r := ((mcall.ram.get! (0x100 + mcall.s.toNat + 1)).toUInt16 ||| ((mcall.ram.get! (0x100 + mcall.s.toNat + 2)).toUInt16 <<< 8)) + 1
          match runToRet mcall (mcall.s + 2) r 100000 0 with
          | some (m', _) =>
            cmin := Nat.min cmin (m'.cyc - mcall.cyc)
            cmax := Nat.max cmax (m'.cyc - mcall.cyc)
          | none => pure ()
        | none => pure ()
        m := PipeTransition.frame m 0
    IO.println s!"calls {calls}, sound states {tbl.size}, cycles of the real calls [{cmin}, {cmax}]"
    let mut steps := 0
    let mut fails := 0
    let mut dlo := 1000000
    let mut dhi := 0
    for σ in tbl.keys do
      let S := (SB.zip σ).foldl (fun (A : TaintRun.AS) (i, v) => A.setK i (TaintRun.AB.known v)) A1
      let Y := SoundWalk.ssearch (SideChangeEnd.xsuccs E ops) (SideChangeEnd.xkey E []) (fun B => B.s == s0 + 2 && B.pc == ret) 100000 [S]
      steps := steps + Y.steps
      fails := fails + Y.fails + Y.over
      for B in Y.ends do
        dlo := Nat.min dlo (B.lo - mc.fdot)
        dhi := Nat.max dhi (B.hi - mc.fdot)
    IO.println s!"walks from each sound state: steps {steps}, failures {fails}, dots of the call [{dlo}, {dhi}]"
    return 0
  -- `exits`: real exits with Start at random on the pipe's frames; the sound bytes at the exit, the sound states at the calls after it, the writes of the game
  -- to the sound bytes outside the call, and the walk of the call from each state (`StepWrites`: what a table of sound states needs)
  if toks.contains "exits" then
    let nx := SideChangeEnd.namesOf text
    let nm := SideChangeBound.namesOf text
    let o := PipeTransition.run m0 SideTransition.onBlock
    let st := PipeTransition.run o SideTransition.stand
    let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
    let real := (starts.filterMap (sideWalkToEntry sy 300)).map fun p => PipeTransition.frame p SideTransition.walkIn
    let all := e :: real
    let SBs := SB.foldl (fun (h : Std.HashSet Nat) i => h.insert i) {}
    let pq := SideChangeEnd.adI nx "PauseSoundQueue"
    let pb := SideChangeEnd.adI nx "PauseSoundBuffer"
    let pf := SideChangeEnd.adI nx "PauseModeFlag"
    let pc := ((ns.ad "Squ1_SfxLenCounter") &&& 0x7FF).toNat
    -- one frame, step by step: the sound state at each call, and the game's writes to sound bytes outside the call
    let frameScan := fun (c : Machine) (i : UInt8) => Id.run do
      let mut m := { c with pad := smbToPad i }
      let f := c.frame
      let mut calls : List (List UInt8) := []
      let mut writes : List (UInt16 × Nat × UInt8) := []
      let mut depth : Option UInt8 := none
      let mut n := 0
      while m.frame == f && !m.halted && n < fuelPerFrame do
        if depth.isNone && m.pc == sy.SoundEngine then
          depth := some m.s
          calls := (SB.map fun i => m.ram.get! i) :: calls
        let m' := (PipeTransitionAll.go step m).2
        match depth with
        | some d => if m'.s == d + 2 then depth := none
        | none =>
          for i in StepWrites.stepLocs m do
            if SBs.contains i then writes := (m.pc, i, m'.ram.get! i) :: writes
        m := m'
        n := n + 1
      return (m, calls, writes)
    let mut s : UInt64 := 99991
    let mut exitKinds : Std.HashMap (List UInt8) Nat := {}
    let mut exitAll : Std.HashMap (List UInt8) Nat := {}
    let mut tbl : Std.HashMap (List UInt8) Unit := {}
    let mut tblS : Std.HashMap (List UInt8) Unit := {}
    let mut gw : Std.HashMap (UInt16 × Nat × UInt8) Nat := {}
    let mut gwS : Std.HashMap (UInt16 × Nat × UInt8) Nat := {}
    let mut runs := 0
    let mut kxSame := 0
    let xT := SideChangeEnd.refExit e 160
    for m in all do
      for withStart in [false, true] do
        for _ in [0:10] do
          let mut c := m
          let mut after := false
          let mut j := 0
          let mut done := false
          while !done && j < 1500 do
            s := s ^^^ (s <<< 13)
            s := s ^^^ (s >>> 7)
            s := s ^^^ (s <<< 17)
            let r := (s >>> 13).toUInt8
            let i := if (!after || withStart) && (s >>> 40) % 9 == 0 then r ||| 0x10 else r &&& 0xEF
            let (c2, calls, writes) := frameScan c i
            if after then
              for t in calls do
                if withStart then tblS := tblS.insert t () else tbl := tbl.insert t ()
              for w in writes do
                if withStart then gwS := gwS.insert w (gwS.getD w 0 + 1) else gw := gw.insert w (gw.getD w 0 + 1)
            if !after && !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
              after := true
              runs := runs + 1
              let k := [c2.ram.get! pq, c2.ram.get! pb, c2.ram.get! pf, c2.ram.get! pc]
              exitKinds := exitKinds.insert k (exitKinds.getD k 0 + 1)
              let v := SB.map fun i => c2.ram.get! i
              exitAll := exitAll.insert v (exitAll.getD v 0 + 1)
              if (SB.filter fun i => (SideChangeEnd.exitKnown nx).contains i && i != pq && i != pb && i != pf && i != pc).all fun i => c2.ram.get! i == xT.ram.get! i then kxSame := kxSame + 1
            c := c2
            j := j + 1
            if controllable sy c then done := true
    IO.println s!"runs {runs}; at the exit: (PauseSoundQueue, PauseSoundBuffer, PauseModeFlag, Squ1_SfxLenCounter) kinds {exitKinds.size}, sound states {exitAll.size}; the other sound bytes of the exit's list with the reference's values {kxSame}"
    IO.println s!"  kinds: {(exitKinds.toList.mergeSort (fun a b => a.2 ≥ b.2)).take 50}"
    let nonPause := (exitAll.keys.map fun v => (SB.zip v).filter fun (i, _) => i != pq && i != pb && i != pf && i != pc).eraseDups
    IO.println s!"  sound states at the exit without the four pause bytes: {nonPause.length}"
    let names := SoundWalk.soundNames.flatMap fun p => (List.range p.2.2).map fun j => (((ns.ad p.1).toNat + p.2.1 + j) &&& 0x7FF, s!"{p.1}+{j}")
    let nameOf := fun (i : Nat) => (names.find? (·.1 == i)).map (·.2) |>.getD s!"{i}"
    -- which sound bytes differ between exits
    let vs := exitAll.keys
    let varying := SB.filter fun i => (vs.map fun v => ((SB.zip v).find? (·.1 == i)).map (·.2)).eraseDups.length > 1
    IO.println s!"  sound bytes that differ between exits: {varying.map nameOf}"
    IO.println s!"no Start after the exit: sound states at the calls {tbl.size}; writes of the game to sound bytes outside the call {gw.size}: {(gw.toList.map fun ((p, i, v), n) => s!"{hex4 p}:{nameOf i}={hex2 v}x{n}")}"
    IO.println s!"Start at random after the exit too: sound states at the calls {tblS.size}; writes of the game {gwS.size}: {(gwS.toList.map fun ((p, i, v), n) => s!"{hex4 p}:{nameOf i}={hex2 v}x{n}")}"
    flush
    for (name, T) in [("no Start", tbl), ("Start", tblS)] do
      let mut steps := 0
      let mut fails := 0
      let mut dlo := 1000000
      let mut dhi := 0
      let mut outside := 0
      let t0 ← IO.monoMsNow
      for σ in T.keys do
        let S := (SB.zip σ).foldl (fun (A : TaintRun.AS) (i, v) => A.setK i (TaintRun.AB.known v)) A1
        let Y := SoundWalk.ssearch (SideChangeEnd.xsuccs E ops) (SideChangeEnd.xkey E []) (fun B => B.s == s0 + 2 && B.pc == ret) 100000 [S]
        steps := steps + Y.steps
        fails := fails + Y.fails + Y.over
        for B in Y.ends do
          dlo := Nat.min dlo (B.lo - mc.fdot)
          dhi := Nat.max dhi (B.hi - mc.fdot)
          let σ' := SB.map fun i => (B.getK i).v
          if !(SB.all fun i => (B.getK i).isK) || !T.contains σ' then outside := outside + 1
      IO.println s!"{name}: walks of the call from each of {T.size} states: steps {steps}, failures {fails}, dots of the call [{dlo}, {dhi}], ends not in the table {outside} ({(← IO.monoMsNow) - t0} ms)"
      flush
    return 0
  -- `keeprows`: on the walks of the rows `rows0`, the states outside the sound routine where `StepWrites.keepOK` does not say that no sound byte is written
  if toks.contains "keeprows" then
    let nm := SideChangeBound.namesOf text
    let nx := SideChangeEnd.namesOf text
    let c := SideChangeEnd.rowCtx sy nm nx e 160 122
    let rows := SideChangeEnd.rows0 c nx e 160 122
    let SBs := SB.foldl (fun (h : Std.HashSet Nat) i => h.insert i) {}
    let P : Nat → Bool := fun i => SBs.contains i
    let mut visited := 0
    let mut inSound := 0
    let mut fails : Std.HashMap UInt16 Nat := {}
    for r in rows do
      let C := SideChangeEnd.rowCfg c r
      let mut stack : List TaintRun.AS := r.t.toList ++ r.R
      let mut seen : Std.HashSet UInt64 := {}
      let mut n := 0
      while !stack.isEmpty && n < 3000000 do
        match stack with
        | [] => pure ()
        | A :: rest =>
          stack := rest
          n := n + 1
          visited := visited + 1
          if A.pc ≥ sy.SoundEngine then inSound := inSound + 1
          else if !StepWrites.keepOK C.E P A then fails := fails.insert A.pc (fails.getD A.pc 0 + 1)
          for o in SideChangeEnd.xsuccs C.E C.ops A do
            match o with
            | none => pure ()
            | some B =>
              if B.k == A.k && !(C.cut.get! B.pc.toNat != 0 && TaintRun.coverIn C B) then
                let h := hash (B.pc, B.lo, B.hi, TaintRun.keyOf C.E C.keep B)
                if !seen.contains h then
                  seen := seen.insert h
                  stack := B :: stack
    let names := SoundWalk.soundNames.flatMap fun p => (List.range p.2.2).map fun j => (((ns.ad p.1).toNat + p.2.1 + j) &&& 0x7FF, s!"{p.1}+{j}")
    let nameOf := fun (i : Nat) => (names.find? (·.1 == i)).map (·.2) |>.getD s!"{i}"
    let opAt := fun (p : UInt16) => (List.range 3).map fun j => hex2 (mc.prg.get! ((p + j.toUInt16) &&& mc.prgMask).toNat)
    IO.println s!"rows0: rows {rows.length}, states visited {visited}, in the sound routine {inSound}; outside it, keepOK fails at {fails.size} places: {(fails.toList.mergeSort (fun a b => a.2 ≥ b.2)).map fun (p, k) => s!"{hex4 p} {opAt p} x{k}"}"
    IO.println s!"  sound bytes: {SB.map fun i => s!"{nameOf i}={hex4 i.toUInt16}"}"
    return 0
  -- `trows`: the rows of the side change with the sound's bytes forgotten outside the sound routine, the call split by a table for each row (`StepWrites.tsuccs`);
  -- the tables start from the kinds of the pause sound at the exit. A program: no part of the proof.
  if toks.contains "trows" then
    let nm := SideChangeBound.namesOf text
    let nx := SideChangeEnd.namesOf text
    let c := SideChangeEnd.rowCtx sy nm nx e 160 122
    let xT := SideChangeEnd.refExit e 160
    let R : StepWrites.Rt := { SB := SB, call := ret - 3, ret := ret, inR := fun pc => decide (sy.SoundEngine ≤ pc) }
    let P : Nat → Bool := fun i => SB.contains i
    let K := SideChangeEnd.exitKnown nx
    let pq := SideChangeEnd.adI nx "PauseSoundQueue"
    let pb := SideChangeEnd.adI nx "PauseSoundBuffer"
    let pf := SideChangeEnd.adI nx "PauseModeFlag"
    let pc := ((ns.ad "Squ1_SfxLenCounter") &&& 0x7FF).toNat
    let base : StepWrites.SState := (SB.filter fun i => K.contains i && i != pq && i != pb && i != pf && i != pc).map fun i => (i, TaintRun.AB.known (xT.ram.get! i))
    let kn := fun (i : Nat) (v : UInt8) => (i, TaintRun.AB.known v)
    let onlyQuiet := toks.contains "quiet"
    let kinds : List StepWrites.SState :=
      [[kn pq 0, kn pb 0, kn pf 0]] ++ (TaintRun.bitList.map fun b => [kn pq 0, kn pb 0, (pf, (⟨b, b⟩ : TaintRun.AB))]) ++
      (if onlyQuiet then [] else ((List.range 42).map fun j => [kn pq 0, kn pb 2, kn pf 2, kn pc (j + 1).toUInt8]) ++ [[kn pq 2, kn pb 0, kn pf 1, kn pc 0]])
    let T0 : List StepWrites.SState := kinds.map fun kd => base ++ kd
    let starts := (SideChangeEnd.endBase nx e 160).map fun S => StepWrites.retag false (StepWrites.forgetAll SB S)
    let Acall := StepWrites.forgetAll SB A1
    let keepS := c.keep ++ SB
    -- the search with no check on the second table; the bytes at the return and the writing states come out as marked frame ends
    let scan := fun (e2 : TaintRun.Env) (ops2 : Array (TaintRun.AM Unit)) (Tb : List StepWrites.SState) (Rs : List TaintRun.AS) => Id.run do
      let mark := fun (tag : Nat) (B : TaintRun.AS) => ({ B with k := B.k + 1, log := [tag] } : TaintRun.AS)
      let step' := fun (A : TaintRun.AS) =>
        let rs := if R.inR A.pc || A.pc == R.call then StepWrites.tsuccs e2 ops2 R Tb [[]] A
          else (SideChangeEnd.xsuccs e2 ops2 A).map (·.map (StepWrites.retag A.spent))
        let extra : List TaintRun.AS :=
          if R.inR A.pc then
            (SideChangeEnd.xsuccs e2 ops2 A).filterMap fun o => o.bind fun B => if B.pc == R.ret && B.k == A.k then some (mark 1 B) else none
          else if A.pc != R.call && !StepWrites.keepOK e2 P A then [mark 2 A]
          else []
        rs ++ extra.map some
      let X := StepWrites.tsearch step' e2 keepS Rs
      let mut wb : List StepWrites.SState := []
      let mut wa : List StepWrites.SState := []
      let mut rets : List StepWrites.SState := []
      for Z in X.ends do
        if Z.log == [1] then
          let u : StepWrites.SState := SB.map fun i => (i, Z.getK i)
          if !rets.contains u then rets := rets ++ [u]
        else if Z.log == [2] then
          let A := ({ Z with k := Z.k - 1, log := [] } : TaintRun.AS)
          match StepWrites.aLocs e2 A with
          | some L =>
            for o in SideChangeEnd.xsuccs e2 ops2 A do
              match o with
              | some B =>
                let w : StepWrites.SState := (L.filter fun i => SB.contains i).map fun i => (i, B.getK i)
                if A.spent then
                  if !wa.contains w then wa := wa ++ [w]
                else
                  if !wb.contains w then wb := wb ++ [w]
              | none => pure ()
          | none => pure ()
      return (wb, wa, rets, X.steps)
    let mut Rs := starts
    let mut T := T0
    let mut total := 0
    let mut fails := 0
    let mut scanned := 0
    let mut maxT := 0
    let t0 ← IO.monoMsNow
    for k in [0:122] do
      let core := Rs.any fun S => SideChangeEnd.coreFrame c.sy c.eng (SideChangeEnd.mOf S)
      let e2 : TaintRun.Env := if core then { c.E with pad := SideChangeEnd.noStartPad } else c.E
      let ops2 := (TaintRun.aRows e2).toArray
      let (wb, _, _, n1) := scan e2 ops2 T Rs
      let T0c := StepWrites.joinUnder wb T
      let (_, wa, rets, n2) := scan e2 ops2 T0c Rs
      scanned := scanned + n1 + n2
      let kindKey := fun (u : StepWrites.SState) => if toks.contains "nojoin" then u else u.filter fun p => p.1 == pq || p.1 == pb || p.1 == pf || p.1 == pc
      let T1 := StepWrites.joinUnder wa (StepWrites.groupJoin kindKey rets)
      let X := StepWrites.tsearch (StepWrites.tsuccs e2 ops2 R T0c T1) e2 keepS Rs
      total := total + X.steps
      fails := fails + X.fails
      maxT := Nat.max maxT (Nat.max T0c.length T1.length)
      if X.fails > 0 || k % 20 == 0 || k == 121 then
        IO.println s!"row {k}: left {(Rs.head?.map fun S => c.left (SideChangeEnd.mOf S)).getD 0}, table {T0c.length} -> {T1.length}, writes before {wb.length} after {wa.length}, steps {X.steps}, failures {X.fails}, ends {X.ends.size}"
        match X.firstFail with
        | some F =>
          let opAt := fun (p : UInt16) => (List.range 3).map fun j => hex2 (mc.prg.get! ((p + j.toUInt16) &&& mc.prgMask).toNat)
          let knownSB := SB.filter fun i => (F.getK i).isK
          IO.println s!"  first failure at {hex4 F.pc} {opAt F.pc} spent {F.spent} s {hex2 F.s} a {hex2 F.a.v}/{hex2 F.a.k} x {hex2 F.x.v}/{hex2 F.x.k} y {hex2 F.y.v}/{hex2 F.y.k} dots [{F.lo},{F.hi}] sound bytes known {knownSB.length}"
          for o in SideChangeEnd.xsuccs e2 ops2 F do
            match o with
            | none => IO.println "    plain step fails"
            | some B =>
              let u : StepWrites.SState := SB.map fun i => (i, B.getK i)
              IO.println s!"    successor pc {hex4 B.pc} k {B.k} (A.k {F.k}); in T1 {T1.any (StepWrites.soundLe B)}; B's bytes: {u.map fun p => s!"{hex4 p.1.toUInt16}:{hex2 p.2.v}/{hex2 p.2.k}"}"
              for t in T1 do
                let bad := t.filter fun q => !(decide (q.1 < 2048) && (B.getK q.1).le q.2)
                IO.println s!"      T1 entry: bytes against B {bad.map fun p => s!"{hex4 p.1.toUInt16}:{hex2 p.2.v}/{hex2 p.2.k}"}"
              match StepWrites.aLocs e2 F with
              | some L => IO.println s!"    aLocs {L}"
              | none => IO.println "    aLocs none"
        | none => pure ()
        flush
      Rs := (SideChangeEnd.nextStates c.E (k == 121) X.ends.toList).map (StepWrites.retag false)
      -- a frame with no call ends with the first table
      T := (if X.ends.any (!·.spent) then T0c else []) ++ (if X.ends.any (·.spent) then T1 else [])
    IO.println s!"rows with the sound forgotten: steps of the search {total}, states of the scans {scanned}, failures {fails}, largest table {maxT}, last row: {Rs.length} states, left {(Rs.head?.map fun S => c.left (SideChangeEnd.mOf S)).getD 0}, control in all of them {Rs.all fun S => SideChangeEnd.ctlKnown sy S} ({(← IO.monoMsNow) - t0} ms)"
    return 0
  -- `probe`: the settings with all bits known, on the real machine at the call
  if toks.contains "probe" then
    let mp := toks.foldl (fun (m : Machine) t =>
      match t.splitOn "=" with
      | [n, vk] => match vk.splitOn "/" with
        | [v, _] => { m with ram := m.ram.set! ((ns.ad n) &&& 0x7FF).toNat (hexB v) }
        | _ => m
      | _ => m) { mc with trk := true, trkRead := ByteArray.mk (Array.replicate 2048 0), trkWrite := ByteArray.mk (Array.replicate 2048 0), trkIO := false }
    match runToRet mp (s0 + 2) ret 200000 0 with
    | none => IO.println s!"probe: no return in 200000 steps; pc now {hex4 (runToPcN mp 200000).pc}"
    | some (m', k) => IO.println s!"probe: returned after {k} steps, {m'.cyc - mp.cyc} cycles, read a register {m'.trkIO}"
    return 0
  let vic := (ns.vl "VictoryMusic")
  let L : List (Nat × UInt8) := [("EventMusicQueue", 0xFF), ("AreaMusicQueue", 0xFF), ("AreaMusicBuffer_Alt", 0xFF), ("AreaMusicBuffer", 0xFF), ("EventMusicBuffer", vic)].map
    fun (n, k) => (((ns.ad n) &&& 0x7FF).toNat, k)
  let stepF := if toks.contains "ctz" then SoundWalk.ctzSuccs E ops L else SideChangeEnd.xsuccs E ops
  let t0 ← IO.monoMsNow
  let X := SoundWalk.ssearch stepF (SideChangeEnd.xkey E []) (fun B => B.s == s0 + 2 && B.pc == ret) 2000000 [start]
  IO.println s!"abstract ({variant}): steps {X.steps}, failures {X.fails}, frame ends {X.over}, returns {X.ends.size}, places {X.visited.size} ({(← IO.monoMsNow) - t0} ms)"
  let lo := X.ends.foldl (fun a B => Nat.min a B.lo) 1000000
  let hi := X.ends.foldl (fun a B => Nat.max a B.hi) 0
  IO.println s!"  dots of the call: [{lo - mc.fdot}, {hi - mc.fdot}]"
  let fp := (X.failPcs.toList.mergeSort (fun a b => a.2 ≥ b.2)).take 12
  IO.println s!"  failing places: {fp.map fun (p, c) => s!"{hex4 p.toUInt16}:{c}"}"
  match X.firstFail with
  | some F => IO.println s!"  first failure at {hex4 F.pc}: a {hex2 F.a.v}/{hex2 F.a.k} x {hex2 F.x.v}/{hex2 F.x.k} y {hex2 F.y.v}/{hex2 F.y.k} dots [{F.lo}, {F.hi}]"
  | none => pure ()
  -- concrete calls with the sound bytes at random
  let mut sd : UInt64 := 777
  let mut back := 0
  let mut hang := 0
  let mut io := 0
  let mut other := 0
  let mut cmin := 1000000
  let mut cmax := 0
  let runs := 2000
  for _ in [0:runs] do
    let mut m := { mc with trk := true, trkRead := ByteArray.mk (Array.replicate 2048 0), trkWrite := ByteArray.mk (Array.replicate 2048 0), trkIO := false }
    for i in SB do
      sd := sd ^^^ (sd <<< 13)
      sd := sd ^^^ (sd >>> 7)
      sd := sd ^^^ (sd <<< 17)
      m := { m with ram := m.ram.set! i (sd >>> 20).toUInt8 }
    match runToRet m (s0 + 2) ret 100000 0 with
    | none => hang := hang + 1
    | some (m', _) =>
      back := back + 1
      if m'.trkIO then io := io + 1
      let bad := (List.range 2048).any fun i => !SB.contains i && !(0x100 ≤ i && i < 0x200) && m'.ram.get! i != m.ram.get! i
      if bad then other := other + 1
      let c := m'.cyc - m.cyc
      cmin := Nat.min cmin c
      cmax := Nat.max cmax c
  IO.println s!"concrete, sound bytes at random: {runs} calls, returned {back}, no return in 100000 steps {hang}, read a register {io}, wrote another byte {other}, cycles [{cmin}, {cmax}]"
  return 0

/-- the sound routine's place in the frame after the exit: its bytes, the call and the return, from the reference machine (`SideChangeSound`) -/
def soundRt (sy : Syms) (e : Machine) (ns : PipeTransitionAll.Names) : Option StepWrites.Rt := do
  let mc ← atSound sy (PipeTransition.run e (PipeTransition.zeros 200))
  let ret : UInt16 := ((mc.ram.get! (0x100 + mc.s.toNat + 1)).toUInt16 ||| ((mc.ram.get! (0x100 + mc.s.toNat + 2)).toUInt16 <<< 8)) + 1
  return { SB := SoundWalk.soundBytes ns, call := ret - 3, ret, inR := fun pc => decide (sy.SoundEngine ≤ pc) }

/-- the private file of `SideChangeSound`: the place of the sound routine in the frames after the side pipe's exit (its check is in `Route.lean`, which knows the state at control) -/
def genSideSound (sy : Syms) (romPath dir : String) : IO Unit := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let some R := soundRt sy (SideTransition.entry m0) (SoundWalk.namesOf text) | throw (IO.userError "genSideSound: no call of the sound routine")
  IO.FS.writeFile s!"{dir}/SideChangeSound.lean" ("import Proof.Rom\nimport Theorems.SideChangeSound\n" ++ s!"/-! {privateNote} -/
open Smbrta Smbrta.Rom

set_option maxHeartbeats 0

/-- the sound routine in the frames after the side pipe's exit: its bytes, the call, the return, and its code from `SoundEngine` on -/
def sideRt : StepWrites.Rt := \{ SB := {R.SB}, call := {R.call.toNat}, ret := {R.ret.toNat}, inR := fun pc => decide (sy.SoundEngine ≤ pc) }
")

/-- the rows of the change out of the side pipe with the sound's bytes in tables (`SideChangeSound`): the check, as a program, with a report of each link -/
def soundRowsCheck (sy : Syms) (romPath : String) (verbose : Bool) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let ns := SoundWalk.namesOf text
  let e := SideTransition.entry m0
  let some R := soundRt sy e ns | IO.println "no call"; return 1
  IO.println s!"sound bytes {R.SB.length}, call {hex4 R.call}, return {hex4 R.ret}"
  let x := SideChangeEnd.refExit e 160
  let T := SideChangeSound.tableOf sy nx e 160 R
  IO.println s!"kinds {T.length}"
  let c := SideChangeSound.soundCtx sy nm nx e 160 122 R.SB
  let t0 ← IO.monoMsNow
  let rows ← IO.lazyPure fun _ => SideChangeSound.rowsK c R nx e 160 122 T
  IO.println s!"rows {rows.length}, states {rows.foldl (fun a r => a + r.row.R.length) 0}, table states {rows.foldl (fun a r => a + r.row.t.size) 0}, largest tables {rows.foldl (fun a r => Nat.max a (Nat.max r.T0.length r.T1.length)) 0} ({(← IO.monoMsNow) - t0} ms)"
  flush
  let t1 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideChangeSound.chainS c R rows
  IO.println s!"chainS {ok} ({(← IO.monoMsNow) - t1} ms)"
  let t2 ← IO.monoMsNow
  let okAll ← IO.lazyPure fun _ => SideChangeSound.endCheckK sy nm nx e 160 122 R
  IO.println s!"endCheckK {okAll} ({(← IO.monoMsNow) - t2} ms)"
  flush
  if verbose || !ok then
    let mut k := 0
    for (r, r') in rows.zip rows.tail do
      let C := SideChangeEnd.rowCfg c r.row
      let fin := SideChangeSound.finS c.E.D (SideChangeSound.incl r.T0 r'.T0) (SideChangeSound.incl r.T1 r'.T0) r'.row.R
      let a1 := SideChangeEnd.statesOK c r.row
      let a2 := decide (r.row.v ≤ r'.row.v + 1)
      let a3 := StepWrites.tabOK R.SB r.T0 && StepWrites.tabOK R.SB r.T1
      let a4 := C.t.all (StepWrites.twalk C R r.T0 r.T1 fin TaintRun.walkFuel)
      let a5 := r.row.R.all (StepWrites.twalk C R r.T0 r.T1 fin TaintRun.walkFuel)
      if verbose || !(a1 && a2 && a3 && a4 && a5) then
        IO.println s!"row {k}: left {r.row.v} -> {r'.row.v}, core {r.row.core}, states {r.row.R.length}, table {r.row.t.size}, T0 {r.T0.length} T1 {r.T1.length}; statesOK {a1}, left {a2}, tabOK {a3}, walks of the table {a4}, of the states {a5}, incl {SideChangeSound.incl r.T0 r'.T0} {SideChangeSound.incl r.T1 r'.T0}"
        flush
      k := k + 1
    match rows.getLast? with
    | some r => IO.println s!"last row: left {r.row.v}, states {r.row.R.length}, statesOK {SideChangeEnd.statesOK c r.row}, control in all {r.row.R.all (SideChangeEnd.ctlKnown sy)}"
    | none => pure ()
  return (if ok then 0 else 1)

/-- probe (part d, round 11): the sound tables of the side pipe's rows, which bytes vary, and their union over the rows of the game core -/
def soundProbe (sy : Syms) (romPath : String) (which : List Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let ns := SoundWalk.namesOf text
  let e := SideTransition.entry m0
  let some R := soundRt sy e ns | IO.println "no call"; return 1
  let T := SideChangeSound.tableOf sy nx e 160 R
  let c := SideChangeSound.soundCtx sy nm nx e 160 122 R.SB
  let rows ← IO.lazyPure fun _ => SideChangeSound.rowsK c R nx e 160 122 T
  let nameOf := fun (i : Nat) => match ns.find? (fun (p : String × Nat) => p.2 &&& 0x7FF == i) with
    | some p => p.1
    | none => match nx.find? (fun (p : String × Nat) => p.2 &&& 0x7FF == i) with
      | some p => p.1
      | none => s!"{i}"
  let ab := fun (b : TaintRun.AB) => if b.k == 0xFF then hex2 b.v else if b.k == 0 then "?" else s!"{hex2 b.v}/{hex2 b.k}"
  let ix := SideChangeSound.pauseIdx nx
  let pz := [ix.q, ix.b, ix.f, ix.c]
  let proj := fun (t : StepWrites.SState) => (t.filter fun p => !pz.contains p.1).map fun p => (p.1, p.2.v &&& p.2.k, p.2.k)
  let mut uni : List (List (Nat × UInt8 × UInt8)) := []
  let mut k := 0
  for r in rows do
    let ps := (r.T0.map proj).eraseDups
    if r.row.core then
      for p in ps do
        if !uni.contains p then uni := uni ++ [p]
    -- the bytes that vary in T0
    let bytes := (r.T0.flatMap fun t => t.map (·.1)).eraseDups
    let vary := bytes.filter fun i => ((r.T0.map fun t => (t.find? (·.1 == i)).map fun p => (p.2.v &&& p.2.k, p.2.k)).eraseDups.length > 1)
    IO.println s!"row {k} left {r.row.v} core {r.row.core}: T0 {r.T0.length} (without the 4 pause bytes {ps.length}), T1 {r.T1.length}, union of core {uni.length}; vary: {vary.map nameOf}"
    if which.contains k then
      for t in r.T0 do
        IO.println s!"   {(t.map fun p => s!"{nameOf p.1}={ab p.2}").foldl (· ++ " " ++ ·) ""}"
    flush
    k := k + 1
  return 0

/-- probe (part d, round 11): `SideChangeSound.rowsFromS` with the tables' states cut to the bytes `keepB` (the others not known), deduplicated -/
def rowsFromSP (c : SideChangeEnd.Ctx) (R : StepWrites.Rt) (keepB : List Nat) : Nat → List TaintRun.AS → List StepWrites.SState → List SideChangeSound.SRow
  | 0, Rs, T => [{ row := { core := false, R := Rs, v := SideChangeSound.leftHead c Rs, t := #[], idx := {}, cut := ByteArray.empty }, T0 := T, T1 := [] }]
  | n + 1, Rs, T =>
    let pj := fun (l : List StepWrites.SState) => (l.map fun t => t.filter fun p => keepB.contains p.1).eraseDups
    let core := Rs.any fun S => SideChangeEnd.coreFrame c.sy c.eng (SideChangeEnd.mOf S)
    let e : TaintRun.Env := if core then { c.E with pad := SideChangeEnd.noStartPad } else c.E
    let s1 := SideChangeSound.scan e R c.keep T Rs
    let T0 := pj (StepWrites.joinUnder s1.wb T)
    let s2 := if s1.wb.isEmpty && T0.length == T.length then s1 else SideChangeSound.scan e R c.keep T0 Rs
    let T1 := pj (StepWrites.joinUnder s2.wa s2.rets)
    let I := SideChangeSound.indexOf e c.keep s2.out
    let ends := s2.ends
    { row := { core, R := Rs, v := SideChangeSound.leftHead c Rs, t := s2.out, idx := I.1, cut := I.2 }, T0, T1 } ::
      rowsFromSP c R keepB n ((SideChangeEnd.nextStatesD c.E (n == 0) ends).map (StepWrites.retag false))
        ((if ends.any (!·.spent) then T0 else []) ++ (if ends.any (·.spent) then T1 else []))

/-- probe: the rows with the effects' bytes not known in the tables: sizes, time, and the check `chainS` -/
def soundRowsP (sy : Syms) (romPath : String) (drop : List String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let ns := SoundWalk.namesOf text
  let e := SideTransition.entry m0
  let some R := soundRt sy e ns | IO.println "no call"; return 1
  let dropI := drop.map fun n => SideChangeEnd.adI ns n
  let keepB := R.SB.filter fun i => !dropI.contains i
  IO.println s!"dropped {drop} = {dropI}; kept {keepB.length} of {R.SB.length}"
  let T := (SideChangeSound.tableOf sy nx e 160 R).map fun t => t.filter fun p => keepB.contains p.1
  let c := SideChangeSound.soundCtx sy nm nx e 160 122 R.SB
  let t0 ← IO.monoMsNow
  let rows ← IO.lazyPure fun _ => rowsFromSP c R keepB 122 (SideChangeSound.startsK R (SideChangeSound.baseK nx e 160)) T
  IO.println s!"rows {rows.length}, states {rows.foldl (fun a r => a + r.row.R.length) 0}, table states {rows.foldl (fun a r => a + r.row.t.size) 0}, largest tables {rows.foldl (fun a r => Nat.max a (Nat.max r.T0.length r.T1.length)) 0} ({(← IO.monoMsNow) - t0} ms)"
  flush
  IO.println s!"T0 sizes {rows.map (·.T0.length)}"
  let t1 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideChangeSound.chainS c R rows
  IO.println s!"chainS {ok} ({(← IO.monoMsNow) - t1} ms)"
  -- the first frame's search, with its failures
  let ops := (TaintRun.aRows c.E).toArray
  let st0 := SideChangeSound.startsK R (SideChangeSound.baseK nx e 160)
  let X := StepWrites.tsearch (fun A => StepWrites.tsuccs c.E ops R T [[]] A) c.E c.keep st0
  IO.println s!"first frame search: steps {X.steps}, fails {X.fails}, ends {X.ends.size}"
  match X.firstFail with
  | some A =>
    let op := c.E.prg.get! (A.pc &&& c.E.mask).toNat
    IO.println s!"  first fail at pc {hex4 A.pc} op {hex2 op} spent {A.spent} s {hex2 A.s} a {hex2 A.a.v}/{hex2 A.a.k} x {hex2 A.x.v}/{hex2 A.x.k} y {hex2 A.y.v}/{hex2 A.y.k}"
    let succ := SideChangeEnd.xsuccs c.E ops A
    IO.println s!"  xsuccs: {succ.map (·.isSome)}"
  | none => pure ()
  if !ok then
    let mut k := 0
    for (r, r') in rows.zip rows.tail do
      if !SideChangeSound.linkS c R r r' then
        IO.println s!"row {k} fails: left {r.row.v}, core {r.row.core}, T0 {r.T0.length}, T1 {r.T1.length}"
        flush
      k := k + 1
  return (if ok then 0 else 1)

/-- probe (part d, round 11): real runs with Start at random after the side pipe's exit too. At each frame start after the exit: `left`, paused or not, and the sound's
bytes with the pause timer and the pause byte. Counts the distinct states for each value of `left`. -/
def pauseRowsReal (sy : Syms) (romPath fm2 : String) (runs rate : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let ns := SoundWalk.namesOf text
  let e := SideTransition.entry m0
  let some R := soundRt sy e ns | IO.println "no call"; return 1
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let real := (starts.filterMap (sideWalkToEntry sy 300)).map fun p => PipeTransition.frame p SideTransition.walkIn
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let all := e :: t :: real
  let x := SideChangeEnd.refExit e 160
  let lf := PipeChangeBound.leftOf sy nm sy.EngSidePipe (SideChangeBound.tableFrom sy nm 122 x) 122
  let gps := SideChangeEnd.adI nx "GamePauseStatus"
  let gpt := SideChangeEnd.adI nx "GamePauseTimer"
  let ix := SideChangeSound.pauseIdx nx
  let dac := SideChangeEnd.adI ns "DAC_Counter"
  let pz := [ix.q, ix.b, ix.f, ix.c, dac]
  let songB := R.SB.filter fun i => !pz.contains i
  let joint := fun (m : Machine) => (R.SB ++ [gpt, gps]).map fun i => m.ram.get! i
  let song := fun (m : Machine) => songB.map fun i => m.ram.get! i
  let cls := fun (m : Machine) => ([ix.q, ix.b, ix.f, ix.c, gpt, gps]).map fun i => m.ram.get! i
  let mut buckets : Std.HashMap (Nat × Bool) (Std.HashSet (List UInt8)) := {}
  let mut songs : Std.HashMap Nat (Std.HashSet (List UInt8)) := {}
  let mut songAll : Std.HashSet (List UInt8) := {}
  let mut clsAll : Std.HashSet (List UInt8) := {}
  let mut s : UInt64 := 4242
  let mut nruns := 0
  let mut pauses := 0
  let mut most := 0
  let mut notCtl := 0
  let mut leftBad := 0
  for m in all do
    for _ in [0:runs] do
      nruns := nruns + 1
      let mut c := m
      let mut j := 0
      let mut after := false
      let mut done := false
      while !done && j < 3000 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let i := if (s >>> 40) % rate.toUInt64 == 0 then r ||| 0x10 else r &&& 0xEF
        if after then
          let l := lf c
          let p := c.ram.get! gps &&& 1 == 1
          buckets := buckets.insert (l, p) ((buckets.getD (l, p) {}).insert (joint c))
          if !p then songs := songs.insert l ((songs.getD l {}).insert (song c))
          songAll := songAll.insert (song c)
          clsAll := clsAll.insert (cls c)
        let c2 := PipeTransition.frame c i
        if after then
          if c2.ram.get! gps &&& 1 == 1 && c.ram.get! gps &&& 1 == 0 then pauses := pauses + 1
          let l1 := lf c
          let l2 := lf c2
          if l1 > l2 + 1 then leftBad := leftBad + 1
          if c2.ram.get! gps &&& 1 == 1 && l1 > l2 then leftBad := leftBad + 1
          if controllable sy c2 then
            done := true
            most := Nat.max most j
        else if !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then after := true
        c := c2
        j := j + 1
      if !done then notCtl := notCtl + 1
  IO.println s!"runs {nruns}, pauses after the exit {pauses}, runs without control in 3000 frames {notCtl}, longest {most}; frames where left falls by more than one, or falls on a frame that ends paused: {leftBad}"
  IO.println s!"distinct over all frames after the exit: songs (34 bytes) {songAll.size}, pause classes (6 bytes) {clsAll.size}"
  let mut tot := 0
  for l in (List.range 123).reverse do
    let a := (buckets.getD (l, false) {}).size
    let b := (buckets.getD (l, true) {}).size
    let sg := (songs.getD l {}).size
    tot := tot + a + b
    IO.println s!"left {l}: joint not paused {a}, paused {b}; songs not paused {sg}"
  IO.println s!"sum of the buckets {tot}"
  return 0

/-- the pause sound at the exit as `SideChangeSound.QuietK` says, as a check for a program -/
def quietKOK (sy : Syms) (ix : SideChangeSound.PauseIdx) (x m : Machine) : Bool :=
  (m.ram.get! ix.q == x.ram.get! ix.q && m.ram.get! ix.b == x.ram.get! ix.b) ||
  (m.ram.get! ix.q == x.ram.get! ix.q && m.ram.get! ix.b == sy.UnpauseSfxValue.toUInt8 && m.ram.get! ix.f == sy.UnpauseSfxValue.toUInt8 &&
    decide (1 ≤ (m.ram.get! ix.c).toNat) && decide ((m.ram.get! ix.c).toNat ≤ sy.PauseSfxLength.toNat)) ||
  (m.ram.get! ix.q == sy.UnpauseSfxValue.toUInt8 && m.ram.get! ix.b == x.ram.get! ix.b && m.ram.get! ix.f == sy.PauseSfxValue.toUInt8)

/-- the conditions of `SideChangeSound` on real runs: entries of the movie and of own walks, Start at random on the pipe's frames, then no Start up to control.
At the exit: `ExitCond` with the bytes of `exitKnownK`, `QuietK`, the timer, and the old `Quiet`. After it: `left` falls by one on each frame, control where it is 0. -/
def soundRowsReal (sy : Syms) (romPath fm2 : String) (runs : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let e := SideTransition.entry m0
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let real := (starts.filterMap (sideWalkToEntry sy 300)).map fun p => PipeTransition.frame p SideTransition.walkIn
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let all := e :: t :: real
  let E2 := SideChangeBound.sideEnv nm e
  let V2 := SideChangeEnd.refs2 nm nx e
  IO.println s!"entries {all.length}; with Entry2 {(all.filter (SideChangeBound.entryOK E2 V2 160)).length}"
  let x := SideChangeEnd.refExit e 160
  let lf := PipeChangeBound.leftOf sy nm sy.EngSidePipe (SideChangeBound.tableFrom sy nm 122 x) 122
  let E3 := SideChangeEnd.timeEnv nm nx e
  let K := SideChangeSound.exitKnownK nx
  let gps := SideChangeEnd.adI nx "GamePauseStatus"
  let ix := SideChangeSound.pauseIdx nx
  let timerB := fun (m : Machine) => (SideChangeEnd.digitsOf nx).any fun i => m.ram.get! i != 0
  let qOld := fun (m : Machine) => m.ram.get! ix.q == x.ram.get! ix.q && m.ram.get! ix.b == x.ram.get! ix.b
  let mut s : UInt64 := 777
  let mut exits := 0
  let mut exitOk := 0
  let mut qk := 0
  let mut qo := 0
  let mut tm := 0
  let mut notOne := 0
  let mut ctlBad := 0
  let mut least := 100000
  let mut most := 0
  let mut failQ : List (List UInt8) := []
  for m in all do
    for _ in [0:runs] do
      let mut c := m
      let mut j := 0
      let mut after := false
      let mut done := false
      let mut prev := 0
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let i := if !after && (s >>> 40) % 9 == 0 then r ||| 0x10 else r &&& 0xEF
        let c2 := PipeTransition.frame c i
        if after then
          let l2 := lf c2
          if l2 + 1 != prev then notOne := notOne + 1
          if controllable sy c2 != (l2 == 0) then ctlBad := ctlBad + 1
          prev := l2
          if controllable sy c2 then
            done := true
            least := Nat.min least (j + 1)
            most := Nat.max most (j + 1)
        else if !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
          after := true
          exits := exits + 1
          prev := lf c2
          if SideChangeEnd.exitOK E3 x K gps c2 then exitOk := exitOk + 1
          if quietKOK sy ix x c2 then qk := qk + 1
          else failQ := [c2.ram.get! ix.q, c2.ram.get! ix.b, c2.ram.get! ix.f, c2.ram.get! ix.c] :: failQ
          if qOld c2 then qo := qo + 1
          if timerB c2 then tm := tm + 1
        c := c2
        j := j + 1
  IO.println s!"runs {all.length * runs}, exits {exits}: ExitCond with exitKnownK {exitOk}, QuietK {qk}, the old Quiet {qo}, the timer not 000 {tm}"
  IO.println s!"  exits against QuietK (queue, buffer, flag, counter): {failQ.eraseDups.take 20}"
  IO.println s!"after the exit: frames where left does not fall by exactly one {notOne}, frames where control and left 0 differ {ctlBad}; frames from the entry to control: least {least}, most {most}"
  return 0

/-- the pause sound at the vertical pipe's exit on real runs, with Start at random on the pipe's frames and no Start after the exit: the kind of the pause sound at the exit
(as `SideChangeSound.QuietK`), the old `quiet₁`, the song, the screen buffer, the sound effects' buffers, the timer, and at control the room's condition (`ScreenPage.Room`) -/
def pipeSoundReal (sy : Syms) (romPath fm2 : String) (runs : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let nmS := ScreenPage.namesOf txt
  let e := PipeTransition.entry m0
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let x := PipeChangeEnd.refX e
  let ix := SideChangeSound.pauseIdx nx
  let U := sy.UnpauseSfxValue.toUInt8
  let P := sy.PauseSfxValue.toUInt8
  let L := sy.PauseSfxLength.toNat
  let s1 := SideChangeEnd.adI nx "Square1SoundBuffer"
  let s2 := SideChangeEnd.adI nx "Square2SoundBuffer"
  let kindOf := fun (m : Machine) =>
    let q := m.ram.get! ix.q
    let b := m.ram.get! ix.b
    let f := m.ram.get! ix.f
    let c := m.ram.get! ix.c
    if q == x.ram.get! ix.q && b == x.ram.get! ix.b then (if f == 0 then "S0" else "S1")
    else if q == x.ram.get! ix.q && b == U && f == U && decide (1 ≤ c.toNat) && decide (c.toNat ≤ L) then s!"U{c.toNat}"
    else if q == U && b == x.ram.get! ix.b && f == P then "UP"
    else s!"other({q},{b},{f},{c})"
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let all := [e, t] ++ (PipeTransitionAll.realEntries sy m0 25 13).map (·.2) ++ (PipeTransitionAll.realEntries sy m0 7 40).map (·.2)
  let xq := PipeChangeEnd.exitQ sy nm e
  let r := ScreenPage.refR m0
  let K := ScreenPage.knownOf nmS
  let E := ScreenPage.envR sy nmS m0
  let lf := PipeChangeBound.leftOf sy nm sy.EngVerticalPipe (PipeChangeBound.tableOf sy nm e 48 43) 43
  let songOK := fun (m : Machine) => d.song.any fun q => q.all fun p => m.ram.get! p.1 == p.2
  let shapeOK := fun (m : Machine) => d.xshape.any fun q => q.all fun p => m.ram.get! p.1 == p.2
  let oldQ := fun (m : Machine) => (PipeChangeEnd.quietQ d e).all (fun p => m.ram.get! p.1 == p.2) && songOK m && shapeOK m
  let timerB := fun (m : Machine) => (SideChangeEnd.digitsOf nx).any fun i => m.ram.get! i != 0
  let amq := SideChangeEnd.adI nx "AreaMusicQueue"
  -- for each kind: exits, the old condition, the song, the screen buffer, both effects' buffers as at the reference, the timer, Room at control, frames from the exit to control
  let mut stats : List (String × Array Nat) := []
  let mut s : UInt64 := 99991
  let mut exits := 0
  let mut noCtl := 0
  let mut notOne := 0
  for pr in [2, 9] do
    for m in all do
      for _ in [0:runs] do
        let mut c := m
        let mut j := 0
        let mut after := false
        let mut kd := ""
        let mut xj := 0
        let mut prev := 0
        let mut done := false
        while !done && j < 2000 do
          s := s ^^^ (s <<< 13)
          s := s ^^^ (s >>> 7)
          s := s ^^^ (s <<< 17)
          let rr := (s >>> 13).toUInt8
          let i := if !after && (s >>> 40) % pr == 0 then rr ||| 0x10 else rr &&& 0xEF
          let c2 := PipeTransition.frame c i
          if after then
            if lf c2 + 1 != prev then notOne := notOne + 1
            prev := lf c2
          if !after && !PipeChangeBound.inPipe sy sy.EngVerticalPipe c2 then
            after := true
            exits := exits + 1
            xj := j
            prev := lf c2
            kd := kindOf c2
            let row : Array Nat := #[1, (if xq.all (fun p => c2.ram.get! p.1 == p.2) then 1 else 0), (if oldQ c2 then 1 else 0), (if songOK c2 then 1 else 0),
              (if shapeOK c2 then 1 else 0), (if c2.ram.get! s1 == x.ram.get! s1 && c2.ram.get! s2 == x.ram.get! s2 then 1 else 0), (if timerB c2 then 1 else 0), 0, 0, 0, 0]
            stats := match stats.find? (·.1 == kd) with
              | some _ => stats.map fun p => if p.1 == kd then (p.1, (p.2.zip row).map fun z => z.1 + z.2) else p
              | none => stats ++ [(kd, row)]
          c := c2
          j := j + 1
          if controllable sy c then
            done := true
            let rok := ScreenPage.roomOK E r K c
            let row : Array Nat := #[0, 0, 0, 0, 0, 0, 0, (if rok then 1 else 0), (if c.ram.get! amq == r.ram.get! amq then 1 else 0), j - xj, 1]
            stats := stats.map fun p => if p.1 == kd then (p.1, (p.2.zip row).map fun z => z.1 + z.2) else p
        if !done then noCtl := noCtl + 1
  IO.println s!"entries {all.length}, runs {2 * all.length * runs}, exits {exits}, no control in 2000 frames {noCtl}, frames after the exit where left does not fall by one {notOne}"
  IO.println "kind: exits, exit bytes, old quiet₁, song, screen buffer, effects' buffers 0, timer not 000, Room at control, AreaMusicQueue as reference, frames exit→control (sum), controls"
  for p in stats do
    IO.println s!"  {p.1}: {p.2.toList}"
  return 0

/-- the change into the room on real runs with Start at random on every frame, also after the pipe: the frames that end not paused (the counted frames) from the entry to control,
the frames of the game core after the pipe with Start, and how often `left` falls on a frame that ends paused -/
def pipeStartAfter (sy : Syms) (romPath fm2 : String) (runs : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let gps := SideChangeEnd.adI nx "GamePauseStatus"
  let paused := fun (m : Machine) => m.ram.get! gps &&& 1 == 1
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let all := [e, t] ++ (PipeTransitionAll.realEntries sy m0 25 13).map (·.2) ++ (PipeTransitionAll.realEntries sy m0 7 40).map (·.2)
  let lf := PipeChangeBound.leftOf sy nm sy.EngVerticalPipe (PipeChangeBound.tableOf sy nm e 48 43) 43
  let mut s : UInt64 := 31337
  let mut least := 100000
  let mut nRuns := 0
  let mut coreStart := 0
  let mut runsCoreStart := 0
  let mut fallPaused := 0
  let mut fallTwo := 0
  let mut leastCore := 100000
  for pr in [2, 9] do
    for m in all do
      for _ in [0:runs] do
        nRuns := nRuns + 1
        let mut c := m
        let mut j := 0
        let mut counted := 0
        let mut cs := false
        while j < 3000 && !controllable sy c do
          s := s ^^^ (s <<< 13)
          s := s ^^^ (s >>> 7)
          s := s ^^^ (s <<< 17)
          let rr := (s >>> 13).toUInt8
          let i := if (s >>> 40) % pr == 0 then rr ||| 0x10 else rr &&& 0xEF
          if i &&& 0x10 != 0 && SideChangeEnd.coreFrame sy sy.EngVerticalPipe c then
            coreStart := coreStart + 1
            cs := true
          let c2 := PipeTransition.frame c i
          if !paused c2 then counted := counted + 1
          else if lf c2 < lf c then fallPaused := fallPaused + 1
          if lf c2 + 1 < lf c then fallTwo := fallTwo + 1
          c := c2
          j := j + 1
        if controllable sy c then
          least := Nat.min least counted
          if cs then
            runsCoreStart := runsCoreStart + 1
            leastCore := Nat.min leastCore counted
  IO.println s!"runs {nRuns}; frames of the game core after the pipe with Start {coreStart}, in {runsCoreStart} runs; frames that end paused and lower left {fallPaused}; frames that lower left by 2 or more {fallTwo}"
  IO.println s!"least counted frames from the entry to control: all runs {least}, runs with Start on the game core after the pipe {leastCore}"
  return 0

/-- the rows of the change into the room with the sound's bytes in tables (`PipeChangeEnd.rowsKc`): the rows, their check with a report of each link, and the states where `left` is 0 -/
def pipeSoundRows (sy : Syms) (romPath : String) (verbose full : Bool) (room : Bool := false) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let R := PipeChangeEnd.rtOf sy nx e
  IO.println s!"sound bytes {R.SB.length}, call {hex4 R.call}, return {hex4 R.ret}; the first table {(PipeChangeEnd.tableP sy R d (PipeChangeEnd.refX e)).length}, start states {(PipeChangeEnd.startsK R d e).length}"
  flush
  let c := PipeChangeEnd.timeCtx sy nm d e
  let cK := PipeChangeEnd.soundCtx c R
  -- the rows frame by frame, as `SoundRows.rowsFromS` makes them, with the time of each
  let ix := PipeChangeEnd.pauseIx d.nx
  let mut Rs := PipeChangeEnd.startsK R d e
  let mut Tt := PipeChangeEnd.tableP sy R d (PipeChangeEnd.refX e)
  for k in [0:PipeChangeEnd.afterF] do
    let n1 := PipeChangeEnd.afterF - k
    let core := Rs.any fun S => SideChangeEnd.coreFrame cK.sy cK.eng (SideChangeEnd.mOf S)
    let en : TaintRun.Env := if core then { cK.E with pad := SideChangeEnd.noStartPad } else cK.E
    let ta ← IO.monoMsNow
    let s1 ← IO.lazyPure fun _ => SoundRows.scan en R cK.keep Tt Rs
    let T0 := StepWrites.joinUnder s1.wb Tt
    let s2 ← IO.lazyPure fun _ => if s1.wb.isEmpty then s1 else SoundRows.scan en R cK.keep T0 Rs
    let T1 := StepWrites.joinUnder s2.wa (PipeChangeEnd.grpP ix n1 s2.rets)
    IO.println s!"frame {k}: left {n1}, states {Rs.length}, core {core}, T0 {T0.length}, rets {s2.rets.length}, T1 {T1.length}, writes before {s1.wb.length} after {s2.wa.length}, search states {s2.out.size}, ends {s2.ends.length}, fails {s1.fails} {s2.fails} ({(← IO.monoMsNow) - ta} ms)"
    flush
    let ends := s2.ends
    Rs := SoundRows.afterEnds cK (n1 - 1 == 0) ends
    Tt := (if ends.any (!·.spent) then T0 else []) ++ (if ends.any (·.spent) then T1 else [])
  if room then
    -- the checks of the room on the rows where `left` is 0
    let nmS := ScreenPage.namesOf txt
    let t3 ← IO.monoMsNow
    let okR ← IO.lazyPure fun _ => ScreenStart.roomCheck sy nm d e nmS m0
    IO.println s!"ScreenStart.roomCheck {okR} ({(← IO.monoMsNow) - t3} ms)"
    flush
    let t4 ← IO.monoMsNow
    let okM ← IO.lazyPure fun _ => RoomMap.startCheckT sy nm d e nmS m0
    IO.println s!"RoomMap.startCheckT {okM} ({(← IO.monoMsNow) - t4} ms)"
    flush
    return (if okR && okM then 0 else 1)
  if !full && !verbose then return 0
  let t0 ← IO.monoMsNow
  let rows ← IO.lazyPure fun _ => PipeChangeEnd.rowsKc c d e
  IO.println s!"rows {rows.length}, states {rows.foldl (fun a r => a + r.row.R.length) 0}, table states {rows.foldl (fun a r => a + r.row.t.size) 0}, largest tables {rows.foldl (fun a r => Nat.max a (Nat.max r.T0.length r.T1.length)) 0} ({(← IO.monoMsNow) - t0} ms)"
  flush
  let mut ok := true
  let mut okAll := true
  if full then
    let t1 ← IO.monoMsNow
    ok ← IO.lazyPure fun _ => SoundRows.chainS cK R rows
    IO.println s!"chainS {ok} ({(← IO.monoMsNow) - t1} ms)"
    flush
    let t2 ← IO.monoMsNow
    okAll ← IO.lazyPure fun _ => PipeChangeEnd.soundCheck sy nm d e
    IO.println s!"soundCheck {okAll} ({(← IO.monoMsNow) - t2} ms)"
    flush
  if verbose || !ok then
    let mut k := 0
    for (r, r') in rows.zip rows.tail do
      let C := SideChangeEnd.rowCfg cK r.row
      let fin := SoundRows.finS cK.E.D (SoundRows.incl r.T0 r'.T0) (SoundRows.incl r.T1 r'.T0) r'.row.R
      let a1 := SideChangeEnd.statesOK cK r.row
      let a2 := decide (r.row.v ≤ r'.row.v + 1)
      let a3 := StepWrites.tabOK R.SB r.T0 && StepWrites.tabOK R.SB r.T1
      let tw ← IO.monoMsNow
      let a4 ← IO.lazyPure fun _ => C.t.all (StepWrites.twalk C R r.T0 r.T1 fin TaintRun.walkFuel)
      let tw2 ← IO.monoMsNow
      let a5 ← IO.lazyPure fun _ => r.row.R.all (StepWrites.twalk C R r.T0 r.T1 fin TaintRun.walkFuel)
      let tw3 ← IO.monoMsNow
      let i0 ← IO.lazyPure fun _ => SoundRows.incl r.T0 r'.T0
      let i1 ← IO.lazyPure fun _ => SoundRows.incl r.T1 r'.T0
      let tw4 ← IO.monoMsNow
      if verbose || !(a1 && a2 && a3 && a4 && a5) then
        IO.println s!"row {k}: left {r.row.v} -> {r'.row.v}, core {r.row.core}, states {r.row.R.length}, table {r.row.t.size}, T0 {r.T0.length} T1 {r.T1.length}; statesOK {a1}, left {a2}, tabOK {a3}, walks of the table {a4} ({tw2 - tw} ms), of the states {a5} ({tw3 - tw2} ms), incl {i0} {i1} ({tw4 - tw3} ms)"
        flush
      k := k + 1
  let z := PipeChangeEnd.timeRows c d e
  IO.println s!"rows with left 0: {z.length}, states with the table {z.foldl (fun a r => a + r.R.length) 0}, all with control {z.all fun r => r.R.all (SideChangeEnd.ctlKnown sy)}"
  return (if ok && okAll then 0 else 1)

/-! ## The pause through the side pipe's frames (`SidePause`) -/

/-- a byte of an abstract state as value/known bits -/
def abS (a : TaintRun.AB) : String := s!"{hex2 a.v}/{hex2 a.k}"

/-- the machine has the bytes of the state of a table -/
def sInB (t : StepWrites.SState) (m : Machine) : Bool := t.all fun p => m.ram.get! p.1 &&& p.2.k == p.2.v &&& p.2.k

/-- the condition on the pause at the entry (`SidePause.PauseE`), as a check for a program -/
def pauseEOK (sy : Syms) (ix : SideChangeSound.PauseIdx) (pb : SidePause.PauseBytes) (m : Machine) : Bool :=
  let L := sy.PauseSfxLength.toNat
  let U := sy.UnpauseSfxValue.toUInt8
  let g := m.ram.get! pb.g
  let c := (m.ram.get! ix.c).toNat
  let t := (m.ram.get! pb.t).toNat
  ((g == 0 || g == 0x80) && m.ram.get! ix.q == 0 && m.ram.get! ix.b == 0) ||
  (g == 0x80 && m.ram.get! ix.q == 0 && m.ram.get! ix.b == U && m.ram.get! ix.f == U && decide (1 ≤ c) && decide (c ≤ L) && t == c + 1) ||
  (g == 0x80 && m.ram.get! ix.q == U && m.ram.get! ix.b == 0 && m.ram.get! ix.f == sy.PauseSfxValue.toUInt8 && t == L + 1)

/-- the side pipe's frames with the game timer's digits as the bytes `D` of the walk, `dg` at the start and at the exit: the frames keep the timer not 000
(a program, for measuring) -/
def sideTimeCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let pb := SidePause.pauseBytesOf nx
  let ix := SideChangeSound.pauseIdx nx
  let e := SideTransition.entry m0
  let st0 := SideChangeBound.startsOf (SideChangeEnd.refs2 nm nx e)
  let x := SideChangeEnd.refExit e 160
  let base := SideChangeSound.baseK nx e 160
  let E : TaintRun.Env := { SideChangeBound.sideEnv nm e with D := SideChangeEnd.digitsOf nx }
  let st := (SidePause.startsC sy ix pb st0).map fun S => ({ S with dg := true } : TaintRun.AS)
  let bx := (SidePause.baseX sy ix x base).map fun S => ({ S with dg := true } : TaintRun.AS)
  IO.println s!"digits {SideChangeEnd.digitsOf nx}, start states {st.length}, states at the exit {bx.length}"
  flush
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideChangeEnd.duringCheck E (SideChangeEnd.exitSplits nm nx e) sy (SideChangeBound.keepOf nm ++ SidePause.pauseKeep ix pb)
    (SideChangeEnd.keep2 nm nx ++ SidePause.pauseKeep ix pb) st bx [] (SideChangeBound.exitBytes sy nm x)
  IO.println s!"the walk with dg: {ok} ({(← IO.monoMsNow) - t0} ms)"
  flush
  return (if ok then 0 else 1)

/-- the check of `SidePause` as a program: the pipe's frames from every class, with a report of the classes whose frames do not close -/
def sidePauseCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let pb := SidePause.pauseBytesOf nx
  let ix := SideChangeSound.pauseIdx nx
  let e := SideTransition.entry m0
  let st0 := SideChangeBound.startsOf (SideChangeEnd.refs2 nm nx e)
  let cls := SidePause.classesP sy ix pb
  let st := SidePause.startsC sy ix pb st0
  let x := SideChangeEnd.refExit e 160
  IO.println s!"classes {cls.length}, start states {st.length}, kinds at the exit {(SidePause.kindsX sy ix x).length}"
  flush
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SidePause.pipeCheck sy nm nx e 160
  IO.println s!"pipeCheck {ok} ({(← IO.monoMsNow) - t0} ms)"
  flush
  if !ok then
    let E := SideChangeBound.sideEnv nm e
    let keep := SideChangeBound.keepOf nm ++ SidePause.pauseKeep ix pb
    let showB := fun (B : TaintRun.AS) => s!"pc {hex4 B.pc} rk {B.rk} spent {B.spent} k {B.k} q {abS (B.getK ix.q)} b {abS (B.getK ix.b)} f {abS (B.getK ix.f)} c {abS (B.getK ix.c)} t {abS (B.getK pb.t)} g {abS (B.getK pb.g)}"
    let ops := (TaintRun.aRows E).toArray
    let mut j := 0
    for S in st do
      let X := TaintRun.search E ops keep 1 [S]
      let bad := X.ends.toList.filter fun B => !TaintRun.finRk st B
      if X.fails > 0 || !bad.isEmpty then
        IO.println s!"start {j} (class {j % cls.length}): fails {X.fails} first {(X.firstFail.map showB)}, ends {X.ends.size}, not in a class {bad.length}"
        for B in bad.take 3 do IO.println s!"   {showB B}"
        flush
      j := j + 1
  return (if ok then 0 else 1)

/-- the conditions of `SidePause` on real runs: walks in the room to the side pipe with Start at random, then the pipe's frames with Start at random. At the entry:
`Entry2` and `PauseE`; on each frame of the pipe: the bytes of a class; at the exit: `QuietK`, and the class that the exit came from. -/
def sidePauseReal (sy : Syms) (romPath fm2 : String) (runs rate : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let pb := SidePause.pauseBytesOf nx
  let ix := SideChangeSound.pauseIdx nx
  let cls := SidePause.classesP sy ix pb
  let e := SideTransition.entry m0
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let E2 := SideChangeBound.sideEnv nm e
  let V2 := SideChangeEnd.refs2 nm nx e
  let x := SideChangeEnd.refExit e 160
  let inSide := fun (m : Machine) => (peek m sy.OperMode_Task).toUInt16 == sy.Task_GameCore && (peek m sy.GameEngineSubroutine).toUInt16 == sy.EngSidePipe
  let mut s : UInt64 := 99991
  -- the entries: the reference, the movie's, and walks with Start at random
  let mut entries : List Machine := [e, t]
  let mut walks := 0
  for m in starts do
    for _ in [0:runs] do
      let mut c := m
      let mut j := 0
      let mut done := false
      while !done && j < 2000 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let i := if (s >>> 40) % rate.toUInt64 == 0 then SideTransition.walkIn ||| 0x10 else SideTransition.walkIn
        c := PipeTransition.frame c i
        if inSide c then done := true
        j := j + 1
      walks := walks + 1
      if done then entries := entries ++ [c]
  let mut e2 := 0
  let mut pe := 0
  let mut frames := 0
  let mut inCls := 0
  let mut exits := 0
  let mut qk := 0
  let mut failE : List (List UInt8) := []
  let mut failF : List (List UInt8) := []
  let mut pausedEntry := 0
  let mut kindE : Array Nat := #[0, 0, 0]
  let mut visited : Array Bool := Array.replicate cls.length false
  for m in entries do
    if SideChangeBound.entryOK E2 V2 160 m then e2 := e2 + 1
    let v := [m.ram.get! ix.q, m.ram.get! ix.b, m.ram.get! ix.f, m.ram.get! ix.c, m.ram.get! pb.t, m.ram.get! pb.g]
    if pauseEOK sy ix pb m then pe := pe + 1 else failE := v :: failE
    if m.ram.get! pb.g &&& 1 == 1 then pausedEntry := pausedEntry + 1
    let kE := if m.ram.get! ix.b == sy.UnpauseSfxValue.toUInt8 then 1 else if m.ram.get! ix.q == sy.UnpauseSfxValue.toUInt8 then 2 else 0
    kindE := kindE.set! kE (kindE[kE]! + 1)
    let mut c := m
    let mut j := 0
    let mut done := false
    while !done && j < 3000 do
      s := s ^^^ (s <<< 13)
      s := s ^^^ (s >>> 7)
      s := s ^^^ (s <<< 17)
      let r := (s >>> 13).toUInt8
      let i := if (s >>> 40) % rate.toUInt64 == 0 then r ||| 0x10 else r &&& 0xEF
      let c2 := PipeTransition.frame c i
      if PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
        frames := frames + 1
        if cls.any (sInB · c2) then inCls := inCls + 1
        else failF := [c2.ram.get! ix.q, c2.ram.get! ix.b, c2.ram.get! ix.f, c2.ram.get! ix.c, c2.ram.get! pb.t, c2.ram.get! pb.g] :: failF
        for (cl, ci) in cls.zipIdx do
          if sInB cl c2 then visited := visited.set! ci true
      else
        done := true
        exits := exits + 1
        if quietKOK sy ix x c2 then qk := qk + 1
      c := c2
      j := j + 1
  IO.println s!"walks {walks}, entries {entries.length} (paused at the entry {pausedEntry}): Entry2 {e2}, PauseE {pe}"
  IO.println s!"  entries against PauseE (queue, buffer, flag, counter, timer, pause byte): {failE.eraseDups.take 20}"
  IO.println s!"  entries silent, with the unpause sound, with the unpause pressed: {kindE}"
  IO.println s!"frames of the pipe {frames}: in a class {inCls}; against the classes: {failF.eraseDups.take 20}; classes seen {(visited.toList.filter id).length} of {cls.length}"
  IO.println s!"exits {exits}: QuietK {qk}"
  return 0

/-- the pause in the room (`RoomPause`): the region of the walk, the search and the check of one frame with the classes carried in a table, and what the rows of the
change into the room know of the six bytes at control -/
def roomPauseCheck (sy : Syms) (romPath : String) (rows : Bool) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nx2 := SideChangeEnd.namesOf txt
  let G := RoomPause.regOf sy m0 nx2
  let r := ScreenPage.refR m0
  let P := ScreenPage.placesOf sy nmS m0 r
  let Z := ScreenPage.aidsOf sy nmS m0
  let E := ScreenPage.envOf nmS sy r
  let K := ScreenPage.knownOf nmS
  let ix := SideChangeSound.pauseIdx nx2
  let pb := SidePause.pauseBytesOf nx2
  let showB := fun (B : TaintRun.AS) => s!"pc {hex4 B.pc} spent {B.spent} k {B.k} nmi {B.nmi} q {abS (B.getK ix.q)} b {abS (B.getK ix.b)} f {abS (B.getK ix.f)} c {abS (B.getK ix.c)} t {abS (B.getK pb.t)} g {abS (B.getK pb.g)} a {abS B.a} x {abS B.x} y {abS B.y}"
  IO.println s!"region: call {hex4 G.call}, after {hex4 G.ret}, bytes {G.SB}, classes {G.T.length}, pause byte {G.gI}"
  flush
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => RoomPause.searchOfP P Z E G r K
  let t1 ← IO.monoMsNow
  IO.println s!"the search: {X.steps} steps, {X.forks} forks, {X.fails} failures, {X.joins} joins, {X.done.size} keys, {X.ends.size} frame ends, {t1 - t0} ms"
  if let some B := X.firstFail then IO.println s!"  first failure: {showB B}"
  let badEnds := X.ends.toList.filter fun B => !RoomPause.finP P r K G.gI G.needG B
  IO.println s!"  frame ends not accepted: {badEnds.length}"
  for B in badEnds.take 4 do IO.println s!"    {showB B} rt {abS (B.getK P.rtI)}"
  flush
  let ok ← IO.lazyPure fun _ => RoomPause.roomCheck sy nmS nx2 m0
  let t2 ← IO.monoMsNow
  IO.println s!"RoomPause.roomCheck {ok} ({t2 - t1} ms)"
  flush
  if rows then
    let nm := PipeChangeBound.namesOf txt
    let nx := PipeChangeEnd.namesOf txt
    let e := PipeTransition.entry m0
    let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
    let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
    let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
    let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
    let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
    let t3 ← IO.monoMsNow
    let rT ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
    let cs := RoomStart.ctlStates sy rT
    IO.println s!"rows of the time: {rT.length} rows, states with control {cs.length} ({(← IO.monoMsNow) - t3} ms)"
    let kinds := (cs.map fun S => s!"q {abS (S.getK ix.q)} b {abS (S.getK ix.b)} f {abS (S.getK ix.f)} c {abS (S.getK ix.c)} t {abS (S.getK pb.t)} g {abS (S.getK pb.g)}").eraseDups
    IO.println s!"  the six bytes at control ({kinds.length} kinds): {kinds.take 12}"
    IO.println s!"  in a class: {(cs.filter fun S => G.T.any (StepWrites.soundLe S)).length} of {cs.length}"
    let t4 ← IO.monoMsNow
    let okS ← IO.lazyPure fun _ => RoomPause.startCheck sy nm d e nx2
    IO.println s!"RoomPause.startCheck {okS} ({(← IO.monoMsNow) - t4} ms)"
  return (if ok then 0 else 1)

/-- the region of `RoomMusic` walked from `starts` with the joins of `RoomPause.searchP`: the states at the region's end, and the failures (a program, to build the table) -/
partial def regionSearch (P : ScreenPage.Places) (Z : ScreenPage.Aids) (E : TaintRun.Env) (ops : Array (TaintRun.AM Unit)) (ret : UInt16) (starts : List TaintRun.AS) :
    Array TaintRun.AS × Nat × Nat := Id.run do
  let mut X : ScreenPage.SearchS := starts.foldl (RoomPause.routeP P Z E) {}
  let mut ends : Array TaintRun.AS := #[]
  let mut fails := 0
  let mut steps := 0
  while true do
    match X.pending.minEntry? with
    | none => break
    | some (q, A) =>
      let K := RoomPause.keyP Z E A
      X := { X with pending := X.pending.erase q, pendKey := X.pendKey.erase K }
      steps := steps + 1
      for o in RoomPause.baseS P E ops A do
        match o with
        | none => fails := fails + 1
        | some B =>
          if B.k != A.k then fails := fails + 1
          else if B.pc == ret then ends := ends.push B
          else X := RoomPause.routeP P Z E X (StepWrites.retag true B)
  return (ends, fails, steps)

/-- the table of `RoomMusic`: from the music bytes at the room's first control (the two values of the event music's queue), closed under the region (the bytes at its end)
and under the stores outside the region that the room's search meets (a program; the check does not depend on it) -/
def musicTable (sy : Syms) (m0 : Machine) (nmS : PipeTransitionAll.Names) (t0 : StepWrites.SState) (verbose : Bool) : IO (List StepWrites.SState) := do
  let r := ScreenPage.refR m0
  let P := ScreenPage.placesR sy nmS m0
  let Z := ScreenPage.aidsOf sy nmS m0
  let E := ScreenPage.envR sy nmS m0
  let K := RoomMusic.knownM nmS
  let ops := (TaintRun.aRows E).toArray
  let q := RoomMusic.emq nmS
  let hb := RoomMusic.hurryBit nmS
  let set := fun (t : StepWrites.SState) (v : UInt8) => StepWrites.overwrite t [(q, TaintRun.AB.known v)]
  let am := RoomMusic.amb nmS
  let mo1 := RoomMusic.ix nmS "MusicOffset_Square1"
  let admits := fun (t : StepWrites.SState) => t.all fun p => p.1 != am || r.ram.get! p.1 &&& p.2.k == p.2.v &&& p.2.k
  let mut T : List StepWrites.SState := [set t0 0, set t0 hb]
  let mut todo := T
  for outer in [0:40] do
    let G := RoomMusic.regM sy m0 nmS T
    let Zp := RoomPause.aidsP Z G
    let X0 ← IO.lazyPure fun _ => RoomPause.searchOfP P Z E (RoomMusic.regM sy m0 nmS todo) r K
    let pre := ((X0.done.toList.map (·.2)).filter fun A => A.spent && A.pc == sy.SoundEngine).map fun A => StepWrites.forgetAll G.SB A
    let mut rounds := 0
    while !todo.isEmpty && rounds < 400 do
      rounds := rounds + 1
      let pieces := todo.flatMap fun t => (pre.filter (StepWrites.agrees t)).map fun S => StepWrites.retag true (StepWrites.refineAll t S)
      let (ends, fails, _) := regionSearch P Zp E ops G.ret pieces
      if fails > 0 then IO.println s!"  region failures {fails}"
      let mut fresh : List StepWrites.SState := []
      for B in ends do
        let u0 : StepWrites.SState := G.SB.map fun i => (i, B.getK i)
        -- square 1's offset is followed only in the states of the reference's music
        let u := if admits u0 then u0 else u0.map fun p => if p.1 == mo1 then (p.1, TaintRun.AB.top) else p
        if !(T ++ fresh).any (fun w => StepWrites.entails u w) then fresh := fresh ++ [u]
      T := T ++ fresh
      todo := fresh
    let X ← IO.lazyPure fun _ => RoomPause.searchOfP P Z E (RoomMusic.regM sy m0 nmS T) r K
    IO.println s!"  step {outer}: table {T.length} after {rounds} rounds of the region; the room's search {X.steps} steps, {X.fails} failures"
    flush
    if X.fails == 0 then break
    match X.firstFail with
    | none => break
    | some A =>
      if A.spent then
        IO.println s!"  a failure in the region at {hex4 A.pc}"
        break
      let mut w : StepWrites.SState := []
      for A₁ in ScreenPage.preS P (ScreenPage.clampS P A) do
        if let some L := StepWrites.aLocs E A₁ then
          for o in ScreenPage.stepS P E ops A₁ do
            if let some B := o then
              for i in L do
                if G.SB.contains i then w := w ++ [(i, B.getK i)]
      IO.println s!"  a store at {hex4 A.pc} outside the region: {w.map fun p => (p.1, abS p.2)}"
      if w.isEmpty then break
      let fresh := (T.map fun t => StepWrites.overwrite t w).filter fun u => !T.any (StepWrites.entails u)
      T := T ++ fresh
      todo := fresh
  if verbose then
    for t in T do IO.println s!"    {t.map fun p => abS p.2}"
  return T

/-- the checks of `RoomMusic`, as a program -/
def roomMusicCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let nm2 := SideChangeBound.namesOf txt
  let nx2 := SideChangeEnd.namesOf txt
  let r := ScreenPage.refR m0
  let e := PipeTransition.entry m0
  let T0 ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T0.2.1 T0.1 T0.2.2.1 T0.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let tm0 ← IO.monoMsNow
  let rT ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
  let cs := RoomStart.ctlStates sy rT
  let SB := RoomMusic.tabIdx nmS
  let t0 : StepWrites.SState := SB.filterMap fun i =>
    match cs.map (·.getK i) with
    | a :: l => some (i, l.foldl TaintRun.AB.join a)
    | [] => none
  IO.println s!"rows of the time: states with control {cs.length}; the first table state {t0.map fun p => abS p.2} ({(← IO.monoMsNow) - tm0} ms)"
  flush
  let tm1 ← IO.monoMsNow
  let T ← musicTable sy m0 nmS t0 true
  IO.println s!"the table: {T.length} states ({(← IO.monoMsNow) - tm1} ms)"
  flush
  let tm2 ← IO.monoMsNow
  let ok1 ← IO.lazyPure fun _ => RoomMusic.roomCheckM sy nmS m0 T
  IO.println s!"roomCheckM {ok1} ({(← IO.monoMsNow) - tm2} ms)"
  flush
  if !ok1 then
    let G := RoomMusic.regM sy m0 nmS T
    let X ← IO.lazyPure fun _ => RoomPause.searchOfP (ScreenPage.placesR sy nmS m0) (ScreenPage.aidsOf sy nmS m0) (ScreenPage.envR sy nmS m0) G r (RoomMusic.knownM nmS)
    IO.println s!"  search {X.steps} steps, {X.fails} failures, ends {X.ends.size}"
    if let some B := X.firstFail then IO.println s!"  first failure pc {hex4 B.pc} spent {B.spent} music {SB.map fun i => abS (B.getK i)}"
    let P := ScreenPage.placesR sy nmS m0
    let K := RoomMusic.knownM nmS
    let bad := X.ends.toList.filter fun B => !RoomPause.finP P r K G.gI G.needG B
    IO.println s!"  ends refused by finP: {bad.length}"
    for B in bad.take 5 do
      let miss := K.filter fun p => !(((B.getK p.1).k &&& p.2 == p.2) && ((B.getK p.1).v &&& p.2 == r.ram.get! p.1 &&& p.2))
      IO.println s!"    end spent {B.spent} rt {abS (B.getK P.rtI)} k {B.k} pc {hex4 B.pc} lo {B.lo} hi {B.hi}; bits of K not known as r: {miss.take 8 |>.map fun p => (p.1, hex2 p.2, abS (B.getK p.1))}"
    let C := RoomMusic.cfgM sy nmS m0 T
    let badT := C.t.toList.filter fun A => !RoomPause.walkP G C ScreenPage.fuelS A
    let badS := (ScreenPage.startsR r K).filter fun A => !RoomPause.walkP G C ScreenPage.fuelS A
    IO.println s!"  table states {C.t.size}, walks that fail {badT.length}; start states whose walk fails {badS.length}; tabOK {StepWrites.tabOK G.SB G.T}, maskOK {ScreenPage.maskOK r K}"
  let tm3 ← IO.monoMsNow
  let ok2 ← IO.lazyPure fun _ => RoomMusic.startCheckM sy nm d e nmS r T
  IO.println s!"startCheckM {ok2} ({(← IO.monoMsNow) - tm3} ms)"
  let ok3 := RoomMusic.deriveCheck nmS r T
  let V := SideChangeEnd.refs2 nm2 nx2 (SideTransition.entry m0)
  let ok4 := RoomMusic.refsCheck nmS r V
  let ok5 := (RoomMusic.derivedIdx nmS).contains (ScreenPage.placesR sy nmS m0).rtI == false
  IO.println s!"deriveCheck {ok3}, refsCheck {ok4}, routine not derived {ok5}; restIdxM {(RoomMusic.restIdxM nmS).length} bytes of {(ScreenPage.restIdx nmS).length}"
  return (if ok1 && ok2 && ok3 && ok4 && ok5 then 0 else 1)

/-- what the room's walks know of the 11 bytes of `RoomMusic.EntryRestM` and of the game timer: at the room's first control (the rows of the time of the change
into the room) and at the ends of the room's walk (`ScreenPage`), grouped by the routine byte (a program, for measuring) -/
def entryBytesCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let ls := txt.splitOn "\n"
  let nmS := ScreenPage.namesOf txt
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let nm2 := SideChangeBound.namesOf txt
  let nx2 := SideChangeEnd.namesOf txt
  let r := ScreenPage.refR m0
  let e := PipeTransition.entry m0
  let P := ScreenPage.placesR sy nmS m0
  let Z := ScreenPage.aidsOf sy nmS m0
  let E := ScreenPage.envR sy nmS m0
  let K := ScreenPage.knownOf nmS
  let V := SideChangeEnd.refs2 nm2 nx2 (SideTransition.entry m0)
  let adOf := fun (n : String) (o : Nat) => match PipeTransitionAll.asmValue ls n with
    | some a => some ((a + o) &&& 0x7FF)
    | none => none
  let named : List (String × Nat) := (([("GameEngineSubroutine", 0), ("Player_Y_Position", 0), ("Player_Y_HighPos", 0), ("VRAM_Buffer1_Offset", 0), ("VRAM_Buffer1", 0), ("VRAM_Buffer1", 1),
    ("VRAM_Buffer1", 2), ("VRAM_Buffer1", 7), ("VRAM_Buffer_AddrCtrl", 0), ("AreaMusicBuffer", 0), ("EventMusicQueue", 0), ("NoteLengthTblAdder", 0), ("EventMusicBuffer", 0),
    ("AreaNumber", 0), ("GameTimerDisplay", 0), ("GameTimerDisplay", 1), ("GameTimerDisplay", 2), ("GameTimerCtrlTimer", 0), ("DeathMusicLoaded", 0), ("PauseModeFlag", 0),
    ("GameTimerExpiredFlag", 0), ("FetchNewGameTimerFlag", 0)] : List (String × Nat)).filterMap fun p =>
      (adOf p.1 p.2).map fun i => (s!"{p.1}+{p.2}", i))
  IO.println s!"restIdxM: {(RoomMusic.restIdxM nmS).map fun i => ((named.find? (·.2 == i)).map (·.1)).getD (toString i)}"
  IO.println s!"the reference r: {named.map fun p => s!"{p.1}={hex2 (r.ram.get! p.2)}"}"
  for v in V do
    IO.println s!"a reference of the entry: {named.map fun p => s!"{p.1}={hex2 (v.1.ram.get! p.2)}{if v.2.contains p.2 then "" else "(not listed)"}"}"
  flush
  -- the rows of the time of the change into the room, at control
  let T0 ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T0.2.1 T0.1 T0.2.2.1 T0.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let rT ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
  let cs := RoomStart.ctlStates sy rT
  IO.println s!"rows of the time: states with control {cs.length}"
  for S in cs do
    IO.println s!"  dg {S.dg}: {named.map fun p => s!"{p.1}={abS (S.getK p.2)}"}"
  flush
  -- the ends of the room's walk
  let W := ScreenPage.entryW nmS V
  let C ← IO.lazyPure fun _ => ScreenPage.cfgOf P Z E r K W
  let ends := (C.t.toList ++ ScreenPage.startsR r K).flatMap (ScreenPage.walkEnds C ScreenPage.fuelS)
  let rts := (ends.map fun B => abS (B.getK P.rtI)).eraseDups
  IO.println s!"the room's walk: table {C.t.size}, frame ends {ends.length}; the routine at the ends: {rts.map fun s => (s, (ends.filter fun B => abS (B.getK P.rtI) == s).length)}; player's {hex2 (r.ram.get! P.rtI)}, side pipe's {hex2 P.eng}"
  for s in rts do
    let es := ends.filter fun B => abS (B.getK P.rtI) == s
    IO.println s!"  routine {s}: {named.map fun p => s!"{p.1}={((es.map fun B => abS (B.getK p.2)).eraseDups).take 4}"}"
  return 0

/-- the table of `RoomMusic` built from the first control's music bytes with `NoteLengthTblAdder` known to be 0 (which the rows do not know): do the states with
the reference's area music buffer then know it 0? (a program, for measuring) -/
def entryNltaCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let r := ScreenPage.refR m0
  let e := PipeTransition.entry m0
  let T0 ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T0.2.1 T0.1 T0.2.2.1 T0.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let rT ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
  let cs := RoomStart.ctlStates sy rT
  let nl := RoomMusic.ix nmS "NoteLengthTblAdder"
  let am := RoomMusic.amb nmS
  let t0 : StepWrites.SState := (RoomMusic.tabIdx nmS).filterMap fun i =>
    match cs.map (·.getK i) with
    | a :: l => some (i, if i == nl then TaintRun.AB.known 0 else l.foldl TaintRun.AB.join a)
    | [] => none
  IO.println s!"the first table state, with NoteLengthTblAdder known 0: {t0.map fun p => abS p.2}"
  flush
  let T ← musicTable sy m0 nmS t0 false
  let admits := fun (t : StepWrites.SState) => t.all fun p => p.1 != am || r.ram.get! p.1 &&& p.2.k == p.2.v &&& p.2.k
  let adm := T.filter admits
  let nlOf := fun (t : StepWrites.SState) => ((t.find? (·.1 == nl)).map fun p => abS p.2).getD "-"
  IO.println s!"the table: {T.length} states; with the reference's area music buffer {adm.length}; NoteLengthTblAdder in them: {(adm.map nlOf).eraseDups}"
  for t in adm do IO.println s!"    {t.map fun p => abS p.2}"
  return 0

/-- the level's number on real runs (a program, for measuring `Run.area₁` and `Run.area₂`): on the movie at every frame up to its first change after the side pipe,
and at the vertical pipe's entry, the room's first control and the side pipe's entry; at the real entries into the vertical pipe of `PipeTransitionAll.realEntries`, with
`runs` runs each (Start at random on the pipe's frames, one frame in `rate`), at the room's first control, and at the side pipe's entry with the movie's inputs from its
first control in the room -/
def areaReal (sy : Syms) (romPath fm2 : String) (runs rate : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let aA : UInt16 := ((PipeTransitionAll.asmValue (txt.splitOn "\n") "AreaNumber").getD 0).toUInt16
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let rt := fun (m : Machine) => (peek m sy.GameEngineSubroutine).toUInt16
  -- the movie
  let mut t := powerOn cart 0
  let mut hist : Array Machine := #[t]
  for k in [0:inputs.size] do
    t := runFrame t inputs[k]!
    hist := hist.push t
  let a0 := peek hist[0]! aA
  let kCtl := (List.range hist.size).find? (fun n => controllable sy hist[n]!) |>.getD 0
  let kV := (List.range hist.size).find? (fun n => n > kCtl && rt hist[n]! == sy.EngVerticalPipe) |>.getD 0
  let kB := (List.range hist.size).find? (fun n => n > kV && controllable sy hist[n]!) |>.getD 0
  let kS := (List.range hist.size).find? (fun n => n > kB && rt hist[n]! == sy.EngSidePipe) |>.getD 0
  let kL := (List.range hist.size).find? (fun n => n > kS && peek hist[n]! aA != peek hist[kS]! aA) |>.getD hist.size
  let vals := ((List.range kL).map fun n => peek hist[n]! aA).eraseDups
  IO.println s!"the movie: power-on {hex2 a0}; first control {kCtl}, vertical entry {kV} ({hex2 (peek hist[kV]! aA)}), room's first control {kB} ({hex2 (peek hist[kB]! aA)}), side entry {kS} ({hex2 (peek hist[kS]! aA)}); first change of the byte after {kS} at {kL}; values before it {vals.map hex2}"
  flush
  -- real entries into the vertical pipe, Start at random on the pipe's frames, then the movie's inputs from its first control in the room
  let m0 := smb11Start sy cart
  let reals := PipeTransitionAll.realEntries sy m0 25 13
  let mut z : UInt64 := 99991
  let mut nV := 0
  let mut nB := 0
  let mut nS := 0
  let mut bad := 0
  for q in reals do
    nV := nV + 1
    if peek q.2 aA != a0 then bad := bad + 1
    for k in [0:runs] do
      let mut c := q.2
      let mut j := 0
      while j < 400 && !controllable sy c do
        z := z ^^^ (z <<< 13)
        z := z ^^^ (z >>> 7)
        z := z ^^^ (z <<< 17)
        let st := k > 0 && PipeChangeBound.inPipe sy sy.EngVerticalPipe c && (z >>> 40) % rate.toUInt64 == 0
        c := PipeTransition.frame c (if st then 0x10 else 0)
        j := j + 1
      if controllable sy c then
        nB := nB + 1
        if peek c aA != a0 then bad := bad + 1
        let mut jj := kB
        while jj < kS + 40 && rt c == sy.Eng_PlayerCtrl do
          c := runFrame c inputs[jj]!
          jj := jj + 1
        if rt c == sy.EngSidePipe then
          nS := nS + 1
          if peek c aA != a0 then bad := bad + 1
  IO.println s!"real vertical entries {nV} ({runs} runs each): room's first controls {nB}, side entries {nS} (the movie's inputs from its first control in the room); other values of the byte {bad}"
  return (if bad == 0 then 0 else 1)

/-- the checks for the level's number as a program, with their times: the small checks and the room's walk of `AreaKeep`, and the rows of the first change
(`ScreenStart.roomCheck`, whose last part asks that every state of the rows where `left` is 0 knows the byte). The two copied walks of round 14 are gone. -/
def areaKeepCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let nm2 := SideChangeBound.namesOf txt
  let nx2 := SideChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let T0 ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T0.2.1 T0.1 T0.2.2.1 T0.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let i := AreaKeep.areaI nmS
  let V := SideChangeEnd.refs2 nm2 nx2 (SideTransition.entry m0)
  IO.println s!"AreaNumber {i}: entry {hex2 (e.ram.get! i)}; the references of the side pipe's entry: {V.map fun v => (v.2.contains i, hex2 (v.1.ram.get! i))}"
  IO.println s!"the entry's list has it {d.known.contains i}, the exit's list has it {(PipeChangeEnd.exitKnownK nx).contains i}, the states at the exit know it {(PipeChangeEnd.baseK d e).all fun S => TaintRun.knownIs S (i, e.ram.get! i)}"
  let ok4 := AreaKeep.smallCheck sy e V nmS m0
  IO.println s!"smallCheck {ok4}"
  flush
  let tm3 ← IO.monoMsNow
  let ok3 ← IO.lazyPure fun _ => AreaKeep.roomCheckA sy nmS m0 i (e.ram.get! i)
  IO.println s!"roomCheckA {ok3} ({(← IO.monoMsNow) - tm3} ms)"
  flush
  let tm4 ← IO.monoMsNow
  let lb ← IO.lazyPure fun _ => PipeChangeEnd.rowsKc (PipeChangeEnd.timeCtx sy nm d e) d e
  let kb := lb.all fun r => r.row.R.all fun S => TaintRun.knownIs S (i, e.ram.get! i)
  IO.println s!"part b's rows with tables: {lb.length} rows, {(lb.map (·.row.R.length)).foldl (· + ·) 0} states, every state knows the byte {kb} ({(← IO.monoMsNow) - tm4} ms)"
  flush
  let tm5 ← IO.monoMsNow
  let lt ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
  let ok5 := ScreenStart.rowsArea (ScreenStart.areaI nmS) (e.ram.get! (ScreenStart.areaI nmS)) lt
  IO.println s!"the rows where left is 0: {lt.length} rows, {(lt.map (·.R.length)).foldl (· + ·) 0} states, rowsArea {ok5} ({(← IO.monoMsNow) - tm5} ms)"
  flush
  let tm6 ← IO.monoMsNow
  let ok6 ← IO.lazyPure fun _ => ScreenStart.roomCheck sy nm d e nmS m0
  IO.println s!"ScreenStart.roomCheck {ok6} ({(← IO.monoMsNow) - tm6} ms)"
  if (← IO.getEnv "AREA_COMPARE").isSome then
    let tm7 ← IO.monoMsNow
    let ok7 ← IO.lazyPure fun _ => PipeChangeEnd.soundCheck sy nm d e
    IO.println s!"part b's soundCheck {ok7} ({(← IO.monoMsNow) - tm7} ms)"
  return (if ok3 && ok4 && kb && ok5 && ok6 then 0 else 1)

/-- the movie to the room's first control; there the game timer's digits are set to `0 0 v` and its control timer to `c`, for each `v` and `c`; then the movie's inputs to
the frame that leaves the player's routine: the routine there, and the digits (a program, for measuring `chg.time₂`: the timer not 000 at the room's first control does
not give it at the side pipe's entry) -/
def sideTimeLow (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let ls := txt.splitOn "\n"
  let adOf := fun (n : String) => ((PipeTransitionAll.asmValue ls n).getD 0).toUInt16
  let gtd := adOf "GameTimerDisplay"
  let gtc := adOf "GameTimerCtrlTimer"
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn cart 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  while k < inputs.size && !controllable sy t do
    t := runFrame t inputs[k]!
    k := k + 1
  let kC := k
  let digits := fun (m : Machine) => s!"{peek m gtd}{peek m (gtd + 1)}{peek m (gtd + 2)}"
  IO.println s!"the movie: the room's first control after movie frame {kC}, timer {digits t}, control timer {peek t gtc}"
  let mut zeroAtEntry := 0
  let mut entries := 0
  let mut rows : List String := []
  let mut tally : List String := []
  for v in [1, 2, 3, 4, 5, 6] do
    for c in List.range 25 do
      let set := fun (m : Machine) (a : UInt16) (x : UInt8) => { m with ram := m.ram.set! (a &&& 0x7FF).toNat x }
      let mut u := set (set (set (set t gtd 0) (gtd + 1) 0) (gtd + 2) v.toUInt8) gtc c.toUInt8
      let mut j := kC
      let mut f := 0
      while j < inputs.size && (peek u sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl do
        u := runFrame u inputs[j]!
        j := j + 1
        f := f + 1
      let side := (peek u sy.GameEngineSubroutine).toUInt16 == sy.EngSidePipe
      let ok := peek u gtd != 0 || peek u (gtd + 1) != 0 || peek u (gtd + 2) != 0
      if side then entries := entries + 1
      if side && !ok then zeroAtEntry := zeroAtEntry + 1
      if c % 6 == 0 || (side && !ok) then rows := rows ++ [s!"00{v}/{c}: after {f} frames routine {peek u sy.GameEngineSubroutine} timer {digits u}"]
      tally := tally ++ [s!"00{v}: routine {peek u sy.GameEngineSubroutine}, timer {digits u}, {if f ≤ 60 then "≤ 60" else if f ≤ 110 then "61..110" else "111+"} frames"]
  for s in rows do IO.println s!"  {s}"
  for w in tally.eraseDups do IO.println s!"  {w}: {(tally.filter (· == w)).length} starts"
  IO.println s!"side pipe entries {entries} of 150 starts; with the timer 000 at the entry {zeroAtEntry}"
  return 0

/-- whether `AreaNumber` and `NoteLengthTblAdder` go through the walks of the route (a program, for measuring): where the conditions know them; the rows of the time
from a copy of their start that knows both (`rows`); the room's walk with `AreaNumber` in the music table (`room`); the vertical pipe's walk from a start that knows
them, and its exit states asked to know them (`pipe`) -/
def areaLinksCheck (sy : Syms) (romPath : String) (what : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let r := ScreenPage.refR m0
  let aI := RoomMusic.ix nmS "AreaNumber"
  let nI := RoomMusic.ix nmS "NoteLengthTblAdder"
  let T0 ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T0.2.1 T0.1 T0.2.2.1 T0.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let x := PipeChangeEnd.refX e
  for (n, i) in [("AreaNumber", aI), ("NoteLengthTblAdder", nI)] do
    IO.println s!"{n} ({i}): entry {hex2 (e.ram.get! i)}, exit {hex2 (x.ram.get! i)}, room {hex2 (r.ram.get! i)}; Entry knows {d.known.contains i}, masks {d.bits.any (·.1 == i)}, Rest {(EntryKeep.restIdx nx).contains i}, exit (rows) {(PipeChangeEnd.exitKnownK nx).contains i}, sound bytes {(SoundWalk.soundBytes nx).contains i}, room's bits {(RoomMusic.knownM nmS).any (·.1 == i)}, EntryRest {(ScreenPage.restIdx nmS).contains i}"
  flush
  let c := PipeChangeEnd.timeCtx sy nm d e
  let R := PipeChangeEnd.rtc c d e
  if what == "rows" || what == "all" then
    let tm ← IO.monoMsNow
    let st := (PipeChangeEnd.startsK R d e).map fun S => S.setK aI (TaintRun.AB.known (x.ram.get! aI))
    let tb := (PipeChangeEnd.tableP sy R d x).map fun t => StepWrites.overwrite t [(nI, TaintRun.AB.known (x.ram.get! nI))]
    let rows ← IO.lazyPure fun _ => SoundRows.rowsFromS (PipeChangeEnd.ctxK c d e) R (PipeChangeEnd.grpP (PipeChangeEnd.pauseIx d.nx)) PipeChangeEnd.afterF st tb
    let cs := RoomStart.ctlStates sy (SoundRows.zeroRows R rows)
    IO.println s!"rows of the time from the copy: {rows.length} rows, states with control {cs.length} ({(← IO.monoMsNow) - tm} ms)"
    IO.println s!"  AreaNumber at control: {((cs.map fun S => abS (S.getK aI)).eraseDups).take 8}; NoteLengthTblAdder: {((cs.map fun S => abS (S.getK nI)).eraseDups).take 8}"
    let rows0 ← IO.lazyPure fun _ => PipeChangeEnd.timeRows c d e
    let cs0 := RoomStart.ctlStates sy rows0
    IO.println s!"  the rows of part b: states with control {cs0.length}; AreaNumber {((cs0.map fun S => abS (S.getK aI)).eraseDups).take 8}; NoteLengthTblAdder {((cs0.map fun S => abS (S.getK nI)).eraseDups).take 8}"
    flush
  if what == "room" || what == "all" then
    let rT ← IO.lazyPure fun _ => PipeChangeEnd.timeRows c d e
    let cs := RoomStart.ctlStates sy rT
    let t0 : StepWrites.SState := (RoomMusic.tabIdx nmS).filterMap fun i =>
      match cs.map (·.getK i) with
      | a :: l => some (i, l.foldl TaintRun.AB.join a)
      | [] => none
    let T ← musicTable sy m0 nmS t0 false
    let SB' := RoomMusic.tabIdx nmS ++ [aI]
    let T' := T.map fun t => StepWrites.overwrite t [(aI, TaintRun.AB.known (r.ram.get! aI))]
    let G0 := RoomMusic.regM sy m0 nmS T'
    let G : RoomPause.Reg := { G0 with SB := SB', keepB := (RoomMusic.knownM nmS).filter fun p => SB'.contains p.1 }
    let P := ScreenPage.placesR sy nmS m0
    let Z := ScreenPage.aidsOf sy nmS m0
    let E := ScreenPage.envR sy nmS m0
    let K := RoomMusic.knownM nmS
    let tm ← IO.monoMsNow
    let ok ← IO.lazyPure fun _ => RoomPause.walkCheck P Z E G r K
    IO.println s!"the room's walk with AreaNumber in the table ({T'.length} states): {ok} ({(← IO.monoMsNow) - tm} ms)"
    if !ok then
      let X ← IO.lazyPure fun _ => RoomPause.searchOfP P Z E G r K
      IO.println s!"  search {X.steps} steps, {X.fails} failures"
      if let some B := X.firstFail then IO.println s!"  first failure pc {hex4 B.pc} spent {B.spent} AreaNumber {abS (B.getK aI)}"
    flush
  if what == "pipe" || what == "all" then
    for (n, L) in [("AreaNumber", [aI]), ("NoteLengthTblAdder", [nI]), ("both", [aI, nI])] do
      let tm ← IO.monoMsNow
      let addK := fun (v : Machine) (S : TaintRun.AS) => L.foldl (fun S i => S.setK i (TaintRun.AB.known (v.ram.get! i))) S
      let st := (PipeChangeEnd.startsP d e).map (addK e)
      let base := (PipeChangeEnd.baseK d e).map (addK x)
      let E := PipeChangeEnd.envOf d e
      let Cr := PipeChangeEnd.zcfgOf d.places d.jump E d.ckeys d.keep [(PipeChangeEnd.pauseI d, 1)] d.hints st
      let Co := PipeChangeEnd.zcfgOf d.places d.jump E d.ckeys (SideChangeEnd.adI d.nx "GamePauseStatus" :: d.keep) [(PipeChangeEnd.pauseI d, 1)] d.hints (st.map (TaintRun.toOne E))
      let ok ← IO.lazyPure fun _ => PipeChangeEnd.zcheck Cr Co E (PipeChangeEnd.pauseI d) st base [] (SideChangeBound.exitBytes sy nm x)
      IO.println s!"the vertical pipe's walk with {n} known at the entry and asked at the exit: {ok} ({(← IO.monoMsNow) - tm} ms)"
      flush
  if what == "keep" || what == "all" then
    let cart ← loadCart romPath
    let tc := TitleStart.ctxOf sy (TitleStart.namesFrom txt) cart 39
    for (n, L) in [("AreaNumber", [aI]), ("NoteLengthTblAdder", [nI])] do
      let tm ← IO.monoMsNow
      let G0 := EntryKeep.guardOf sy m0 d e
      let G : PipeWrites.Guard := { G0 with prot := L ++ G0.prot }
      let ws : List FrameKeep.Watch := L.map fun i => (i, 0xFF, e.ram.get! i)
      let W := EntryKeep.kept sy d e ++ ws
      let AE := EntryKeep.atEntry d e ++ ws
      let fin := EntryKeep.finE G.rtI sy.Eng_PlayerCtrl.toUInt8 (PipeEntryRule.vp sy) W AE (FrameKeep.endOK G)
        (fun B => EntryKeep.idleOK e B && EntryKeep.timerOK (EntryKeep.timerI d e) B)
      let C ← IO.lazyPure fun _ => EntryKeep.cfgOfE EntryKeep.spot G (PipeEntryRule.envOf m0) (EntryKeep.timerI d e) fin W
      let bad := C.t.toList.filter fun A => !EntryKeep.walkE C EntryKeep.fuelE A
      let s0 := EntryKeep.walkE C EntryKeep.fuelE (FrameKeep.startK G W false)
      let s1 := EntryKeep.walkE C EntryKeep.fuelE (FrameKeep.startK G W true)
      IO.println s!"the frames from control to the vertical pipe's entry with {n} kept and protected: table {C.t.size}, walks that fail {bad.length}, starts {s0} {s1} ({(← IO.monoMsNow) - tm} ms)"
      flush
      let tm2 ← IO.monoMsNow
      let okN ← IO.lazyPure fun _ => EntryKeep.nearCheck sy m0 tc W
      IO.println s!"  frame 0 ends with {n} at the entry's value too: {okN} ({(← IO.monoMsNow) - tm2} ms)"
      flush
  return 0

/-- the private file of `RoomPause` and `RoomMusic`: the room's walk with the six bytes of the pause, the table of the music bytes (found here by a search; the checks do not
depend on it), the room's walk with the music bytes, and the checks at the room's first control, with the rows of the time made once -/
def genRoomMusic (sy : Syms) (romPath dir : String) : IO Unit := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let T0 ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T0.2.1 T0.1 T0.2.2.1 T0.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let rT ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
  let cs := RoomStart.ctlStates sy rT
  let t0 : StepWrites.SState := (RoomMusic.tabIdx nmS).filterMap fun i =>
    match cs.map (·.getK i) with
    | a :: l => some (i, l.foldl TaintRun.AB.join a)
    | [] => none
  let T ← musicTable sy m0 nmS t0 false
  let showT := fun (t : StepWrites.SState) => "[" ++ ", ".intercalate (t.map fun p => s!"({p.1}, ⟨{p.2.v.toNat}, {p.2.k.toNat}⟩)") ++ "]"
  let tab := "[" ++ ",\n  ".intercalate (T.map showT) ++ "]"
  IO.FS.writeFile s!"{dir}/RoomPause.lean" ("import Proof.PipeChangeBound\nimport Proof.PipeChangeEnd\nimport Proof.SideChangeBound\nimport Proof.SideChangeEnd\nimport Proof.ScreenPage\nimport Proof.Rom\nimport Theorems.RoomMusic\n" ++ s!"/-! {privateNote} -/
open Smbrta Smbrta.Rom

set_option maxHeartbeats 0
" ++ "
/-- one frame in the room, with the six bytes of the pause in a table: the walk closes -/
theorem room_pause_walk : RoomPause.roomCheck sy screenNames sideEndNames ctx = true := by native_decide

/-- the table of the music bytes in the room, found by a search of the program `gen-proofs`; the checks below do not depend on how it was found -/
def musicTab : List StepWrites.SState :=
  " ++ tab ++ "

/-- in the rows of the time of the change into the room, a state with control knows that the pause is silent and not paused, knows the noise effect's queue, and has
its music bytes in a state of the table (the rows made once) -/
theorem room_starts : RoomMusic.startBoth sy pipeBoundNames pipeEndData (PipeTransition.entry ctx) sideEndNames screenNames (ScreenPage.refR ctx) musicTab = true := by
  native_decide

theorem room_pause_start : RoomPause.startCheck sy pipeBoundNames pipeEndData (PipeTransition.entry ctx) sideEndNames = true := (RoomMusic.startBoth_parts room_starts).1

/-- what the checks give for the pause -/
theorem room_pause : RoomPause.Facts sy ctx pipeBoundNames pipeEndData sideEndNames screenNames := RoomPause.factsOf room_pause_walk room_pause_start

/-- one frame in the room, with the music bytes in the table: the walk closes -/
theorem room_music_walk : RoomMusic.roomCheckM sy screenNames ctx musicTab = true := by native_decide

theorem room_music_derive : RoomMusic.deriveCheck screenNames (ScreenPage.refR ctx) musicTab = true := by native_decide

theorem room_music_refs : RoomMusic.refsCheck screenNames (ScreenPage.refR ctx) (SideChangeEnd.refs2 sideBoundNames sideEndNames (SideTransition.entry ctx)) = true := by
  native_decide

theorem room_music_rt : (RoomMusic.derivedIdx screenNames).contains (ScreenPage.placesR sy screenNames ctx).rtI = false := by native_decide

theorem room_music_bit : TaintRun.bitList.contains (RoomMusic.hurryBit screenNames) = true := by native_decide

/-- what the checks give for the music -/
theorem room_music : ∃ T, RoomMusic.Facts sy ctx pipeBoundNames pipeEndData (SideChangeEnd.refs2 sideBoundNames sideEndNames (SideTransition.entry ctx)) screenNames T :=
  ⟨musicTab, RoomMusic.factsOf room_music_walk (RoomMusic.startBoth_parts room_starts).2 room_music_derive room_music_refs room_music_rt room_music_bit⟩
")

/-- the private files of `AreaKeep`. `AreaKeep.lean` has the walk of the room's frames with the level's number known, and the small checks (round 16: the walks of
the vertical pipe's frames and of the last frames of the change with the byte known are gone; part b's rows carry the byte, `screen_start`). It takes copies of the
names of the room and of the side pipe from the files that `genProofs` wrote, so that it imports only `Proof.Rom`. `AreaJoin.lean` gives the same facts for the
route's names: the copies are the same terms (`rfl`). -/
def genAreaKeep (dir : String) : IO Unit := do
  let grab := fun (file name : String) => do
    let ls := (← IO.FS.readFile s!"{dir}/{file}.lean").splitOn "\n"
    let body := (ls.dropWhile fun l => !l.startsWith s!"def {name} :").takeWhile fun l => l != ""
    if body.isEmpty then throw (IO.userError s!"genAreaKeep: no def {name} in {file}.lean")
    return "\n".intercalate body
  let ren := fun (t : String) => (((t.replace "screenNames" "areaScreenNames").replace "sideBoundNames" "areaSideBoundNames").replace "sideEndNames" "areaSideEndNames")
  let defs := [← grab "ScreenPage" "screenNames", ← grab "SideChangeBound" "sideBoundNames", ← grab "SideChangeEnd" "sideEndNames"].map ren
  IO.FS.writeFile s!"{dir}/AreaKeep.lean" ("import Proof.Rom\nimport Theorems.AreaKeep\n" ++ s!"/-! {privateNote} -/
open Smbrta Smbrta.Rom Smbrta.PipeTransitionAll

set_option maxHeartbeats 0

/-! The names of `ScreenPage`, `SideChangeBound`, `SideChangeEnd`, copied from those files -/

" ++ "\n\n".intercalate defs ++ "

/-- the room's frames with the level's number in a table of one state -/
theorem area_room : AreaKeep.roomCheckA sy areaScreenNames ctx (AreaKeep.areaI areaScreenNames) ((PipeTransition.entry ctx).ram.get! (AreaKeep.areaI areaScreenNames)) = true := by
  native_decide

/-- the small checks -/
theorem area_small : AreaKeep.smallCheck sy (PipeTransition.entry ctx) (SideChangeEnd.refs2 areaSideBoundNames areaSideEndNames (SideTransition.entry ctx)) areaScreenNames ctx = true := by
  native_decide

/-- what the checks give for the level's number, with the copies -/
theorem area_factsA : AreaKeep.Facts sy ctx (SideChangeEnd.refs2 areaSideBoundNames areaSideEndNames (SideTransition.entry ctx)) areaScreenNames :=
  AreaKeep.factsOf area_room area_small
")
  IO.FS.writeFile s!"{dir}/AreaJoin.lean" ("import Proof.AreaKeep\nimport Proof.ScreenPage\nimport Proof.SideChangeBound\nimport Proof.SideChangeEnd\n" ++ s!"/-! {privateNote} -/
open Smbrta Smbrta.Rom

/-- what the checks give for the level's number, with the route's names: the copies of `Proof.AreaKeep` are these terms -/
theorem area_facts : AreaKeep.Facts sy ctx (SideChangeEnd.refs2 sideBoundNames sideEndNames (SideTransition.entry ctx)) screenNames :=
  area_factsA
")

