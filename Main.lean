/-! ## Ground physics -/

def physValidate (sy : Syms) (romPath : String) (runs len : Nat) (bias : UInt8) (pct : Nat) :
    IO UInt32 := do
  let m0 := (← startM sy romPath)
  let s0 := PState.read sy m0
  let ins := groundInputs.toArray
  let mut seed : Nat := 12345
  let mut bad := 0
  for r in [0:runs] do
    let mut m := m0
    let mut s := s0
    for k in [0:len] do
      seed := (seed * 1103515245 + 12345) % 2147483648
      let inp := if (seed / 4096) % 100 < pct then bias else ins[(seed / 65536) % ins.size]!
      let x0 := playerX sy m
      let (s', dx) := stepFull sy m0 s inp
      m := runFrame m (smbToPad inp)
      s := s'
      if PState.read sy m != s || playerX sy m - x0 != dx then
        bad := bad + 1
        if bad ≤ 3 then IO.println s!"run {r} frame {k}: model and emulator differ at x={playerX sy m}"
        break
  IO.println s!"validate: {runs} runs x {len} frames, differing runs: {bad}"
  return if bad == 0 then 0 else 1

/-- RAM bytes the ground step reads and writes over the search up to `depth`. -/
def physLive (sy : Syms) (romPath : String) (depth : Nat) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let mut rd := ByteArray.mk (Array.replicate 2048 0)
  let mut wr := ByteArray.mk (Array.replicate 2048 0)
  let mut io := false
  let mut layer : List PState := [dropPos (PState.read sy m0)]
  for _ in [0:depth] do
    for s in layer do
      for i in padInputs do
        for p in [0, 0x80] do
          let (_, r, w, o) := stepTracked sy m0 { s with posMF := p.toUInt8 } i
          for k in [0:2048] do
            if r.get! k != 0 then rd := rd.set! k 1
            if w.get! k != 0 then wr := wr.set! k 1
          io := io || o
    layer := Cert.next (fun s i => dropPos (stepP sy m0 s i)) padInputs layer
  let name := fun (k : Nat) => match Syms.fields.find? (fun (_, f) => (f sy).toNat == k) with
    | some (n, _) => n
    | none => s!"(unnamed {k})"
  let live := (flagged rd).filter fun k => wr.get! k != 0
  let readOnly := (flagged rd).filter fun k => wr.get! k == 0
  IO.println s!"I/O read: {io}"
  IO.println s!"carried between frames: {live.map name}"
  IO.println s!"read only (constant or injected): {readOnly.map name}"
  return 0

/-- Vary the dropped bytes (x, page, position fraction) on every search step up to `depth`. -/
def physIndep (sy : Syms) (romPath : String) (depth : Nat) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let variants : List (UInt8 × UInt8 × UInt8) := [(0xF0, 0xFF, 0x00), (0x80, 0x7F, 0x01), (0x10, 0x00, 0x02)]
  let ctxs := variants.map fun (p, x, pg) =>
    (poke (poke m0 sy.Player_X_Position x) sy.Player_PageLoc pg, p)
  let stepR := fun s i => dropPos (stepP sy m0 s i)
  let mut layer : List PState := [dropPos (PState.read sy m0)]
  let mut steps := 0
  let mut bad := 0
  for _ in [0:depth] do
    for s in layer do
      for i in padInputs do
        let t := stepR s i
        for (c, p) in ctxs do
          steps := steps + 1
          if dropPos (stepP sy c { s with posMF := p } i) != t then bad := bad + 1
    layer := Cert.next stepR padInputs layer
  IO.println s!"independence: {steps} varied steps, {bad} differences"
  return if bad == 0 then 0 else 1

/-! ## Jumping -/

/-- open area of 1-1 used by the jump searches -/
def openLo : Int := 0x18
def openHi : Int := 0xE0

def jumpDiscover (sy : Syms) (romPath : String) (walks len : Nat) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let (carried, io) := discoverCarried sy m0 walks len openLo openHi
  let name := fun (a : UInt16) => match Syms.fields.find? (fun (_, f) => f sy == a) with
    | some (n, _) => n
    | none => s!"(unnamed {a.toNat})"
  IO.println s!"I/O read: {io}; carried between frames ({carried.length}): {carried.map name}"
  let md : Model := { sy, ctx := m0, vars := movementVars sy carried }
  -- compare with the full emulator on the movement bytes
  let ins := padInputsA.toArray
  let mut seed : Nat := 4242
  let mut bad := 0
  let mut frames := 0
  for _ in [0:walks] do
    let mut s := md.read m0
    let mut m := m0
    let mut inp : UInt8 := 0
    for _ in [0:len] do
      seed := (seed * 1103515245 + 12345) % 2147483648
      if (seed / 65536) % 4 == 0 then inp := ins[(seed / 256) % ins.size]!
      s := md.step s inp
      m := runFrame m (smbToPad inp)
      frames := frames + 1
      if md.read m != s then bad := bad + 1
      let x := playerX sy m
      if x > openHi || x < openLo then break
  IO.println s!"model vs full emulator on the {md.vars.size} movement bytes: {frames} frames, {bad} differing"
  return if bad == 0 then 0 else 1

def relaxLayers (sy : Syms) (romPath : String) (depth : Nat) (rins : List (UInt8 × Bool)) :
    IO UInt32 := do
  let m0 := (← startM sy romPath)
  let top := sy.RunTopSpeed.toNat
  let mut layer : List RState := [{ h := dropPos (PState.read sy m0), air := false }]
  for d in [1:depth + 1] do
    layer := Cert.next (stepRelax sy m0) rins layer
    let best := layer.foldl (fun b s => max b s.h.speedInt) (-1000)
    IO.println s!"depth {d}: {layer.length} states, best speed {best}"; flush
    if best ≥ top then IO.println s!"top speed first reached at depth {d}"; return 0
  return 0

/-- Exact search for `depth` frames, pruned by relaxed reachability (loses no real path). -/
def realize (sy : Syms) (romPath : String) (depth : Nat) (rins : List (UInt8 × Bool))
    (eins : List UInt8) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let top := sy.RunTopSpeed.toNat
  let goalR := fun (s : RState) => s.h.speedInt ≥ top
  let mut layers : Array (List RState) := #[[{ h := dropPos (PState.read sy m0), air := false }]]
  for _ in [0:depth] do
    layers := layers.push (Cert.next (stepRelax sy m0) rins layers.back!)
  let mut good : Array (Std.HashSet RState) := Array.replicate (depth + 1) {}
  good := good.set! depth (Std.HashSet.ofList (layers[depth]!.filter goalR))
  for j in [0:depth] do
    let k := depth - 1 - j
    let ng := good[k + 1]!
    good := good.set! k (Std.HashSet.ofList (layers[k]!.filter fun s =>
      goalR s || rins.any fun c => ng.contains (stepRelax sy m0 s c)))
  IO.println s!"relaxed good-state counts: {good.map (·.size)}"; flush
  let (carried, _) := discoverCarried sy m0 300 150 openLo openHi
  let md : Model := { sy, ctx := m0, vars := movementVars sy carried }
  let mut layer : Array (GState × List UInt8) := #[(md.read m0, [])]
  for k in [0:depth] do
    let mut seen : Std.HashSet GState := {}
    let mut next : Array (GState × List UInt8) := #[]
    for (s, path) in layer do
      for i in eins do
        let t := md.step s i
        if !seen.contains t && good[k + 1]!.contains (md.toRelax t) then
          seen := seen.insert t
          next := next.push (t, i :: path)
    layer := next
    IO.println s!"exact depth {k + 1}: {layer.size} states"; flush
    if layer.isEmpty then IO.println s!"no real sequence of {depth} frames"; return 1
  match layer.find? (fun (s, _) => (md.toRelax s).h.speedInt ≥ top) with
  | none => IO.println s!"no real sequence of {depth} frames"; return 1
  | some (_, path) =>
    let path := path.reverse
    IO.println s!"FOUND {depth} frames: {path.map hex2}"
    let m := playFull m0 path
    IO.println s!"full emulator after these inputs: at top speed = {decide ((PState.read sy m).speedInt ≥ top)}"
    return 0

/-- On every relaxed search step up to `depth`, change vertical bytes (or the position) in the
context and check that the relaxed result does not change. -/
def relaxIndep (sy : Syms) (romPath : String) (depth : Nat) (posMode : Bool)
    (rins : List (UInt8 × Bool)) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let vert : List (List (UInt16 × UInt8)) := [
    [(sy.Player_Y_Position, 0x70), (sy.Player_Y_HighPos, 1), (sy.Player_Y_Speed, 0xFC), (sy.Player_YMF_Dummy, 0x40),
     (sy.Player_Y_MoveForce, 0x80), (sy.JumpOrigin_Y_Position, 0xB0), (sy.DiffToHaltJump, 1),
     (sy.VerticalForce, 0x20), (sy.VerticalForceDown, 0x70)],
    [(sy.Player_Y_Position, 0x98), (sy.Player_Y_HighPos, 1), (sy.Player_Y_Speed, 0x04), (sy.Player_YMF_Dummy, 0xC0),
     (sy.Player_Y_MoveForce, 0x10), (sy.JumpOrigin_Y_Position, 0xB0), (sy.DiffToHaltJump, 1),
     (sy.VerticalForce, 0x28), (sy.VerticalForceDown, 0x90)],
    [(sy.Player_Y_Position, 0x40), (sy.Player_Y_HighPos, 1), (sy.Player_Y_Speed, 0x00), (sy.Player_YMF_Dummy, 0x00),
     (sy.Player_Y_MoveForce, 0x00), (sy.JumpOrigin_Y_Position, 0x90), (sy.DiffToHaltJump, 1),
     (sy.VerticalForce, 0x1E), (sy.VerticalForceDown, 0x60)]]
  let posv : List (List (UInt16 × UInt8)) := [
    [(sy.Player_X_Position, 0xFF), (sy.Player_PageLoc, 0)], [(sy.Player_X_Position, 0x7F), (sy.Player_PageLoc, 1)],
    [(sy.Player_X_Position, 0x00), (sy.Player_PageLoc, 2)]]
  let ctxs := (if posMode then posv else vert).map fun l => l.foldl (fun m (a, v) => poke m a v) m0
  let fracs : List UInt8 := if posMode then [0xF0, 0x80, 0x10] else [0, 0, 0]
  let mut layer : List RState := [{ h := dropPos (PState.read sy m0), air := false }]
  let mut steps := 0
  let mut bad := 0
  for _ in [0:depth] do
    for s in layer do
      for c in rins do
        let t := stepRelax sy m0 s c
        for (cx, p) in ctxs.zip fracs do
          steps := steps + 1
          if stepRelax sy cx { s with h := { s.h with posMF := p } } c != t then bad := bad + 1
    layer := Cert.next (stepRelax sy m0) rins layer
  IO.println s!"relax independence: {steps} varied steps, {bad} differences"
  return if bad == 0 then 0 else 1

/-- On every relaxed search step up to `depth`, record the RAM bytes the step reads before
writing them: the bytes the relaxed model depends on. -/
def relaxReads (sy : Syms) (romPath : String) (depth : Nat) (rins : List (UInt8 × Bool)) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let mut rd := ByteArray.mk (Array.replicate 2048 0)
  let mut io := false
  let mut layer : List RState := [{ h := dropPos (PState.read sy m0), air := false }]
  let z := ByteArray.mk (Array.replicate 2048 0)
  for _ in [0:depth] do
    for s in layer do
      for (inp, _) in rins do
        let m := poke m0 sy.Player_State (if s.air then 1 else 0)
        let m := poke m sy.PreviousA_B_Buttons 0
        let m := prepare sy m s.h inp
        let m := { m with trk := true, trkRead := z, trkWrite := z, trkIO := false }
        let m := callRange m sy.PlayerCtrlRoutine sy.PlayerSubs
        for k in [0:2048] do
          if m.trkRead.get! k != 0 then rd := rd.set! k 1
        io := io || m.trkIO
    layer := Cert.next (stepRelax sy m0) rins layer
  let name := fun (k : Nat) => match Syms.fields.find? (fun (_, f) => (f sy).toNat == k) with
    | some (n, _) => n
    | none => s!"(unnamed {k})"
  IO.println s!"I/O read: {io}"
  IO.println s!"bytes read by the relaxed step: {(flagged rd).map name}"
  return 0

/-- run the top-speed checks as a program, with timings -/
def topCheck (sy : Syms) (romPath : String) (which : String) : IO UInt32 := do
  let m0 ← startM sy romPath
  let mut ok := true
  for (name, f) in [("friction", TopSpeed.frictionCheck), ("physics", TopSpeed.physicsCheck),
      ("impede", TopSpeed.impedeCheck), ("anim", TopSpeed.animCheck), ("mover", TopSpeed.moverCheck),
      -- a false claim, to see that the checks can fail: top lowered by one
      ("friction-neg", fun sy m => TopSpeed.frictionCheck { sy with RunTopSpeed := sy.RunTopSpeed - 1 } m),
      ("attain", fun sy m => TopSpeed.attainCheck sy m 20)] do
    if which == "all" || which == name then
      let t0 ← IO.monoMsNow
      let r := f sy m0
      let t1 ← IO.monoMsNow
      IO.println s!"{name}: {r} ({t1 - t0} ms)"; flush
      ok := ok && r
  return if ok then 0 else 1

/-- relaxed search keeping, for each state up to its speed, only the fastest one
(experiment: is the answer the same, and how many states remain?) -/
def relaxDom (sy : Syms) (romPath : String) (depth : Nat) (rins : List (UInt8 × Bool)) : IO UInt32 := do
  let m0 ← startM sy romPath
  let top := (sy.RunTopSpeed.toNat : Int)
  let key := fun (s : RState) => ({ s with h := { s.h with speed := 0, fricMF := 0, absSpd := 0 } } : RState)
  let val := fun (s : RState) => 256 * s.h.speedInt + s.h.fricMF.toNat
  let mut layer : Array RState := #[{ h := dropPos (PState.read sy m0), air := false }]
  let t0 ← IO.monoMsNow
  for d in [1:depth + 1] do
    let mut best : Std.HashMap RState RState := {}
    for s in layer do
      for c in rins do
        let t := stepRelax sy m0 s c
        let k := key t
        match best.get? k with
        | some u => if val t > val u then best := best.insert k t
        | none => best := best.insert k t
    layer := best.toArray.map (·.2)
    let hi := layer.foldl (fun b s => max b s.h.speedInt) (-1000)
    let t1 ← IO.monoMsNow
    IO.println s!"depth {d}: {layer.size} states, best speed {hi}, {t1 - t0} ms"; flush
    if hi ≥ top then IO.println s!"top speed first reached at depth {d}"; return 0
  return 0

/-- run the fast lower-bound checks of fast accel and TAS fast accel, every land area -/
def fastCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← startM sy romPath
  let mut ok := true
  for (name, rins, n) in [("fast accel", relaxInputs, 33), ("TAS fast accel", relaxInputsLR, 30)] do
    for a in FastAccel.landAreas do
      let t0 ← IO.monoMsNow
      let r ← IO.lazyPure fun _ => FastAccel.lowerFastCheck sy (FastAccel.inArea sy m0 a) rins n
      let t1 ← IO.monoMsNow
      IO.println s!"{name}, AreaType {a}, lower bound {n}: {r} ({t1 - t0} ms)"; flush
      ok := ok && r
  return if ok then 0 else 1

/-- the reach bound against the distance of some input sequences, as a program -/
def reachCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let top := (TopSpeed.top sy : Int)
  let a := amax sy m0
  let K := TopSpeed.reachK sy m0
  let R := TopSpeed.reachG sy m0 K
  IO.println s!"top {top}, amax {a}, w0 {TopSpeed.w0 sy m0}, K {K}, reach K {R}, loss {16 * top * K - R} (1/256 px)"
  let p0 := Potential.phi sy m0 (Potential.startHS sy m0)
  let K2 := Potential.openK sy m0 p0
  let R2 := Potential.dbound sy m0 p0 K2
  IO.println s!"open area: phi0 {p0}, K {K2}, dbound K {R2}, loss {16 * top * K2 - R2} (1/256 px)"
  let pad := fun (n : Nat) => FastAccel.witness ++ List.replicate (n - 34) 0x41
  let rb := fun (n : Nat) => List.replicate n (0x41 : UInt8)
  for n in [34, 40, 50, 60, 100] do
    IO.println s!"n {n}: bound {TopSpeed.reachG sy m0 n}, open bound {Potential.dbound sy m0 p0 n}, TAS witness {TopSpeed.walkDist sy m0 (TopSpeed.reachWitness n)}, pad witness {TopSpeed.walkDist sy m0 (pad n)}, Right+B {TopSpeed.walkDist sy m0 (rb n)}"
    flush
  return 0

/-- experiment: for each speed `s`, is `s` unreachable before the TAS witness first reaches it? -/
def profileCheck (sy : Syms) (romPath : String) (lr : Bool) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let w := if lr then TasFastAccel.witness else FastAccel.witness
  let rins := if lr then relaxInputsLR else relaxInputs
  let top := (sy.RunTopSpeed.toNat : Int)
  -- speeds of the witness, frame by frame
  let mut m := m0
  let mut sp : Array Int := #[]
  for i in w do
    m := runFrame m (smbToPad i)
    sp := sp.push (PState.read sy m).speedInt
  IO.println s!"witness speeds: {sp.toList}"
  let mut ok := true
  for T in (List.range top.toNat).map (fun (i : Nat) => i + 1) do
    let d := (sp.toList.findIdx? (· ≥ (T : Int))).getD w.length  -- reached after frame d+1
    let keep := fun (r : Nat) (s : RState) => !(FastAccel.inRange sy s) ||
      decide (256 * (T : Int) ≤ max (FastAccel.V s) 0 + amax sy m0 * r)
    let t0 ← IO.monoMsNow
    let r ← IO.lazyPure fun _ => Cert.checkPruned (stepRelax sy m0) rins
      (fun s => decide (s.h.speedInt < (T : Int))) keep d [FastAccel.start sy m0]
    let t1 ← IO.monoMsNow
    IO.println s!"speed {T}: witness reaches it at frame {d + 1}; none by frame {d}: {r} ({t1 - t0} ms)"; flush
    ok := ok && r
  return if ok then 0 else 1

/-- experiment: the abstract transitions (facing, moving dir) of the relaxed step on the states of
the pruned search, the largest `|V|` gain of each, and the smallest per-frame gain `g` that a
potential `w(facing, moving)` allows in the slow regime (`RunningSpeed = 0`, `|v|` below the air
threshold of `X_Physics`) -/
def phiExplore (sy : Syms) (romPath : String) (lr : Bool) (depth : Nat) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let rins := if lr then relaxInputsLR else relaxInputs
  let top := (sy.RunTopSpeed.toNat : Int)
  let airFast := sy.AirFastSpeed.toNat
  let absV := fun (s : RState) => (FastAccel.V s).natAbs
  let node := fun (s : RState) => s.h.faceDir.toNat * 4 + s.h.movDir.toNat
  let slow := fun (s : RState) => s.h.runSpd == 0 && (s.h.speedInt.natAbs < airFast)
  -- edges: (from, to, slow) ↦ max Δ|V|
  let mut edges : Std.HashMap (Nat × Nat × Bool) Int := {}
  let mut layer : Array RState := #[FastAccel.start sy m0]
  for k in [0:depth] do
    let r := depth - k
    let mut nxt : Std.HashSet RState := {}
    for s in layer do
      for c in rins do
        let t := stepRelax sy m0 s c
        let key := (node s, node t, slow s)
        let d := (absV t : Int) - absV s
        edges := edges.insert key (max d (edges.getD key d))
        if FastAccel.keepFast sy m0 (r - 1) t then nxt := nxt.insert t
    layer := nxt.toArray
    IO.println s!"depth {k + 1}: {layer.size} states, {edges.size} edges"; flush
  for sl in [true, false] do
    IO.println s!"-- slow = {sl}"
    for ((a, b, s'), d) in edges.toList do
      if s' == sl then IO.println s!"  ({a / 4},{a % 4}) -> ({b / 4},{b % 4}): {d}"
    -- smallest g with potentials: w b ≤ w a + g - d on every edge (no negative cycle)
    let es := edges.toList.filter (·.1.2.2 == sl)
    let feasible := fun (g : Int) => Id.run do
      let mut w : Array Int := Array.replicate 16 0
      for _ in [0:20] do
        for ((a, b, _), d) in es do
          if w[a]! + g - d < w[b]! then w := w.set! b (w[a]! + g - d)
      let ok := es.all fun ((a, b, _), d) => w[b]! ≤ w[a]! + g - d
      (ok, w)
    let mut lo : Int := 0
    let mut hi : Int := 2000
    while lo < hi do
      let mid := (lo + hi) / 2
      if (feasible mid).1 then hi := mid else lo := mid + 1
    let w := (feasible lo).2
    IO.println s!"  smallest g: {lo}; potentials (facing,moving): {(List.range 16).filterMap fun (i : Nat) => if w[i]! != (0 : Int) then some ((i / 4, i % 4, (0 : Int) - w[i]!) : Nat × Nat × Int) else none}"
  let _ := top
  return 0

/-- the potential check, as a program; prints the first failures -/
def potCheckProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  IO.println s!"c {Potential.c sy m0}, g_slow {Potential.gSlow sy m0}, g_fast {Potential.gFast sy m0}"
  let mut ok := true
  for fd in Potential.facings do
    let t0 ← IO.monoMsNow
    let r ← IO.lazyPure fun _ => Potential.potCheck sy m0 fd
    let t1 ← IO.monoMsNow
    IO.println s!"facing {fd}: {r} ({t1 - t0} ms)"; flush
    if !r then
      ok := false
      let bad := (Potential.statesFd sy fd).flatMap fun s =>
        (Potential.inputs.filter fun i => !Potential.stepOk sy m0 s i).map fun i => (s, i)
      for (s, i) in bad.take 12 do
        let t := Potential.hstep sy m0 s i
        IO.println s!"  {repr s} {repr i} -> {repr t}: phi {Potential.phi sy m0 s} -> {Potential.phi sy m0 t}, slow {Potential.slow sy s}"
  return if ok then 0 else 1

/-- `hstep` against the relaxed step on the states of the pruned search -/
def hstepValidate (sy : Syms) (romPath : String) (lr : Bool) (depth : Nat) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let rins := if lr then relaxInputsLR else relaxInputs
  let toHS := fun (s : RState) =>
    let rs : UInt8 := if s.h.runSpd == 0 then 0 else sy.RunSpeedMin.toUInt8
    (Potential.HS.mk s.h.speed s.h.fricMF s.h.faceDir s.h.movDir rs)
  let mut layer : Array RState := #[FastAccel.start sy m0]
  let mut n := 0
  let mut bad := 0
  for k in [0:depth] do
    let r := depth - k
    let mut nxt : Std.HashSet RState := {}
    for s in layer do
      for c in rins do
        let t := stepRelax sy m0 s c
        let want := toHS t
        let ok := [(0 : UInt8), 1].any fun rt =>
          Potential.hstep sy m0 (toHS s) (Potential.HIn.mk (if s.air then 1 else 0)
            (c.1 &&& 0x80 != 0 && !s.air) (c.1 &&& 0x7F) rt) == want
        n := n + 1
        if !ok then
          bad := bad + 1
          if bad ≤ 5 then IO.println s!"mismatch: {repr (toHS s)} air {s.air} input {c.1} -> {repr want}"
        if FastAccel.keepFast sy m0 (r - 1) t then nxt := nxt.insert t
    layer := nxt.toArray
  IO.println s!"{n} steps, {bad} mismatches"
  return if bad == 0 then 0 else 1

/-- play inputs (hex, game layout) from the 1-1 start; print speed, subspeed, state, facing, moving dir -/
def traceInputs (sy : Syms) (romPath : String) (hex : String) : IO UInt32 := do
  let m0 ← startM sy romPath
  let mut m := m0
  let w := (hexDecode hex).toList
  for h : k in [0:w.length] do
    m := runFrame m (smbToPad w[k])
    let p := PState.read sy m
    IO.println s!"{k + 1}: in {hex2 w[k]} v {p.speedInt} f {p.fricMF} st {peek m sy.Player_State} fd {p.faceDir} md {p.movDir} y {peek m sy.Player_Y_Position} x {peek m sy.Player_X_Position} pg {peek m sy.Player_PageLoc} eng {peek m sy.GameEngineSubroutine}"
  return 0

/-- experiment: the largest distance in `n` frames of `hstep` with jumps of the measured lengths -/
def reachOpt (sy : Syms) (romPath : String) (n : Nat) (target : Int) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  -- jump lengths per takeoff speed: from a tap to a full hold
  let mut lens : Array (Nat × Nat) := #[]
  for v in [0:41] do
    let lo := Opening.airTime sy m0 v.toUInt8 1
    let hi := Opening.airTime sy m0 v.toUInt8 60
    lens := lens.push (lo, hi)
  IO.println s!"jump lengths (tap, hold) by speed: {lens.toList}"; flush
  let s0 := Potential.startHS sy m0
  let ins := Potential.inputsN
  -- mode 0 = ground, r > 0 = air frames left
  let mut layer : Std.HashMap (Potential.HS × Nat) Int := ({} : Std.HashMap _ _).insert (s0, 0) 0
  for k in [0:n] do
    let left := n - k - 1
    let mut nxt : Std.HashMap (Potential.HS × Nat) Int := {}
    for ((s, r), d) in layer.toList do
      for i in ins do
        let ok := if r == 0 then i.st == 0 else i.st == 1 && !i.jump
        if ok then
          let t := Potential.hstep sy m0 s i
          let d' := d + 16 * sbyte t.v
          -- optimistic rest: from Φ of t
          let opt := Potential.dbound sy m0 (Potential.phi sy m0 t) left
          if d' + opt ≥ target then
            let modes : List Nat :=
              if r == 0 && i.jump then
                let (lo, hi) := lens[(sbyte s.v).natAbs]!
                (List.range (hi - lo + 1)).map fun j => lo + j - 1
              else if r == 0 then [0] else [r - 1]
            for r' in modes do
              let key := (t, r')
              if d' > nxt.getD key (-1000000) then nxt := nxt.insert key d'
    layer := nxt
    let best := layer.fold (fun a _ d => max a d) (-1000000)
    IO.println s!"frame {k + 1}: {layer.size} states, best {best}"; flush
  return 0

/-- the opening search (`Opening.optCheck`), as a program -/
def openCheck (sy : Syms) (romPath : String) (n : Nat) (T : Int) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let t0 ← IO.monoMsNow
  let lens := Opening.jumpLens sy m0
  let t1 ← IO.monoMsNow
  IO.println s!"jump lengths ({t1 - t0} ms): {lens.toList}"; flush
  let r ← IO.lazyPure fun _ => Opening.optCheck sy m0 lens T n
  let t2 ← IO.monoMsNow
  IO.println s!"no {n}-frame input gets past {T}: {r} ({t2 - t1} ms)"
  return if r then 0 else 1

/-- the jump-length assumption: every hold length gives a length between a tap and a full hold -/
def jumpCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let lens := Opening.jumpLens sy m0
  let mut bad := 0
  for v in [0:TopSpeed.top sy + 1] do
    let (lo, hi) := lens[v]!
    for h in [1:61] do
      let l := Opening.airTime sy m0 v.toUInt8 h
      if l < lo || l > hi then
        bad := bad + 1
        IO.println s!"speed {v}, hold {h}: length {l} outside {lo}..{hi}"
  IO.println s!"jump lengths checked, {bad} outside the range"
  return if bad == 0 then 0 else 1

/-- play a movie; from its first controllable frame in 1-1, compare the distance with the bound
`16·top·n − loss` (`loss` from the opening) until the player control routine ends -/
def tasTrace (sy : Syms) (romPath fm2Path : String) (skip : Nat) : IO UInt32 := do
  let movie := parseFm2 (← IO.FS.readFile fm2Path)
  let inputs := alignInputs movie skip
  let mut m := powerOn (← loadCart romPath) 0
  let top := (sy.RunTopSpeed.toNat : Int)
  let n0 := TasFastAccel.witness.length
  let m1 ← smb11Start sy <$> loadCart romPath
  let loss := 16 * top * n0 - TopSpeed.walkDist sy m1 (TopSpeed.reachWitness n0)
  let mut start : Option (Nat × Int) := none
  let mut behind := 0
  let mut ended := false
  let mut lastEng : UInt8 := 255
  let mut lastArea : UInt8 := 255
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    match start with
    | none =>
      if controllable sy m then start := some (k, posP sy m)
    | some (k0, p0) =>
      let n := k - k0
      let d := posP sy m - p0
      let eng := peek m sy.GameEngineSubroutine
      let area := peek m sy.AreaType
      if eng != lastEng || area != lastArea then
        IO.println s!"frame {n}: engine routine {eng}, area type {area}, x {peek m sy.Player_X_Position} page {peek m sy.Player_PageLoc}, distance {d}, speed {(PState.read sy m).speedInt}"
        lastEng := eng
        lastArea := area
      if eng.toUInt16 != sy.Eng_PlayerCtrl && !ended then
        IO.println s!"frames {n0}..{n}: behind the bound in {behind} frames"
        ended := true
      if eng == 4 then return 0
      if n ≥ n0 && !ended then
        let b := 16 * top * n - loss
        if d != b then
          behind := behind + 1
          if behind ≤ 20 then
            IO.println s!"frame {n}: distance {d}, bound {b}, behind {b - d}, speed {(PState.read sy m).speedInt}, x {peek m sy.Player_X_Position} page {peek m sy.Player_PageLoc}"
  IO.println "player control did not end"
  return 1

/-- a movie from its first controllable frame: frames `a..b` (counted from there), the distance
from frame `a` against `16·top·n − loss` -/
def tasSeg (sy : Syms) (romPath fm2Path : String) (a b : Nat) : IO UInt32 := do
  let movie := parseFm2 (← IO.FS.readFile fm2Path)
  let inputs := alignInputs movie fceuxSkip
  let mut m := powerOn (← loadCart romPath) 0
  let top := (sy.RunTopSpeed.toNat : Int)
  let n0 := TasFastAccel.witness.length
  let m1 ← smb11Start sy <$> loadCart romPath
  let loss := 16 * top * n0 - TopSpeed.walkDist sy m1 (TopSpeed.reachWitness n0)
  let mut k0 : Option Nat := none
  let mut pa : Int := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if k0.isNone && controllable sy m then k0 := some k
    match k0 with
    | none => pure ()
    | some c =>
      let n := k - c
      if n == a then pa := posP sy m
      if n ≥ a && n ≤ b then
        let p := PState.read sy m
        let d := posP sy m - pa
        let j : Int := (n - a : Nat)
        let bd := if j ≥ n0 then s!"{16 * top * j - loss}" else "-"
        IO.println s!"{n} (+{j}): in {hex2 (smbToPad inputs[k])} v {p.speedInt} f {p.fricMF} st {peek m sy.Player_State} fd {p.faceDir} md {p.movDir} x {peek m sy.Player_X_Position} pg {peek m sy.Player_PageLoc} y {peek m sy.Player_Y_Position} dist {d} bound {bd}"
      if n > b then return 0
  return 0

/-- a movie with `k` empty frames inserted at frame `at` (from its first controllable frame), or
`del` frames deleted there: the frame of the flag (end-level routine) and of the level change -/
def tasInsert (sy : Syms) (romPath fm2Path : String) (at_ k : Nat) (del : Nat := 0) : IO UInt32 := do
  let movie := parseFm2 (← IO.FS.readFile fm2Path)
  let inputs := alignInputs movie fceuxSkip
  -- find the first controllable frame
  let mut m := powerOn (← loadCart romPath) 0
  let mut c := 0
  for h : j in [0:inputs.size] do
    m := runFrame m inputs[j]
    if controllable sy m then c := j; break
  let cut := c + at_
  let ins := inputs.extract 0 cut ++ Array.replicate k (0 : UInt8) ++ inputs.extract (cut + del) inputs.size
  let mut m2 := powerOn (← loadCart romPath) 0
  let mut flag := false
  for h : j in [0:ins.size] do
    m2 := runFrame m2 ins[j]
    let eng := peek m2 sy.GameEngineSubroutine
    if !flag && j > c + at_ && (eng == 4 || eng == 5) then
      flag := true
      IO.println s!"k {k} del {del}: flag (routine {eng}) after frame {j - c}, y {peek m2 sy.Player_Y_Position}"
    if peek m2 sy.LevelNumber != 0 || peek m2 sy.WorldNumber != 0 then
      IO.println s!"k {k} del {del}: level changes after frame {j - c}"
      return 0
  IO.println s!"k {k}: no level change"
  return 1

/-- the machine of a movie at frame `n` (from its first controllable frame), and the inputs -/
def movieAt (sy : Syms) (romPath fm2Path : String) (n : Nat) : IO (Machine × Array UInt8 × Nat) := do
  let movie := parseFm2 (← IO.FS.readFile fm2Path)
  let inputs := alignInputs movie fceuxSkip
  let mut m := powerOn (← loadCart romPath) 0
  let mut c : Option Nat := none
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if c.isNone && controllable sy m then c := some k
    if c == some (k - n) && k ≥ n then return (m, inputs, k)
  throw (IO.userError "movie too short")

/-- experiment: from a movie's frame `a`, can any input sequence of `d` frames move `P` further
than the movie does? A search on the full emulator (states merged by RAM), pruned by the
potential bound. -/
def segSearch (sy : Syms) (romPath fm2Path : String) (a d : Nat) (goal : Option Int := none) : IO UInt32 := do
  let (m0, inputs, k0) ← movieAt sy romPath fm2Path a
  -- the movie's distance after d frames, or the distance to `goal - 1` (an absolute position)
  let mut mt := m0
  for j in [0:d] do mt := runFrame mt inputs[k0 + 1 + j]!
  let target := match goal with
    | some g => g - 1 - posP sy m0
    | none => posP sy mt - posP sy m0
  IO.println s!"movie: distance {target} in {d} frames"; flush
  let ins : List UInt8 := (List.range 64).map fun (n : Nat) =>
    let i := n.toUInt8
    ((i &&& 16) <<< 2) ||| ((i &&& 32) <<< 2) ||| (i &&& 15)
  let toHS := fun (m : Machine) =>
    let p := PState.read sy m
    (Potential.HS.mk p.speed p.fricMF p.faceDir p.movDir (if p.runSpd == 0 then 0 else sy.RunSpeedMin.toUInt8))
  let p0 := posP sy m0
  let mut layer : Array Machine := #[m0]
  let t0 ← IO.monoMsNow
  let mut best : Int := 0
  for k in [0:d] do
    let left := d - k - 1
    let mut nxt : Std.HashMap (Array UInt8) Machine := {}
    best := -1000000
    for m in layer do
      for i in ins do
        let m' := runFrame m (smbToPad i)
        let eng := peek m' sy.GameEngineSubroutine
        if eng.toUInt16 == sy.Eng_PlayerCtrl then
          let dist := posP sy m' - p0
          let hs := toHS m'
          let opt := Potential.dbound sy m0 (Opening.pOf sy m0 hs) left
          if dist + opt > target then
            nxt := nxt.insert (ramKey sy m') m'
            best := max best dist
        else if eng == 4 || eng == 5 then
          IO.println s!"frame {k + 1}: the flag!"; flush
    layer := nxt.valuesArray
    let t1 ← IO.monoMsNow
    IO.println s!"frame {k + 1}: {layer.size} states, best {best} ({t1 - t0} ms)"; flush
  IO.println s!"after {d} frames: {layer.size} states beat the movie (best {best}, movie {target})"
  return 0

/-- frames until the castle entry (`StarFlagTaskControl` set), with no input -/
def toCastle (sy : Syms) (m : Machine) (limit : Nat := 600) : Option Nat := Id.run do
  let mut m := m
  for k in [0:limit] do
    if peek m sy.StarFlagTaskControl != 0 then return some k
    m := runFrame m 0
  return none

/-- experiment: from a movie's frame `a`, every input for `d` frames (emulator, states merged by
RAM); the earliest castle entry over the states that touch the flag -/
def endSearch (sy : Syms) (romPath fm2Path : String) (a d : Nat) : IO UInt32 := do
  let (m0, inputs, k0) ← movieAt sy romPath fm2Path a
  -- the movie's castle entry
  let mut mt := m0
  let mut tas : Nat := 0
  for j in [0:2000] do
    if peek mt sy.StarFlagTaskControl != 0 then tas := a + j; break
    mt := runFrame mt inputs[k0 + 1 + j]!
  IO.println s!"movie: castle entry after frame {tas}"; flush
  let ins : List UInt8 := (List.range 64).map fun (n : Nat) =>
    let i := n.toUInt8
    ((i &&& 16) <<< 2) ||| ((i &&& 32) <<< 2) ||| (i &&& 15)
  let mut layer : Array Machine := #[m0]
  let mut best : Option Nat := none
  let mut bestTouch : Nat := 0
  let t0 ← IO.monoMsNow
  for k in [0:d] do
    let mut nxt : Std.HashMap (Array UInt8) Machine := {}
    let mut touched : Std.HashMap (Array UInt8) Machine := {}
    for m in layer do
      for i in ins do
        let m' := runFrame m (smbToPad i)
        let eng := peek m' sy.GameEngineSubroutine
        if eng.toUInt16 == sy.Eng_PlayerCtrl then nxt := nxt.insert (ramKey sy m') m'
        else if eng == 4 || eng == 5 then touched := touched.insert (ramKey sy m') m'
    for m in touched.valuesArray do
      match toCastle sy m with
      | some c =>
        let f := a + k + 1 + c
        let better : Bool := match best with
          | some b => decide (f < b)
          | none => true
        if better then
          best := some f
          bestTouch := a + k + 1
      | none => pure ()
    layer := nxt.valuesArray
    let t1 ← IO.monoMsNow
    IO.println s!"frame {a + k + 1}: {layer.size} states in control, {touched.size} touched, best castle {best} (touch {bestTouch}) ({t1 - t0} ms)"; flush
  return 0

/-- experiment: which RAM bytes differ after one frame from a movie's frame `a`, over the inputs -/
def ramDiff (sy : Syms) (romPath fm2Path : String) (a : Nat) : IO UInt32 := do
  let (m0, _, _) ← movieAt sy romPath fm2Path a
  let ins : List UInt8 := (List.range 64).map fun (n : Nat) =>
    let i := n.toUInt8
    ((i &&& 16) <<< 2) ||| ((i &&& 32) <<< 2) ||| (i &&& 15)
  let rams := ins.map fun i => ramKey sy (runFrame m0 (smbToPad i))
  for k in [0:2048] do
    let vals := (rams.map (·[k]!)).eraseDups
    if vals.length > 1 then IO.println s!"${hex4 k.toUInt16}: {vals.length} values {vals.take 8}"
  return 0

/-- a RAM address by symbol name, `NAME+N`, or `$hex` -/
def parseAddr (sy : Syms) (nm : String) : Option UInt16 :=
  if nm.startsWith "$" then
    some ((nm.drop 1).toString.toList.foldl (fun (acc : Nat) ch =>
      acc * 16 + (if ch.isDigit then ch.toNat - '0'.toNat else ch.toLower.toNat - 'a'.toNat + 10)) 0).toUInt16
  else match nm.splitOn "+" with
    | [base, off] => (Syms.fields.lookup base).map fun f => f sy + off.toNat!.toUInt16
    | _ => (Syms.fields.lookup nm).map fun f => f sy

/-- a movie's frames `a..b` (from its first controllable frame): the given RAM bytes, by symbol
name (`tools/smb-symbols.txt`), name+offset (`Enemy_ID+5`), or hex address (`$0746`) -/
def tasPeek (sy : Syms) (romPath fm2Path : String) (a b : Nat) (names : List String) : IO UInt32 := do
  let parse := parseAddr sy
  let addrs := names.map fun nm => (nm, parse nm)
  for (nm, ad) in addrs do
    if ad.isNone then throw (IO.userError s!"unknown name {nm}")
  let movie := parseFm2 (← IO.FS.readFile fm2Path)
  let inputs := alignInputs movie fceuxSkip
  let mut m := powerOn (← loadCart romPath) 0
  let mut c : Option Nat := none
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if c.isNone && controllable sy m then c := some k
    match c with
    | none => pure ()
    | some c0 =>
      let n := k - c0
      if n ≥ a && n ≤ b then
        let vals := addrs.map fun (nm, ad) => s!"{nm} {peek m ad.get!}"
        IO.println (s!"{n}: in {hex2 (smbToPad inputs[k])} " ++ " ".intercalate vals)
      if n > b then return 0
  return 0

/-- a movie up to frame `a` (from its first controllable frame), then the given inputs (hex, game
layout), then no input; per frame the state, until the castle entry or `limit` frames -/
def tasThen (sy : Syms) (romPath fm2Path : String) (a : Nat) (hex : String) (limit : Nat := 200) : IO UInt32 := do
  let (m0, _, _) ← movieAt sy romPath fm2Path a
  let w := (hexDecode hex).toList
  let mut m := m0
  for k in [0:limit] do
    let i := w.getD k 0
    m := runFrame m (smbToPad i)
    let p := PState.read sy m
    IO.println s!"{a + k + 1}: in {hex2 i} v {p.speedInt} st {peek m sy.Player_State} x {peek m sy.Player_X_Position} pg {peek m sy.Player_PageLoc} y {peek m sy.Player_Y_Position} vy {peek m sy.Player_Y_Speed} eng {peek m sy.GameEngineSubroutine} castle {peek m sy.StarFlagTaskControl}"
    if peek m sy.StarFlagTaskControl != 0 then return 0
  return 0

/-- the earliest castle entry from `m` over a few inputs for `d` frames (states merged by `ramKey`) -/
def earliestCastle (sy : Syms) (m0 : Machine) (d : Nat) : Option Nat := Id.run do
  let ins : List UInt8 := [0x41, 0xC1, 0x01, 0x81, 0x03, 0x83, 0x00, 0x80]
  let mut layer : Array Machine := #[m0]
  let mut best : Option Nat := none
  for k in [0:d] do
    let mut nxt : Std.HashMap (Array UInt8) Machine := {}
    for m in layer do
      for i in ins do
        let m' := runFrame m (smbToPad i)
        let eng := peek m' sy.GameEngineSubroutine
        if eng.toUInt16 == sy.Eng_PlayerCtrl then nxt := nxt.insert (ramKey sy m') m'
        else if eng == 4 || eng == 5 then
          match toCastle sy m' with
          | some c =>
            let f := k + 1 + c
            best := some (match best with | some b => min b f | none => f)
          | none => pure ()
    layer := nxt.valuesArray
  return best

/-- experiment: from a movie's frame `a`, every jump pattern (Right+B with or without A) that stays
within one pixel of the movie's position, until frame `b`; then the earliest castle entry from
each state reached -/
def stairSearch (sy : Syms) (romPath fm2Path : String) (a b : Nat) (shift : Nat := 0) : IO UInt32 := do
  let (m0, inputs, k0) ← movieAt sy romPath fm2Path a
  -- move the player `shift` subpixels to the right (page, x, fraction)
  let p := posP sy m0 + shift
  let m0 := poke m0 sy.SprObject_X_MoveForce (p % 256).toNat.toUInt8
  let m0 := poke m0 sy.Player_X_Position ((p / 256) % 256).toNat.toUInt8
  let m0 := poke m0 sy.Player_PageLoc ((p / 65536) % 256).toNat.toUInt8
  -- the movie's positions
  let mut mt := m0
  let mut pt : Array Int := #[posP sy m0]
  for j in [0:b - a] do
    mt := runFrame mt inputs[k0 + 1 + j]!
    pt := pt.push (posP sy mt)
  let mut layer : Array Machine := #[m0]
  let t0 ← IO.monoMsNow
  let mut touchBest : Option Nat := none
  for k in [0:b - a] do
    let mut nxt : Std.HashMap (Array UInt8) Machine := {}
    let mut touched : Std.HashMap (Array UInt8) Machine := {}
    for m in layer do
      for i in [(0x41 : UInt8), 0xC1, 0x42, 0xC2, 0x00, 0x80] do
        let m' := runFrame m (smbToPad i)
        let eng := peek m' sy.GameEngineSubroutine
        if eng.toUInt16 == sy.Eng_PlayerCtrl && posP sy m' ≥ pt[k + 1]! - 768 then
          nxt := nxt.insert (ramKey sy m') m'
        else if eng == 4 || eng == 5 then touched := touched.insert (ramKey sy m') m'
    for m in touched.valuesArray do
      match toCastle sy m with
      | some c =>
        let f := a + k + 1 + c
        if (match touchBest with | some t => decide (f < t) | none => true) then
          touchBest := some f
          IO.println s!"touch at {a + k + 1} (y {peek m sy.Player_Y_Position}, eng {peek m sy.GameEngineSubroutine}): castle {f}"; flush
      | none => pure ()
    layer := nxt.valuesArray
    if (k + 1) % 10 == 0 then
      let t1 ← IO.monoMsNow
      IO.println s!"frame {a + k + 1}: {layer.size} states ({t1 - t0} ms)"; flush
  -- the states at frame b
  let mut seen : Std.HashSet (Int × UInt8 × UInt8 × UInt8 × UInt8) := {}
  let mut best : Option Nat := none
  for m in layer do
    let key := (posP sy m / 256, peek m sy.Player_Y_Position, peek m sy.Player_Y_Speed,
      peek m sy.Player_Y_MoveForce, peek m sy.Player_State)
    if !seen.contains key then
      seen := seen.insert key
      let c := (earliestCastle sy m 10).map (b + ·)
      IO.println s!"at {b}: x {peek m sy.Player_X_Position} pg {peek m sy.Player_PageLoc} y {peek m sy.Player_Y_Position} vy {peek m sy.Player_Y_Speed} st {peek m sy.Player_State}: earliest castle {c}"; flush
      match c with
      | some f => best := some (match best with | some x => min x f | none => f)
      | none => pure ()
  IO.println s!"{layer.size} states at frame {b}; earliest castle over them: {best}; over the touches on the way: {touchBest}"
  return 0

/-- a movie up to frame `a`, then the inputs HEX; from there, the earliest castle entry over 8 inputs
for `d` frames (states merged by `ramKey`) -/
def tasThenEnd (sy : Syms) (romPath fm2Path : String) (a : Nat) (hex : String) (d : Nat) : IO UInt32 := do
  let (m0, _, _) ← movieAt sy romPath fm2Path a
  let w := (hexDecode hex).toList
  let m := w.foldl (fun m i => runFrame m (smbToPad i)) m0
  let p := PState.read sy m
  IO.println s!"after frame {a + w.length}: x {peek m sy.Player_X_Position} pg {peek m sy.Player_PageLoc} y {peek m sy.Player_Y_Position} vy {peek m sy.Player_Y_Speed} v {p.speedInt} st {peek m sy.Player_State}"
  let c := earliestCastle sy m d
  IO.println s!"earliest castle entry: {c.map (a + w.length + ·)}"
  return 0

/-- a movie's state at frame `a`, with y, the x position (shifted by `dx` subpixels) and the facing
direction overwritten (falling at the top fall speed, fraction 0); the earliest
castle entry over 8 inputs for `d` frames -/
def endPoke (sy : Syms) (romPath fm2Path : String) (a y : Nat) (dx : Int) (fd d : Nat) : IO UInt32 := do
  let (m0, _, _) ← movieAt sy romPath fm2Path a
  let p := posP sy m0 + dx
  let m := poke m0 sy.SprObject_X_MoveForce (p % 256).toNat.toUInt8
  let m := poke m sy.Player_X_Position ((p / 256) % 256).toNat.toUInt8
  let m := poke m sy.Player_PageLoc ((p / 65536) % 256).toNat.toUInt8
  let m := poke m sy.Player_Y_Position y.toUInt8
  let m := poke m sy.Player_Y_Speed sy.MaxFallSpeed.toUInt8
  let m := poke m sy.Player_Y_MoveForce 0
  let m := poke m sy.PlayerFacingDir fd.toUInt8
  let c := earliestCastle sy m d
  IO.println s!"y {y} dx {dx} fd {fd}: earliest castle {c.map (a + ·)}"
  return 0

/-- a movie's state at frame `a`: the potential bound on its position `n` frames later, against the
movie's own position then -/
def potBound (sy : Syms) (romPath fm2Path : String) (a n : Nat) : IO UInt32 := do
  let (m0, inputs, k0) ← movieAt sy romPath fm2Path a
  let p := PState.read sy m0
  let hs : Potential.HS := ⟨p.speed, p.fricMF, p.faceDir, p.movDir,
    if p.runSpd == 0 then 0 else sy.RunSpeedMin.toUInt8⟩
  let b := posP sy m0 + Potential.dbound sy m0 (Opening.pOf sy m0 hs) n
  let mut mt := m0
  for j in [0:n] do mt := runFrame mt inputs[k0 + 1 + j]!
  IO.println s!"frame {a}: phi {Potential.phi sy m0 hs}; bound at {a + n}: P {b} (x {(b / 256) % 256} + {b % 256}/256); movie: P {posP sy mt} (x {peek mt sy.Player_X_Position}); bound - movie = {b - posP sy mt}"
  return 0

/-- the jump arcs from the ground at a movie's frame `f`, for takeoff speed `v` and A held `h`
frames: `(h, s, l)` with `l` the first frame after the takeoff frame count at which Mario falls
inside the landing window `[wlo, whi]`, and `s` the last frame before it with `y ≥ cy`
(frames counted so that `1` is the first frame after `f`) -/
def jumpArcs (sy : Syms) (m0 : Machine) (v : Nat) (cy wlo whi : Nat) (maxHold : Nat := 36) :
    List (Nat × Nat × Nat) := Id.run do
  let x0 := peek m0 sy.Player_X_Position
  let m1 := poke (poke m0 sy.Player_X_Speed v.toUInt8) sy.Player_XSpeedAbsolute v.toUInt8
  let mut out : List (Nat × Nat × Nat) := []
  for h in [1:maxHold + 1] do
    let mut m := m1
    let mut s := 0
    let mut l : Option Nat := none
    for k in [1:90] do
      if l.isNone then
        m := runFrame m (smbToPad (if k ≤ h then 0x80 else 0))
        m := poke m sy.Player_X_Position x0
        let y := (peek m sy.Player_Y_Position).toNat
        let vy := peek m sy.Player_Y_Speed
        if vy < 0x80 && wlo ≤ y && y ≤ whi && k > 1 then l := some k
        else if y ≥ cy then s := k
        if peek m sy.Player_State == 0 then break
    match l with
    | some k => out := out ++ [(h, s, k)]
    | none => pure ()
  return out

/-- experiment: an upper bound on `P` at frame `n` over all inputs from the first frame of a room,
when Mario starts on the left of a block whose left edge he has to clear.
`f`: the frame he lands on the floor. `cx`, `cy`: while `y ≥ cy`, `x < cx` or he hits the block.
`[wlo, whi]`: the window where a falling Mario lands on the block. `tx`: the goal in pixels. -/
def roomBound (sy : Syms) (romPath fm2Path : String) (a f n cx cy wlo whi tx : Nat) : IO UInt32 := do
  let (ma, inputs, ka) ← movieAt sy romPath fm2Path a
  let (mf, _, _) ← movieAt sy romPath fm2Path f
  -- the theorems are about the frames in the context of the 1-1 start
  let ctx ← smb11Start sy <$> loadCart romPath
  let cp : Int := (cx : Int) * 256
  let target : Int := (tx : Int) * 256
  let fast : Int := sy.AirFastSpeed.toNat
  let top' : Int := TopSpeed.top sy
  let dB := Potential.dbound sy ctx
  -- the arcs
  let mut last : List (Nat × Nat × Nat) := []
  let mut classes : Array (Nat × List (Nat × Nat × Nat)) := #[]
  for v in [0:(TopSpeed.top sy) + 1] do
    let arcs := jumpArcs sy mf v cy wlo whi
    if arcs != last || v == 0 then
      classes := classes.push (v, arcs)
      IO.println s!"takeoff |v| ≥ {v}: (hold, s, L) = {arcs.take 14}"
      (← IO.getStdout).flush
    last := arcs
  -- takeoff below the air threshold: `AirCap.landing_bound` from the last low frame
  let cd := AirCap.capDist sy ctx
  let mut best : Int := -1
  let mut bestAt : String := ""
  let mut sMin : Nat := 1000
  for (v, arcs) in classes do
    if (v : Int) < fast then
      for (_, s, l) in arcs do
        sMin := min sMin s
        let b := cp - 1 + 16 * (fast - 1) * ((l : Int) - s) + cd (n - (f + l))
        if b > best then
          best := b
          bestAt := s!"last low frame {f + s}, landing {f + l}"
  IO.println s!"slow takeoff: bound at {n}: P {best} ({bestAt}); goal {target}; margin {target - best}"
  -- the last takeoff from the block is slow: at most the capped speed in the air, for a long time
  let hRoom := (Jump.groundY sy - wlo) / 16
  let rs := Jump.summary sy ctx hRoom
  let boundAt (t : Nat) : Int := Id.run do
    let mut b : Int := -1
    for (v, arcs) in classes do
      if (v : Int) < fast then
        for (_, s, l) in arcs do
          if f + l ≤ t then
            b := max b (cp - 1 + 16 * (fast - 1) * ((l : Int) - s) + cd (t - (f + l)))
    return b
  let en := n + 12
  let tk := en - rs.airS
  let slowEnd := boundAt (tk - 1) + 16 * (fast - 1) * (rs.airS + 1 : Nat)
  IO.println s!"a slow takeoff from the block ({rs.airS} air frames or more): at {en} P ≤ {slowEnd}; to the ground after the last frame above the block: slow {rs.aboveS}, fast {rs.aboveF}; stepping off {rs.walk}"
  -- a block hit on the last frame below the top: no speed left
  let sHit := f + sMin
  let g := cp + 16 * top' + dB (2560 : Int) (n - sHit)
  IO.println s!"block hit at the last low frame (s ≥ {sHit}): P ≤ {g}; margin {target - g}"
  -- takeoff at the air threshold or more: the frames from the takeoff until above the block
  let fastArc := (classes.toList.filter fun c => (c.1 : Int) ≥ fast).flatMap fun c => c.2
  let sFast := (fastArc.map fun t => t.2.1).foldl min 1000
  let tLast : Nat := Id.run do
    let mut t := f + 1
    for k in [f + 1:n] do
      if cp - 1 + 16 * top' * ((n : Int) - (k + sFast - 1)) ≥ target then t := k
    return t
  IO.println s!"fast takeoff: at least {sFast - 1} air frames after the takeoff frame; takeoff later than {tLast} misses the goal"
  -- a block hit on the ground leaves the stored absolute speed: a jump right after it counts as
  -- fast, from a speed near 0. The speed cannot reach the threshold before `f + 4` (`hitT`).
  let hitT := f + 5
  let hitS := hitT + sFast - 1
  let g2 := cp + 16 * top' + dB (255 + Potential.gFast sy ctx * ((sFast : Int))) (n - hitS)
  IO.println s!"hit on the ground, jump at {hitT} or later: P ≤ {g2}; margin {target - g2}"
  IO.println "takeoffs by then: `takeoff-check` (a Lean theorem, both directions)"
  -- the movie, for comparison; and the model against its frames
  let mut mt := ma
  let mut bad : Nat := 0
  let mut vbad : Nat := 0
  let mut vframes : Nat := 0
  for j in [0:n - a] do
    let pad := inputs[ka + 1 + j]!
    let p := PState.read sy mt
    let hs : Potential.HS := ⟨p.speed, p.fricMF, p.faceDir, p.movDir,
      if p.runSpd == 0 then 0 else sy.RunSpeedMin.toUInt8⟩
    let mn := runFrame mt pad
    let st := peek mt sy.Player_State
    let jump := st == 0 && peek mn sy.Player_State == 1
    let saved := peek mn sy.SavedJoypadBits
    let i : Potential.HIn := { st := if st == 0 then 0 else 1, jump, joy := saved &&& 0x7F,
                               rt := if p.runTmr == 0 then 0 else 1 }
    let u := Potential.hstep sy ctx hs i
    let q := PState.read sy mn
    if u.v != q.speed || u.f != q.fricMF || u.fd != q.faceDir || u.md != q.movDir then
      bad := bad + 1
      IO.println s!"model differs at {a + j + 1}: model {sbyte u.v} {u.f} {u.fd} {u.md}, movie {sbyte q.speed} {q.fricMF} {q.faceDir} {q.movDir}"
    -- the vertical model, on the frames that do not land
    let vs : Jump.VS := ⟨peek mt sy.Player_Y_Position, peek mt sy.Player_Y_MoveForce, peek mt sy.Player_Y_Speed,
      peek mt sy.Player_YMF_Dummy, peek mt sy.VerticalForce, peek mt sy.VerticalForceDown,
      peek mt sy.JumpOrigin_Y_Position, st, (peek mt sy.A_B_Buttons &&& 0x80) != 0⟩
    let w := Jump.vstep sy ctx vs ((saved &&& 0x80) != 0) p.absSpd
    if (peek mn sy.Player_State != 0 && st != 0) || jump then
      vframes := vframes + 1
      if w.y != peek mn sy.Player_Y_Position || w.vy != peek mn sy.Player_Y_Speed
          || w.mf != peek mn sy.Player_Y_MoveForce || w.dummy != peek mn sy.Player_YMF_Dummy then
        vbad := vbad + 1
        IO.println s!"vertical model differs at {a + j + 1}: model y {w.y} vy {sbyte w.vy} mf {w.mf} dummy {w.dummy}, movie y {peek mn sy.Player_Y_Position} vy {sbyte (peek mn sy.Player_Y_Speed)} mf {peek mn sy.Player_Y_MoveForce} dummy {peek mn sy.Player_YMF_Dummy}"
    mt := mn
  IO.println s!"model against the movie, frames {a + 1}..{n}: {bad} differ; vertical model on {vframes} frames in the air: {vbad} differ"
  IO.println s!"movie at {n}: P {posP sy mt}"
  return 0

/-- a movie's state at frame `a` with the height, position, speed, fall speed and facing overwritten:
every left/right, A and B input for `d` frames; the first touch of the pole at a height `≥ gy`
(the direct grab) and the first touch at any height -/
def flagPoke (sy : Syms) (romPath fm2Path : String) (a y : Nat) (dx : Int) (v vy fd d gy : Nat) : IO UInt32 := do
  let (m0, _, _) ← movieAt sy romPath fm2Path a
  let p := posP sy m0 + dx
  let m := poke m0 sy.SprObject_X_MoveForce (p % 256).toNat.toUInt8
  let m := poke m sy.Player_X_Position ((p / 256) % 256).toNat.toUInt8
  let m := poke m sy.Player_PageLoc ((p / 65536) % 256).toNat.toUInt8
  let m := poke m sy.Player_Y_Position y.toUInt8
  let m := poke m sy.Player_Y_Speed vy.toUInt8
  let m := poke m sy.Player_Y_MoveForce 0
  let m := poke m sy.Player_X_Speed v.toUInt8
  let m := poke m sy.Player_XSpeedAbsolute v.toUInt8
  let m := poke m sy.PlayerFacingDir fd.toUInt8
  let ins : List UInt8 := [0, 1, 2, 3].flatMap fun lr => [0, 0x40, 0x80, 0xC0].map fun ab => lr ||| ab
  let mut layer : Array Machine := #[m]
  let mut direct : Option Nat := none
  let mut any : Option Nat := none
  let mut runs := 0
  for k in [0:d] do
    let mut nxt : Std.HashMap (Array UInt8) Machine := {}
    for m1 in layer do
      for i in ins do
        let m2 := runFrame m1 (smbToPad i)
        runs := runs + 1
        let eng := peek m2 sy.GameEngineSubroutine
        if eng.toUInt16 == sy.Eng_PlayerCtrl then nxt := nxt.insert (ramKey sy m2) m2
        else if eng == 4 || eng == 5 then
          if any.isNone then any := some (a + k + 1)
          if direct.isNone && eng == 5 then direct := some (a + k + 1)
          if direct.isNone && (peek m2 sy.Player_Y_Position).toNat ≥ gy then direct := some (a + k + 1)
    layer := nxt.valuesArray
  IO.println s!"y {y} dx {dx} v {v} vy {vy} fd {fd}: direct {direct}, any touch {any}; {runs} frames"
  return 0

/-- the collision routine near the flagpole against the rules, as a program -/
def poleCheckProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let mp := PoleGrab.withPole sy m0
  let cs := PoleGrab.cases sy
  IO.println s!"column x {PoleGrab.colX sy}, top y {PoleGrab.topY sy}, {cs.length} cases"
  let bad := cs.filter fun c => !PoleGrab.ruleOk sy mp c
  IO.println s!"{bad.length} differ"
  for c in bad.take 30 do
    let r := PoleGrab.collide sy mp c
    IO.println s!"x {c.x} y {c.y} v {sbyte c.v} md {c.md} vy {sbyte c.vy} st {c.st} fd {c.fd} -> x {peek r sy.Player_X_Position} y {peek r sy.Player_Y_Position} v {sbyte (peek r sy.Player_X_Speed)} st {peek r sy.Player_State} eng {peek r sy.GameEngineSubroutine} bits {peek r sy.Player_CollisionBits}"
  IO.println s!"mask check: {PoleGrab.maskCheck sy m0}"
  return 0

open Jump in
/-- the jump table: for blocks `h` rows above the ground, what every jump from the ground and from the block does -/
def jumpTable (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  for h in [1, 2, 3, 4] do
    let r := summary sy m0 h
    IO.println s!"h {h}: stand {standY sy h}, corner {cornerY sy h}; from the ground, (last low frame, frame on the block): slow {r.slow} fast {r.fast}"
    IO.println s!"     from the block, to the ground after the last frame above it: slow {r.aboveS} fast {r.aboveF}; air frames when slow: {r.airS}; stepping off: {r.walk}"
    IO.println s!"     checks: {arcCheck sy m0 (groundY sy) h (windowOk sy h r.slow r.fast)} {arcCheck sy m0 (standY sy h) h (dropOk sy r.aboveS r.aboveF r.airS)} {walkOk sy m0 h r.walk}"
    (← IO.getStdout).flush
  let pole := arcAll sy m0 (groundY sy) 1
  let rise := pole.filter fun x => !falling x.s && sy.FlagGrabY.toNat ≤ x.s.y.toNat && x.s.y.toNat < cornerY sy 1
  IO.println s!"rising at the height of a direct grab: {(rise.map fun x => (x.fast, x.k, x.s.y)).eraseDups}; check {arcCheck sy m0 (groundY sy) 1 (riseOk sy 1 2 1)}"
  return 0

/-- the collision routine on the pipe's top against the rule, and the position bound, as a program -/
def pipeCheckProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let mp := PipeEntry.withPipe sy m0
  let cs := PipeEntry.cases sy
  IO.println s!"{cs.length} cases, level data {PipeEntry.levelOk sy m0}"
  let bad := cs.filter fun c => !PipeEntry.ruleOk sy mp c
  IO.println s!"{bad.length} differ"
  for c in bad.take 30 do
    let r := PipeEntry.collide sy mp c
    IO.println s!"x {c.x} y {c.y} v {sbyte c.v} md {c.md} vy {sbyte c.vy} st {c.st} ud {c.ud} fd {c.fd} size {c.size} -> eng {peek r sy.GameEngineSubroutine} rule {PipeEntry.rule sy c}"
  let n := TasFastAccel.witness.length
  let d := TopSpeed.walkDist sy m0 (TopSpeed.reachWitness n)
  let l := PipeEntry.windowP sy (PipeEntry.pipePage sy m0)
  for t in [367, 368] do
    let b := posP sy m0 + d + 16 * (TopSpeed.top sy : Int) * ((t - n : Nat) : Int)
    IO.println s!"frame {t}: the window's left end minus the bound = {l - b} (1/256 px)"
  return 0

/-- the change from the vertical pipe to the bonus room, as a program -/
def pipeChangeProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => PipeTransition.allCheck sy m0 91 21
  let t1 ← IO.monoMsNow
  IO.println s!"the change into the room: {ok} ({t1 - t0} ms)"
  return if ok then 0 else 1

/-- the fast takeoff search in the bonus room, as a program -/
def takeoffCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let R := FastTakeoff.bonusRoom sy 34 6 8 64
  let t0 ← IO.monoMsNow
  let r ← IO.lazyPure fun _ => FastTakeoff.roomCheck sy m0 R
  let t1 ← IO.monoMsNow
  IO.println s!"takeoffs up to {R.G} ground frames after the fall: moving right none stays left of the corner, moving left all short of the goal: {r} ({t1 - t0} ms)"
  IO.println s!"later takeoffs short of the goal by the top speed: {FastTakeoff.lateOk sy R}"
  return if r && FastTakeoff.lateOk sy R then 0 else 1

/-- the collision routine at the side pipe's mouth against the rule, as a program -/
def sideCheckProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let mp := SidePipe.withPipe sy m0
  let cs := SidePipe.cases sy
  IO.println s!"{cs.length} cases"
  let bad := cs.filter fun c => !SidePipe.ruleOk sy mp c
  IO.println s!"{bad.length} differ"
  for c in bad.take 30 do
    let r := SidePipe.collide sy mp c
    IO.println s!"x {c.x} y {c.y} v {sbyte c.v} md {c.md} vy {sbyte c.vy} st {c.st} fd {c.fd} -> eng {peek r sy.GameEngineSubroutine} y {peek r sy.Player_Y_Position} st {peek r sy.Player_State} rule {SidePipe.rule sy c}"
  return if bad.isEmpty then 0 else 1

/-- the movement routine from a stopped Mario with a high stored speed, as a program -/
def absCheckProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let cs := FastHop.cases sy
  IO.println s!"{cs.length} cases"
  let bad := cs.filter fun c => !FastHop.caseOk sy m0 c
  IO.println s!"{bad.length} differ"
  for c in bad.take 20 do
    let r := FastHop.move sy m0 c
    IO.println s!"abs {c.abs} f {c.f} lr {c.lr} bits {c.bits} st {c.st} md {c.md} rs {c.rs} -> abs {peek r sy.Player_XSpeedAbsolute} v {sbyte (peek r sy.Player_X_Speed)} md {peek r sy.Player_MovingDir}"
  return if bad.isEmpty then 0 else 1

open CastleWalk in
/-- from the frame of the touch to the castle, as a program -/
def castleCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let b := beside m0
  IO.println s!"route {route.length} frames: x {peek b sy.Player_X_Position} pg {peek b sy.Player_PageLoc} y {peek b sy.Player_Y_Position} st {peek b sy.Player_State}"
  let vs := beforeGrab sy m0
  let v0 := vs.headD default
  for fr in fracs do
    IO.println s!"fraction {fr}: castle after {framesToCastle sy (touchAt sy b (firstX sy) fr v0)}"
  for y in otherYs sy do
    let t := touchAt sy b (PoleGrab.colX sy - 9).toUInt8 bigFrac { v0 with y := y + 3 }
    IO.println s!"touch at {peek t sy.Player_Y_Position}: castle after {framesToCastle sy t}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => checkOn sy b vs 126 160
  let t1 ← IO.monoMsNow
  IO.println s!"check: {ok} ({t1 - t0} ms)"
  return if ok then 0 else 1

/-- as `endPoke`, but print the best input sequence and replay it frame by frame -/
def endPokeTrace (sy : Syms) (romPath fm2Path : String) (a y : Nat) (dx : Int) (fd d : Nat) : IO UInt32 := do
  let (m0, _, _) ← movieAt sy romPath fm2Path a
  let p := posP sy m0 + dx
  let m := poke m0 sy.SprObject_X_MoveForce (p % 256).toNat.toUInt8
  let m := poke m sy.Player_X_Position ((p / 256) % 256).toNat.toUInt8
  let m := poke m sy.Player_PageLoc ((p / 65536) % 256).toNat.toUInt8
  let m := poke m sy.Player_Y_Position y.toUInt8
  let m := poke m sy.Player_Y_Speed sy.MaxFallSpeed.toUInt8
  let m := poke m sy.Player_Y_MoveForce 0
  let m1 := poke m sy.PlayerFacingDir fd.toUInt8
  let ins : List UInt8 := [0x41, 0xC1, 0x01, 0x81, 0x03, 0x83, 0x00, 0x80]
  let mut layer : Array (Machine × List UInt8) := #[(m1, [])]
  let mut best : Option (Nat × List UInt8) := none
  for k in [0:d] do
    let mut nxt : Std.HashMap (Array UInt8) (Machine × List UInt8) := {}
    for (m, path) in layer do
      for i in ins do
        let m' := runFrame m (smbToPad i)
        let eng := peek m' sy.GameEngineSubroutine
        if eng.toUInt16 == sy.Eng_PlayerCtrl then nxt := nxt.insert (ramKey sy m') (m', path ++ [i])
        else if eng == 4 || eng == 5 then
          match toCastle sy m' with
          | some c =>
            let f := k + 1 + c
            if (match best with | some (b, _) => decide (f < b) | none => true) then best := some (f, path ++ [i])
          | none => pure ()
    layer := nxt.valuesArray
  match best with
  | none => IO.println "no castle entry"
  | some (f, path) =>
    IO.println s!"castle after {f} frames, inputs {path.map hex2}"
    let mut mm := m1
    for i in path ++ List.replicate 140 (0 : UInt8) do
      mm := runFrame mm (smbToPad i)
      IO.println s!"  in {hex2 i} x {peek mm sy.Player_X_Position} pg {peek mm sy.Player_PageLoc} y {peek mm sy.Player_Y_Position} st {peek mm sy.Player_State} eng {peek mm sy.GameEngineSubroutine} castle {peek mm sy.StarFlagTaskControl}"
      if peek mm sy.StarFlagTaskControl != 0 then break
  return 0

/-! ## main -/

def usage : String := "usage: smbrta [--config FILE] [--poke NAME=VALUE]... COMMAND
  (--poke changes a RAM byte, named as in tools/smb-symbols.txt, in the 1-1 start)
  nestest                            the CPU against the nestest log
  run FM2 [skip]                     play a movie, report level changes and the clear
  gen-rom                            private: Rom.lean (ROM, symbols, 1-1 start)
  gen-proofs [--full]                private: the theorem files (--full: also the full-search proofs)
  phys-validate RUNS LEN [BIAS PCT]  ground model vs emulator
  phys-live DEPTH                    RAM bytes the ground step uses
  phys-indep DEPTH                   position does not affect the ground step
  jump-discover WALKS LEN            carried bytes with jumping; model vs emulator
  relax-layers DEPTH [pad|lr]
  realize DEPTH [pad|lr]             exact search for a DEPTH-frame sequence
  relax-reads DEPTH [pad|lr]         RAM bytes the relaxed step reads
  top-check NAME|all                 the top-speed routine checks, as a program
  fast-check                         the pruned fast-accel lower bounds, as a program
  profile-check [pad|lr]             experiment: is each speed unreachable before the witness reaches it?
  reach-check                        the reach bounds against some input sequences, as a program
  pot-check                          the open-area potential check, as a program
  hstep-validate pad|lr DEPTH        the horizontal frame (hstep) against the relaxed step
  reach-opt N T                      experiment: the largest distance, keeping the best per state
  open-check N T                     the opening search: no N-frame input moves P past T, as a program
  jump-check                         every A hold length gives a jump between a tap and a full hold
  tas-trace FM2                      a movie's distance in 1-1 against the bound, until the player control ends
  tas-seg FM2 A B                    a movie's frames A..B (from its first controllable frame), distance from A
  tas-insert FM2 AT K                a movie with K empty frames inserted at AT: when the level changes
  seg-search FM2 A D                 experiment: from a movie's frame A, can D frames move P further? (emulator)
  end-search FM2 A D                 experiment: from a movie's frame A, the earliest castle entry (emulator)
  tas-peek FM2 A B NAME...           a movie's frames A..B: RAM bytes by symbol name, NAME+N, or $hex
  tas-then FM2 A HEX                 a movie up to frame A, then the inputs HEX; the state per frame until the castle
  stair-search FM2 A B               experiment: jump patterns at top speed from A to B, then the earliest castle
  tas-then-end FM2 A HEX D           as tas-then, then the earliest castle over 8 inputs for D frames
  end-poke FM2 A Y DX FD D           a movie's state at A with y, x+DX and facing overwritten: the earliest castle
  flag-poke FM2 A Y DX V VY FD D GY  a movie's state at A overwritten: the first touches of the pole over all inputs
  pole-check                         the collision routine near the flagpole against the rules, as a program
  pipe-check                         the collision routine on the pipe's top against the rule, and the bound at 367 and 368
  pipe-change-check                  the change from the vertical pipe to the bonus room, as a program
  takeoff-check                      the fast takeoff search in the bonus room, as a program
  side-check                         the collision routine at the side pipe's mouth against the rule, as a program
  abs-check                          the movement routine from a stopped Mario with a high stored speed, as a program
  castle-check                       from the frame of the touch to the castle, as a program
  jump-table                         what every jump from the ground and from a block does
  pot-bound FM2 A N                  a movie's state at A: the potential bound on P after N frames vs the movie
  room-bound FM2 A F N CX CY WLO WHI TX  room start A, floor landing F: a bound on P at N over all inputs (see the route page)
  trace HEX                          play inputs (hex bytes) from the 1-1 start, print the state per frame
  phi-explore pad|lr DEPTH           experiment: abstract transitions and the smallest potential gain
  check-witness [pad|lr]             play a theorem's witness on the full emulator
  relax-indep DEPTH [vert|pos] [pad|lr]"

/-- play a theorem's witness on the full emulator; print the speed per frame -/
def checkWitness (sy : Syms) (romPath : String) (w : List UInt8) : IO UInt32 := do
  let m0 ← startM sy romPath
  let top := (sy.RunTopSpeed.toNat : Int)
  let mut m := m0
  let mut out := ""
  let mut first : Option Nat := none
  for h : k in [0:w.length] do
    m := runFrame m (smbToPad w[k])
    let v := (PState.read sy m).speedInt
    out := out ++ s!"{v} "
    if first.isNone && v ≥ top then first := some (k + 1)
  IO.println s!"speeds: {out}"
  IO.println s!"top speed first reached after frame {first} of {w.length}"
  return if first == some w.length then 0 else 1

def main (args : List String) : IO UInt32 := do
  let rec opts (cfg : Option String) : List String → IO (Option String × List String)
    | "--config" :: p :: rest => opts (some p) rest
    | "--poke" :: kv :: rest => do
      match kv.splitOn "=" with
      | [k, v] => pokes.modify (· ++ [(k, v.toNat!)]); opts cfg rest
      | _ => throw (IO.userError s!"--poke NAME=VALUE, got {kv}")
    | rest => pure (cfg, rest)
  let (cfgPath, args) ← opts none args
  let cfg ← Config.load cfgPath
  let lr := fun (s : String) => s == "lr"
  match args with
  | ["nestest"] => runNestest (← cfg.path "nestestRom") (← cfg.path "nestestLog")
  | _ =>
  let sy ← Syms.load (← cfg.path "syms")
  let rom ← cfg.path "rom"
  let dir := (System.FilePath.mk (← cfg.path "proofProject") / "Proof").toString
  match args with
  | ["run", fm2] => runMovie sy rom fm2 fceuxSkip
  | ["run", fm2, k] => runMovie sy rom fm2 k.toNat!
  | ["gen-rom"] => genRom sy rom dir
  | ["gen-proofs"] => genProofs sy rom dir false
  | ["gen-proofs", "--full"] => genProofs sy rom dir true
  | ["phys-validate", r, l] => physValidate sy rom r.toNat! l.toNat! 0 0
  | ["phys-validate", r, l, b, p] =>
    physValidate sy rom r.toNat! l.toNat! ((hexDecode b).toList.headD 0) p.toNat!
  | ["phys-live", d] => physLive sy rom d.toNat!
  | ["phys-indep", d] => physIndep sy rom d.toNat!
  | ["jump-discover", w, l] => jumpDiscover sy rom w.toNat! l.toNat!
  | ["relax-layers", d] => relaxLayers sy rom d.toNat! relaxInputs
  | ["relax-layers", d, m] => relaxLayers sy rom d.toNat! (if lr m then relaxInputsLR else relaxInputs)
  | ["realize", d] => realize sy rom d.toNat! relaxInputs padInputsA
  | ["realize", d, m] =>
    if lr m then realize sy rom d.toNat! relaxInputsLR lrInputsA else realize sy rom d.toNat! relaxInputs padInputsA
  | ["check-witness"] => checkWitness sy rom FastAccel.witness
  | ["check-witness", m] => checkWitness sy rom (if lr m then TasFastAccel.witness else FastAccel.witness)
  | ["top-check", w] => topCheck sy rom w
  | ["fast-check"] => fastCheck sy rom
  | ["reach-check"] => reachCheck sy rom
  | ["trace", hex] => traceInputs sy rom hex
  | ["tas-trace", fm2] => tasTrace sy rom fm2 fceuxSkip
  | ["tas-seg", fm2, a, b] => tasSeg sy rom fm2 a.toNat! b.toNat!
  | ["seg-search", fm2, a, d] => segSearch sy rom fm2 a.toNat! d.toNat!
  | ["seg-search", fm2, a, d, g] => segSearch sy rom fm2 a.toNat! d.toNat! (some g.toInt!)
  | ["end-search", fm2, a, d] => endSearch sy rom fm2 a.toNat! d.toNat!
  | ["stair-search", fm2, a, b] => stairSearch sy rom fm2 a.toNat! b.toNat!
  | ["stair-search", fm2, a, b, sh] => stairSearch sy rom fm2 a.toNat! b.toNat! sh.toNat!
  | ["ram-diff", fm2, a] => ramDiff sy rom fm2 a.toNat!
  | "tas-peek" :: fm2 :: a :: b :: names => tasPeek sy rom fm2 a.toNat! b.toNat! names
  | ["tas-then", fm2, a, hex] => tasThen sy rom fm2 a.toNat! hex
  | ["pot-bound", fm2, a, n] => potBound sy rom fm2 a.toNat! n.toNat!
  | ["pole-check"] => poleCheckProg sy rom
  | ["pipe-check"] => pipeCheckProg sy rom
  | ["pipe-change-check"] => pipeChangeProg sy rom
  | ["takeoff-check"] => takeoffCheck sy rom
  | ["side-check"] => sideCheckProg sy rom
  | ["abs-check"] => absCheckProg sy rom
  | ["castle-check"] => castleCheck sy rom
  | ["jump-table"] => jumpTable sy rom
  | ["flag-poke", fm2, a, y, dx, v, vy, fd, d, gy] =>
    flagPoke sy rom fm2 a.toNat! y.toNat! dx.toInt! v.toNat! vy.toNat! fd.toNat! d.toNat! gy.toNat!
  | ["room-bound", fm2, a, f, n, cx, cy, wlo, whi, tx] =>
    roomBound sy rom fm2 a.toNat! f.toNat! n.toNat! cx.toNat! cy.toNat! wlo.toNat! whi.toNat! tx.toNat!
  | ["tas-then-end", fm2, a, hex, d] => tasThenEnd sy rom fm2 a.toNat! hex d.toNat!
  | ["end-poke", fm2, a, y, dx, fd, d] => endPoke sy rom fm2 a.toNat! y.toNat! dx.toInt! fd.toNat! d.toNat!
  | ["end-poke-trace", fm2, a, y, dx, fd, d] => endPokeTrace sy rom fm2 a.toNat! y.toNat! dx.toInt! fd.toNat! d.toNat!
  | ["tas-insert", fm2, a, k] => tasInsert sy rom fm2 a.toNat! k.toNat!
  | ["tas-delete", fm2, a, k] => tasInsert sy rom fm2 a.toNat! 0 k.toNat!
  | ["open-check", n, t] => openCheck sy rom n.toNat! t.toInt!
  | ["jump-check"] => jumpCheck sy rom
  | ["reach-opt", n, t] => reachOpt sy rom n.toNat! t.toInt!
  | ["pot-check"] => potCheckProg sy rom
  | ["hstep-validate", m, d] => hstepValidate sy rom (lr m) d.toNat!
  | ["phi-explore", m, d] => phiExplore sy rom (lr m) d.toNat!
  | ["profile-check"] => profileCheck sy rom false
  | ["profile-check", m] => profileCheck sy rom (lr m)
  | ["fast-check-neg"] => do
    -- reachable bounds: these must be false
    let m0 ← startM sy rom
    IO.println s!"fast accel, 34: {FastAccel.lowerFastCheck sy m0 relaxInputs 34}"
    IO.println s!"TAS fast accel, 31: {FastAccel.lowerFastCheck sy m0 relaxInputsLR 31}"
    return 0
  | ["relax-dom", d] => relaxDom sy rom d.toNat! relaxInputs
  | ["relax-dom", d, m] => relaxDom sy rom d.toNat! (if lr m then relaxInputsLR else relaxInputs)
  | ["relax-reads", d] => relaxReads sy rom d.toNat! relaxInputs
  | ["relax-reads", d, m] => relaxReads sy rom d.toNat! (if lr m then relaxInputsLR else relaxInputs)
  | ["relax-indep", d] => relaxIndep sy rom d.toNat! false relaxInputs
  | ["relax-indep", d, v] => relaxIndep sy rom d.toNat! (v == "pos") relaxInputs
  | ["relax-indep", d, v, m] =>
    relaxIndep sy rom d.toNat! (v == "pos") (if lr m then relaxInputsLR else relaxInputs)
  | _ => IO.println usage; return 2
