/-- play a theorem's witness on the full emulator; print the speed per frame -/
def checkWitness (sy : Syms) (romPath : String) (w : List UInt8) : IO UInt32 := do
  let m0 ← startM sy romPath
  let top := (sy.RunTopSpeed.toNat : Int)
  let mut m := m0
  let mut out := ""
  let mut first : Option Nat := none
  for h : k in [0:w.length] do
    m := runFrame m (smbToPad w[k])
    let v := (PState.read sy m).speedInt
    out := out ++ s!"{v} "
    if first.isNone && v ≥ top then first := some (k + 1)
  IO.println s!"speeds: {out}"
  IO.println s!"top speed first reached after frame {first} of {w.length}"
  return if first == some w.length then 0 else 1

/-! ## The block buffers, the jumpspring and the player's state on the first frames (`OpenMap`, part a) -/

/-- `open-map-check`: the title's check and the walk of `OpenMap`, then real runs from control to the counted frame 33: the block buffers, the jumpspring byte and the
player's state at each frame's start, `OpenMap.MapOK` on each instruction, and what the screen and the vertical bytes do -/
def openMapCheck (sy : Syms) (romPath fm2 : String) (nRuns : Nat := 300) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let ls := text.splitOn "\n"
  let nmA := fun (n : String) => ((PipeTransitionAll.asmValue ls n).getD 0) &&& 0x7FF
  let tnm := TitleStart.namesFrom text
  let tc := TitleStart.ctxOf sy tnm cart 39
  let N := 32
  let bI := OpenMap.bufI sy
  let b1 := bI.take 0xD0
  let b2 := bI.drop 0xD0
  -- the block buffers of m0, by rows
  for (nmB, L) in [("Block_Buffer_1", b1), ("Block_Buffer_2", b2)] do
    IO.println s!"{nmB} of m0:"
    for r in List.range 13 do
      IO.println s!"  row {r}: {(List.range 16).map fun c => m0.ram.get! (L.getD (16 * r + c) 0)}"
  IO.println s!"tiles of m0's buffers: {OpenMap.tilesOf sy m0}"
  flush
  -- the title's check and the walk of one whole frame
  let t0 ← IO.monoMsNow
  let kT ← IO.lazyPure fun _ => OpenMap.titleMapCheck sy tc m0
  let t1 ← IO.monoMsNow
  IO.println s!"the title's check (the buffers of m0, the jumpspring byte 0, the player's state 0 at control): {kT}, {t1 - t0} ms"
  flush
  let okM ← IO.lazyPure fun _ => OpenMap.mapCheck sy m0
  let t2 ← IO.monoMsNow
  IO.println s!"mapCheck {okM}, {t2 - t1} ms (with its search)"
  flush
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut m := powerOn cart 0
  let mut k := 0
  while k < inputs.size && !controllable sy m do
    m := runFrame m inputs[k]!
    k := k + 1
  IO.println s!"the movie at control: buffers as m0 {bI.all fun i => m.ram.get! i == m0.ram.get! i}"
  let pz := CtrlKeep.pauseI sy m0
  let apI := nmA "AreaParserTaskNum"
  let s32I := nmA "ScrollThirtyTwo"
  let slI := nmA "ScreenLeft_X_Pos"
  let hpI := (sy.Player_Y_HighPos &&& 0x7FF).toNat
  let vI := [sy.Player_Y_Position, sy.Player_Y_MoveForce, sy.Player_Y_Speed, sy.Player_YMF_Dummy, sy.Player_Y_HighPos, sy.VerticalForce, sy.VerticalForceDown,
    sy.JumpOrigin_Y_Position, sy.DiffToHaltJump].map fun a => (a &&& 0x7FF).toNat
  IO.println s!"at control (movie): parser {m.ram.get! apI}, scroll32 {m.ram.get! s32I}, screen left {m.ram.get! slI}, vertical {vI.map fun i => m.ram.get! i}"
  IO.println s!"m0: parser {m0.ram.get! apI}, scroll32 {m0.ram.get! s32I}, screen left {m0.ram.get! slI}, vertical {vI.map fun i => m0.ram.get! i}"
  -- the runs: own inputs (the styles of `open-real-check`), the movie, and pauses on the first frames then the movie's inputs
  let mut z : UInt64 := 91283
  let mut runs : Array (Nat → UInt8) := #[]
  for q in List.range nRuns do
    let style := q % 7
    let mut pads : Array UInt8 := #[]
    for _ in List.range (8 * (N + 100)) do
      z := z ^^^ (z <<< 13)
      z := z ^^^ (z >>> 7)
      z := z ^^^ (z <<< 17)
      let w := ((z >>> 11) &&& 63).toNat
      let bits := ((z >>> 20) &&& 0xFF).toUInt8
      let i : UInt8 := match style with
        | 0 => if w < 2 then 0x10 else if w < 36 then 0x41 else if w < 46 then 0xC1 else if w < 52 then 0x04 else bits &&& 0xEF
        | 1 => if w < 3 then 0x10 else if w < 30 then 0x41 else if w < 40 then 0x81 else if w < 48 then 0x42 else bits
        | 2 => if w < 20 then 0x01 else if w < 40 then 0xC1 else if w < 50 then 0x82 else bits &&& 0xEF
        | 3 => bits
        | 4 => if w < 8 then 0x02 else if w < 40 then 0x42 else 0xC2
        | 6 => if pads.size == 0 then 0xC2 else 0x42
        | _ => if w < 3 then 0x18 else if w < 32 then 0x81 else if w < 48 then 0x01 else 0x43
      pads := pads.push i
    runs := runs.push fun r => pads.getD r 0
  let k0 := k
  runs := runs.push fun r => smbToPad (inputs.getD (k0 + r) 0)
  for q in List.range 60 do
    let p := q % 4
    let L := 43 + (q * 7) % 40
    runs := runs.push fun r =>
      if r < p then smbToPad (inputs.getD (k0 + r) 0)
      else if r == p then 0x10
      else if r ≤ p + L then (if q % 3 == 0 then 0x41 else 0)
      else if r == p + L + 1 then 0x10
      else smbToPad (inputs.getD (k0 + r - L - 2) 0)
  -- the bytes of `OpenMap.keepI` and of the buffers, as masks
  let kmask := (OpenMap.keepI sy m0).foldl (fun a b => a.set! b 1) (ByteArray.mk (Array.replicate 2048 0))
  let bmask := (OpenMap.bufI1 sy).foldl (fun a b => a.set! b 1) (ByteArray.mk (Array.replicate 2048 0))
  let rdPc := (OpenMap.rdOf sy m0).pc
  let mut frames := 0
  let mut bufBad := 0
  let mut stBad := 0
  let mut parser := 0
  let mut scroll := 0
  let mut highBad := 0
  let mut groundV : List (List UInt8) := []
  let mut groundBad := 0
  let mut maxX : Nat := 0
  let mut outs := 0
  let mut ins := 0
  let mut insPause := 0
  let mut insSpare := 0
  let mut insMap := 0
  let mut reads := 0
  for inp in runs do
    let mut x := m
    let mut cnt := 0
    let mut r := 0
    while cnt ≤ N && r < 8 * (N + 100) do
      if !controllable sy x then
        outs := outs + 1
        break
      frames := frames + 1
      if !(bI.all fun i => x.ram.get! i == m0.ram.get! i) then bufBad := bufBad + 1
      if peek x sy.Player_State > 2 || peek x sy.JumpspringAnimCtrl != 0 then stBad := stBad + 1
      if x.ram.get! apI != 0 then parser := parser + 1
      if x.ram.get! slI != m0.ram.get! slI || x.ram.get! s32I != m0.ram.get! s32I then scroll := scroll + 1
      if x.ram.get! hpI != 1 then highBad := highBad + 1
      maxX := max maxX (x.ram.get! ((sy.Player_X_Position &&& 0x7FF).toNat)).toNat
      if peek x sy.Player_State == 0 then
        let v := vI.map fun i => x.ram.get! i
        if !groundV.contains v then groundV := v :: groundV
        if !(peek x sy.Player_Y_Position == peek m0 sy.Player_Y_Position && peek x sy.Player_Y_HighPos == 1 && peek x sy.Player_Y_Speed == 0 &&
            peek x sy.Player_Y_MoveForce == 0) then groundBad := groundBad + 1
      -- each instruction of the frame: `MapOK`, and stores through an index or a pointer to the pause byte and to the bytes of spareI
      let tf := x.frame + 1
      let mut c : Machine := { x with pad := smbToPad (inp r) }
      let mut n := 0
      while n < fuelPerFrame && !(decide (c.frame ≥ tf) || c.halted) do
        match PipeWrites.wTarget (PipeWrites.opAt c) c with
        | some a =>
          if a < 0x2000 then
            let ai := (a &&& 0x7FF).toNat
            if ai == pz then insPause := insPause + 1
            if (CtrlKeep.spareI sy m0).contains ai then insSpare := insSpare + 1
            if kmask.get! ai != 0 then insMap := insMap + 1
        | none => pure ()
        if c.pc == rdPc then
          reads := reads + 1
          let ad := ScreenPage.readAddr c
          if !(ad < 0x2000 && bmask.get! (ad &&& 0x7FF).toNat != 0) then insMap := insMap + 1
        c := PipeEntryRule.nxt tf c
        n := n + 1
        ins := ins + 1
      let y := PipeTransition.frame x (inp r)
      if y.ram.get! pz &&& 1 == 0 then cnt := cnt + 1
      x := y
      r := r + 1
  IO.println s!"runs {runs.size} (own {nRuns}, the movie, 60 with a pause on the first frames), frames {frames}, runs out of control {outs}: buffers not m0's {bufBad}, state above 2 or jumpspring not 0 {stBad}, parser running {parser}, screen moved {scroll}, high byte not 1 {highBad}, max x {maxX}"
  IO.println s!"instructions {ins}: not MapOK {insMap}; reads of the block buffer routine {reads}; a store through an index or a pointer to the pause byte {insPause}, to the bytes of spareI {insSpare}"
  IO.println s!"vertical bytes at the start of a frame on the ground (y, mf, vy, dummy, high, vf, vfd, origin, dthj): {groundV.length} kinds; not OpenFlat.GroundAt {groundBad}"
  for v in groundV.take 20 do IO.println s!"  {v}"
  let bad := bufBad + stBad + insMap + outs + groundBad + (if kT && okM then 0 else 1)
  IO.println s!"bad {bad}"
  return if bad == 0 then 0 else 1

/-- where the walk of `OpenMap` makes the player's state 3 or the jumpspring byte not 0: no part of the proof -/
partial def openMapWhy (sy : Syms) (m0 : Machine) : List (Nat × String) := Id.run do
  let R := OpenMap.rdOf sy m0
  let G := OpenMap.guardM sy m0
  let W := OpenMap.mapW sy m0
  let E := PipeEntryRule.envOf m0
  let ops := (TaintRun.aRows E).toArray
  let key := OpenMap.keyM sy G
  let st := OpenMap.startsM G W (OpenMap.stI sy)
  let mut X : PipeWrites.SG := st.foldl (OpenMap.routeT (OpenMap.inColl sy) OpenMap.tempsC StartRun.noSpot G key) {}
  let mut seen : Std.HashMap Nat String := {}
  let sI := OpenMap.stI sy
  let jI := OpenMap.jI sy
  while true do
    match X.pending.minEntry? with
    | none => break
    | some (k, A0) =>
      X := { X with pending := X.pending.erase k }
      let mut cur := A0
      let mut run := 0
      while true do
        let rs := (FrameKeep.preK StartRun.noSpot G cur).flatMap (OpenMap.tstep R StartRun.noSpot G E ops)
        for r in rs do
          match r with
          | some B =>
            let b := B.getK sI
            let a := cur.getK sI
            if b.isK && b.v == 3 && !(a.isK && a.v == 3) then seen := seen.insert cur.pc.toNat s!"state 3 (before {a.v &&& a.k}/{a.k})"
            let j := B.getK jI
            let i := cur.getK jI
            if !(j.isK && j.v == 0) && (i.isK && i.v == 0) then seen := seen.insert cur.pc.toNat s!"jumpspring {j.v &&& j.k}/{j.k}"
          | none => pure ()
        let good := (rs.filterMap id).filter fun b => b.k == cur.k
        match good with
        | [b] =>
          if (X.leaders[b.pc.toNat]?).isNone && run < 64 && b.pc != G.je && b.pc != R.pc &&
              (b.pc.toNat == cur.pc.toNat + 1 || b.pc.toNat == cur.pc.toNat + 2 || b.pc.toNat == cur.pc.toNat + 3) then
            cur := b
            run := run + 1
            continue
          else pure ()
        | _ => pure ()
        for b in good do
          X := { X with leaders := X.leaders.insert b.pc.toNat () }
          X := OpenMap.routeT (OpenMap.inColl sy) OpenMap.tempsC StartRun.noSpot G key X b
        break
  return seen.toList

/-- `open-map-walk`: the walk of one whole frame of the first frames with the tiles of the block buffers (`OpenMap.mapCheck`): the search, its failures, and the check -/
def openMapWalk (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let R := OpenMap.rdOf sy m0
  IO.println s!"the read at {R.pc} (opcode {romByte m0 R.pc}), tiles {R.tl}"
  let G := OpenMap.guardM sy m0
  let W := OpenMap.mapW sy m0
  let st := OpenMap.startsM G W (OpenMap.stI sy)
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => OpenMap.searchT R (OpenMap.inColl sy) OpenMap.tempsC StartRun.noSpot G (PipeEntryRule.envOf m0) W (OpenMap.keyM sy G)
    (TaintRun.aRows (PipeEntryRule.envOf m0)).toArray (OpenMap.finM sy) (st.foldl (OpenMap.routeT (OpenMap.inColl sy) OpenMap.tempsC StartRun.noSpot G (OpenMap.keyM sy G)) {})
  let t1 ← IO.monoMsNow
  IO.println s!"the search: {X.steps} steps, {X.forks} forks, {X.fails} failures, table {X.multi.size}, {t1 - t0} ms; fails at {X.failPcs.toList.take 20}"
  match X.firstFail with
  | some A =>
    let b := A.getK (OpenMap.stI sy)
    let j := A.getK (OpenMap.jI sy)
    IO.println s!"  first failing state: pc {A.pc}, state {b.v &&& b.k}/{b.k}, jumpspring {j.v &&& j.k}/{j.k}, known buffers {R.known A}"
  | none => pure ()
  flush
  if X.fails > 0 then
    for (pc, w) in openMapWhy sy m0 do IO.println s!"  at pc {pc}: {w}"
  let ok ← IO.lazyPure fun _ => OpenMap.mapCheck sy m0
  let t2 ← IO.monoMsNow
  IO.println s!"mapCheck {ok}, {t2 - t1} ms (with its search)"
  return if ok then 0 else 1

/-- `open-flat-check`: the walks of a frame on the ground of the opening (`OpenFlat`): the search up to the return of the collision routine and the states there, the
search and the check of the walk after it, and the whole check `OpenFlat.flatCheck` -/
def openFlatCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let R := OpenFlat.rdOf sy m0
  let Q := OpenFlat.collRet sy m0
  IO.println s!"the read at {R.pc} (opcode {romByte m0 R.pc}), the ADC of the buffer's address at {R.adc} (opcode {romByte m0 R.adc}), the first buffer at {R.lo}, its tiles {OpenFlat.tilesAll R}"
  IO.println s!"the return of the collision routine at {Q} (the call before it: {romByte m0 (Q - 3)} {romByte m0 (Q - 2)} {romByte m0 (Q - 1)}, PlayerBGCollision {sy.PlayerBGCollision})"
  let v : UInt8 := peek m0 sy.AreaType
  let t1 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => OpenFlat.searchB sy m0 v
  let t2 ← IO.monoMsNow
  let sI := OpenFlat.I sy.Player_State
  let qBad := X.2.toList.filter fun B => !((B.getK sI).isK && (B.getK sI).v == 0)
  IO.println s!"the search up to the return: {X.1.steps} steps, {X.1.forks} forks, {X.1.fails} failures, table {X.1.multi.size}, states at the return {X.2.size} (the state not 0: {qBad.length}), {t2 - t1} ms"
  (← IO.getStdout).flush
  let CC := OpenFlat.cfgCOf sy m0 v X
  let okC ← IO.lazyPure fun _ => CC.t.all (FrameKeep.walkK CC FrameKeep.fuelK) && X.2.toList.all (FrameKeep.walkK CC FrameKeep.fuelK)
  let t3 ← IO.monoMsNow
  IO.println s!"the walk after the return: table {CC.t.size}, the check {okC}, {t3 - t2} ms (with its search)"
  (← IO.getStdout).flush
  let okF ← IO.lazyPure fun _ => OpenFlat.flatCheck sy m0 v
  let t4 ← IO.monoMsNow
  IO.println s!"OpenFlat.flatCheck: {okF}, {t4 - t3} ms"
  return if X.1.fails == 0 && qBad.isEmpty && okC && okF then 0 else 1

/-- `open-ground-exp`: the four vertical bytes of `m0` and the title's check that asks them at control; with `EXP_ALL=1`, the search after the return of the collision
routine on a frame on the ground that keeps the four bytes, its ends, and the instructions that lose them: why `OpenFrames.Real.afterV` is assumed (no part of the proof) -/
def openGroundExp (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let v : UInt8 := peek m0 sy.AreaType
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let tc := TitleStart.ctxOf sy (TitleStart.namesFrom text) (← loadCart romPath) 39
  IO.println s!"m0: y {peek m0 sy.Player_Y_Position} hi {peek m0 sy.Player_Y_HighPos} vy {peek m0 sy.Player_Y_Speed} mf {peek m0 sy.Player_Y_MoveForce}; GroundAt m0 m0 {decide (OpenFlat.GroundAt sy m0 m0)}"
  let okP ← IO.lazyPure fun _ => StartRun.titlePosCheck sy tc m0
  IO.println s!"titlePosCheck {okP}"
  (← IO.getStdout).flush
  if (← IO.getEnv "EXP_ALL").isNone then return 0
  let X := OpenFlat.searchB sy m0 v
  let I := OpenFlat.I
  let sh := fun (B : TaintRun.AS) (a : UInt16) => let b := B.getK (I a); s!"{b.v &&& b.k}/{b.k}"
  for B in X.2 do
    IO.println s!"Q: st {sh B sy.Player_State} y {sh B sy.Player_Y_Position} hi {sh B sy.Player_Y_HighPos} vy {sh B sy.Player_Y_Speed} mf {sh B sy.Player_Y_MoveForce} x {B.x.v}/{B.x.k}"
  let S := FrameKeep.spotOf sy m0
  let G := OpenFlat.guardQ sy m0
  let W := OpenFlat.watchF sy m0 v
  let E := PipeEntryRule.envOf m0
  let ops := (TaintRun.aRows E).toArray
  let vI := [I sy.Player_Y_Position, I sy.Player_Y_HighPos, I sy.Player_Y_Speed, I sy.Player_Y_MoveForce]
  let num := fun (b : TaintRun.AB) => b.k.toNat * 256 + (b.v &&& b.k).toNat
  let key := fun (A : TaintRun.AS) => vI.foldl (fun n i => n * 65536 + num (A.getK i)) (FrameKeep.keyK S G W A)
  let y0 := peek m0 sy.Player_Y_Position
  let gOK := fun (B : TaintRun.AS) => FrameKeep.watchOK (OpenFlat.groundW sy y0) B
  let t1 ← IO.monoMsNow
  let Y := OpenFlat.searchKF vI S G E W key ops (OpenFlat.finF sy) (X.2.toList.foldl (OpenFlat.routeF (fun _ => false) [] vI S G key) {})
  let t2 ← IO.monoMsNow
  IO.println s!"search C': {Y.1.steps} steps, {Y.1.fails} failures, table {Y.1.multi.size}, done {Y.1.done.size}, ends {Y.2.size}, {t2 - t1} ms"
  let sI := I sy.Player_State
  let ends0 := Y.2.toList.filter fun B => (B.getK sI).isK && (B.getK sI).v == 0
  let endsBad := ends0.filter fun B => !gOK B
  IO.println s!"ends with the state known 0: {ends0.length}; of these not ground: {endsBad.length}"
  for B in endsBad.take 10 do
    IO.println s!"  bad end: y {sh B sy.Player_Y_Position} hi {sh B sy.Player_Y_HighPos} vy {sh B sy.Player_Y_Speed} mf {sh B sy.Player_Y_MoveForce} eng {sh B sy.GameEngineSubroutine}"
  -- where the table loses the vertical bytes, while the state is 0
  let lost := Y.1.done.toList.filterMap fun (_, (A, _)) => if (A.getK sI).isK && (A.getK sI).v == 0 && !gOK A then some A.pc.toNat else none
  let kept := Y.1.done.toList.filterMap fun (_, (A, _)) => if gOK A then some A.pc.toNat else none
  let lostS := (lost.toArray.qsort (· < ·)).toList.eraseDups
  IO.println s!"table states with the state 0 and not ground: {lost.length} at {lostS.length} pcs; ground kept: {kept.length}"
  IO.println s!"  lowest pcs: {lostS.take 40}"
  let keptS := (kept.toArray.qsort (· < ·)).toList.eraseDups
  IO.println s!"  kept pcs (first 40): {keptS.take 40}"
  -- the steps that lose them
  let mut loss : Std.HashMap Nat Nat := {}
  for (_, (A, _)) in Y.1.done.toList do
    if gOK A then
      let rs := (FrameKeep.preK S G A).flatMap (FrameKeep.kstep S G E ops)
      for r in rs do
        match r with
        | some B => if B.k == A.k && !gOK B then loss := loss.insert A.pc.toNat (loss.getD A.pc.toNat 0 + 1)
        | none => pure ()
  IO.println s!"steps from a table state on the ground to one not: {loss.toList.length} pcs"
  for (pc, c) in (loss.toList.toArray.qsort (fun a b => a.1 < b.1)).toList do
    IO.println s!"  pc {pc} (op {romByte m0 pc.toUInt16} {romByte m0 (pc.toUInt16 + 1)} {romByte m0 (pc.toUInt16 + 2)}): {c}"
  return 0

/-- `open-jump-check`: the jumps of the opening's vertical model (`OpenJump`): the takeoff states, the layers of the search, the frames that break `arcOK`, and the check -/
def openJumpCheckCmd (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let S := FrameModel.ctrlStack sy m0
  let y0 := peek m0 sy.Player_Y_Position
  let d := sy.LandDepth.toUInt8
  let lens := Opening.jumpLens sy m0
  IO.println s!"the ground's height {y0}, the window {d}, the stack pointer {S}; lengths {lens.toList.eraseDups}"
  let st0 := OpenJump.arcStart sy m0 S y0 lens
  IO.println s!"takeoff states: {st0.length}"
  for x in st0 do
    IO.println s!"  y {x.s.y} vy {x.s.vy} mf {x.s.mf} vf {x.s.vf} vfd {x.s.vfd} st {x.s.st} lengths ({x.lo}, {x.hi})"
  let mut L := st0
  let mut total := L.length
  let mut bad : List OpenJump.Arc := L.filter fun x => !OpenJump.arcOK y0 d x
  let mut lands : List (Nat × Nat × Nat) := []
  let mut minY : Nat := 255
  for _ in [0:OpenJump.arcDepth] do
    L := Cert.nextS (OpenJump.arcSucc sy m0 S y0) L
    total := total + L.length
    bad := bad ++ L.filter fun x => !OpenJump.arcOK y0 d x
    for x in L do
      if x.s.st == 0 then lands := (x.lo, x.hi, x.k) :: lands
      else minY := min minY x.s.y.toNat
  IO.println s!"arc states {total}, the highest point {minY}, frames that break arcOK {bad.length}"
  for x in bad.take 8 do
    IO.println s!"  bad: k {x.k} y {x.s.y} vy {x.s.vy} st {x.s.st} pre {x.pre} lengths ({x.lo}, {x.hi})"
  for (lo, hi) in (lands.map fun p => (p.1, p.2.1)).eraseDups do
    let ks := (lands.filter fun p => p.1 == lo && p.2.1 == hi).map (·.2.2)
    IO.println s!"  lengths ({lo}, {hi}): landings from {ks.foldl min 1000} to {ks.foldl max 0} frames"
  let t1 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => OpenJump.openJumpCheck sy m0
  let t2 ← IO.monoMsNow
  IO.println s!"OpenJump.openJumpCheck: {ok}, {t2 - t1} ms"
  return if ok then 0 else 1

/-- `open-air-search`: the walk of a frame of the opening in the air or at a takeoff (`OpenAir`): its search, the failures, the table and the check
(no part of the proof) -/
def openAirSearch (sy : Syms) (romPath : String) (which : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let v : UInt8 := peek m0 sy.AreaType
  let I := OpenAir.I
  let sh := fun (A : TaintRun.AS) (a : UInt16) => let b := A.getK (I a); s!"{b.v &&& b.k}/{b.k}"
  let K := OpenAir.ctxOf sy m0 v
  let cuts := OpenAir.cutsA sy m0
  let all := cuts.flatMap (OpenAir.startsA sy K v)
  let starts := if which == "air" then all.filter (·.log == []) else if which == "take8" then all.filter (·.log == [8])
    else if which == "take" then all.filter (·.log.head? == some 5) else if which == "take1" then all.filter (·.log == [5, 20]) else all
  IO.println s!"cuts {cuts.length}, starts {all.length} (searched {starts.length}), Q {sy.PlayerSubs}, the return {K.cR}, the routine {K.cE}, its flag {K.dI}"
  (← IO.getStdout).flush
  let t1 ← IO.monoMsNow
  let E := PipeEntryRule.envOf m0
  let ops := (TaintRun.aRows E).toArray
  let Z := OpenAir.phA sy K (OpenAir.expT sy m0) E
  let mut X : PipeWrites.SG := if which == "vert" then {} else starts.foldl (OpenAir.routeA sy K) {}
  let lim := ((← IO.getEnv "AIR_LIM").getD "10000000").toNat!
  let mut it := 0
  while it < lim do
    match X.pending.minEntry? with
    | none => break
    | some (k, A) =>
      X := { X with pending := X.pending.erase k }
      X := OpenWalk.runP K.R Z (OpenAir.routeA sy K) K.S K.G E K.W ops OpenAir.finA X A
      it := it + 1
      if it % 20000 == 0 then
        IO.println s!"  it {it}: pending {X.pending.size} done {X.done.size} multi {X.multi.size} steps {X.steps} fails {X.fails}; at pc {A.pc} log {A.log}"
        (← IO.getStdout).flush
  let t2 ← IO.monoMsNow
  IO.println s!"search: {it} iterations, {X.steps} steps, {X.forks} forks, {X.fails} failures, table {X.multi.size}, done {X.done.size}, {t2 - t1} ms"
  IO.println s!"failing pcs {(X.failPcs.toList.toArray.qsort (fun a b => a.1 < b.1)).toList.take 30}"
  match X.firstFail with
  | some A => IO.println s!"first failure: pc {A.pc} log {A.log} y {sh A sy.Player_Y_Position} hi {sh A sy.Player_Y_HighPos} vy {sh A sy.Player_Y_Speed} mf {sh A sy.Player_Y_MoveForce} st {sh A sy.Player_State} dthj {sh A sy.DiffToHaltJump} ab {sh A sy.A_B_Buttons} dummy {sh A sy.Player_YMF_Dummy} vf {sh A sy.VerticalForce} vfd {sh A sy.VerticalForceDown} org {sh A sy.JumpOrigin_Y_Position}"
  | none => pure ()
  let fl := X.done.toList.filterMap fun (_, (A, _)) => if (OpenAir.Phase.bad == OpenAir.decode A.log) then some A else none
  IO.println s!"failed states in the table: {fl.length}"
  let logs := (X.done.toList.map fun (_, (A, _)) => A.log).eraseDups
  IO.println s!"phases in the search: {logs.take 40}"
  (← IO.getStdout).flush
  if which == "vert" then
    let S := FrameModel.ctrlStack sy m0
    let Er := FrameModel.Rom.of m0
    IO.println s!"  vertAirOK {VertAir.vertAirOK sy m0 S}; prefixes {VertModel.pCases.all (OpenVert.prefixOKH sy Er S)}; cases {VertAir.vCasesA.all (OpenVert.caseOKH sy m0 S)}; last {OpenVert.lastOKH sy Er S}; vmach hi {(VertModel.vmach sy m0 S).ram.get! (OpenAir.I sy.Player_Y_HighPos)}; in vIdx {(VertModel.vIdx sy).contains (OpenAir.I sy.Player_Y_HighPos)}"
    for c in VertAir.vCasesA do
      if !OpenVert.caseOKH sy m0 S c then
        IO.println s!"  case st {c.st} ab {c.ab} prevA {c.prevA}: tags {FrameModel.tagsOK S (OpenVert.vTagsH sy (VertModel.vmach sy m0 S) c)}"
    return 0
  if which != "all" then return (if X.fails == 0 then 0 else 1)
  let C := OpenAir.cfgAOf sy m0 K X
  let ok ← IO.lazyPure fun _ => OpenAir.airCheckWith sy m0 K v C
  let t3 ← IO.monoMsNow
  IO.println s!"the table {C.t.size}; OpenAir.airCheck: {ok}, {t3 - t2} ms"
  (← IO.getStdout).flush
  let okD ← IO.lazyPure fun _ => CtrlKeep.ctrlCheck1 (CtrlKeep.cfgOf sy m0 (CtrlKeep.cutTable sy m0 false) (OpenMap.dcdI sy m0) false)
  let t4 ← IO.monoMsNow
  let okY := decide ((peek m0 sy.Player_Y_Position).toNat + sy.LandDepth.toUInt8.toNat < 256)
  let I := OpenAir.I
  let okI := decide (I sy.Player_Y_Position ≠ I sy.Player_Y_HighPos ∧ I sy.Player_Y_Position ≠ I sy.Player_Y_Speed ∧ I sy.Player_Y_HighPos ≠ I sy.Player_Y_Speed ∧
    I sy.Player_Y_Speed ≠ I sy.Player_State ∧ I sy.Player_Y_Position ≠ I sy.Player_State ∧ I sy.Player_Y_HighPos ≠ I sy.Player_State)
  IO.println s!"the walk of the flag to the player's routine: {okD}, {t4 - t3} ms; the height and LandDepth in a byte {okY}; the bytes distinct {okI}"
  (← IO.getStdout).flush
  let okV ← IO.lazyPure fun _ => OpenVert.vertAirHOK sy m0 (FrameModel.ctrlStack sy m0)
  let t5 ← IO.monoMsNow
  IO.println s!"OpenVert.vertAirHOK: {okV}, {t5 - t4} ms; PrevOK m0 {PrevKeep.prevOKB sy m0}"
  let S := FrameModel.ctrlStack sy m0
  let Er := FrameModel.Rom.of m0
  IO.println s!"  vertAirOK {VertAir.vertAirOK sy m0 S}; prefixes {VertModel.pCases.all (OpenVert.prefixOKH sy Er S)}; cases {VertAir.vCasesA.all (OpenVert.caseOKH sy m0 S)}; last {OpenVert.lastOKH sy Er S}; vmach hi {(VertModel.vmach sy m0 S).ram.get! (OpenAir.I sy.Player_Y_HighPos)}; in vIdx {(VertModel.vIdx sy).contains (OpenAir.I sy.Player_Y_HighPos)}"
  for c in VertAir.vCasesA do
    if !OpenVert.caseOKH sy m0 S c then
      IO.println s!"  case st {c.st} ab {c.ab} prevA {c.prevA}: tags {FrameModel.tagsOK S (OpenVert.vTagsH sy (VertModel.vmach sy m0 S) c)}"
  return if ok && okD && okY && okI && okV then 0 else 1

/-! ## Round 21 (part d, 1-1-d-2-5-4-3): measuring the big player's head call in the entering frame's walk. No part of a proof. -/

/-- the band split of a byte: its bits from the top, as long as the piece meets the values `lo .. lo + n − 1` -/
def diagMeets (lo n : Nat) (b : TaintRun.AB) : Bool := (List.range n).any fun j => ((lo + j).toUInt8 &&& b.k) == (b.v &&& b.k)

def diagBand (d lo n : Nat) : List UInt8 → TaintRun.AS → List TaintRun.AS
  | [], A => [A]
  | b :: bs, A => if diagMeets lo n (A.getK d) then (TaintRun.splitBit d b A).flatMap (diagBand d lo n bs) else [A]

structure DiagB where
  headAt : UInt16
  xI : Nat
  pgI : Nat
  pageAdc : UInt16
  lo : Nat
  n : Nat
  map : Machine
  coins : List UInt8
  xsplit : Bool
  pgsplit : Bool
  refine : Bool
  solid : Bool
  landCmp : UInt16
  landSplit : Bool
  bandAt : UInt16
  szAt : UInt16
  szI : Nat
  szSplit : Bool
  carry1 : Bool

def diagPre (S : EntryHeight.HP) (D : DiagB) (A : TaintRun.AS) : List TaintRun.AS :=
  let L := EntryHeight.preY S A
  L.flatMap fun B =>
    if B.pc == D.bandAt then diagBand S.yI D.lo D.n [128, 64, 32, 16, 8, 4, 2, 1] B
    else if D.szSplit && B.pc == D.szAt then diagBand D.szI 0 2 [128, 64, 32, 16, 8, 4, 2, 1] B
    else if B.pc == D.headAt then
      let y := B.getK S.yI
      if y.isK && D.lo ≤ y.v.toNat && y.v.toNat < D.lo + D.n then
        let xs := if D.xsplit then PipeEntryRule.splitAll D.xI B else [B]
        if D.pgsplit then xs.flatMap (TaintRun.splitBit D.pgI 1) else xs
      else [B]
    else if D.landSplit && B.pc == D.landCmp then
      (((PipeChangeEnd.bitY 8 B).flatMap (PipeChangeEnd.bitY 4)).flatMap (PipeChangeEnd.bitY 2)).flatMap (PipeChangeEnd.bitY 1)
    else [B]

def diagStep (S : EntryHeight.HP) (D : DiagB) (E : TaintRun.Env) (ops : Array (TaintRun.AM Unit)) (A : TaintRun.AS) : List (Option TaintRun.AS) :=
  let P := S.P
  if D.refine && !A.nmi && A.pc == D.pageAdc then
    let c := A.p.and (TaintRun.AB.known 1)
    (TaintRun.succs E ops A).map fun r => r.map fun B =>
      if c.isK && c.v == 0 then { B with a := A.a }
      else if D.carry1 && c.isK && (A.a.k &&& 1) == 1 then { B with a := ⟨(A.a.v ^^^ 1) &&& 1, 1⟩ }
      else B
  else if D.solid && !A.nmi && A.pc == P.read && !ScreenPage.ptrNotKnown E A && A.y.isK then
    let z := E.prg.get! ((A.pc + 1) &&& E.mask).toNat
    let ptr : UInt16 := (A.getK z.toNat).v.toUInt16 ||| ((A.getK (z + 1).toNat).v.toUInt16 <<< 8)
    let ad := ptr + A.y.v.toUInt16
    let d := (ad &&& 0x7FF).toNat
    if ad < 0x2000 && P.bufLo ≤ d && d < P.bufLo + P.bufN && !D.coins.contains (D.map.ram.get! d) then
      let v := D.map.ram.get! d
      if (ScreenPage.tilesFor P A).contains v then [ScreenPage.readStep E (TaintRun.AB.known v) A] else []
    else TaintRun.succs E ops A
  else EntryHeight.stepY P E ops A

def diagNorm (S : EntryHeight.HP) (Z : ScreenPage.Aids) (D : DiagB) (A : TaintRun.AS) : TaintRun.AS :=
  let B := EntryHeight.normY S Z A
  if A.pc == Z.colEnd && !SideEntryEnd.isV S.ev (B.getK S.rtI) && D.xsplit then (B.setK D.xI TaintRun.AB.top).setK D.pgI TaintRun.AB.top else B

partial def diagRun (S : EntryHeight.HP) (D : DiagB) (Z : ScreenPage.Aids) (O : EntryHeight.Opts) (fin : TaintRun.AS → Bool) (E : TaintRun.Env) (ops : Array (TaintRun.AM Unit))
    (X0 : ScreenPage.SearchS) (A0 : TaintRun.AS) : ScreenPage.SearchS := Id.run do
  let mut X := X0
  let mut cur := A0
  let mut run := 0
  while true do
    let rs := (diagPre S D (ScreenPage.clampS S.P cur)).flatMap (diagStep S D E ops)
    X := { X with steps := X.steps + rs.length, forks := X.forks + (rs.length - 1) }
    let bad := rs.any fun r => match r with
      | none => true
      | some B => B.k != cur.k && !fin B
    if bad then
      X := { X with fails := X.fails + 1, firstFail := X.firstFail <|> some cur }
    let good := rs.filterMap id
    match good with
    | [b] =>
      if b.k == cur.k && (X.leaders[b.pc.toNat]?).isNone && run < 256 && (O.norm b).pc == b.pc && !Z.cutAY.contains b.pc && !Z.cutX.contains b.pc && !Z.regs.contains b.pc && !Z.ends.contains b.pc && b.pc != Z.colEnd &&
          !O.stops.contains b.pc && (b.pc.toNat == cur.pc.toNat + 1 || b.pc.toNat == cur.pc.toNat + 2 || b.pc.toNat == cur.pc.toNat + 3) then
        cur := b
        run := run + 1
        continue
      else pure ()
    | _ => pure ()
    for b in good do
      if b.k != cur.k then X := { X with ends := X.ends.push b }
      else
        X := { X with leaders := X.leaders.insert b.pc.toNat () }
        X := EntryHeight.routeY S.P O X b
    break
  return X

partial def diagSearch (S : EntryHeight.HP) (D : DiagB) (Z : ScreenPage.Aids) (O : EntryHeight.Opts) (fin : TaintRun.AS → Bool) (E : TaintRun.Env) (ops : Array (TaintRun.AM Unit))
    (X0 : ScreenPage.SearchS) (limit : Nat) : ScreenPage.SearchS := Id.run do
  let mut X := X0
  let mut c := 0
  while true do
    if c ≥ limit then break
    c := c + 1
    match X.pending.minEntry? with
    | none => break
    | some (q, A) =>
      let K := O.key A
      X := { X with pending := X.pending.erase q, pendKey := X.pendKey.erase K }
      X := diagRun S D Z O fin E ops X A
  return X


def entryHeadDiag (sy : Syms) (romPath : String) (mode : String) (limit : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let S := EntryHeight.hpOf sy nmS m0
  let Z := EntryHeight.aidsY sy nmS m0
  let E := ScreenPage.envR sy nmS m0
  let r := ScreenPage.refR m0
  let szI := EntryHeight.sizeI sy
  let rBig : Machine := { r with ram := r.ram.set! szI 0 }
  let P := S.P
  if mode == "check" then
    -- the walk of `EntryHeightBig` (a big player): its search, and its check as the private proof runs it
    let DB := EntryHeightBig.hbOf sy nmS m0
    let OB := EntryHeightBig.optsB DB Z E
    let t0 ← IO.monoMsNow
    let XB ← IO.lazyPure fun _ => EntryHeightBig.searchOfB DB Z OB (EntryHeight.finY S) E (EntryHeightBig.refB sy m0) (EntryHeight.knownY sy nmS m0)
    let t1 ← IO.monoMsNow
    let evB := XB.ends.toList.filter fun B => SideEntryEnd.isV S.ev (B.getK S.rtI)
    IO.println s!"EntryHeightBig's walk: {XB.steps} steps, {XB.forks} forks, {XB.fails} failures, states {XB.done.size}, joins {XB.joins}; frame ends {XB.ends.size}, with the side pipe's routine {evB.length}, their heights {(evB.map fun B => abS (B.getK S.yI)).eraseDups}; ends that fail {(XB.ends.toList.filter fun B => !EntryHeight.finY S B).length}; search {t1 - t0} ms"
    flush
    let ok ← IO.lazyPure fun _ => EntryHeightBig.checkB sy nmS m0
    IO.println s!"  EntryHeightBig.checkB {ok}, {(← IO.monoMsNow) - t1} ms"
    return if ok then 0 else 1
  let headAt := sy.BlockBufferCollision - 7
  let pageAdc := PipeEntryRule.findOp m0 sy.BlockBufferCollision 0x69 32
  let landCmp := PipeEntryRule.findOp m0 sy.DoFootCheck 0xC0 128
  IO.println s!"band at {ScreenPage.findOpZ m0 sy.PlayerBGCollision 0xA5 sy.Player_Y_Position.toUInt8 64}; hpAt {S.P.hpAt}; land compare {landCmp}: {(List.range 4).map fun j => hex2 (romByte m0 (landCmp - 2 + j.toUInt16))}; LandDepth {sy.LandDepth}"
  IO.println s!"head entry {headAt}: bytes {(List.range 3).map fun j => hex2 (romByte m0 (headAt + j.toUInt16))}; before {hex2 (romByte m0 (headAt - 1))}; page adc {pageAdc}: {(List.range 4).map fun j => hex2 (romByte m0 (pageAdc - 2 + j.toUInt16))}; colEnd {Z.colEnd}; read {P.read}; heads {P.heads.map hex2}"
  let D : DiagB := DiagB.mk headAt (sy.Player_X_Position &&& 0x7FF).toNat (sy.Player_PageLoc &&& 0x7FF).toNat pageAdc
    (S.yv + 16).toNat sy.LandDepth.toNat (RoomMap.mapRef m0) (RoomBlocks.coinsOf P)
    (mode.contains 'x') (mode.contains 'p') (mode.contains 'r') (mode.contains 's') landCmp (mode.contains 'l')
    (ScreenPage.findOpZ m0 sy.PlayerBGCollision 0xA5 sy.Player_Y_Position.toUInt8 64) sy.PlayerBGCollision szI (mode.contains 'z') (mode.contains 'c')
  let K := if mode.contains 'u' then RoomMap.knownT sy nmS m0 else EntryHeight.knownY sy nmS m0
  let rr := if mode.contains 'm' then r else rBig
  let O := EntryHeight.optsY S Z E
  let O := if mode.contains 'x' then { O with norm := diagNorm S Z D, normAt := O.normAt } else O
  let numB := fun (b : TaintRun.AB) => b.k.toNat * 256 + (b.v &&& b.k).toNat
  let O := if mode.contains 'k' then { O with key := fun A =>
      let K := (O.key A >>> 64) + (numB (A.getK D.xI) * 65536 + numB (A.getK D.pgI)) * (1 <<< 380)
      K * 18446744073709551616 + EntryHeight.mix64 K } else O
  let fin := EntryHeight.finY S
  let ops := (TaintRun.aRows E).toArray
  let t0 ← IO.monoMsNow
  let X0 := (ScreenPage.startsR rr K).foldl (EntryHeight.routeY S.P O) {}
  let X ← IO.lazyPure fun _ => diagSearch S D Z O fin E ops X0 limit
  let t1 ← IO.monoMsNow
  let evEnds := X.ends.toList.filter fun B => SideEntryEnd.isV S.ev (B.getK S.rtI)
  let badEnds := X.ends.toList.filter fun B => !fin B
  IO.println s!"mode {mode}: {X.steps} steps, {X.forks} forks, {X.fails} failures, states {X.done.size}, joins {X.joins}, pending {X.pending.size}; frame ends {X.ends.size}, with the side pipe's routine {evEnds.length}, their heights {(evEnds.map fun B => abS (B.getK S.yI)).eraseDups}; ends that fail {badEnds.length}; search {t1 - t0} ms"
  let hs := X.done.toList.filter fun q => q.2.pc == headAt
  IO.println s!"  states at the head entry: {hs.length}; with the height known {(hs.filter fun q => (q.2.getK S.yI).isK).length}; meeting the band {(hs.filter fun q => diagMeets D.lo D.n (q.2.getK S.yI)).length}; Y regs {(hs.map fun q => abS q.2.y).eraseDups.take 8}; x masks {(hs.map fun q => hex2 (q.2.getK D.xI).k).eraseDups}; page masks {(hs.map fun q => hex2 (q.2.getK D.pgI).k).eraseDups}"
  let cs := X.done.toList.filter fun q => q.2.pc == sy.PlayerBGCollision
  IO.println s!"  states at the collision routine: {cs.length}; height masks {(cs.map fun q => hex2 (q.2.getK S.yI).k).eraseDups}"
  match X.firstFail with
  | some A => IO.println s!"  first failure: pc {A.pc} rt {abS (A.getK S.rtI)} height {abS (A.getK S.yI)} size {abS (A.getK szI)} a {abS A.a} x {abS A.x} y {abS A.y} px {abS (A.getK D.xI)} pg {abS (A.getK D.pgI)}"
  | none => pure ()
  for B in badEnds.take 4 do
    IO.println s!"  a failing end: rt {abS (B.getK S.rtI)} height {abS (B.getK S.yI)} px {abS (B.getK D.xI)} pg {abS (B.getK D.pgI)}"
  return 0


/-! ## Round 22: the player's size through the room (`SizeKeep`, the field `size₁`), on real frames -/

/-- the player's size on real frames: on the movie from power-on (every frame; at the room's first control `b₁`, on every frame of the room, at the start of the
frame that enters the side pipe), on own runs from the movie's frames from control to the vertical pipe (random inputs: the size takes the values of real play),
and on own runs in the room, small and big: every frame of the room keeps the size; the start of an entering frame has it. With `walk` also the two walks
of `SizeKeep` (natively, timed). -/
def sizeKeepCheck (sy : Syms) (romPath fm2 : String) (runs : Nat) (mode : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let r := ScreenPage.refR m0
  let szI := SizeKeep.sizeI sy
  let rs := r.ram.get! szI
  let okS := fun (v : UInt8) => v == rs || v == 0
  let mut okAll := true
  IO.println s!"the reference's size {hex2 rs}; at the start of 1-1 {hex2 (m0.ram.get! szI)}"
  if mode == "walk" then
    for v in [rs, 0] do
      let t0 ← IO.monoMsNow
      let ok ← IO.lazyPure fun _ => SizeKeep.roomCheckS sy nmS m0 v
      IO.println s!"the room's walk with the size {hex2 v}: {ok} ({(← IO.monoMsNow) - t0} ms)"
      flush
      if !ok then okAll := false
    let nm := PipeChangeBound.namesOf txt
    let nx := PipeChangeEnd.namesOf txt
    let e := PipeTransition.entry m0
    let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
    let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
    let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
    let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
    let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
    IO.println s!"the entry's masks: {d.bits.length}, with the size {d.bits.any (·.1 == szI)}"
    let t1 ← IO.monoMsNow
    let rows ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
    let sts := rows.flatMap (·.R)
    let bad := sts.filter fun S => !SizeKeep.rowS sy S
    IO.println s!"the rows of the time of the first change: {rows.length} rows, {sts.length} states, {bad.length} that do not know bits 1 to 7 of the size as 0 ({(← IO.monoMsNow) - t1} ms); sizes known {(sts.map fun S => s!"{hex2 (S.getK szI).v}/{hex2 (S.getK szI).k}").eraseDups.take 8}"
    flush
    let t2 ← IO.monoMsNow
    let okR ← IO.lazyPure fun _ => SizeKeep.rowsCheckS sy nm d e m0
    IO.println s!"rowsCheckS {okR} ({(← IO.monoMsNow) - t2} ms)"
    flush
    if !okR then okAll := false
  let ev := SideEntryRule.vs sy
  let statusA := nmS.ad "PlayerStatus"
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  if mode == "mushroom" then
    -- own runs that take the mushroom before the vertical pipe: the movie's inputs to a frame near the block, then random inputs (right and jumps); on a run whose
    -- size changes, `CleanK` of the guard of `chg.upCleanU` (with the size byte since round 22) on every instruction from control, and the size's bits 1 to 7
    let nx := PipeChangeEnd.namesOf txt
    let e := PipeTransition.entry m0
    let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
    let d := PipeChangeEnd.assemble sy nx m0 (PipeChangeEnd.songTable nx m0 5327) T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
    let gps := SideChangeEnd.adI nx "GamePauseStatus"
    let GE := EntryKeep.guardOf sy m0 d e
    let GP := LagPause.guardP sy m0 gps
    let GF := FrameKeep.guardE sy m0
    let GU := UpClean.guardU sy m0 d e
    let q := UpClean.qOf sy m0
    IO.println s!"the guard of upCleanU protects {GU.prot.eraseDups.length} bytes, the size among them {GU.prot.contains szI}"
    let mut x := powerOn cart 0
    let mut k0 := 0
    for h : k in [0:inputs.size] do
      x := runFrame x inputs[k]
      if controllable sy x then
        k0 := k
        break
    let mut tas : Array Machine := #[x]
    let mut a := x
    for j in [1:368] do
      a := runFrame a inputs[k0 + j]!
      tas := tas.push a
    let posOf := fun (c : Machine) => (peek c sy.Player_PageLoc).toNat * 256 + (peek c sy.Player_X_Position).toNat
    let near := (List.range tas.size).filter fun j => let p := posOf tas[j]!; 200 ≤ p && p ≤ 400
    IO.println s!"the movie's frames from control with the position 200 to 400 px: {near.length} (positions {(near.map fun j => posOf tas[j]!).take 3} ...)"
    let mut z : UInt64 := 4242
    let mut tried := 0
    let mut found := 0
    let mut cnt : UnionCount := {}
    let mut sizesSeen : List UInt8 := []
    let mut bitsBad := 0
    let mut firstHit : Option (Nat × Nat) := none
    for q0 in List.range (runs * 40) do
      if near.isEmpty || found ≥ runs then break
      let j := near[(q0 * 7) % near.length]!
      let mut c := tas[j]!
      let mut suf : Array UInt8 := #[]
      let mut grew := false
      z := z ^^^ (z <<< 13)
      z := z ^^^ (z >>> 7)
      z := z ^^^ (z <<< 17)
      -- a run: walk for `pre` frames in a direction, a jump held for `hold` frames, then right with a jump now and then
      let pre := ((z >>> 5) % 50).toNat
      let dir : UInt8 := match ((z >>> 13) % 3).toNat with | 0 => 0x01 | 1 => 0x02 | _ => 0x00
      let hold := 14 + ((z >>> 17) % 24).toNat
      let jdir : UInt8 := match ((z >>> 23) % 3).toNat with | 0 => 0x01 | 1 => 0x02 | _ => 0x00
      for f in List.range 240 do
        z := z ^^^ (z <<< 13)
        z := z ^^^ (z >>> 7)
        z := z ^^^ (z <<< 17)
        let i : UInt8 := if f < pre then dir else if f < pre + hold then 0x80 ||| jdir else if f < pre + hold + 4 then jdir
          else if ((z >>> 11) &&& 31) == 0 then 0x81 else 0x01
        let pad := smbToPad i
        suf := suf.push pad
        c := runFrame c pad
        if c.ram.get! szI != tas[j]!.ram.get! szI then
          grew := true
          if firstHit.isNone then firstHit := some (j, f)
        if grew && f > 0 && suf.size ≥ 200 then break
        if (peek c sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then break
      tried := tried + 1
      if grew then
        found := found + 1
        -- the whole run from control: the movie's inputs to frame j, then the suffix
        let w := ((List.range j).map fun t => inputs[k0 + 1 + t]!).toArray ++ suf
        cnt := unionRun sy GE GP GF GU q gps x w true cnt
        let mut b := x
        for i in w do
          b := runFrame b i
          let v := b.ram.get! szI
          if !sizesSeen.contains v then sizesSeen := v :: sizesSeen
          if v &&& 0xFE != 0 then bitsBad := bitsBad + 1
    IO.println s!"own runs near the mushroom's block: tried {tried}, the size changed on {found} (first at movie frame {firstHit.map (·.1)} + {firstHit.map (·.2)}); on these runs from control: {cnt.str}; sizes seen {sizesSeen.map hex2}; frames with bits 1 to 7 of the size not 0: {bitsBad}"
    flush
    return (if cnt.badU == 0 && bitsBad == 0 && found > 0 then 0 else 1)
  -- the movie from power-on
  let mut t := powerOn cart 0
  let mut seen := false
  let mut k := 0
  let mut sizes : List UInt8 := []
  let mut partA : Array Machine := #[]
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    sizes := t.ram.get! szI :: sizes
    if seen then partA := partA.push t
    seen := seen || controllable sy t
    k := k + 1
  let kA := k
  while k < inputs.size && !controllable sy t do
    t := runFrame t inputs[k]!
    sizes := t.ram.get! szI :: sizes
    k := k + 1
  let kB := k
  let sB := t.ram.get! szI
  let mut hist : Array Machine := #[t]
  while k < inputs.size && peek t sy.GameEngineSubroutine != ev do
    t := runFrame t inputs[k]!
    hist := hist.push t
    k := k + 1
  let kE := hist.size - 1
  let roomSizes := ((hist.toList.take kE).map fun c => c.ram.get! szI).eraseDups
  let sE := hist[kE - 1]!.ram.get! szI
  IO.println s!"the movie: the size on the frames from power-on to the room's first control {(sizes.eraseDups.map hex2)}, from the first control on {((partA.toList.map fun c => c.ram.get! szI) ++ [sB]).eraseDups.map hex2}; the vertical pipe's entry after movie frame {kA}, the room's first control after movie frame {kB}: size {hex2 sB} (size₁ {okS sB}); the room's {kE} frames before the side pipe's entry start with the sizes {roomSizes.map hex2}; the entering frame starts with {hex2 sE} (size₂ {okS sE})"
  if !(okS sB && okS sE && roomSizes == [sB]) then okAll := false
  flush
  -- the movie's inputs with a big player from 30 frames before the vertical pipe's entry (the size byte 0 and the status 1 put in): through the vertical pipe
  -- to the room
  if partA.size > 31 then
    let a := partA.size - 31
    let mut c := poke (poke partA[a]! sy.PlayerSize 0) statusA 1
    let mut j := kA - partA.size + a + 1
    let mut seenB := false
    let mut vals : List UInt8 := []
    while j < inputs.size && (!seenB || (peek c sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) && j < kA + 600 do
      c := runFrame c inputs[j]!
      seenB := seenB || controllable sy c
      vals := c.ram.get! szI :: vals
      j := j + 1
    let inPipe := (peek c sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe
    let mut jB := j
    while jB < inputs.size && !controllable sy c && jB < j + 400 do
      c := runFrame c inputs[jB]!
      vals := c.ram.get! szI :: vals
      jB := jB + 1
    let sBB := c.ram.get! szI
    let mut room : List UInt8 := []
    let mut f := 0
    while inPipe && f < 400 && (peek c sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl do
      room := c.ram.get! szI :: room
      c := runFrame c inputs[jB + f]!
      f := f + 1
    IO.println s!"the movie's inputs with a big player put in 30 frames before the vertical pipe's entry: the vertical pipe's routine reached {inPipe} (after input {j}); the sizes up to the room's first control {vals.eraseDups.map hex2}; at the room's first control (after input {jB}) size {hex2 sBB} (size₁ {okS sBB}); the room's frames ({room.length}, up to the next routine or 400) start with the sizes {room.eraseDups.map hex2}"
    if inPipe && !(okS sBB && room.eraseDups.length ≤ 1) then okAll := false
    flush
  -- own runs from the movie's frames from control to the vertical pipe
  let rnd := fun (z : UInt64) =>
    let z := z ^^^ (z <<< 13)
    let z := z ^^^ (z >>> 7)
    let z := z ^^^ (z <<< 17)
    let w := ((z >>> 11) &&& 15).toNat
    let i : UInt8 := match w with
      | 0 | 1 | 2 | 3 | 4 | 5 => 0x01
      | 6 | 7 | 8 => 0x81
      | 9 | 10 => 0x41
      | 11 => 0xC1
      | 12 => 0x02
      | 13 => 0x82
      | 14 => 0x00
      | _ => ((z >>> 20) &&& 0xCF).toUInt8
    (z, i)
  let mut z : UInt64 := 77713
  let mut framesA := 0
  let mut valsA : List UInt8 := []
  let mut grow := 0
  let mut badA := 0
  for q in List.range runs do
    if partA.size == 0 then break
    let a := (q * 13) % partA.size
    let mut c := partA[a]!
    for _ in List.range 400 do
      let (z', i) := rnd z
      z := z'
      let c' := runFrame c (smbToPad i)
      framesA := framesA + 1
      let v := c'.ram.get! szI
      if !valsA.contains v then valsA := v :: valsA
      if v != c.ram.get! szI then grow := grow + 1
      if !okS v then badA := badA + 1
      c := c'
  IO.println s!"own runs from the movie's frames from control to the vertical pipe ({runs} runs of 400 frames, {framesA} frames): sizes {valsA.map hex2}; frames that change the size {grow}; frames that end with another size {badA}"
  if badA != 0 then okAll := false
  flush
  -- own runs in the room, small and big
  let big := fun (c : Machine) => poke (poke c sy.PlayerSize 0) statusA 1
  for (label, mk) in [("small", fun (c : Machine) => c), ("big", big)] do
    let mut frames := 0
    let mut entries := 0
    let mut changed := 0
    let mut startOK := 0
    let mut eSizes : List UInt8 := []
    for q in List.range runs do
      let a := (q * 7) % (kE - 1)
      let c0 := mk hist[a]!
      let s0 := c0.ram.get! szI
      let mut c := c0
      let mut f := 0
      while f < 600 && (peek c sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl do
        let (z', i) := rnd z
        z := z'
        let c' := runFrame c (smbToPad i)
        f := f + 1
        frames := frames + 1
        if c'.ram.get! szI != s0 then changed := changed + 1
        if peek c' sy.GameEngineSubroutine == ev then
          entries := entries + 1
          eSizes := c.ram.get! szI :: eSizes
          if okS (c.ram.get! szI) then startOK := startOK + 1
        c := c'
    IO.println s!"own runs in the room, {label} ({runs} runs, {frames} frames): frames that end with another size than the run's start {changed}; {entries} entries, their entering frames start with the sizes {(eSizes.eraseDups.map hex2)}, the reference's or 0: {startOK}"
    if changed != 0 || startOK != entries then okAll := false
    flush
  return (if okAll then 0 else 1)

/-- round 23 (`EntryBuffer`, 1-1-d-2-5-5): what one real frame of the room does with the control of the screen's buffers and the player's position (page · 256 + x):
the position at each coin erase (the write `Places.erase`) and the erased byte's column, the first end of the move (`PlayerSubs`), the first write of the side pipe's
routine, the writes to the control, and the least and the largest position after the first erase. No part of the proof. -/
structure CtlScan where
  erase : List (Nat × Nat) := []
  subs : Option Nat := none
  write : Option Nat := none
  ctlW : List (Nat × Nat) := []
  minP : Nat := 1000000
  maxP : Nat := 0
  deriving Inhabited

def ctlScanFrame (sy : Syms) (P : ScreenPage.Places) (cI : Nat) (ev : UInt8) (m : Machine) (pad : UInt8) : CtlScan × Machine := Id.run do
  let t := m.frame + 1
  let mut c : Machine := { m with pad }
  let mut R : CtlScan := {}
  let mut n := 0
  let pos := fun (c : Machine) => (peek c sy.Player_PageLoc).toNat * 256 + (peek c sy.Player_X_Position).toNat
  while n < fuelPerFrame && !(decide (c.frame ≥ t) || c.halted) do
    if c.pc == P.erase then
      let w := ((ScreenPage.writeAddr c) &&& 0x7FF).toNat
      R := { R with erase := (pos c, (w - P.bufLo) / (P.bufN / 2) * 16 + (w - P.bufLo) % 16) :: R.erase }
    if c.pc == sy.PlayerSubs && R.subs.isNone then R := { R with subs := some (pos c) }
    let c2 := (PipeTransitionAll.go step c).2
    if c2.ram.get! cI != c.ram.get! cI then R := { R with ctlW := (c.pc.toNat, (c2.ram.get! cI).toNat) :: R.ctlW }
    if R.write.isNone && peek c2 sy.GameEngineSubroutine == ev && peek c sy.GameEngineSubroutine != ev then R := { R with write := some (pos c2) }
    if !R.erase.isEmpty then R := { R with minP := min R.minP (pos c2), maxP := max R.maxP (pos c2) }
    c := c2
    n := n + 1
  return (R, c)

/-- round 26 (1-1-d-2-4-2, measured only): which parts of `SiteOK` the walk of `BufferEnd` (the room's frame with the control and the page) knows at the
instructions where they are asked. From every state of its table, the walk's steps up to a covered state of the table or the frame's end; at each state:
`reads` the pointer's high byte of an `LDA (zp),Y` known at most 0x1E or at least 0x80; `off` the buffer's offset known below 64; `xbit` the position's low bits
known not 0; `read`, `erase` the place known in the block buffers; `late` the dot's upper bound (after the walk's clamp, so only the states it clamps are counted).
The result: for each part, the states where the walk knows it, those where it does not, and the places of the second. -/
def siteScan (S : EntryHeight.HP) (M : BufferEnd.MX) (C : ScreenPage.CfgS) (fuel : Nat) : IO (Array (String × Nat × Nat × List Nat)) := do
  let P := C.P
  let E := C.E
  let parts := #["reads", "off", "xbit", "read", "erase", "late"]
  let mut good : Array Nat := Array.replicate parts.size 0
  let mut bad : Array Nat := Array.replicate parts.size 0
  let mut where_ : Array (Std.HashSet Nat) := Array.replicate parts.size {}
  let mut steps := 0
  for A0 in C.t do
    let mut stack : List TaintRun.AS := [A0]
    let mut n := 0
    while n < fuel do
      match stack with
      | [] => break
      | A :: rest =>
        stack := rest
        n := n + 1
        steps := steps + 1
        if !A.nmi && decide (0x8000 ≤ A.pc) then
          let op := E.prg.get! (A.pc &&& E.mask).toNat
          -- reads
          if op == 0xB1 then
            let z := E.prg.get! ((A.pc + 1) &&& E.mask).toNat
            let hi := A.getK (z + 1).toNat
            if hi.isK && (hi.v ≤ 0x1E || hi.v ≥ 0x80) then good := good.modify 0 (· + 1)
            else
              bad := bad.modify 0 (· + 1)
              where_ := where_.modify 0 fun l => l.insert A.pc.toNat
          if P.offAt.contains A.pc then
            if (A.getK P.offI).maxv < 64 then good := good.modify 1 (· + 1)
            else
              bad := bad.modify 1 (· + 1)
              where_ := where_.modify 1 fun l => l.insert A.pc.toNat
          if A.pc == P.xAt then
            let xb := A.getK P.xI
            if xb.k &&& 0x0F == 0x0F && xb.v &&& 0x0F != 0 then good := good.modify 2 (· + 1)
            else
              bad := bad.modify 2 (· + 1)
              where_ := where_.modify 2 fun l => l.insert A.pc.toNat
          if A.pc == P.read || A.pc == P.erase then
            let k := if A.pc == P.read then 3 else 4
            let known := (EntryHeightBig.ptrLo E A).isK && (EntryHeightBig.ptrHi E A).isK && A.y.isK
            if known && decide (EntryHeightBig.readAd E A < 0x2000) && decide (P.bufLo ≤ EntryHeightBig.readI E A) && decide (EntryHeightBig.readI E A < P.bufLo + P.bufN) then
              good := good.modify k (· + 1)
            else
              bad := bad.modify k (· + 1)
              where_ := where_.modify k fun l => l.insert A.pc.toNat
          if A.pc != P.idle then
            if A.hi ≤ P.late then good := good.modify 5 (· + 1)
            else
              bad := bad.modify 5 (· + 1)
              where_ := where_.modify 5 fun l => l.insert A.pc.toNat
        for A₁ in BufferEnd.preX S M (ScreenPage.clampS P A) do
          for r in BufferEnd.stepZ P E C.ops A₁ do
            match r with
            | none => pure ()
            | some B =>
              if B.k == A.k then
                let B' := ScreenPage.weaken C B
                if !(C.cut.get! B'.pc.toNat != 0 && ScreenPage.coverS C (ScreenPage.clampS P B')) then stack := B' :: stack
  IO.println s!"  the scan: {C.t.size} states of the table, {steps} steps"
  return (List.range parts.size).toArray.map fun k => (parts[k]!, good[k]!, bad[k]!, where_[k]!.toList.mergeSort)

/-- round 23: the control of the screen's buffers in the room (`BufferControl`, `buffer₂`), on real frames and in walks. `real`: the movie's room and own runs (small
and big, from the movie's frames in the room; kind 0 random, kind 1 from the last 60 frames before the entry, with jumps); `walk`: the buffer's walk from a frame that
starts with the control at 0 and at 6; `keep`: the two checks of `BufferControl`; `rows`: what the rows of the first change know; `sites`: the parts of `SiteOK` on
own runs in the room. No part of the proof. -/
def bufferCtlCheck (sy : Syms) (romPath fm2 : String) (runs : Nat) (mode : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nm2 := SideChangeBound.namesOf txt
  let nx2 := SideChangeEnd.namesOf txt
  let P := ScreenPage.placesR sy nmS m0
  let cI := EntryBuffer.ctlI nmS
  let r := ScreenPage.refR m0
  let ev := SideEntryRule.vs sy
  let statusA := nmS.ad "PlayerStatus"
  let E := ScreenPage.envR sy nmS m0
  let mut okAll := true
  IO.println s!"the reference's control {hex2 (r.ram.get! cI)}; the erase's place {P.erase}; the mouth's column {SidePipe.column sy}, its left end {SidePipe.xLo sy} px; the end of the move {sy.PlayerSubs}"
  if mode == "rows" then
    let nm := PipeChangeBound.namesOf txt
    let nx := PipeChangeEnd.namesOf txt
    let e := PipeTransition.entry m0
    let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
    let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
    let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
    let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
    let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
    let t1 ← IO.monoMsNow
    let rows ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
    let sts := rows.flatMap (·.R)
    let xI := (sy.Player_X_Position &&& 0x7FF).toNat
    let pI := (sy.Player_PageLoc &&& 0x7FF).toNat
    IO.println s!"the rows of the time of the first change: {rows.length} rows, {sts.length} states ({(← IO.monoMsNow) - t1} ms)"
    IO.println s!"  the control in the states: {(sts.map fun S => abS (S.getK cI)).eraseDups.take 12}; the position {(sts.map fun S => abS (S.getK xI)).eraseDups.take 12}; the page {(sts.map fun S => abS (S.getK pI)).eraseDups.take 12}"
    IO.println s!"  the second buffer's offset {(sts.map fun S => abS (S.getK ((((nmS.ad "VRAM_Buffer1_Offset").toNat + 1) &&& 0x7FF)))).eraseDups.take 12}; the routine {(sts.map fun S => abS (S.getK P.rtI)).eraseDups.take 12}"
    -- round 24: the exit code says whether every state knows the control at the reference's value
    let ctlK := sts.all fun S => (S.getK cI).isK && (S.getK cI).v == r.ram.get! cI
    IO.println s!"  every state knows the control at the reference's value: {ctlK}"
    flush
    return (if ctlK && !sts.isEmpty then 0 else 1)
  if mode == "sites" then
    -- round 23, measured only: the parts of `SiteOK` (`chg.roomSites`) on real frames of the room, with their margins
    let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
    let mut t := powerOn cart 0
    let mut seen := false
    let mut k := 0
    while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
      t := runFrame t inputs[k]!
      seen := seen || controllable sy t
      k := k + 1
    while k < inputs.size && !controllable sy t do
      t := runFrame t inputs[k]!
      k := k + 1
    let mut hist : Array Machine := #[t]
    while k < inputs.size && peek t sy.GameEngineSubroutine != ev do
      t := runFrame t inputs[k]!
      hist := hist.push t
      k := k + 1
    let kE := hist.size - 1
    let big := fun (c : Machine) => poke (poke c sy.PlayerSize 0) statusA 1
    let mut z : UInt64 := 71993
    for (label, mk) in [("small", fun (c : Machine) => c), ("big", big)] do
      let mut frames := 0
      let mut bad : Array Nat := #[0, 0, 0, 0, 0, 0, 0]
      let mut maxDot := 0
      let mut izy := 0
      let mut izyPcs : List Nat := []
      let mut tiles : List UInt8 := []
      let mut heads : List UInt8 := []
      let mut readOut := 0
      let mut erases := 0
      let mut maxOff := 0
      let mut xbits : List Nat := []
      for q in List.range runs do
        let a := (q * 7) % (kE - 1)
        let mut c := mk hist[a]!
        let mut f := 0
        while f < 600 && (peek c sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl do
          z := z ^^^ (z <<< 13)
          z := z ^^^ (z >>> 7)
          z := z ^^^ (z <<< 17)
          let w := ((z >>> 11) &&& 15).toNat
          let i : UInt8 := match w with
            | 0 | 1 | 2 | 3 | 4 | 5 => 0x01
            | 6 | 7 | 8 => 0x81
            | 9 | 10 => 0x41
            | 11 => 0xC1
            | 12 => 0x02
            | 13 => 0x82
            | 14 => 0x00
            | _ => ((z >>> 20) &&& 0xCF).toUInt8
          let tt := c.frame + 1
          let mut m : Machine := { c with pad := smbToPad i }
          let mut n := 0
          while n < fuelPerFrame && !(decide (m.frame ≥ tt) || m.halted) do
            let b := ScreenPage.siteBad P m
            if b != 0 then bad := bad.set! (b - 1) (bad[b - 1]! + 1)
            if m.pc != P.idle && m.frame == c.frame then maxDot := max maxDot m.fdot
            if decide (0x8000 ≤ m.pc) && m.prg.get! (m.pc &&& m.prgMask).toNat == 0xB1 then
              izy := izy + 1
              izyPcs := (m.pc.toNat :: izyPcs).eraseDups
            if m.pc == P.read then
              tiles := (ScreenPage.readVal m :: tiles).eraseDups
              if P.heads.contains (m.ram.get! P.saveI) then heads := (ScreenPage.readVal m :: heads).eraseDups
              let ra := (ScreenPage.readAddr m &&& 0x7FF).toNat
              if !(decide (ScreenPage.readAddr m < 0x2000) && decide (P.bufLo ≤ ra) && decide (ra < P.bufLo + P.bufN)) then readOut := readOut + 1
            if m.pc == P.erase then erases := erases + 1
            if P.offAt.contains m.pc then maxOff := max maxOff (m.ram.get! P.offI).toNat
            if m.pc == P.xAt then xbits := ((m.ram.get! P.xI &&& 0x0F).toNat :: xbits).eraseDups
            m := (PipeTransitionAll.go step m).2
            n := n + 1
          f := f + 1
          frames := frames + 1
          c := m
      IO.println s!"SiteOK on own runs in the room, {label} ({runs} runs, {frames} frames): instructions that fail each part (late, reads, read, head read, erase, off, xbit) {bad.toList}"
      IO.println s!"  late: the last dot of a handler {maxDot}, the bound {P.late}; reads: {izy} reads through a pointer at the places {izyPcs.mergeSort}; read: tiles read {tiles.map hex2}, the list {P.tiles.map hex2}; head reads {heads.map hex2}, the list {P.headTiles.map hex2}; reads outside the block buffers {readOut}; erase: {erases} erases; off: the largest offset {maxOff}, the bound 64; xbit: the low bits of the position at the side pipe's read {xbits.mergeSort}"
      flush
      -- round 24: the exit code covers every part and margin printed
      if bad.any (· != 0) || decide (P.late ≤ maxDot) || readOut != 0 || decide (64 ≤ maxOff) || !(tiles.all P.tiles.contains) ||
          !(heads.all P.headTiles.contains) || frames == 0 then okAll := false
    return (if okAll then 0 else 1)
  if mode == "keep" then
    -- the checks of `BufferControl`: the walks from the control at 0 and at 6, and the rows at the room's first control
    let t0 ← IO.monoMsNow
    let ok1 ← IO.lazyPure fun _ => BufferControl.keepCheck sy nmS m0
    IO.println s!"BufferControl.keepCheck {ok1} ({(← IO.monoMsNow) - t0} ms)"
    flush
    let nm := PipeChangeBound.namesOf txt
    let nx := PipeChangeEnd.namesOf txt
    let e := PipeTransition.entry m0
    let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
    let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
    let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
    let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
    let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
    let t1 ← IO.monoMsNow
    let ok2 ← IO.lazyPure fun _ => BufferControl.startCheckC sy nm d e nmS m0
    IO.println s!"BufferControl.startCheckC {ok2} ({(← IO.monoMsNow) - t1} ms)"
    flush
    return (if ok1 && ok2 then 0 else 1)
  if mode == "coin" then
    -- round 24: the walks of `BufferCoin` (searches): from the control at 6, page 0 and the position in each piece of [16, 181), every state at the end of the
    -- move is a state of the table, on page 0 and left of the mouth. With N ≠ 0 also the check `BufferCoin.coinCheck` (about 1.5 min natively since round 25)
    let SB := EntryBuffer.hpB sy nmS m0
    let ZB := ScreenPage.aidsOf sy nmS m0
    let M := BufferCoin.mpOf sy m0
    let O := BufferCoin.optsG ZB E cI M
    let ps := BufferCoin.rangePieces 16 181
    IO.println s!"the move's add {M.addAt}, the compares {M.cmpAt} {M.cmp0At}, the climbing add {M.climbAt}, the end of the move {M.subs}, the scroll handler {M.scrollAt}, the mouth's left end {M.left}; pieces {ps.map abS}, cover {BufferCoin.rangeCover 16 181}"
    if !BufferCoin.rangeCover 16 181 then okAll := false
    for a in ps do
      let t0 ← IO.monoMsNow
      let X ← IO.lazyPure fun _ => BufferCoin.searchOfG SB M ZB O (fun _ => true) E (BufferCoin.ref6x nmS M r a) (BufferCoin.knownG sy nmS m0 M a)
      let t1 ← IO.monoMsNow
      let atQ := X.done.toList.filter fun q => q.2.pc == M.subs
      let badQ := atQ.filter fun q => !BufferCoin.posLeft M q.2
      IO.println s!"the position {abS a}: {X.steps} steps, {X.forks} forks, {X.fails} failures, states {X.done.size}, frame ends {X.ends.size}; at the end of the move {atQ.length} states, the position there {((atQ.map fun q => (q.2.getK M.xI).minv.toNat).foldl min 255)} to {((atQ.map fun q => (q.2.getK M.xI).maxv.toNat).foldl max 0)} px, not on page 0 left of the mouth {badQ.length}; search {t1 - t0} ms"
      match X.firstFail with
      | some A => IO.println s!"  first failure: pc {A.pc} a {abS A.a} x {abS A.x} y {abS A.y} control {abS (A.getK cI)} pos {abS (A.getK M.xI)} page {abS (A.getK M.pI)}"
      | none => pure ()
      flush
      if X.fails != 0 || !badQ.isEmpty then okAll := false
    if runs != 0 then
      let t0 ← IO.monoMsNow
      let ok ← IO.lazyPure fun _ => BufferCoin.coinCheck sy nmS m0
      IO.println s!"BufferCoin.coinCheck {ok} ({(← IO.monoMsNow) - t0} ms)"
      if !ok then okAll := false
    return (if okAll then 0 else 1)
  if mode == "coin1" then
    -- round 25, measured only: the seven walks of `BufferCoin` as one search with the start states of all pieces
    let SB := EntryBuffer.hpB sy nmS m0
    let ZB := ScreenPage.aidsOf sy nmS m0
    let M := BufferCoin.mpOf sy m0
    let O := BufferCoin.optsG ZB E cI M
    let ps := BufferCoin.rangePieces 16 181
    let t0 ← IO.monoMsNow
    let starts := ps.flatMap fun a => ScreenPage.startsR (BufferCoin.ref6x nmS M r a) (BufferCoin.knownG sy nmS m0 M a)
    let X ← IO.lazyPure fun _ => BufferCoin.searchG SB M ZB O (fun _ => true) E (TaintRun.aRows E).toArray (starts.foldl (EntryHeight.routeY SB.P O) {})
    let t1 ← IO.monoMsNow
    let atQ := X.done.toList.filter fun q => q.2.pc == M.subs
    let badQ := atQ.filter fun q => !BufferCoin.posLeft M q.2
    IO.println s!"one search for the seven pieces: {starts.length} starts, {X.steps} steps, {X.fails} failures, states {X.done.size}, at the end of the move {atQ.length}, not left {badQ.length}; {t1 - t0} ms"
    flush
    return (if X.fails == 0 && badQ.isEmpty then 0 else 1)
  if mode == "sites26" then
    -- round 26 (measured only): the parts of `SiteOK` that the walk of `BufferEnd` knows where they are asked (`siteScan`), from the control 0 and 6
    let SX := BufferEnd.hpX sy nmS m0
    let ZB := ScreenPage.aidsOf sy nmS m0
    let M := BufferEnd.mxOf sy m0
    let O := BufferEnd.optsX ZB E cI M
    let fin := BufferEnd.finX cI M
    for v in ([0, 6] : List UInt8) do
      let rv : Machine := { r with ram := r.ram.set! cI v }
      let t0 ← IO.monoMsNow
      let C ← IO.lazyPure fun _ => BufferEnd.cfgOfX SX M ZB O fin E rv (EntryBuffer.knownB sy nmS m0)
      IO.println s!"the walk of BufferEnd from the control {hex2 v}: the table {C.t.size} states ({(← IO.monoMsNow) - t0} ms)"
      let res ← siteScan SX M C (if runs == 0 then 4000 else runs)
      for (nm, g, b, w) in res do
        IO.println s!"  {nm}: known at {g} states, not known at {b}, at the places {w.take 40}"
      IO.println s!"  ({(← IO.monoMsNow) - t0} ms)"
      flush
    return 0
  if mode == "end" then
    -- round 25: the walks of `BufferEnd` (searches): from the control at 0 and at 6, a frame end with the control at 6 has the position's piece inside [16, 181).
    -- With N ≠ 0 also the check `BufferEnd.endCheck`
    let SX := BufferEnd.hpX sy nmS m0
    let ZB := ScreenPage.aidsOf sy nmS m0
    let M := BufferEnd.mxOf sy m0
    let O := BufferEnd.optsX ZB E cI M
    let fin := BufferEnd.finX cI M
    IO.println s!"BufferEnd places: the end of the move {M.subs}, the offsets' load {M.gbb}, the add {M.adc}, the address's routine {M.colAt}, the row's mask {M.andAt}, the return {M.colEnd}; the tile {SX.tileI} after {SX.tileAt}; pieces {(BufferEnd.piecesX M.lo M.hi).map abS}, cover {BufferEnd.piecesCover M.lo M.hi}"
    if !BufferEnd.piecesCover M.lo M.hi then okAll := false
    for v in ([0, 6] : List UInt8) do
      let rv : Machine := { r with ram := r.ram.set! cI v }
      let t0 ← IO.monoMsNow
      let X ← IO.lazyPure fun _ => BufferEnd.searchOfX SX M ZB O fin E rv (EntryBuffer.knownB sy nmS m0)
      let t1 ← IO.monoMsNow
      let ends6 := X.ends.toList.filter fun B => !SideEntryRest.notV 6 (B.getK cI)
      let badE := X.ends.toList.filter fun B => !fin B
      let atQ := X.done.toList.filter fun q => q.2.pc == M.subs
      let atAdc := X.done.toList.filter fun q => q.2.pc == M.adc
      IO.println s!"the walk from the control {hex2 v}: {X.steps} steps, {X.forks} forks, {X.fails} failures, states {X.done.size}, frame ends {X.ends.size}, of them with the control maybe 6 {ends6.length}, the positions there {(ends6.map fun B => abS (B.getK M.xI)).eraseDups.take 20}; ends that fail {badE.length}; states at the end of the move {atQ.length}, at the add {atAdc.length}; search {t1 - t0} ms"
      match X.firstFail with
      | some A => IO.println s!"  first failure: pc {A.pc} a {abS A.a} x {abS A.x} y {abS A.y} control {abS (A.getK cI)} pos {abS (A.getK M.xI)}"
      | none => pure ()
      for B in badE.take 5 do
        IO.println s!"  a failing end: control {abS (B.getK cI)} pos {abS (B.getK M.xI)} pc {B.pc}"
      -- where the control becomes 6 with the position outside: the states of the table with the control known 6 and a piece not inside
      let out6 := X.done.toList.filter fun q => (q.2.getK cI).isK && (q.2.getK cI).v == 6 && (q.2.getK M.xI).k != 0 && !BufferEnd.inside M.lo M.hi (q.2.getK M.xI)
      let pcs := (out6.map fun q => q.2.pc.toNat).eraseDups.mergeSort
      IO.println s!"  states with the control 6 and the position outside: {out6.length}, at {pcs.length} places, the first places {pcs.take 40}"
      let atE := X.done.toList.filter fun q => q.2.pc == P.erase
      IO.println s!"  states at the erase: {atE.length}; their positions {(atE.map fun q => abS (q.2.getK M.xI)).eraseDups.take 30}; with a piece not inside: {(atE.filter fun q => !BufferEnd.inside M.lo M.hi (q.2.getK M.xI)).length}"
      for q in (atE.filter fun q => !BufferEnd.inside M.lo M.hi (q.2.getK M.xI)).take 12 do
        let rt := fun (k : Nat) => abS (q.2.getK (0x100 + q.2.s.toNat + k))
        IO.println s!"    erase outside: pos {abS (q.2.getK M.xI)} ptr {abS (q.2.getK M.ptrI)} {abS (q.2.getK (M.ptrI+1))} row {abS (q.2.getK M.rowI)} y {abS q.2.y} tile {abS (q.2.getK M.tileI)} a {abS q.2.a} stack {rt 1} {rt 2} {rt 3} {rt 4} {rt 5} {rt 6}"
      let atR := X.done.toList.filter fun q => q.2.pc == P.read && (q.2.getK M.xI).isK
      let ptrK := fun (A : TaintRun.AS) => (A.getK ((SX.tileI) + 3)).isK && (A.getK ((SX.tileI) + 4)).isK
      IO.println s!"  reads with the position known: {atR.length}; of them with Y known {(atR.filter fun q => q.2.y.isK).length}, with the pointer known {(atR.filter fun q => ptrK q.2).length}"
      let mr := RoomMap.mapRef m0
      let coinCells := (List.range P.bufN).filter fun j => (mr.ram.get! (P.bufLo + j)) &&& sy.CoinTile.toUInt8 == sy.CoinTile.toUInt8
      IO.println s!"  map cells that may hold a coin (buffer, row, column): {coinCells.map fun j => (j / (P.bufN / 2), (j % (P.bufN / 2)) / 16, j % 16)}"
      let rdO := X.done.toList.filter fun q => q.2.pc == P.read && !BufferEnd.inside M.lo M.hi (q.2.getK M.xI) && !BufferEnd.readAt P E q.2
      let ret := fun (A : TaintRun.AS) (k : Nat) => (abS (A.getK (0x100 + A.s.toNat + k)))
      IO.println s!"  reads with the position outside and the place not known: {rdO.length}; (X, Y, ptr, pos, return) {(rdO.map fun q => (abS q.2.x, abS q.2.y, abS (q.2.getK M.ptrI), abS (q.2.getK (M.ptrI+1)), abS (q.2.getK M.xI), ret q.2 1, ret q.2 2, ret q.2 3, ret q.2 4)).eraseDups.take 12}"
      let rc := X.done.toList.filter fun q => q.2.pc == P.read + 2 && !BufferEnd.inside M.lo M.hi (q.2.getK M.xI) && SideFrame.memB q.2.a sy.CoinTile.toUInt8
      IO.println s!"  after a read, outside, the byte may be a coin: {rc.length}; (a, pos, ptr, Y, sum, X) {(rc.map fun q => (abS q.2.a, abS (q.2.getK M.xI), abS (q.2.getK M.ptrI), abS (q.2.getK (M.ptrI+1)), abS q.2.y, abS (q.2.getK M.sumI), abS q.2.x)).eraseDups.take 12}"
      let atG := X.done.toList.filter fun q => (q.2.pc == M.gbb || q.2.pc == M.gbb + 3) && !BufferEnd.inside M.lo M.hi (q.2.getK M.xI)
      IO.println s!"  at the offsets' load and after it, outside: {atG.length}; (pc, Y, side byte) {(atG.map fun q => (q.2.pc.toNat, abS q.2.y, abS (q.2.getK M.sideI))).eraseDups.take 16}"
      let atA := X.done.toList.filter fun q => q.2.pc == M.adc && !BufferEnd.inside M.lo M.hi (q.2.getK M.xI)
      IO.println s!"  at the add, outside: {atA.length}; (A, X, Y, side byte, pos) {(atA.map fun q => (abS q.2.a, abS q.2.x, abS q.2.y, abS (q.2.getK M.sideI), abS (q.2.getK M.xI))).eraseDups.take 24}"
      let w6 := X.done.toList.filter fun q => (q.2.getK cI).isK && (q.2.getK cI).v == 6 && v == 0
      IO.println s!"  (walk from 0) states with the control known 6: {w6.length}, the first places {((w6.map fun q => q.2.pc.toNat).eraseDups.mergeSort).take 30}"
      flush
      if X.fails != 0 || !badE.isEmpty then okAll := false
    if runs != 0 then
      let t0 ← IO.monoMsNow
      let ok ← IO.lazyPure fun _ => BufferEnd.endCheck sy nmS m0
      IO.println s!"BufferEnd.endCheck {ok} ({(← IO.monoMsNow) - t0} ms)"
      if !ok then okAll := false
    return (if okAll then 0 else 1)
  if mode.startsWith "walk" then
    let SB := EntryBuffer.hpB sy nmS m0
    let ZB := ScreenPage.aidsOf sy nmS m0
    let VB := SideChangeEnd.refs2 nm2 nx2 (SideTransition.entry m0)
    let LB := EntryBuffer.bufIdx nmS
    for v in ([0, 6] : List UInt8) do
      let rv : Machine := { r with ram := r.ram.set! cI v }
      let t0 ← IO.monoMsNow
      let X ← IO.lazyPure fun _ => EntryHeight.searchOf SB ZB (EntryBuffer.optsB SB ZB E cI LB) (fun B => (B.getK cI).isK && ((B.getK cI).v == 0 || (B.getK cI).v == 6)) E rv (EntryBuffer.knownB sy nmS m0)
      let t1 ← IO.monoMsNow
      let ctlEnds := (X.ends.toList.map fun B => abS (B.getK cI)).eraseDups
      IO.println s!"the buffer's walk from the control {hex2 v}: {X.steps} steps, {X.forks} forks, {X.fails} failures, states {X.done.size}; frame ends {X.ends.size}, the control at the ends {ctlEnds}; search {t1 - t0} ms"
      match X.firstFail with
      | some A => IO.println s!"  first failure: pc {A.pc} a {abS A.a} x {abS A.x} y {abS A.y} control {abS (A.getK cI)}"
      | none => pure ()
      flush
      -- round 24: the exit code says whether the walk has no failure and ends with the control known to be 0 or 6
      if X.fails != 0 || !(X.ends.toList.all fun B => (B.getK cI).isK && ((B.getK cI).v == 0 || (B.getK cI).v == 6)) then okAll := false
    return (if okAll then 0 else 1)
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn cart 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  while k < inputs.size && !controllable sy t do
    t := runFrame t inputs[k]!
    k := k + 1
  let b2 := ((nmS.ad "VRAM_Buffer1_Offset").toNat + 1) &&& 0x7FF
  IO.println s!"the room's first control (after movie frame {k}): the control {hex2 (t.ram.get! cI)}, the reference's {hex2 (r.ram.get! cI)}; the second buffer's offset {hex2 (t.ram.get! b2)}"
  let mut hist : Array Machine := #[t]
  let mut hin : Array UInt8 := #[]
  while k < inputs.size && peek t sy.GameEngineSubroutine != ev do
    hin := hin.push inputs[k]!
    t := runFrame t inputs[k]!
    hist := hist.push t
    k := k + 1
  let kE := hist.size - 1
  let pos := fun (c : Machine) => (peek c sy.Player_PageLoc).toNat * 256 + (peek c sy.Player_X_Position).toNat
  -- the movie's room frames
  let mut mCoin := 0
  let mut mBad := 0
  for j in List.range kE do
    let c := hist[j]!
    let (R, c2) := ctlScanFrame sy P cI ev c hin[j]!
    if c2.ram.data != hist[j + 1]!.ram.data then mBad := mBad + 1
    if c2.ram.get! cI != 0 then
      mCoin := mCoin + 1
      IO.println s!"  movie room frame {j}: ends with the control {hex2 (c2.ram.get! cI)}; erases {R.erase}; position at the end {pos c2}; writes of the control {R.ctlW}"
  IO.println s!"the movie in the room: {kE} frames to the entry, {mCoin} end with the control set, scans that differ from the run {mBad}; the entering frame starts at {pos hist[kE - 1]!}, its end of the move {(ctlScanFrame sy P cI ev hist[kE - 1]! hin[kE - 1]!).1.subs}"
  -- round 24: the narrowed field `buffer₂` on the movie: the entering frame does not start with the control at 6
  let movieF := hist[kE - 1]!.ram.get! cI != 6
  IO.println s!"  the movie's entering frame starts with the control {hex2 (hist[kE - 1]!.ram.get! cI)}: the narrowed buffer₂ (not 6) {movieF}"
  flush
  if mBad != 0 || !movieF then okAll := false
  let big := fun (c : Machine) => poke (poke c sy.PlayerSize 0) statusA 1
  let mut z : UInt64 := 52361
  if mode == "page" then
    -- round 26: `BufferEnd.end_frame` now also gives page 0. Its walk starts with the page and the position not known, so test it on own states: a room frame of
    -- the movie (small or big) with the page and the position overwritten by random bytes (half of the pages 0), then up to 40 frames of random inputs. Every frame
    -- that ends with the control at 6 must end on page 0 at 16 to 180 px.
    let mut runsN := 0
    let mut framesN := 0
    let mut coinsN := 0
    let mut coinOK := 0
    let mut coinOffPage := 0
    let mut startOff := 0
    let mut endOff := 0
    let mut pagesEnd : List Nat := []
    for q in List.range runs do
      for (_, mk) in [("small", fun (c : Machine) => c), ("big", big)] do
        z := z ^^^ (z <<< 13)
        z := z ^^^ (z >>> 7)
        z := z ^^^ (z <<< 17)
        let a := if q % 2 == 0 then (q * 7) % (kE - 1) else kE - 1 - ((q * 5) % (min 60 (kE - 1)))
        let pg : UInt8 := if (z >>> 3) &&& 1 == 0 then 0 else ((z >>> 8) &&& 0xFF).toUInt8
        let px : UInt8 := if (z >>> 4) &&& 3 == 0 then peek hist[a]! sy.Player_X_Position else ((z >>> 16) &&& 0xFF).toUInt8
        let mut c := poke (poke (mk hist[a]!) sy.Player_PageLoc pg) sy.Player_X_Position px
        runsN := runsN + 1
        let mut f := 0
        while f < 40 && (peek c sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl do
          z := z ^^^ (z <<< 13)
          z := z ^^^ (z >>> 7)
          z := z ^^^ (z <<< 17)
          let w := ((z >>> 11) &&& 15).toNat
          let i : UInt8 := match w with
            | 0 | 1 | 2 | 3 => 0x01
            | 4 | 5 | 6 => 0x41
            | 7 | 8 => 0x81
            | 9 | 10 => 0xC1
            | 11 | 12 => 0x02
            | 13 => 0x42
            | 14 => 0x00
            | _ => ((z >>> 20) &&& 0xCF).toUInt8
          let c' := runFrame c (smbToPad i)
          framesN := framesN + 1
          if peek c sy.Player_PageLoc != 0 then startOff := startOff + 1
          if peek c' sy.Player_PageLoc != 0 then
            endOff := endOff + 1
            pagesEnd := ((peek c' sy.Player_PageLoc).toNat :: pagesEnd).eraseDups
          if c'.ram.get! cI == 6 then
            coinsN := coinsN + 1
            if peek c sy.Player_PageLoc != 0 then coinOffPage := coinOffPage + 1
            if peek c' sy.Player_PageLoc == 0 && decide (16 ≤ (peek c' sy.Player_X_Position).toNat) && decide ((peek c' sy.Player_X_Position).toNat < 181) then
              coinOK := coinOK + 1
          c := c'
          f := f + 1
    IO.println s!"round 26, own states with the page and the position overwritten: {runsN} runs, {framesN} frames; frames that start off page 0 {startOff}, that end off page 0 {endOff} (the pages there {pagesEnd.mergeSort.take 20})"
    IO.println s!"  frames that end with the control at 6: {coinsN}, of them starting off page 0 {coinOffPage}; ending on page 0 at 16 to 180 px {coinOK} of {coinsN}"
    flush
    return (if coinOK == coinsN && coinsN != 0 then 0 else 1)
  for kind in [0, 1] do
   for (label, mk) in [("small", fun (c : Machine) => c), ("big", big)] do
    let mut frames := 0
    let mut entries := 0
    let mut coins := 0
    let mut ctlEnds : List Nat := []
    let mut ctlPcs : List Nat := []
    let mut eraseMax := 0
    let mut eraseCols : List Nat := []
    let mut coinEndMax := 0
    let mut afterMax : Int := -1000
    let mut startMin := 100000
    let mut subsMin := 100000
    let mut writeMin := 100000
    let mut moveMin : Int := 1000
    let mut moveMax : Int := -1000
    let mut restMin : Int := 1000
    let mut restMax : Int := -1000
    let mut pairMax : Int := -1000
    let mut gapMin := 100000
    let mut ctlStartBad := 0
    let mut ctlStart6 := 0
    let mut coinIn := 0
    let mut coinX := 0
    let mut newF := 0
    let mut start6In := 0
    let mut start6Enter := 0
    let mut pages : List Nat := []
    let mut scanBad := 0
    for q in List.range runs do
      let a := if kind == 0 then (q * 7) % (kE - 1) else kE - 1 - ((q * 5) % (min 60 (kE - 1)))
      let mut c := mk hist[a]!
      let mut f := 0
      let mut lastCoin : Option Nat := none
      let mut prevErase : Option Nat := none
      while f < 600 && (peek c sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl do
        z := z ^^^ (z <<< 13)
        z := z ^^^ (z >>> 7)
        z := z ^^^ (z <<< 17)
        let w := ((z >>> 11) &&& 15).toNat
        let i : UInt8 := if kind == 0 then (match w with
          | 0 | 1 | 2 | 3 | 4 | 5 => 0x01
          | 6 | 7 | 8 => 0x81
          | 9 | 10 => 0x41
          | 11 => 0xC1
          | 12 => 0x02
          | 13 => 0x82
          | 14 => 0x00
          | _ => ((z >>> 20) &&& 0xCF).toUInt8)
          else (match w with
          | 0 | 1 | 2 | 3 => 0x01
          | 4 | 5 | 6 | 7 => 0x41
          | 8 | 9 => 0xC1
          | 10 | 11 => 0x02
          | 12 => 0x42
          | 13 => 0x81
          | 14 => 0x00
          | _ => ((z >>> 20) &&& 0xCF).toUInt8)
        let (R, c') := ctlScanFrame sy P cI ev c (smbToPad i)
        if c'.ram.data != (runFrame c (smbToPad i)).ram.data then scanBad := scanBad + 1
        f := f + 1
        frames := frames + 1
        pages := (peek c sy.Player_PageLoc).toNat :: pages
        pages := pages.eraseDups
        ctlEnds := ((c'.ram.get! cI).toNat :: ctlEnds).eraseDups
        ctlPcs := (ctlPcs ++ R.ctlW.map (·.1)).eraseDups
        if let some s := R.subs then
          moveMin := min moveMin ((s : Int) - pos c)
          moveMax := max moveMax ((s : Int) - pos c)
          restMin := min restMin ((pos c' : Int) - s)
          restMax := max restMax ((pos c' : Int) - s)
          if let some e := prevErase then pairMax := max pairMax ((s : Int) - e)
        prevErase := none
        -- round 24: a frame that starts with the control at 6 on page 0 at 16 to 180 px (`BufferCoin.no_enter`), and the end of a coin frame (the middle disjunct of `buffer₂`)
        let inCls := fun (u : Machine) => (peek u sy.Player_PageLoc) == 0 && decide (16 ≤ (peek u sy.Player_X_Position).toNat) && decide ((peek u sy.Player_X_Position).toNat < 181)
        if c.ram.get! cI == 6 && inCls c then
          start6In := start6In + 1
          if peek c' sy.GameEngineSubroutine == ev then start6Enter := start6Enter + 1
        if c'.ram.get! cI == 6 && inCls c' then coinIn := coinIn + 1
        -- round 25: a coin frame ends at 16 to 180 px on any page (`BufferEnd`), and the field `buffer₂` of round 25 at an entering frame's start
        if c'.ram.get! cI == 6 && decide (16 ≤ (peek c' sy.Player_X_Position).toNat) && decide ((peek c' sy.Player_X_Position).toNat < 181) then coinX := coinX + 1
        if peek c' sy.GameEngineSubroutine == ev && (c.ram.get! cI != 6 || peek c sy.Player_PageLoc == 0) then newF := newF + 1
        if c'.ram.get! cI != 0 then
          coins := coins + 1
          lastCoin := some f
          for (p, col) in R.erase do
            eraseMax := max eraseMax p
            eraseCols := (col :: eraseCols).eraseDups
            prevErase := some (match prevErase with | some e => max e p | none => p)
            afterMax := max afterMax ((R.maxP : Int) - p)
          coinEndMax := max coinEndMax (pos c')
        if peek c' sy.GameEngineSubroutine == ev then
          entries := entries + 1
          startMin := min startMin (pos c)
          if let some s := R.subs then subsMin := min subsMin s
          if let some s := R.write then writeMin := min writeMin s
          if c.ram.get! cI != 0 then ctlStartBad := ctlStartBad + 1
          if c.ram.get! cI == 6 then ctlStart6 := ctlStart6 + 1
          if let some l := lastCoin then gapMin := min gapMin (f - l)
        c := c'
    IO.println s!"own runs of kind {kind}, {label} ({runs} runs, {frames} frames; scans that differ from the run {scanBad}): {entries} entries, {coins} frames end with the control set"
    IO.println s!"  the control at the frames' ends {ctlEnds}; the places that write it {ctlPcs}; pages at the frames' starts {pages}"
    IO.println s!"  coin frames: the largest position at an erase {eraseMax}, erased columns {eraseCols.mergeSort}, the largest position at the end {coinEndMax}, the largest rise after an erase to the frame's end {afterMax}"
    IO.println s!"  every frame: the end of the move minus the start {moveMin} .. {moveMax}; the end minus the end of the move {restMin} .. {restMax}; after a coin frame, the next end of the move minus the erase: at most {pairMax}"
    IO.println s!"  entering frames: the least start {startMin}, the least end of the move {subsMin}, the least position at the write {writeMin}; the control set at the start {ctlStartBad}; frames from the last coin frame to the entry at least {gapMin}"
    IO.println s!"  the narrowed buffer₂ (round 24: the entering frame does not start with the control at 6) holds on {entries - ctlStart6} of {entries} entries"
    IO.println s!"  round 24: coin frames that end on page 0 at 16 to 180 px {coinIn} of {coins}; frames that start with the control at 6 there {start6In}, of them entering {start6Enter}"
    IO.println s!"  round 25: coin frames that end at 16 to 180 px (any page) {coinX} of {coins}; entries whose frame starts with the control not 6 or on page 0 (buffer₂) {newF} of {entries}"
    flush
    if coinIn != coins || start6Enter != 0 then okAll := false
    if coinX != coins || newF != entries then okAll := false
    if ctlStartBad != 0 || ctlStart6 != 0 || scanBad != 0 then okAll := false
    if coinEndMax ≥ startMin then okAll := false
    -- round 24: the exit code covers the other facts printed: the control at the frames' ends is 0 or 6, at most two places write it, the page is 0, there are entries
    if !(ctlEnds.all fun v => v == 0 || v == 6) || decide (2 < ctlPcs.length) || !(pages.all (· == 0)) || entries == 0 then okAll := false
  return (if okAll then 0 else 1)

/-- The second half of the command dispatch of `main`. One long `match` makes nested C code
  that passes the C compiler's nesting limit, so the commands are split over two functions. -/
def mainMore (sy : Syms) (rom : String) (args : List String) : IO UInt32 := do
  let lr := fun (s : String) => s == "lr"
  match args with
  | ["title-pause-near"] => titlePauseNear sy rom
  | ["entry-pause-check"] => entryPauseCheck sy rom
  | ["pipe-end-check", fm2] => pipeEndCheck sy rom fm2
  | ["room-start-check", fm2] => roomStartCheck sy rom fm2 20
  | ["room-start-check", fm2, n] => roomStartCheck sy rom fm2 n.toNat!
  | "flag-rule-check" :: fm2 :: r => flagRuleCheck sy rom fm2 r
  | ["touch-end-check", fm2] => touchEndProbe sy rom fm2 100
  | ["touch-end-check", fm2, n] => touchEndProbe sy rom fm2 n.toNat!
  | ["castle-x-check", fm2, s0, n] => castleXProbe sy rom fm2 s0.toNat! n.toNat! false
  | ["castle-x-check", fm2, s0, n, "all"] => castleXProbe sy rom fm2 s0.toNat! n.toNat! true
  | ["castle-rule-check", fm2, s0, n] => castleRuleProbe sy rom fm2 s0.toNat! n.toNat!
  | ["castle-after-check", fm2, s0, n] => castleAfterProbe sy rom fm2 s0.toNat! n.toNat! false
  | ["castle-after-check", fm2, s0, n, "rule"] => castleAfterProbe sy rom fm2 s0.toNat! n.toNat! true
  | ["touch-rows-check", fm2, mode] => touchRowsProbe sy rom fm2 mode 300 ""
  | ["touch-rows-check", fm2, mode, v] => touchRowsProbe sy rom fm2 mode 300 v
  | ["touch-rows-check", fm2, mode, v, m2] => touchRowsProbe sy rom fm2 mode 300 v m2
  | ["screen-check", fm2] => screenCheck sy rom fm2
  | ["pipe-rule-check", fm2] => pipeRuleCheck sy rom fm2
  | ["pipe-frames-check", fm2] => pipeFramesCheck sy rom fm2
  | ["pipe-frames-check", fm2, n] => pipeFramesCheck sy rom fm2 n.toNat!
  | ["pipe-subs-search"] => do return if (← pipeSubsSearch sy rom) then 0 else 1
  | ["pipe-subs-check", fm2] => pipeRuleCheck sy rom fm2 true
  | ["lag-check", fm2] => lagCheckCmd sy rom fm2
  | ["lag-pause-check", fm2] => lagPauseCheckCmd sy rom fm2
  | ["open-frames-check", fm2] => openFramesCheck sy rom fm2
  | ["open-frames-check", fm2, n] => openFramesCheck sy rom fm2 32 n.toNat!
  | ["open-real-check", fm2] => openRealCheck sy rom fm2
  | ["open-real-check", fm2, n] => openRealCheck sy rom fm2 n.toNat!
  | ["open-left-real", fm2] => openLeftReal sy rom fm2
  | ["open-left-real", fm2, b] => openLeftReal sy rom fm2 b.toNat!
  | ["open-after-search"] => openAfterSearch sy rom "all"
  | ["open-after-search", w] => openAfterSearch sy rom w
  | ["open-store-search"] => openStoreSearch sy rom "search"
  | ["open-store-search", w] => openStoreSearch sy rom w
  | ["open-store-real", fm2] => openStoreReal sy rom fm2
  | ["open-store-real", fm2, n] => openStoreReal sy rom fm2 n.toNat!
  | ["open-map-check", fm2] => openMapCheck sy rom fm2
  | ["open-map-check", fm2, n] => openMapCheck sy rom fm2 n.toNat!
  | ["open-map-walk"] => openMapWalk sy rom
  | ["open-flat-check"] => openFlatCheck sy rom
  | ["open-ground-exp"] => openGroundExp sy rom
  | ["open-jump-check"] => openJumpCheckCmd sy rom
  | ["open-air-search"] => openAirSearch sy rom "all"
  | ["open-air-search", w] => openAirSearch sy rom w
  | ["lag-pause-check", fm2, n] => lagPauseCheckCmd sy rom fm2 n.toNat!
  | ["lag-check", fm2, n] => lagCheckCmd sy rom fm2 n.toNat!
  | ["ctrl-keep-check"] => ctrlKeepProg sy rom
