/-- what decides the change out of the side pipe, as a program -/
def sideAllCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let (m0, nm, R, Rvar, RE) ← sideAllSets sy romPath
  let n := SideTransitionAll.numsOf sy nm m0 160 122
  let e := SideTransition.entry m0
  let es := SideTransitionAll.entries sy nm (PipeTransition.run m0 SideTransition.onBlock) e
  IO.println s!"bytes read from the entry: {RE.length}; from the state when the timer has run out: {R.length}, in which entries differ: {Rvar.length}"
  IO.println s!"entries run: {es.length}; lengths: {es.map fun m => PipeTransitionAll.lengthOf sy m 800 0}"
  IO.println s!"screen not on the first page: {(SideTransitionAll.pageBefore sy nm).map fun c => PipeTransitionAll.lengthOf sy (SideTransitionAll.entryWith (SideTransition.pre m0) c) 800 0}; timer overwritten: {n.timerL.map fun v => (v, PipeTransitionAll.lengthOf sy (SideTransitionAll.timerAt nm e v) 800 0)}; six objects: {n.lagL}; time-up flag: {n.X}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideTransitionAll.allCheck sy m0 nm R Rvar RE n
  IO.println s!"the check: {ok} ({(← IO.monoMsNow) - t0} ms)"
  return if ok then 0 else 1

/-- one byte at a time, from the state `start` frames after the side pipe's entry, for the bytes the run reads: the bytes that change the length. With `few`, ten values
of each byte first, and all values only of a byte where one of them changes the length. -/
def sideAllBytes (sy : Syms) (romPath : String) (start n shard shards : Nat) (few : Bool) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let base := PipeTransition.run (SideTransition.entry m0) (PipeTransition.zeros start)
  let bytes := PipeTransitionAll.readSet n (PipeTransitionAll.norm base)
  for a in bytes do
    if a % shards != shard then continue
    let orig := base.ram.get! a
    let len := fun (v : Nat) => PipeTransitionAll.lengthOf sy (poke base a.toUInt16 v.toUInt8) (n + 400) 0
    let some' : List Nat := [0, 1, 2, 0x10, 0x40, 0x7F, 0x80, 0xFF, (orig + 1).toNat, (orig - 1).toNat]
    if few && !some'.any (fun v => v.toUInt8 != orig && len v != n) then continue
    let other := (List.range 256).filterMap fun v =>
      if v.toUInt8 == orig then none else
      let l := len v
      if l == n then none else some (v, l)
    if !other.isEmpty then
      let short := other.filter fun p => p.2 != 0 && p.2 < n
      IO.println s!"byte {a}, value {orig}: {other.length} other values change the length; shorter: {short.length}, first {short.take 8}; first {other.take 8}"
      flush
  return 0

/-- the frame before the side pipe's entry: every value of each byte the entry frame reads, one at a time; the bytes with a value that enters with another timer -/
def sideAllBefore (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := SideTransitionAll.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let p := SideTransition.pre m0
  let tm := fun (m : Machine) => peek m (nm.ad "ChangeAreaTimer")
  let tm0 := tm (PipeTransition.frame p SideTransition.walkIn)
  let bytes := flagged (PipeTransition.frame (PipeTransitionAll.track (PipeTransitionAll.norm p)) SideTransition.walkIn).trkRead
  IO.println s!"bytes the entry frame reads: {bytes.length}"
  for a in bytes do
    let orig := p.ram.get! a
    let others := (List.range 256).filter fun v => v.toUInt8 != orig
    let vals := others.filterMap fun v =>
      let q := poke p a.toUInt16 v.toUInt8
      let q' := PipeTransition.frame q SideTransition.walkIn
      if SideTransition.entersAt sy q SideTransition.walkIn && tm q' != tm0 then some (v, tm q') else none
    if !vals.isEmpty then
      IO.println s!"byte {a}, value {orig}: {vals.length} values enter with another timer; first {vals.take 4}"
      flush
  return 0

/-- a movie's side pipe entry against the assumptions of `SideTransitionAll.every_entry` (the movie stays out of the theorem) -/
def sideAllMovie (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let (m0, nm, R, Rvar, _) ← sideAllSets sy romPath
  let T := SideTransitionAll.cutOf m0 160
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut m := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek m sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    m := runFrame m inputs[k]!
    seen := seen || controllable sy m
    k := k + 1
  let t := PipeTransition.run m (PipeTransition.zeros 160)
  let v := PipeTransitionAll.phaseOf T nm t
  IO.println s!"entry on movie frame {k - 1}: control after {PipeTransitionAll.lengthOf sy m 800 0} frames; (H1) to (H4): {SideTransitionAll.assumptionsHold sy nm R Rvar T 160 122 m}"
  IO.println s!"the run from the cut reads only R: {PipeTransitionAll.readsIn R (PipeTransition.run (PipeTransitionAll.track (PipeTransitionAll.norm t)) (PipeTransition.zeros 122))}"
  IO.println s!"bytes of Rvar that differ from the reference: {(Rvar.filter fun i => t.ram.get! i != v.ram.get! i).length} of {Rvar.length}"
  return 0

/-- walking right from `m`: the machine before the frame that enters the side pipe -/
def sideWalkToEntry (sy : Syms) : Nat → Machine → Option Machine
  | 0, _ => none
  | n + 1, m =>
    if SideTransition.entersAt sy m SideTransition.walkIn then some m
    else sideWalkToEntry sy n (PipeTransition.frame m SideTransition.walkIn)

/-- real entries against the assumptions of `SideTransitionAll.every_entry`: `d < 21` more frames on the block or on the floor, then walking right until he enters -/
def sideAllReal (sy : Syms) (romPath : String) : IO UInt32 := do
  let (m0, nm, R, Rvar, _) ← sideAllSets sy romPath
  let T := SideTransitionAll.cutOf m0 160
  let o := PipeTransition.run m0 SideTransition.onBlock
  let s := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run s (PipeTransition.zeros d)]
  let results := (starts.filterMap (sideWalkToEntry sy 300)).map fun p =>
    let m := PipeTransition.frame p SideTransition.walkIn
    (SideTransition.xOf sy m - SidePipe.xLo sy, PipeTransitionAll.lengthOf sy m 800 0, SideTransitionAll.assumptionsHold sy nm R Rvar T 160 122 m)
  IO.println s!"of {starts.length} starts, real entries: {results.length}; length 282: {(results.filter (·.2.1 == 282)).length}; (H1) to (H4): {(results.filter (·.2.2)).length}; pixels: {(results.map (·.1)).eraseDups}"
  let e := SideTransition.entry m0
  let len := fun (c : PipeTransition.Change) => PipeTransitionAll.lengthOf sy (PipeTransition.applyChange e c) 800 0
  IO.println s!"the overwritten states of the vertical pipe's check on this entry: {((PipeTransitionAll.scenes sy nm e).map len).eraseDups}; screen moved at the end of the entry frame: {(PipeTransitionAll.pageScenes nm e).map len}; six objects: {(PipeTransitionAll.lagScenes sy nm e).map len}"
  return 0

/-- the number `left` of the change into the room on real frames: the movie's entry, the reference entry, the real entries; no input, random inputs without Start, random inputs -/
def pipeBoundCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := PipeChangeBound.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let e := PipeTransition.entry m0
  let lf := PipeChangeBound.leftOf sy nm sy.EngVerticalPipe (PipeChangeBound.tableOf sy nm e 48 43) 43
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let mut frames := 0
  let mut bad := 0
  let mut least := 100000
  let mut s : UInt64 := 4242
  for m in [e, t] ++ (PipeTransitionAll.realEntries sy m0 25 13).map (·.2) do
    if lf m != 91 then bad := bad + 1
    for kind in [0, 1, 2] do
      let mut c := m
      let mut j := 0
      let mut done := false
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let c2 := PipeTransition.frame c (if kind == 0 then 0 else if kind == 1 then r &&& 0xEF else r)
        if lf c > lf c2 + 1 then bad := bad + 1
        c := c2
        j := j + 1
        if controllable sy c then
          done := true
          if lf c != 0 then bad := bad + 1
          if j < least then least := j
      frames := frames + j
  IO.println s!"frames {frames}, frames where left falls by more than one or control with left not 0: {bad}, least frames to control {least}"
  return if bad == 0 then 0 else 1

/-- the side pipe's condition on one state and the number of frames left: the check, as a program, then real entries with no input, with random inputs without Start, with random inputs, with Start held -/
def sideBoundCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := SideChangeBound.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let e := SideTransition.entry m0
  let E := SideChangeBound.sideEnv nm e
  let V := SideChangeBound.refsOf nm e
  let tbl := SideChangeBound.tableFrom sy nm 122 (PipeTransition.run e (PipeTransition.zeros 160))
  let lf := PipeChangeBound.leftOf sy nm sy.EngSidePipe tbl 122
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let real := (starts.filterMap (sideWalkToEntry sy 300)).map fun p => PipeTransition.frame p SideTransition.walkIn
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideChangeBound.allCheck sy nm e (e :: real) 160 122
  IO.println s!"the check of one frame: {ok} ({(← IO.monoMsNow) - t0} ms)"
  let all := e :: t :: real
  IO.println s!"entries {all.length}; with the condition {(all.filter (SideChangeBound.entryOK E V 160)).length}"
  -- the overwritten states with a shorter change: the condition excludes them
  let snm := SideTransitionAll.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let p := SideTransition.pre m0
  let page := (SideTransitionAll.pageBefore sy snm).map fun c => SideTransitionAll.entryWith p c
  let zero := PipeTransition.frame (poke (SideTransition.atX sy p (SideTransition.zeroX sy)) (nm.ad "ChangeAreaTimer") 5) SideTransition.walkIn
  IO.println s!"shorter changes: {(zero :: page).map fun m => (PipeTransitionAll.lengthOf sy m 800 0, SideChangeBound.entryOK E V 160 m)} (length, condition)"
  let mut frames := 0
  let mut bad := 0
  let mut least := 100000
  let mut noCtl := 0
  let pn := PipeTransitionAll.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let mut laggy : List Nat := []
  let mut s : UInt64 := 4242
  for m in all do
    if lf m != 282 then bad := bad + 1
    for kind in [0, 1, 2, 3] do
      let mut c := m
      let mut j := 0
      let mut done := false
      let mut lg := 0
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let c2 := PipeTransition.frame c (if kind == 0 then 0 else if kind == 1 then r &&& 0xEF else if kind == 2 then r else 0x10)
        if lf c > lf c2 + 1 then bad := bad + 1
        if lf c > lf c2 && CastleToLevel.phaseOf pn c2 == CastleToLevel.phaseOf pn c then lg := lg + 1
        c := c2
        j := j + 1
        if controllable sy c then
          done := true
          if lf c != 0 then bad := bad + 1
          if j < least then least := j
      if !done then noCtl := noCtl + 1
      laggy := lg :: laggy
      frames := frames + j
  IO.println s!"frames {frames}, frames where left falls by more than one or control with left not 0: {bad}, least frames to control {least}, runs with no control in 1500 frames {noCtl}; frames in one run where the timers do not run and left falls: {laggy.eraseDups}"
  return if ok && bad == 0 then 0 else 1

/-- the frames from the first control in the room to the side pipe: the check, as a program, then the conditions on real frames: the movie, real entries with random inputs and pauses, a big Mario, runs to the right -/
def screenCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let nm := ScreenPage.namesOf (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let r := SideTransition.pre m0
  let P := ScreenPage.placesOf sy nm m0 r
  let Z := ScreenPage.aidsOf sy nm m0
  let E := ScreenPage.envOf nm sy r
  let K := ScreenPage.knownOf nm
  let pauseI := ((nm.ad "GamePauseStatus") &&& 0x7FF).toNat
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => ScreenPage.searchOf P Z E r K
  let t1 ← IO.monoMsNow
  IO.println s!"the search: {X.steps} steps, {X.forks} forks, {X.fails} failures, {X.joins} joins, {X.done.size} keys, {X.ends.size} frame ends, {t1 - t0} ms"
  let ok ← IO.lazyPure fun _ => ScreenPage.walkCheck P Z E r K
  let t2 ← IO.monoMsNow
  let C ← IO.lazyPure fun _ => ScreenPage.cfgOf P Z E r K
  IO.println s!"the check: {ok}, {t2 - t1} ms; table {C.t.size}; known bytes {K.length}; long timer {P.long}"
  flush
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  -- the movie, from its first control in the room
  let mut t := powerOn cart 0
  let mut k := 0
  let mut seenPipe := false
  while k < inputs.size && !(seenPipe && controllable sy t) do
    t := runFrame t inputs[k]!
    k := k + 1
    if (peek t sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then seenPipe := true
  IO.println s!"the movie: first control in the room on movie frame {k}, in the condition: {ScreenPage.roomOK E r K t}"
  let c0 := t
  let mut rm : ScreenPage.Report := {}
  while k < inputs.size && ScreenPage.roomOK E r K t do
    let (a, b) := ScreenPage.scanFrame P E r K pauseI t inputs[k]! rm
    rm := a
    t := b
    k := k + 1
  IO.println s!"the movie in the room: {rm.show}"
  flush
  -- real entries into the room
  let reals := PipeTransitionAll.realEntries sy m0 25 13
  let rec toCtl (fu : Nat) (c : Machine) : Option Machine :=
    match fu with
    | 0 => none
    | fu' + 1 => if controllable sy c then some c else toCtl fu' (PipeTransition.frame c 0)
  let ctls0 := reals.filterMap fun q => toCtl 400 q.2
  IO.println s!"real entries into the room {reals.length}, first control {ctls0.length}, in the condition {(ctls0.filter (ScreenPage.roomOK E r K)).length}"
  -- other histories: random inputs on the pipe, then Down; and other values at the start of 1-1
  let mut s : UInt64 := 88172645463325252
  let mut hist : Array Machine := #[]
  let pokes : List (List (UInt16 × UInt8)) := [[], [(sy.NumberofLives, 0)], [(sy.NumberofLives, 8), (nm.ad "CoinTally", 57)], [(nm.ad "CoinTally", 99), (nm.ad "PlayerScoreDisplay", 9), (nm.ad "GameTimerDisplay", 2)],
    [(nm.ad "HalfwayPage", 0), (nm.ad "Hidden1UpFlag", 1)], [(nm.ad "FrameCounter", 77), (nm.ad "PseudoRandomBitReg", 200)]]
  for pk in pokes do
    let st := PipeTransition.standing (pk.foldl (fun c q => poke c q.1 q.2) m0)
    for _ in [0:12] do
      let mut c := st
      s := s ^^^ (s <<< 13)
      s := s ^^^ (s >>> 7)
      s := s ^^^ (s <<< 17)
      let wait := (s >>> 25).toNat % 120
      for _ in [0:wait] do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        c := PipeTransition.frame c ((s >>> 13).toUInt8 &&& 0xC3)
      let mut n := 0
      while n < 60 && (peek c sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe do
        c := PipeTransition.frame c 0x04
        n := n + 1
      if (peek c sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then
        match toCtl 400 c with
        | some q => hist := hist.push q
        | none => pure ()
  IO.println s!"other histories (random inputs on the pipe, other values at the start of 1-1): first control {hist.size}, in the condition {(hist.toList.filter (ScreenPage.roomOK E r K)).length}"
  flush
  -- the game timer near 100 at the first control: the hurrying music
  let hurry := (ctls0.take 3).map fun c => poke (poke (poke c (nm.ad "GameTimerDisplay") 1) ((nm.ad "GameTimerDisplay") + 1) 0) ((nm.ad "GameTimerDisplay") + 2) 2
  let mut rh : ScreenPage.Report := {}
  for c in hurry do
    let mut c1 := c
    let mut n := 0
    while n < 300 && ScreenPage.roomOK E r K c1 do
      let (a, b) := ScreenPage.scanFrame P E r K pauseI c1 0 rh
      rh := a
      c1 := b
      n := n + 1
  IO.println s!"the game timer near 100, written at the first control: {rh.show}"
  flush
  -- right of the pipe, written: he runs right past the screen, with pauses
  let mut rp : ScreenPage.Report := {}
  let mut far := 0
  let mut farPage := 0
  for c in (c0 :: ctls0.take 3) do
    for x in [212, 230, 250] do
      let mut c1 := poke (poke c sy.Player_X_Position x.toUInt8) sy.Player_Y_Position 0x70
      let mut n := 0
      while n < 400 && (ScreenPage.roomOK E r K c1) do
        let i : UInt8 := if n % 97 == 96 then 0x10 else if n % 40 < 8 then 0xC1 else 0x41
        let (a, b) := ScreenPage.scanFrame P E r K pauseI c1 (smbToPad i) rp
        rp := a
        c1 := b
        n := n + 1
        let px := 256 * (peek c1 sy.Player_PageLoc).toNat + (peek c1 sy.Player_X_Position).toNat
        if px > far then far := px
        if (peek c1 sy.Player_PageLoc).toNat > farPage then farPage := (peek c1 sy.Player_PageLoc).toNat
  IO.println s!"right of the pipe, written, holding Right and B with pauses: {rp.show}; the furthest pixel {far}, his page {farPage}"
  flush
  let ctls := ctls0 ++ hist.toList.filter (ScreenPage.roomOK E r K)
  -- random inputs with pauses, runs to the right, jumps
  let big := fun (c : Machine) => poke (poke c sy.PlayerSize 0) (nm.ad "PlayerStatus") 1
  let mut bad := 0
  for (name, starts) in [("small", c0 :: ctls), ("big", (c0 :: ctls.take 3).map big)] do
    let mut rr : ScreenPage.Report := {}
    for c in starts do
      if !ScreenPage.roomOK E r K c then bad := bad + 1
      for style in [0, 1, 2, 3, 4] do
        let mut c1 := c
        let mut n := 0
        let mut left := 0
        let mut hold : UInt8 := 0
        while n < 900 && ScreenPage.roomOK E r K c1 do
          if left == 0 then
            s := s ^^^ (s <<< 13)
            s := s ^^^ (s >>> 7)
            s := s ^^^ (s <<< 17)
            left := 1 + (s >>> 20).toNat % 40
            let bits := (s >>> 30).toUInt8
            hold := if style == 0 then bits else if style == 1 then bits &&& 0xEF else if style == 2 then (bits &&& 0xC0) ||| 0x01 else if style == 3 then bits &&& 0xD2 else (bits &&& 0x80) ||| 0x41
          let (a, b) := ScreenPage.scanFrame P E r K pauseI c1 (smbToPad hold) rr
          rr := a
          c1 := b
          n := n + 1
          left := left - 1
    IO.println s!"{name}, random inputs: {rr.show}"
    flush
  return if ok && bad == 0 then 0 else 1

/-- the last frames of the change out of the side pipe: the check, as a program, then real entries with inputs that have no Start after the pipe -/
def sideEndCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let pn := PipeTransitionAll.namesFrom text
  let e := SideTransition.entry m0
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideChangeEnd.endCheck sy nm nx e 160 122
  IO.println s!"the check: {ok} ({(← IO.monoMsNow) - t0} ms)"
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let real := (starts.filterMap (sideWalkToEntry sy 300)).map fun p => PipeTransition.frame p SideTransition.walkIn
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let all := e :: t :: real
  let E2 := SideChangeBound.sideEnv nm e
  let V2 := SideChangeEnd.refs2 nm nx e
  IO.println s!"entries {all.length}; with the condition {(all.filter (SideChangeBound.entryOK E2 V2 160)).length}"
  let x := PipeTransition.run e (PipeTransition.zeros 160)
  let lf := PipeChangeBound.leftOf sy nm sy.EngSidePipe (SideChangeBound.tableFrom sy nm 122 x) 122
  let E3 := SideChangeEnd.rowsEnv nm nx e
  let K := SideChangeEnd.exitKnown nx
  let gps := SideChangeEnd.adI nx "GamePauseStatus"
  let mut bad := 0
  let mut exits := 0
  let mut frames := 0
  let mut stays : List Nat := []
  let mut least := 100000
  let mut s : UInt64 := 4242
  -- the time at the exit (`TimeOK`), and `left` 0 before control
  let timeOKb := fun (m : Machine) => m.ram.get! (SideChangeEnd.adI nx "PauseModeFlag") == 0 && (SideChangeEnd.digitsOf nx).any fun i => m.ram.get! i != 0
  let mut timeOk := 0
  let mut zeroBefore := 0
  for m in all do
    for kind in [0, 1, 2] do
      let mut c := m
      let mut j := 0
      let mut after := false
      let mut done := false
      let mut ps := 0
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        -- no input; random inputs without Start; Start only on the first 80 frames
        let c2 := PipeTransition.frame c (if kind == 0 then 0 else if kind == 1 || j ≥ 80 then r &&& 0xEF else r)
        if after && lf c != lf c2 + 1 then bad := bad + 1
        if after && CastleToLevel.phaseOf pn c2 == CastleToLevel.phaseOf pn c then ps := ps + 1
        if !after && !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
          after := true
          if SideChangeEnd.exitOK E3 x K gps c2 then exits := exits + 1 else bad := bad + 1
          if timeOKb c2 then timeOk := timeOk + 1
        c := c2
        j := j + 1
        if controllable sy c then
          done := true
          if lf c != 0 then bad := bad + 1
          if j < least then least := j
        else if lf c == 0 then zeroBefore := zeroBefore + 1
      if !done then bad := bad + 1
      stays := ps :: stays
      frames := frames + j
  IO.println s!"runs {3 * all.length}, frames {frames}; the condition at the exit holds on {exits}; bad frames (after the exit left does not fall by exactly one, the condition fails, no control or control with left not 0): {bad}; least frames to control {least}; frames after the exit where the timers do not run, in one run: {stays.eraseDups}"
  IO.println s!"the time at the exit (pause flag 0, timer not 000) holds on {timeOk} of {3 * all.length} runs; frames before control with left 0: {zeroBefore}"
  -- Start on the frames of the pipe: where the condition at the exit holds, the time at the exit holds too
  let mut q3 := 0
  let mut t3 := 0
  let mut f3 := 0
  let mut x3 := 0
  -- and the frames where the timers do not run (`lag`, and the one `setup` frame after the exit): do they end paused (`Paused`)?
  let pausedB := fun (m : Machine) => m.ram.get! gps &&& 1 == 1
  let mut lagPipe := 0
  let mut lagPipeNot := 0
  let mut pausedPipe := 0
  let mut pausedFall := 0
  let mut lagAfter := 0
  let mut lagAfterPaused := 0
  for m in all do
    for _ in [0:6] do
      let mut c := m
      let mut j := 0
      let mut after := false
      let mut done := false
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let c2 := PipeTransition.frame c (if !after && (s >>> 40) % 9 == 0 then r ||| 0x10 else r &&& 0xEF)
        let still := CastleToLevel.phaseOf pn c2 == CastleToLevel.phaseOf pn c
        if !after then
          if still then
            lagPipe := lagPipe + 1
            if !pausedB c2 then lagPipeNot := lagPipeNot + 1
          if pausedB c2 && PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
            pausedPipe := pausedPipe + 1
            if lf c > lf c2 then pausedFall := pausedFall + 1
        else if still then
          lagAfter := lagAfter + 1
          if pausedB c2 then lagAfterPaused := lagAfterPaused + 1
        if !after && !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
          after := true
          x3 := x3 + 1
          if c2.ram.get! (SideChangeEnd.adI nx "PauseModeFlag") != 0 then f3 := f3 + 1
          if SideChangeEnd.exitOK E3 x K gps c2 then
            q3 := q3 + 1
            if timeOKb c2 then t3 := t3 + 1
          else done := true
        c := c2
        j := j + 1
        if controllable sy c then done := true
  IO.println s!"Start at random on the frames of the pipe: exits {x3}, with the pause flag not 0 {f3}, with the condition at the exit {q3}, of these with the time at the exit {t3}"
  IO.println s!"  frames of the pipe where the timers do not run {lagPipe}, of these not paused at the end {lagPipeNot}; frames of the pipe that end paused {pausedPipe}, of these with left falling {pausedFall}"
  IO.println s!"  after an exit with the condition, frames where the timers do not run {lagAfter} (one per run is the setup frame), of these paused at the end {lagAfterPaused}"
  -- the time up: entries with the game timer at 000, or at 001
  let mut upRows : List String := []
  for (name, d) in [("000", (0 : UInt8)), ("001", 1)] do
    for m in (all.take 6) do
      let gt := nx.ad "GameTimerDisplay"
      let mut c := poke (poke (poke m gt 0) (gt + 1) 0) (gt + 2) d
      let mut j := 0
      let mut after := false
      let mut tOK := false
      let mut zero : Option (Nat × Bool × UInt8) := none
      while zero.isNone && j < 600 do
        let c2 := PipeTransition.frame c 0
        if !after && !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
          after := true
          tOK := timeOKb c2
        c := c2
        j := j + 1
        if after && lf c == 0 then zero := some (j, controllable sy c, peek c sy.GameEngineSubroutine)
      upRows := s!"{name}: time at the exit {tOK}, first left 0 (frame, control, routine) {zero}" :: upRows
  IO.println s!"the game timer written at the entry: {upRows.reverse.eraseDups}"
  return if ok && bad == 0 && zeroBefore == 0 && timeOk == 3 * all.length && t3 == q3 && lagPipeNot == 0 && pausedFall == 0 && lagAfterPaused == 0 && lagAfter == q3 then 0 else 1

/-- a real frame and the horizontal model: the check on the ROM, then `Clean` and the frame's end on the movie, and on inputs of the room -/
def frameModelCheck (sy : Syms) (romPath fm2 : String) (runs : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let S := FrameModel.ctrlStack sy m0
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => FrameModel.modelOK sy m0 S
  IO.println s!"the check on the ROM: {ok}, {(← IO.monoMsNow) - t0} ms; stack at the player's routine {S}"
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let bump := fun (l : List (String × Nat)) (k : String) => match l.lookup k with
    | some n => (k, n + 1) :: l.filter (·.1 != k)
    | none => (k, 1) :: l
  -- every frame of the movie in control
  let mut m := powerOn cart 0
  let mut ctl := 0
  let mut clean := 0
  let mut bad := 0
  let mut why : List (String × Nat) := []
  let mut maxLen := 0
  let mut minRest := 1000000
  let mut writers : List UInt16 := []
  let mut readOK := 0
  let mut readBad := 0
  let mut whyR : List (String × Nat) := []
  let mut c0 : Option Nat := none
  let mut room : Option (Machine × Nat) := none
  for k in [0:min inputs.size 6000] do
    let hasCtl := controllable sy m
    if hasCtl && c0.isNone then c0 := some k
    if c0.isSome && k == c0.getD 0 + 459 + 1 then room := some (m, k)
    let i := smbToPad inputs[k]!
    let r := FrameModel.scanFrame sy S m i
    if hasCtl then
      ctl := ctl + 1
      maxLen := max maxLen r.len
      minRest := min minRest r.rest
      writers := r.writers.foldl (fun l p => if l.contains p then l else p :: l) writers
      if r.fails.isEmpty then
        clean := clean + 1
        if !FrameModel.agrees sy m0 m r then bad := bad + 1
      else
        for w in r.fails do why := bump why w
      if r.rfails.isEmpty then
        readOK := readOK + 1
        -- what `TopSpeed.Frame` says of the frame
        let V := fun (x : Machine) => 256 * sbyte (peek x sy.Player_X_Speed) + ((peek x sy.Player_X_MoveForce).toNat : Int)
        if !(TopSpeed.inSpeed sy (peek r.next sy.Player_X_Speed) && decide (posP sy r.next - posP sy m ≤ 16 * (TopSpeed.top sy : Int)) &&
            decide (V r.next ≤ max (V m) 0 + amax sy m0)) then readBad := readBad + 1
      else
        for w in r.rfails do whyR := bump whyR w
    m := r.next
  IO.println s!"movie: {ctl} frames in control, {clean} clean, not as the model {bad}; not clean because {why}; longest movement {maxLen} instructions (allowed {FrameModel.moveLen}), least after the arrival {minRest}; {writers.length} writers after the movement"
  IO.println s!"movie, as TopSpeed.Frame: {readOK} frames, not as the frame says {readBad}; not such a frame because {whyR}"
  -- the room: frames that follow the model, or leave him stopped
  let some (r0, k0) := room | do
    IO.println "no room"
    return 1
  let cp := FastTakeoff.cornerP sy
  let goal := FastTakeoff.goalP sy
  let stopPhi := 255 + Potential.gFast sy m0 + Potential.c sy m0
  let runRoom := fun (name : String) (pads : Array UInt8) (t : Nat × Nat × Nat × Nat × List String) => Id.run do
    let mut (fr, cl, st, wrong, ex) := t
    let mut c := r0
    let mut n := 0
    for i in pads do
      if decide (goal ≤ posP sy c) || peek c sy.GameEngineSubroutine != sy.Eng_PlayerCtrl.toUInt8 then break
      let r := FrameModel.scanFrame sy S c i
      fr := fr + 1
      if r.fails.isEmpty then
        cl := cl + 1
        if !FrameModel.agrees sy m0 c r then
          wrong := wrong + 1
          if ex.length < 8 then ex := s!"{name} +{n}: not as the model" :: ex
      else
        let hs := FrameModel.readHS sy r.next
        if Potential.inD sy hs && decide (Potential.phi sy m0 hs ≤ stopPhi) && decide (posP sy r.next ≤ cp + 4096) && r.rfails.isEmpty then
          st := st + 1
        else
          wrong := wrong + 1
          if ex.length < 8 then ex := s!"{name} +{n}: {r.fails} {r.rfails} v {sbyte hs.v} P {posP sy r.next - cp}" :: ex
      c := r.next
      n := n + 1
    return (fr, cl, st, wrong, ex)
  let base : Array UInt8 := ((List.range 180).toArray.map fun j => smbToPad inputs[k0 + j]!)
  let mut t := runRoom "movie" base (0, 0, 0, 0, [])
  IO.println s!"room, the movie: frames {t.1}, clean {t.2.1}, stopped {t.2.2.1}, neither {t.2.2.2.1}"
  let next := fun (z : Nat) => (z * 1103515245 + 12345) % 2147483648
  t := (0, 0, 0, 0, [])
  let mut z := 7
  for r in [0:runs] do
    let mut pads : Array UInt8 := #[]
    let mut hold := 0
    let mut b : UInt8 := 0
    for _ in [0:200] do
      z := next z
      if hold == 0 then
        hold := 1 + (z / 65536) % 24
        z := next z
        b := ((z / 65536) % 256).toUInt8 &&& 0xCF
        if r % 3 == 0 then b := (b &&& 0xC0) ||| 0x02
        if r % 3 == 1 then b := (b &&& 0xC0) ||| 0x01
      else
        hold := hold - 1
      pads := pads.push b
    t := runRoom s!"random {r}" pads t
  IO.println s!"room, {runs} runs of random inputs: frames {t.1}, clean {t.2.1}, stopped {t.2.2.1}, neither {t.2.2.2.1}"
  for e in t.2.2.2.2 do IO.println e
  return if ok && bad == 0 && readBad == 0 && t.2.2.2.1 == 0 then 0 else 1

/-- the change into the room on real frames: the check of the frames, the conditions on real entries, on the frames of the pipe and at the exit, `left` on real frames with inputs -/
def pipeEndCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let t0 ← IO.monoMsNow
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  IO.println s!"rows: song {d.song.length}, the buffer at the exit {d.xshape.length}, the places {d.places.map (·.rows.length)}; {(← IO.monoMsNow) - t0} ms"
  (← IO.getStdout).flush
  let t1 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => PipeChangeEnd.endCheck sy nm d e [e]
  IO.println s!"the check: {ok} ({(← IO.monoMsNow) - t1} ms)"
  (← IO.getStdout).flush
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let tbl ← IO.lazyPure fun _ => PipeChangeBound.tableOf sy nm e 48 43
  let lf := PipeChangeBound.leftOf sy nm sy.EngVerticalPipe tbl 43
  let places ← IO.lazyPure fun _ => d.places
  let xq := PipeChangeEnd.exitQ sy nm e
  let pn := PipeTransitionAll.namesFrom txt
  let mut bad := 0
  let mut s : UInt64 := 4242
  let all := [e, t] ++ (PipeTransitionAll.realEntries sy m0 25 13).map (·.2)
  for kind in [0, 1, 2] do
    let mut entries := 0
    let mut frames := 0
    let mut placeBad := 0
    let mut exits := 0
    let mut quietBad := 0
    let mut leftBad := 0
    let mut least := 100000
    -- the `lag` frames: the phase stays and `left` does not fall
    let mut lags := 0
    let mut lagBad := 0
    for m in all do
      if PipeChangeEnd.entryOKp d e m then entries := entries + 1 else bad := bad + 1
      let mut c := m
      let mut j := 0
      let mut after := false
      let mut done := false
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let inP := PipeChangeBound.inPipe sy sy.EngVerticalPipe c
        -- 0: no input; 1: random inputs without Start; 2: random inputs, Start only on the pipe's frames
        let i := if kind == 0 then 0 else if kind == 1 || !inP then r &&& 0xEF else r
        if inP && !PipeChangeEnd.placesOK places c i then placeBad := placeBad + 1
        let c2 := PipeTransition.frame c i
        if lf c > lf c2 + 1 then leftBad := leftBad + 1
        if CastleToLevel.phaseOf pn c2 == CastleToLevel.phaseOf pn c && !decide (lf c2 < lf c) then
          lags := lags + 1
          if !PipeChangeEnd.pausedB d c2 then lagBad := lagBad + 1
        if !after && !PipeChangeBound.inPipe sy sy.EngVerticalPipe c2 then
          after := true
          exits := exits + 1
          if !(xq.all (fun p => c2.ram.get! p.1 == p.2) && (PipeChangeEnd.quietQ d e).all (fun p => c2.ram.get! p.1 == p.2) &&
              d.song.any (fun q => q.all fun p => c2.ram.get! p.1 == p.2) && d.xshape.any (fun q => q.all fun p => c2.ram.get! p.1 == p.2)) then quietBad := quietBad + 1
        c := c2
        j := j + 1
        if controllable sy c then
          done := true
          if lf c != 0 then leftBad := leftBad + 1
          if j < least then least := j
      frames := frames + j
    IO.println s!"inputs {kind}: entries {all.length}, with the condition {entries}; frames {frames}, frames of the pipe against the places {placeBad}; exits {exits}, against the condition at the exit {quietBad}; frames where left falls by more than one {leftBad}; least frames to control {least}; `lag` frames {lags}, not paused at their end {lagBad}"
    bad := bad + placeBad + leftBad + lagBad + (if kind == 2 then 0 else quietBad)
  return if ok && bad == 0 then 0 else 1

/-- the state at the first control in the room: the check on the rows of the change into the room, then `first₁` and the state at control on the movie and on random inputs -/
def roomStartCheck (sy : Syms) (romPath fm2 : String) (runs : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let nmS := ScreenPage.namesOf txt
  let e := PipeTransition.entry m0
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let rm := FastTakeoff.bonusRoom sy 0 0 0 0
  -- the numbers of `v_start` as the private proof has them: 50 px, 2.375 px per frame, the machine's fall force
  let (yMax, wMax, vfd) : Int × Int × Nat := (256 * 50, 608, (peek m0 sy.VerticalForceDown).toNat)
  let t1 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => RoomStart.startCheck sy nm d e rm yMax wMax vfd
  IO.println s!"the check: {ok} ({(← IO.monoMsNow) - t1} ms)"
  (← IO.getStdout).flush
  let c := PipeChangeEnd.ctxOf sy nm d e
  let rA ← IO.lazyPure fun _ => PipeChangeEnd.rowsA c d e
  let rB ← IO.lazyPure fun _ => PipeChangeEnd.rowsB c d e
  let cA := RoomStart.rowCount sy rm yMax wMax vfd rA
  let cB := RoomStart.rowCount sy rm yMax wMax vfd rB
  IO.println s!"rows A: {rA.length} rows, {cA.1} states, with control {cA.2.1}, failing {cA.2.2}; rows B: {rB.length} rows, {cB.1} states, with control {cB.2.1}, failing {cB.2.2}"
  -- the room's condition of `ScreenPage` on the states with control
  let r := ScreenPage.refR m0
  let K := ScreenPage.knownOf nmS
  let nameOf := fun (i : Nat) => match nmS.find? (fun p => (p.2 &&& 0x7FF) == i) with
    | some p => p.1
    | none => match nmS.find? (fun p => (p.2 &&& 0x7FF) ≤ i && i < (p.2 &&& 0x7FF) + 9) with
      | some p => s!"{p.1}+{i - (p.2 &&& 0x7FF)}"
      | none => s!"{i}"
  let t2 ← IO.monoMsNow
  let ok2 ← IO.lazyPure fun _ => ScreenStart.roomCheck sy nm d e nmS m0
  IO.println s!"the check of the room's condition without {ScreenStart.restNames}: {ok2} ({(← IO.monoMsNow) - t2} ms); the bytes as names {(ScreenStart.restIdx nmS).map nameOf}"
  let mut miss : List Nat := []
  let mut roomBad := 0
  let mut other := 0
  for S in RoomStart.ctlStates sy rA ++ RoomStart.ctlStates sy rB do
    if !(ScreenPage.startsR r K).any (S.le ·) then
      roomBad := roomBad + 1
      for p in K do
        if !(S.getK p.1).le ⟨r.ram.get! p.1, p.2⟩ && !miss.contains p.1 then miss := miss ++ [p.1]
      IO.println s!"  a state with control, the five bytes as (value, known bits; the reference's value, the mask): {(ScreenStart.restIdx nmS).map fun i => (nameOf i, (S.getK i).v, (S.getK i).k, r.ram.get! i, ((K.find? (·.1 == i)).map (·.2)).getD 0)}"
      let T := if S.lo == 0 then ScreenPage.startR r K true else ScreenPage.startR r K false
      if !(S.pc == T.pc && S.s == T.s && S.k == T.k && S.vb == T.vb && S.nmi == T.nmi && S.ppuCtrl.le T.ppuCtrl && decide (T.lo ≤ S.lo) && decide (S.hi ≤ T.hi) && S.rk == T.rk && S.spent == T.spent && S.strobe == T.strobe) then
        other := other + 1
        if other ≤ 3 then IO.println s!"  not RAM: pc {S.pc}/{T.pc} s {S.s}/{T.s} k {S.k} vb {S.vb} nmi {S.nmi} lo {S.lo} hi {S.hi} ppuCtrl {S.ppuCtrl.v}/{S.ppuCtrl.k} rk {S.rk} spent {S.spent} strobe {S.strobe}"
  IO.println s!"Room on the states with control: failing {roomBad}, of them not in RAM {other}; bytes of K not known as in the reference: {miss.map nameOf}"
  for S in RoomStart.ctlStates sy rA ++ RoomStart.ctlStates sy rB do
    let bs := [sy.Player_State, sy.Player_Y_Position, sy.Player_YMF_Dummy, sy.Player_Y_Speed, sy.Player_Y_MoveForce, sy.VerticalForceDown, sy.Player_XSpeedAbsolute, sy.VerticalForce, sy.JumpOrigin_Y_Position, sy.A_B_Buttons]
    IO.println s!"  vertical bytes and stored speed at control (value, known bits): {bs.map fun a => ((S.getK (a &&& 0x7FF).toNat).v, (S.getK (a &&& 0x7FF).toNat).k)}; the machine's VerticalForceDown {peek m0 sy.VerticalForceDown}"
  (← IO.getStdout).flush
  -- real runs: the movie, and from real entries with random inputs
  let lf := PipeChangeBound.leftOf sy nm sy.EngVerticalPipe (PipeChangeBound.tableOf sy nm e 48 43) 43
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  -- the movie, from its entry to control
  let mut tm := t
  let mut tmFirst := 0
  while k < inputs.size && !controllable sy tm do
    if lf tm == 0 then tmFirst := tmFirst + 1
    tm := runFrame tm inputs[k]!
    k := k + 1
  let stOK := fun (x : Machine) => FrameModel.readHS sy x == rm.s0 && decide (rm.P0 ≤ posP sy x) && decide (posP sy x ≤ rm.P1) && RoomStart.vOK sy yMax wMax vfd x
  let E := ScreenPage.envR sy nmS m0
  let restOK := fun (x : Machine) => K.all fun p => !(ScreenStart.restIdx nmS).contains p.1 || x.ram.get! p.1 &&& p.2 == r.ram.get! p.1 &&& p.2
  let badK := fun (x : Machine) => (K.filter fun p => x.ram.get! p.1 &&& p.2 != r.ram.get! p.1 &&& p.2).map (nameOf ·.1)
  let xq := PipeChangeEnd.exitQ sy nm e
  IO.println s!"the movie: control at frame {k}; left 0 before control {tmFirst}; the state at control {stOK tm}; Room {ScreenPage.roomOK E r K tm}; the five bytes {restOK tm}; RoomStart bytes x {peek tm sy.Player_X_Position} page {peek tm sy.Player_PageLoc} v {peek tm sy.Player_X_Speed}"
  let mut bad := tmFirst + (if stOK tm then 0 else 1) + (if restOK tm then 0 else 1)
  let mut s : UInt64 := 4242
  let all := [e, t] ++ (PipeTransitionAll.realEntries sy m0 25 13).map (·.2)
  for kind in [0, 1, 2] do
    let mut nRuns := 0
    let mut first := 0
    let mut stBad := 0
    let mut roomNo := 0
    let mut restNo := 0
    let mut roomQuiet := 0
    let mut noCtl := 0
    let mut why : List String := []
    for m in all do
      for _ in [0:(if kind == 0 then 1 else runs)] do
        nRuns := nRuns + 1
        let mut x := m
        let mut j := 0
        let mut zero := false
        let mut after := false
        let mut quiet := true
        while j < 1500 && !controllable sy x do
          s := s ^^^ (s <<< 13)
          s := s ^^^ (s >>> 7)
          s := s ^^^ (s <<< 17)
          let rr := (s >>> 13).toUInt8
          let inP := PipeChangeBound.inPipe sy sy.EngVerticalPipe x
          let i := if kind == 0 then 0 else if kind == 1 || !inP then rr &&& 0xEF else rr
          if lf x == 0 then zero := true
          x := PipeTransition.frame x i
          if !after && !PipeChangeBound.inPipe sy sy.EngVerticalPipe x then
            after := true
            quiet := xq.all (fun p => x.ram.get! p.1 == p.2) && (PipeChangeEnd.quietQ d e).all (fun p => x.ram.get! p.1 == p.2) &&
              d.song.any (fun q => q.all fun p => x.ram.get! p.1 == p.2) && d.xshape.any (fun q => q.all fun p => x.ram.get! p.1 == p.2)
          j := j + 1
        if !controllable sy x then noCtl := noCtl + 1
        else
          if zero then first := first + 1
          if !stOK x then stBad := stBad + 1
          if !ScreenPage.roomOK E r K x then
            roomNo := roomNo + 1
            if quiet then roomQuiet := roomQuiet + 1
            for b in badK x do
              if !why.contains b then why := why ++ [b]
          if !restOK x then restNo := restNo + 1
    IO.println s!"inputs {kind}: runs {nRuns}; with no control in 1500 frames {noCtl}; left 0 before control {first}; not the room's start at control {stBad}; not Room at control {roomNo}, of them with the exit's condition {roomQuiet}, bytes {why}; not the five bytes {restNo}"
    bad := bad + first + stBad + (if kind == 2 then 0 else restNo)
  return if ok && ok2 && bad == 0 then 0 else 1

/-- an entry into the vertical pipe on real frames: the check of one frame, then the hypotheses on the movie and on random inputs -/
def pipeRuleCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let G := PipeWrites.guardOf sy m0
  let E := PipeEntryRule.envOf m0
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => PipeWrites.searchOf G E
  let t1 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => PipeWrites.frameCheck G E
  IO.println s!"one frame: {X.steps} steps, {X.forks} forks, {X.fails} failures, table {X.multi.size}; search {t1 - t0} ms; the check {ok}, {(← IO.monoMsNow) - t1} ms"
  flush
  -- the movie
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn cart 0
  let mut seen := false
  let mut k := 0
  let mut hist : Array Machine := #[]
  let mut ra : PipeWrites.Report := {}
  let mut done := false
  while k < inputs.size && !done do
    if seen then
      hist := hist.push t
      let (r, c) := PipeWrites.scanFrame sy G E t inputs[k]! ra
      ra := r
      t := c
      done := ra.entries > 0
    else
      t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  IO.println s!"the movie up to the entry (frame {k}): {ra.show}"
  flush
  let mut rb : PipeWrites.Report := {}
  let mut j := 0
  while j < 1300 && k < inputs.size do
    let (r, c) := PipeWrites.scanFrame sy G E t inputs[k]! rb
    rb := r
    t := c
    k := k + 1
    j := j + 1
  IO.println s!"the movie after the entry, {j} frames: {rb.show}"
  flush
  -- random inputs from states of the movie before the entry: small and big
  let mut z : UInt64 := 77123
  let mut rr : PipeWrites.Report := {}
  let mut bigR : PipeWrites.Report := {}
  let n := hist.size
  let picks := (List.range 240).map fun q => (q, 2 + (q * 7) % (Nat.min 340 (n - 2)))
  for (q, b) in picks do
    let mut c := hist[n - b]!
    let big := q % 4 == 3
    if big then c := poke c sy.PlayerSize 0
    let mut f := 0
    while f < 150 && (peek c sy.GameEngineSubroutine) != sy.EngVerticalPipe.toUInt8 do
      z := z ^^^ (z <<< 13)
      z := z ^^^ (z >>> 7)
      z := z ^^^ (z <<< 17)
      let w := ((z >>> 11) &&& 15).toNat
      let i : UInt8 := match w with
        | 0 | 1 | 2 | 3 | 4 | 5 => 0x41
        | 6 | 7 => 0x04
        | 8 => 0xC1
        | 9 => 0x84
        | 10 => 0x00
        | 11 => 0x42
        | 12 => 0x81
        | 13 => 0x05
        | 14 => 0x01
        | _ => ((z >>> 20) &&& 0xEF).toUInt8
      let (r, d) := PipeWrites.scanFrame sy G E c (smbToPad i) (if big then bigR else rr)
      if big then bigR := r else rr := r
      c := d
      f := f + 1
  -- walking into the window and pressing Down; jumping and landing with Down held
  let holdDown := fun (c0 : Machine) (w : List UInt8) (big : Bool) (r0 : PipeWrites.Report) => Id.run do
    let mut c := if big then poke c0 sy.PlayerSize 0 else c0
    let mut r := r0
    for i in w do
      let (r1, d) := PipeWrites.scanFrame sy G E c (smbToPad i) r
      r := r1
      c := d
    let mut f := 0
    while f < 50 && (peek c sy.GameEngineSubroutine) != sy.EngVerticalPipe.toUInt8 do
      let (r1, d) := PipeWrites.scanFrame sy G E c (smbToPad 0x04) r
      r := r1
      c := d
      f := f + 1
    return r
  let mut rw : PipeWrites.Report := {}
  for b in (List.range 16).map (· + 1) do
    for run in List.range 14 do
      rw := holdDown hist[n - b]! (List.replicate run 0x41) false rw
  IO.println s!"walking and Down: {rw.show}"
  let mut rj : PipeWrites.Report := {}
  for b in (List.range 12).map (fun q => 16 + 8 * q) do
    for a in [2, 6, 10, 14, 18, 22] do
      for r in [0, 5, 10, 15, 20] do
        rj := holdDown hist[n - b]! (List.replicate a 0xC1 ++ List.replicate r 0x41) (a == 6) rj
  IO.println s!"jumping, landing with Down: {rj.show}"
  IO.println s!"random inputs near the pipe, small: {rr.show}"
  IO.println s!"random inputs near the pipe, big (overwritten): {bigR.show}"
  let all := [ra, rb, rr, bigR, rw, rj]
  let bad := all.foldl (fun n r => n + r.eStart + r.eClean + r.eTiles + r.writeBad + r.noFoot + r.leftBad + r.posDiff) 0
  IO.println s!"the tile in the block buffers when control comes, at bytes: {(List.range G.P.bufBytes).filter (fun j => hist[0]!.ram.get! (G.P.bufLo + j) == G.P.tile)}"
  IO.println s!"totals: frames {all.foldl (fun n r => n + r.frames) 0}, entries {all.foldl (fun n r => n + r.entries) 0}, bad on entries {bad}"
  return if ok && bad == 0 then 0 else 1

/-- one real frame for `pipe-frames-check`: the machine after the move (at `PlayerSubs`, after the player's routine began), if there is one, and the machine at the frame's end -/
def pipeFrameRun (sy : Syms) (m : Machine) (i : UInt8) : Option Machine × Machine := Id.run do
  let t := m.frame + 1
  let mut c : Machine := { m with pad := smbToPad i }
  let mut n := 0
  let mut arr := false
  let mut sub : Option Machine := none
  while n < fuelPerFrame && !(decide (c.frame ≥ t) || c.halted) do
    if c.pc == sy.PlayerCtrlRoutine then arr := true
    if arr && sub.isNone && c.pc == sy.PlayerSubs then sub := some c
    c := PipeEntryRule.nxt t c
    n := n + 1
  return (sub, c)

/-- Is there a `TopSpeed.Frame` that begins with the bytes of `a`, ends with those of `b`, and moves as the machine `s` after the move says? `none` when there is one, or the reason. -/
def pipeFrameWhy (sy : Syms) (am : Int) (a : Machine) (s : Option Machine) (b : Machine) : Option String :=
  let top := (TopSpeed.top sy : Int)
  let v := SurfaceFrames.vOf sy a
  let f := SurfaceFrames.fOf sy a
  let P := posP sy a
  let v' := SurfaceFrames.vOf sy b
  let f' := SurfaceFrames.fOf sy b
  let P' := posP sy b
  let inR := fun (x : Int) => decide (-top ≤ x ∧ x ≤ top)
  match s with
  | none =>
    -- no move: a frame that changes nothing is a frame only standing still (v₂ = 0) or moving left (v₂ = v)
    if v' == v && f' == f && P' == P && (v == 0 || (v < 0 && inR v)) then none else some "no move"
  | some s =>
    let v₂ := SurfaceFrames.vOf sy s
    let f₂ := SurfaceFrames.fOf sy s
    let P₂ := posP sy s
    -- `anim`: v₁ = v ∧ f₁ = f, or both 0
    let ok1 := (!inR v || inR v₂) && decide (256 * v₂ + f₂ ≤ max (256 * v + f) 0 + am)
    let ok2 := inR v₂ && decide (256 * v₂ + f₂ ≤ am)
    if !(ok1 || ok2) then some "friction"
    else if P₂ != P + 16 * v₂ then some "move"
    else if !(v' == v₂ || v' == 0) then some "impedeV"
    else if f' != f₂ then some "impedeF"
    else if !(P' == P₂ || P' == P₂ - 256 || (decide (P' ≤ P + 256) && decide (v₂ ≤ 0))) then some "impedeP"
    else none

/-- Is there any `TopSpeed.Frame` that begins with the bytes of `a` and ends with those of `b`? `Reads` asks no more of a frame between frame `N` and the entry. A witness is searched
with `v₂` in a byte's range, `f₂ = f'` and `P₂ = P + 16·v₂`. -/
def pipeFrameExists (sy : Syms) (am : Int) (a b : Machine) : Bool :=
  let top := (TopSpeed.top sy : Int)
  let v := SurfaceFrames.vOf sy a
  let f := SurfaceFrames.fOf sy a
  let P := posP sy a
  let v' := SurfaceFrames.vOf sy b
  let f' := SurfaceFrames.fOf sy b
  let P' := posP sy b
  let inR := fun (x : Int) => decide (-top ≤ x ∧ x ≤ top)
  (List.range 256).any fun k =>
    let v₂ : Int := (k : Int) - 128
    let P₂ := P + 16 * v₂
    let gainOK := fun (v₁ f₁ : Int) => (!inR v₁ || inR v₂) && decide (256 * v₂ + f' ≤ max (256 * v₁ + f₁) 0 + am)
    (gainOK v f || gainOK 0 0) && (v' == v₂ || v' == 0) && (P' == P₂ || P' == P₂ - 256 || (decide (P' ≤ P + 256) && decide (v₂ ≤ 0)))

/-- how many times a real frame enters `ImpedePlayerMove` -/
def impedeCalls (sy : Syms) (m : Machine) (i : UInt8) : Nat := Id.run do
  let t := m.frame + 1
  let mut c : Machine := { m with pad := smbToPad i }
  let mut n := 0
  let mut k := 0
  while n < fuelPerFrame && !(decide (c.frame ≥ t) || c.halted) do
    if c.pc == sy.ImpedePlayerMove then k := k + 1
    c := PipeEntryRule.nxt t c
    n := n + 1
  return k

/-- the frames of part a read from the machines (`PipeFrames.Reads`, `Route.Pipe.still`): the speed at control, after several waits on the title screen; then the counted frames from
control to the entry on the movie and on own inputs: each is a `TopSpeed.Frame` from its machine to the machine of the next counted frame, a `lag` frame between them changes none of
the speed, the subspeed and the position, and the bounds of the opening on the movie -/
def pipeFramesCheck (sy : Syms) (romPath fm2 : String) (nRuns : Nat := 160) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let nm := CastleToLevel.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let am := amax sy m0
  let bytes3 := fun (x : Machine) => (SurfaceFrames.vOf sy x, SurfaceFrames.fOf sy x, posP sy x)
  let mut bad := 0
  -- the speed at control: Start pressed on the title screen at frame 39 + d
  let mut still := 0
  let mut sameHS := 0
  let ds := List.range 120
  for d in ds do
    let mut m := powerOn cart 0
    let mut k := 0
    let mut got : Option Machine := none
    while k < 900 && got.isNone do
      m := runFrame m (if k == 39 + d then 0x08 else 0)
      if k > 39 + d && controllable sy m then got := some m
      k := k + 1
    match got with
    | some c =>
      if SurfaceFrames.vOf sy c == 0 then still := still + 1 else bad := bad + 1
      if Potential.startHS sy c == Potential.startHS sy m0 && posP sy c == posP sy m0 then sameHS := sameHS + 1
    | none => bad := bad + 1
  IO.println s!"title screen, {ds.length} times of Start: speed 0 at control {still}; the horizontal state and the position of m0 {sameHS}"
  flush
  -- counted frames from a machine at control, with the inputs `inp`, until the entry or `rlim` real frames: (counted frames read, lag frames, lag frames that change the bytes,
  -- frames that are not such a frame, the entry frame, the machines at the start of each counted frame, the machines after the move, the routines of a counted frame out of control)
  let walk := fun (c1 : Machine) (inp : Nat → UInt8) (rlim : Nat) => Id.run do
    let mut x := c1
    let mut t := 1
    let mut lags := 0
    let mut lagBad := 0
    let mut why : List String := []
    let mut E : Option Nat := none
    let mut fms : Array Machine := #[c1, c1]
    let mut subs : Array (Option Machine) := #[none]
    let mut outs : List Nat := []
    let mut whyX : List String := []
    let mut cur := pipeFrameRun sy x (inp 0)
    let mut r := 1
    let mut stop := false
    while !stop && E.isNone && r < rlim do
      let (s, y) := cur
      if CastleToLevel.phaseOf nm y == CastleToLevel.phaseOf nm x then
        -- a `lag` frame before the counted frame
        lags := lags + 1
        if bytes3 y != bytes3 x then lagBad := lagBad + 1
        x := y
        cur := pipeFrameRun sy x (inp r)
        r := r + 1
      else if PipeEntryRule.rt sy x != PipeEntryRule.vp sy && PipeEntryRule.rt sy y == PipeEntryRule.vp sy then
        -- the entry frame: it begins with the bytes of `x`, and its `P₂` is that of the move; its end is not read
        match pipeFrameWhy sy am x s (s.getD y) with
        | some w => whyX := s!"{t}: entry {w}" :: whyX
        | none => pure ()
        subs := subs.push s
        E := some t
      else
        -- the `lag` frames after it, up to the next counted frame
        let mut z := y
        let mut nx := pipeFrameRun sy z (inp r)
        r := r + 1
        let mut lagsHere := 0
        while CastleToLevel.phaseOf nm nx.2 == CastleToLevel.phaseOf nm z && r < rlim do
          lags := lags + 1
          lagsHere := lagsHere + 1
          if bytes3 nx.2 != bytes3 z then lagBad := lagBad + 1
          z := nx.2
          nx := pipeFrameRun sy z (inp r)
          r := r + 1
        if CastleToLevel.phaseOf nm nx.2 == CastleToLevel.phaseOf nm z then stop := true
        else
          -- the frame's own move values: information; some frame with these ends: what `Reads` needs
          match pipeFrameWhy sy am x s z with
          | some w =>
            let dbg := match s with
              | some s' => s!"v {SurfaceFrames.vOf sy x} P {posP sy x} v₂ {SurfaceFrames.vOf sy s'} P₂ {posP sy s'} v' {SurfaceFrames.vOf sy z} P' {posP sy z}"
              | none => s!"v {SurfaceFrames.vOf sy x} P {posP sy x} v' {SurfaceFrames.vOf sy z} P' {posP sy z}"
            why := s!"{t}:{w} [{dbg}; vertical page {peek x sy.Player_Y_HighPos}; ImpedePlayerMove {impedeCalls sy x (inp (r - 2 - lagsHere))} times]" :: why
          | none => pure ()
          if !pipeFrameExists sy am x z then whyX := s!"{t}" :: whyX
          subs := subs.push s
          fms := fms.push z
          t := t + 1
          x := z
          cur := nx
          -- a counted frame that does not begin in control ends the run: before the entry this is a death
          if !controllable sy z then
            outs := (PipeEntryRule.rt sy z).toNat :: outs
            stop := true
    return (t - 1, lags, lagBad, why, E, fms, subs, outs, whyX)
  -- the movie
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut m := powerOn cart 0
  let mut k := 0
  while k < inputs.size && !controllable sy m do
    m := runFrame m inputs[k]!
    k := k + 1
  let k1 := k
  let (_, lagsT, lagBadT, whyT, ET, fmsT, subsT, _, whyXT) := walk m (fun r => smbToPad (inputs.getD (k1 + r) 0)) 2000
  IO.println s!"the movie: speed at control {SurfaceFrames.vOf sy m}; the entry frame {ET}; lag frames {lagsT}, that change the bytes {lagBadT}; own move not a frame {whyT.reverse}; no frame with these ends {whyXT.reverse}"
  match ET with
  | some e =>
    let P0 := posP sy m0
    let openP := (List.range 33).all fun t => match subsT.getD t none with
      | some s => decide (posP sy s ≤ P0 + 9744)
      | none => t == 0
    IO.println s!"the movie: P₂ ≤ P₀ + 9744 up to frame 32: {openP}; P at frame 33 − P₀ = {posP sy (fmsT.getD 33 m) - P0}; frames read {e}"
    if !openP then bad := bad + 1
  | none => bad := bad + 1
  bad := bad + lagBadT + whyT.length + whyXT.length
  flush
  -- own inputs from machines of the movie, small and big
  let mut z : UInt64 := 91357
  let mut runs := 0
  let mut entries := 0
  let mut least := 100000
  let mut frames := 0
  let mut lagsR := 0
  let mut lagBadR := 0
  let mut whyR : List String := []
  let mut outsR : List Nat := []
  let mut grew := 0
  let mut whyXR : List String := []
  for q in List.range nRuns do
    let b := if q % 3 == 2 then 40 + (q * 13) % 120 else 1 + (q * 7) % (Nat.min 360 (fmsT.size - 2))
    let big := q % 4 == 3
    let start := if big then poke fmsT[b]! sy.PlayerSize 0 else fmsT[b]!
    let style := q % 5
    let mut pads : Array UInt8 := #[]
    for _ in List.range 1500 do
      z := z ^^^ (z <<< 13)
      z := z ^^^ (z >>> 7)
      z := z ^^^ (z <<< 17)
      let w := ((z >>> 11) &&& 15).toNat
      let bits := ((z >>> 20) &&& 0xFF).toUInt8
      let i : UInt8 := match style with
        | 0 => if w < 9 then 0x41 else if w < 11 then 0xC1 else if w < 13 then 0x04 else bits &&& 0xEF
        | 1 => if w < 6 then 0x41 else if w < 9 then 0x81 else if w < 11 then 0x42 else if w < 12 then 0x10 else bits
        | 2 => if w < 4 then 0x01 else if w < 8 then 0xC1 else if w < 10 then 0x82 else bits &&& 0xEF
        | 3 => bits &&& 0xCF
        | _ => if w < 7 then 0x81 else if w < 11 then 0x01 else if w < 13 then 0x02 else 0x41
      pads := pads.push i
    let (t, lags, lagBad, why, E, fmsR, _, out, wx) := walk start (fun r => pads.getD r 0) 1500
    whyXR := whyXR ++ wx.map (s!"run {q}, from {b}, frame " ++ ·)
    outsR := out ++ outsR
    if (fmsR.back?.map (fun c => peek c sy.PlayerSize != peek start sy.PlayerSize)).getD false then grew := grew + 1
    runs := runs + 1
    frames := frames + t
    lagsR := lagsR + lags
    lagBadR := lagBadR + lagBad
    whyR := whyR ++ why.map (s!"run {q}, from {b}, frame " ++ ·)
    match E with
    | some e =>
      entries := entries + 1
      if b + e < least then least := b + e
    | none => pure ()
  IO.println s!"own inputs: {runs} runs, {frames} counted frames, {entries} entries (least frame {least}); lag frames {lagsR}, that change the bytes {lagBadR}; own move not a frame {whyR.length}: {whyR.take 12}; no frame with these ends {whyXR.length}: {whyXR.take 12}"
  IO.println s!"own inputs: runs ended by a counted frame out of control {outsR.length}, its routine bytes {outsR.eraseDups}; runs where the size changed {grew}"
  flush
  -- into the pipe: from machines of the movie before the entry, Right for a while, then Down; small and big
  let mut runsD := 0
  let mut entriesD : List Nat := []
  let mut framesD := 0
  let mut whyD : List String := []
  let mut lagBadD := 0
  let mut whyXD : List String := []
  let mut lagsD := 0
  for b in (List.range 40).map (· + 1) do
    for j in List.range 15 do
      for big in [false, true] do
        let c := fmsT.getD (368 - b) m
        let start := if big then poke c sy.PlayerSize 0 else c
        let pads : Array UInt8 := (List.replicate j (0x41 : UInt8) ++ List.replicate 80 (0x04 : UInt8)).toArray
        let (t, lags, lagBad, why, E, _, _, _, wx) := walk start (fun r => pads.getD r 0x04) 100
        whyXD := whyXD ++ wx
        lagsD := lagsD + lags
        runsD := runsD + 1
        framesD := framesD + t
        lagBadD := lagBadD + lagBad
        whyD := whyD ++ why.map (s!"from {368 - b}, {j} Right, frame " ++ ·)
        match E with
        | some e => entriesD := (368 - b + e - 1) :: entriesD
        | none => pure ()
  IO.println s!"into the pipe: {runsD} runs, {framesD} counted frames, {entriesD.length} entries (frames {entriesD.eraseDups.mergeSort}); lag frames {lagsD}, that change the bytes {lagBadD}; own move not a frame {whyD.length}: {whyD.take 12}; no frame with these ends {whyXD.length}"
  bad := bad + lagBadD + whyXD.length
  bad := bad + lagBadR + whyXR.length
  IO.println s!"bad {bad}"
  return if bad == 0 then 0 else 1

/-- a touch of the pole on real frames: the check of one pass, then the hypotheses on the movie, on the late touch and on own inputs -/
def poleRuleCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let P := PoleEntryRule.spots sy m0
  let E := PipeEntryRule.envOf m0
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => PoleEntryRule.searchOf E P
  let t1 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => PoleEntryRule.walkCheck E P
  IO.println s!"one pass: {X.steps} steps, {X.forks} forks, {X.fails} failures, table {X.out.size}; search {t1 - t0} ms; the check {ok}, {(← IO.monoMsNow) - t1} ms"
  IO.println s!"the pole's page {P.pg}, left end {P.left}, its column at {P.dC}"
  flush
  let scan := fun (c : Machine) (i : UInt8) (r : PoleEntryRule.Report) => PoleEntryRule.scanFrame sy P E c (smbToPad i) r
  let bads := fun (r : PoleEntryRule.Report) => r.startBad + r.rowBad + r.tilesBad + r.writeBad + r.passBad + r.leftBad + r.noEntry + r.posBad
  -- the movie, from the first control to after the touch
  let (mS, inputs, k0) ← movieAt sy romPath fm2 0
  let mut t := mS
  let mut ra : PoleEntryRule.Report := {}
  let mut hist : Array Machine := #[mS]
  for j in [1:1240] do
    let (r, c) := PoleEntryRule.scanFrame sy P E t inputs[k0 + j]! ra
    ra := r
    t := c
    hist := hist.push t
  IO.println s!"the movie, frames 1 to 1239 after the first control: {ra.show}"
  flush
  -- the late touch
  let late := (hexDecode "02808080").toList ++ List.replicate 16 0
  let (rl, _) := late.foldl (fun (x : PoleEntryRule.Report × Machine) i => scan x.2 i x.1) (({} : PoleEntryRule.Report), hist[1089]!)
  IO.println s!"frame 1089, then 02808080: {rl.show}"
  flush
  -- every input of Left, Right, A, B for some frames, with the position moved forward by `delta`/256 px as `touch-search-at`
  let ins : List UInt8 := (List.range 16).map fun (n : Nat) =>
    let i := n.toUInt8
    ((i &&& 4) <<< 4) ||| ((i &&& 8) <<< 4) ||| (i &&& 3)
  let searchFrom := fun (c0 : Machine) (delta d : Nat) (r0 : PoleEntryRule.Report) => Id.run do
    let p := (posP sy c0).toNat + delta
    let c1 := poke (poke (poke c0 sy.SprObject_X_MoveForce (p % 256).toUInt8) sy.Player_X_Position (p / 256 % 256).toUInt8) sy.Player_PageLoc (p / 65536).toUInt8
    let mut layer : Array Machine := #[c1]
    let mut r := r0
    for _ in [0:d] do
      let mut nxt : Std.HashMap (Array UInt8) Machine := {}
      for c in layer do
        for i in ins do
          let (r1, c') := scan c i r
          r := r1
          if (peek c' sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl && nxt.size < 150 then nxt := nxt.insert (ramKey sy c') c'
      layer := nxt.valuesArray
    return r
  let mut rs : PoleEntryRule.Report := {}
  for a in [1082, 1089] do
    rs := searchFrom hist[a]! 0 6 rs
  IO.println s!"every input from frames of the movie: {rs.show}"
  flush
  let mut rd : PoleEntryRule.Report := {}
  for delta in [64, 256, 512, 1024, 1536] do
    rd := searchFrom hist[1082]! delta 5 rd
  IO.println s!"every input, the position moved forward (touch-search-at): {rd.show}"
  flush
  -- random inputs from frames of the movie: small, and big (overwritten)
  let mut z : UInt64 := 88172
  let mut rr : PoleEntryRule.Report := {}
  let mut rb : PoleEntryRule.Report := {}
  for q in List.range 160 do
    let mut c := hist[960 + (q * 7) % 130]!
    let big := q % 4 == 3
    if big then c := poke c sy.PlayerSize 0
    let mut f := 0
    while f < 160 && (peek c sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl do
      z := z ^^^ (z <<< 13)
      z := z ^^^ (z >>> 7)
      z := z ^^^ (z <<< 17)
      let w := ((z >>> 11) &&& 15).toNat
      let i : UInt8 := match w with
        | 0 | 1 | 2 | 3 | 4 => 0x41
        | 5 | 6 | 7 | 8 => 0xC1
        | 9 | 10 => 0x81
        | 11 => 0x01
        | 12 => 0x02
        | 13 => 0x82
        | 14 => 0x00
        | _ => ((z >>> 20) &&& 0xCF).toUInt8
      let (r, d) := scan c i (if big then rb else rr)
      if big then rb := r else rr := r
      c := d
      f := f + 1
  IO.println s!"random inputs towards the pole, small: {rr.show}"
  IO.println s!"random inputs towards the pole, big (overwritten): {rb.show}"
  flush
  -- jumps of different lengths from frames of the movie, until the touch: hits at other heights
  let mut rj : PoleEntryRule.Report := {}
  for a in (List.range 22).map (fun q => 985 + 5 * q) do
    for n in [2, 6, 10, 14, 18, 22, 30] do
      let mut c := hist[a]!
      let mut f := 0
      while f < 70 && (peek c sy.GameEngineSubroutine).toUInt16 == sy.Eng_PlayerCtrl do
        let (r, d) := scan c (if f < n then 0xC1 else 0x41) rj
        rj := r
        c := d
        f := f + 1
  IO.println s!"jumps from frames of the movie: {rj.show}"
  flush
  -- one frame from every height, position and input near the pole's column (overwritten)
  let mut rh : PoleEntryRule.Report := {}
  let c0 := hist[1085]!
  for y in (List.range 26).map (fun n => 0x10 + 8 * n) do
    for dx in List.range 44 do
      for fall in [0, 1] do
        let px := P.left - 12 + dx
        let c1 := poke (poke (poke c0 sy.Player_PageLoc (px / 256).toUInt8) sy.Player_X_Position (px % 256).toUInt8) sy.Player_Y_Position y.toUInt8
        let c2 := poke (poke c1 sy.Player_Y_Speed (if fall == 0 then 0xFC else 0x02)) sy.Player_State 1
        for i in ([0x01, 0x02, 0x00] : List UInt8) do
          let (r, _) := scan c2 i rh
          rh := r
  IO.println s!"one frame from each height and position near the column (overwritten): {rh.show}"
  flush
  let bad := bads ra + bads rl + bads rs + bads rd + bads rr + bads rb + bads rj + bads rh
  IO.println s!"bad: {bad}"
  return if ok && bad == 0 then 0 else 1

/-- the run from frame 50 with bytes not known, as a program -/
def taintCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let nm := PipeTransitionAll.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let known := TaintRun.knownSet sy nm m0 50 41
  IO.println s!"bytes the run must know at frame 50: {known.length}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => TaintRun.allCheckAt sy nm m0 known 50 41
  IO.println s!"the check: {ok} ({(← IO.monoMsNow) - t0} ms)"
  return if ok then 0 else 1

open SideTransition in
/-- the change from the side pipe to control above ground, as a program -/
def sideChangeCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let o := PipeTransition.run m0 onBlock
  let p := PipeTransition.run o toPipe
  let e := PipeTransition.frame p walkIn
  let x0 := SidePipe.xLo sy
  IO.println s!"entry after {onBlock.length + toPipe.length + 1} frames: enters {entersAt sy p walkIn}, x0+{xOf sy e - x0}, control after {framesToControl sy e}"
  IO.println "by pixel, written on the frame before the entry; the entry frame really runs:"
  for d in List.range 28 do
    let a := atX sy p (x0 + d)
    let q := PipeTransition.frame a walkIn
    IO.println s!"  x0+{d}: enters {entersAt sy a walkIn}, control after {framesToControl sy q}"
  IO.println "real routes:"
  for r in routes do
    let q := PipeTransition.run o r.1
    let q' := PipeTransition.frame q runIn
    IO.println s!"  entry after {onBlock.length + r.1.length + 1} frames: enters {entersAt sy q runIn}, x0+{xOf sy q' - x0}, control after {framesToControl sy q'}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => allCheck sy m0 282 21 186 378
  let t1 ← IO.monoMsNow
  IO.println s!"check: {ok} ({t1 - t0} ms)"
  return if ok then 0 else 1

/-- above ground: the checks of `SurfaceRun.allCheck`, as a program; then the model with a hit allowed on every frame -/
def surfaceCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let s0 := Potential.startHS sy m0
  let top : Int := (TopSpeed.top sy : Int)
  let a := SurfaceRun.above m0 982
  let X40 := Potential.hdist sy m0 s0 SurfaceRun.freeWitness
  let X := X40 - 16 * top * 9
  let B := posP sy a + X + 16 * top * 202
  IO.println s!"control after 982 frames of the route: {controllable sy a}; same horizontal state as the 1-1 start: {decide (Potential.startHS sy a = s0)}"
  IO.println s!"the model reaches {X40} in 40 frames; bound {X} in 31 frames, then {16 * top} per frame"
  IO.println s!"start {posP sy a}, bound at frame 233 {B}, left end of the pole's range {SurfaceRun.poleP sy m0}, margin after the 32 of PoleGrab: {SurfaceRun.poleP sy m0 - (B + 32)}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SurfaceRun.allCheck sy m0 982 X 31 9 233 9 4 40
  let t1 ← IO.monoMsNow
  IO.println s!"allCheck: {ok} ({t1 - t0} ms)"
  IO.println s!"one less in the search: {SurfaceRun.runCheck sy m0 s0 (X - 1) 31}; one frame later: {SurfaceRun.allCheck sy m0 982 X 31 9 234 9 4 40}; a first hit from frame 8: {SurfaceRun.hitTable sy m0 (Opening.pOf sy m0 s0) X 31 9 8}"
  -- the model with hits: on every frame a side contact of any kind, and the buttons it blocks on the next frame. Dropped states: `TopSpeed.reach`.
  let mNoR := poke m0 sy.Player_CollisionBits sy.noRight
  let mNoL := poke m0 sy.Player_CollisionBits sy.noLeft
  let amax := Smbrta.amax sy m0
  let mut l : List ((Potential.HS × UInt8) × Int) := [((s0, 0xFF), 0)]
  let mut steps := 0
  let mut peak := 0
  let t2 ← IO.monoMsNow
  for k in [0:40] do
    let r := 40 - k - 1
    let mut nx : Std.HashMap (Potential.HS × UInt8) Int := {}
    let add := fun (m : Std.HashMap (Potential.HS × UInt8) Int) (s : Potential.HS × UInt8) (d : Int) =>
      if d ≤ m.getD s (d - 1) then m else m.insert s d
    for ((s, bits), d0) in l do
      let mm := if bits == 0xFF then m0 else if bits == sy.noRight then mNoR else mNoL
      for i in Potential.inputsN do
        steps := steps + 1
        let t := Potential.hstep sy mm s i
        let vt := sbyte t.v
        let d := d0 + 16 * vt
        let keepC := decide (X40 + 1 ≤ d + TopSpeed.reach top amax (max (256 * vt + t.f.toNat) 0) r)
        let keepS := fun (x : Int) => decide (X40 + 1 ≤ x + TopSpeed.reach top amax 255 r)
        if keepC then nx := add nx (t, 0xFF) d
        if vt ≥ 0 && keepS (d - 256) then nx := add nx ({ t with v := 0 }, sy.noRight) (d - 256)
        if vt ≤ 0 && keepS (d + 256) then nx := add nx ({ t with v := 0 }, sy.noLeft) (d + 256)
        if vt < 0 && keepC then nx := add nx (t, sy.noRight) d
        if vt > 0 && keepC then nx := add nx (t, sy.noLeft) d
    l := nx.toList
    peak := max peak l.length
  let t3 ← IO.monoMsNow
  IO.println s!"with hits, past {X40} in 40 frames: {l.length} states left (at most {peak} per frame, {steps} frames of hstep, {t3 - t2} ms)"
  return if ok then 0 else 1

/-- from the castle entry to the level change: the checks of the theorem, then what is measured beside them -/
def castleLevelCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 ← startM sy romPath
  let nm := CastleToLevel.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let p : CastleToLevel.Params :=
    ⟨126, CastleToLevel.subOf nm m0, CastleToLevel.timerOf nm m0 + 1, CastleToLevel.phaseOf nm m0, CastleToLevel.phaseOf nm m0 + 2⟩
  let timed := fun (name : String) (b : Unit → Bool) => do
    let t0 ← IO.monoMsNow
    let r ← IO.lazyPure b
    IO.println s!"{name}: {r} ({(← IO.monoMsNow) - t0} ms)"; flush
  timed "the formula, the grid, 21 delays" fun _ => CastleToLevel.formulaCheck sy nm m0 p 165
  timed "every input from one state" fun _ => CastleToLevel.inputCheck sy nm p m0 8 8 148
  timed "the timer and the grid on real runs" fun _ => CastleToLevel.timerCheck sy nm p cart m0
  timed "the frames after the castle entry" fun _ => CastleToLevel.flagCheck sy nm p m0
  let e0 := CastleToLevel.entryAt sy nm p m0 0 none
  let c := CastleToLevel.phaseOf nm e0
  IO.println s!"real entry: frame {CastleToLevel.entryFrame p 0}, T {CastleToLevel.timerOf nm e0}, c {c}"
  IO.println "the timer overwritten at the entry (no fireworks): T, frames to the level change, the formula with D = 33"
  for t in [0, 60, 100, 120, 124, 125, 200, 360, 400] do
    let e := CastleToLevel.setTimer nm e0 t
    IO.println s!"  {t}: {CastleToLevel.framesToLevel sy e} {CastleToLevel.formula c t 33}; rule of the frames after the entry: {CastleToLevel.flagOK sy nm e (PipeTransition.zeros 2000)}"
  IO.println "the timer overwritten at the touch: T, frames to the level change, the formula with D by the last digit"
  for t in [360, 361, 363, 366, 131, 133, 136, 1, 3, 6] do
    let e := CastleToLevel.entryAt sy nm p m0 0 (some t)
    IO.println s!"  {t}: {CastleToLevel.framesToLevel sy e} {CastleToLevel.formula (CastleToLevel.phaseOf nm e) t (CastleToLevel.fireD t)}; rule of the frames after the entry: {CastleToLevel.flagOK sy nm e (PipeTransition.zeros 2000)}"
  IO.println "a pause: Start on frame 0 and on frame k after the entry, T = 360: frames to the level change"
  for k in [44, 45, 46, 65] do
    let mut x := e0
    let mut res : Option Nat := none
    for j in [0:1200] do
      x := PipeTransition.frame x (if j == 0 || j == k then (0x10 : UInt8) else 0)
      if CastleToLevel.level sy x then
        res := some (j + 1)
        break
    IO.println s!"  {k}: {res}"
  flush
  timed "every input on the real state, every frame" fun _ =>
    PipeTransition.gchain (CastleToLevel.level sy) sy PipeTransition.inputs (fun _ => true)
      (CastleToLevel.formula c (CastleToLevel.timerOf nm e0) 33) e0
  return 0

open RoomJoin in
/-- joining the bonus room: the checks that are new and the margins of the numbers (1/256 px short of the goal or the mouth), as a program -/
def roomJoinCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 ← smb11Start sy <$> loadCart romPath
  let t0 ← IO.monoMsNow
  let up := Jump.arcAll sy m0 (Jump.groundY sy) 3
  let lenOf (l : List Jump.Arc) (f : Bool) := l.foldl (fun b x => if x.fast == f then max b x.k else b) 0
  let lenA := (Jump.arcAll sy m0 (Jump.standY sy 2) 3).foldl (fun b x => max b x.k) 0
  let lenB := (Jump.arcAll sy m0 (Jump.standY sy 3) 3).foldl (fun b x => max b x.k) 0
  let (lenS, lenF) := (lenOf up false, lenOf up true)
  IO.println s!"longest jump: from the floor slow {lenS} fast {lenF}, from the side of the block {lenA}, from the block {lenB}"
  IO.println s!"floor jumps: feet low for 8 frames, back to the floor after 20 or more: {Jump.arcCheck sy m0 (Jump.groundY sy) 3 (floorArcOk sy 3 8 20)}"
  let cp := FastTakeoff.cornerP sy
  let goal := FastTakeoff.goalP sy
  let air : Int := 16 * ((sy.AirFastSpeed.toNat : Int) - 1)
  let run : Int := 16 * (TopSpeed.top sy : Int)
  let phi := 255 + Potential.gFast sy m0 + Potential.c sy m0
  let low := run - 257 + 16 * ((255 + Potential.gFast sy m0) / 256)
  let cd := AirCap.capDist sy m0
  IO.println s!"slow takeoff, the two earliest landings: {goal - (cp - 1 + air * 7 + cd 46)}, {goal - (cp - 1 + air * 5 + cd 47)}"
  IO.println s!"a stop at frame 37: {goal - (cp + low + Potential.dbound sy m0 phi 61)}; at frame 41 with any running speed: {goal - (cp + low + fastDist sy m0 phi 57)}"
  let later := (List.range 99).foldl (fun b j => if j ≤ 43 then b else
    min b (goal - (min (cp + low + run * ((j - 43 : Nat) : Int)) (cp + 4096) + fastDist sy m0 phi (98 - j)))) 100000
  IO.println s!"a stop after the low frames, the least: {later}"
  IO.println s!"a late takeoff: {goal - (cp + low + run * 48)}"
  IO.println s!"over the block in one jump: below the threshold {goal - (cp + 4096 + air * ((lenA + 1 : Nat) : Int))}, at the threshold {goal - (cp + low + run * ((lenF - 8 : Nat) : Int))}, with a stop {goal - (cp + 4096 + fastDist sy m0 phi (lenF - 8))}"
  IO.println s!"a slow jump off the block: {SidePipe.mouthP sy 0 - (goal + air * 12)}"
  IO.println s!"{(← IO.monoMsNow) - t0} ms"
  let phi0 := Potential.phi sy m0 (FastTakeoff.bonusRoom sy 34 6 8 64).s0
  let wallP : Int := 256 * (1 + (sy.SideAdderX.toNat : Int)) + 16 * ((sy.AirFastSpeed.toNat : Int) - 1)
  let safeP := Potential.theta sy - 1 - 3 * Potential.gSlow sy m0
  let lowS := run - 257 + 16 * ((255 + Potential.gFast sy m0) / 256)
  let P1 := (FastTakeoff.bonusRoom sy 34 6 8 64).P1
  IO.println s!"air frames of the fall: {airCheck sy m0}; moving right at its end: {safeCheck sy m0 (phi0 + Potential.a1 sy m0 * 34) 5}"
  IO.println s!"before frame 37, no wall: {cp - (P1 + airDist sy m0 phi0 34 + AirCap.capDist sy m0 2)}; after the wall: {cp - (wallP + Potential.dbound sy m0 phi 21)}"
  IO.println s!"low frames after the wall: {cp + lowS - (wallP + Potential.dbound sy m0 phi 26 + run * 2)}"
  IO.println s!"a stop by frame 40 with a running speed: no wall {goal - (cp - 2048 + fastDist sy m0 phi 61)} (back position {P1 + airDist sy m0 phi0 22 - backD sy m0 (safeP + 1 - 2 * Potential.c sy m0) 12 + run * 6}, kept {cp - 2048}); after the wall, frame 37: {goal - (wallP + Potential.dbound sy m0 phi 22 + fastDist sy m0 phi 61)}"
  let phi1 := Potential.nxt sy m0 phi
  let wQ := phi1 + Potential.a1 sy m0 * 18
  let first := 16 * (phi1 / 256)
  IO.println s!"a wall hit, the last at frame 22 or later: {goal - (wallP + Potential.dbound sy m0 phi 76)}; before it, facing right: {goal - (wallP + first + airDist sy m0 phi1 18 + Potential.dbound sy m0 wQ 64)}; moving left at the end of the fall: {goal - (wallP + first + airDist sy m0 phi1 9 - backD sy m0 (wQ + 1 - 2 * Potential.c sy m0) 9 + AirCap.capDist sy m0 64)}"
  let turned := [(16, 32), (17, 32), (18, 28), (19, 28), (20, 28), (21, 25)].map fun (q : Nat × Nat) =>
    goal - (wallP + capRamp sy m0 phi (q.2 + 1) + AirCap.capDist sy m0 (98 - (q.1 + q.2 + 1)))
  IO.println s!"a wall hit before frame 22, turned away, by the frame of the stand: {turned}"
  return 0

instance joinHIn : Inhabited Potential.HIn := ⟨{ st := 0, jump := false, joy := 0, rt := 0 }⟩

/-- one real frame near the pole, for `poleJoinCheck` -/
structure JoinFrame where
  P : Int
  v : Int
  P2 : Int
  v2 : Int
  P' : Int
  v' : Int
  case : PoleGrab.Case
  hs : Potential.HS
  inp : Potential.HIn
  vs : Jump.VS
  stAfter : UInt8
  /-- `Player_State` before the frame -/
  stBefore : UInt8
  /-- the stored speed and the moving direction before and after the frame, the collision bits before and after -/
  absPrev : Nat
  abs : Nat
  mdPrev : UInt8
  md : UInt8
  bitsPrev : UInt8
  bits : UInt8
  /-- Left and Right as the movement routine reads them -/
  lr : UInt8
  /-- what `X_Physics` left: the adder and the caps -/
  lo : UInt8
  hi : UInt8
  mr : UInt8
  ml : UInt8
  /-- after the frame: height, fraction, fall force -/
  yAfter : UInt8
  dummyAfter : UInt8
  vfdAfter : UInt8
  deriving Inhabited

/-- the case of `PoleGrab.cases` this case is in -/
def joinInCases (sy : Syms) (c : PoleGrab.Case) : Bool :=
  (PoleGrab.caseXs sy).contains c.x && (PoleGrab.caseYs sy).contains c.y && (PoleGrab.caseVs sy).contains c.v &&
  (Potential.mds c.v).contains c.md && (PoleGrab.caseVyStates sy c.y).contains (c.vy, c.st) &&
  ([1, 2, 3] : List UInt8).contains c.fd

/-- `PoleJoin.Collides`, on one real frame -/
def joinCollides (sy : Syms) (mp : Machine) (fr : JoinFrame) : Bool :=
  let r := PoleGrab.collide sy mp fr.case
  let base := fr.P2 - 256 * (fr.case.x.toNat : Int)
  joinInCases sy fr.case && decide (fr.P' = base + 256 * ((peek r sy.Player_X_Position).toNat : Int)) &&
    decide (fr.v' = sbyte (peek r sy.Player_X_Speed))

/-- `Potential.hstepN` with the real stored speed: after a hit it is not `|v|`, and `X_Physics` reads it. So this, not `hstep`, gives `v₂` of a real frame. -/
def joinStep (sy : Syms) (m0 : Machine) (s : Potential.HS) (i : Potential.HIn) (ab : UInt8) : Potential.HS :=
  let lr0 := i.joy &&& 3
  let lr := if i.joy &&& 4 != 0 && i.st == 0 && lr0 != 0 then 0 else lr0
  let st : UInt8 := if i.st == 0 && i.jump then 1 else i.st
  let m := poke m0 sy.Player_State st
  let m := poke m sy.Player_X_Speed s.v
  let m := poke m sy.Player_X_MoveForce s.f
  let m := poke m sy.Player_XSpeedAbsolute ab
  let m := poke m sy.PlayerFacingDir s.fd
  let m := poke m sy.Player_MovingDir s.md
  let m := poke m sy.RunningSpeed s.rs
  let m := poke m sy.RunningTimer i.rt
  let m := poke m sy.Left_Right_Buttons lr
  let m := poke m sy.A_B_Buttons (i.joy &&& 0x40 ||| (if i.jump then 0x80 else 0))
  let m := poke m sy.SavedJoypadBits (i.joy ||| (if i.jump then 0x80 else 0))
  let m := poke m sy.GameEngineSubroutine sy.Eng_PlayerCtrl.toUInt8
  let m := runSub m sy.X_Physics 0 0 0
  let m := if st == 0 then
      let m := runSub m sy.GetPlayerAnimSpeed 0 0 0
      let m := if lr != 0 then poke m sy.PlayerFacingDir lr else m
      runSub m sy.ImposeFriction lr 0 0
    else if lr != 0 then runSub m sy.ImposeFriction lr 0 0 else m
  let v' := peek m sy.Player_X_Speed
  let md' := if v' == 0 then peek m sy.Player_MovingDir else if v' < 0x80 then 1 else 2
  { v := v', f := peek m sy.Player_X_MoveForce, fd := peek m sy.PlayerFacingDir, md := md',
    rs := if peek m sy.RunningSpeed == 0 then 0 else sy.RunSpeedMin.toUInt8 }

/-- `PoleJoin.Imposes`, on one real frame -/
def joinImposes (sy : Syms) (ctx : Machine) (fr : JoinFrame) : Bool :=
  (TopSpeed.upTo 3).contains fr.lr && (TopSpeed.collBits sy).contains fr.bitsPrev &&
  (adders sy ctx).contains (fr.lo, fr.hi) && (maxRs sy ctx).contains fr.mr && (maxLs sy ctx).contains fr.ml &&
  [fr.hs.v, 0].any fun v => (TopSpeed.speedsB sy).contains v && [fr.hs.f, 0].any fun f =>
    let r := PoleJoin.frictionRun sy ctx v f fr.lo fr.hi fr.mr fr.ml fr.lr fr.bitsPrev
    decide (fr.v2 = sbyte (peek r sy.Player_X_Speed)) && decide (fr.abs = (peek r sy.Player_XSpeedAbsolute).toNat)

/-- `PoleJoin.StopStep`, on one real frame: `Imposes` on the ground or with Left or Right, otherwise the case of `keepCases` -/
def joinStop (sy : Syms) (ctx : Machine) (fr : JoinFrame) : Bool :=
  if fr.stBefore == 0 || fr.lr != 0 then joinImposes sy ctx fr else
    let c : FastHop.Case := { abs := fr.absPrev.toUInt8, f := 0, lr := 0, bits := 0xFF, st := fr.stBefore, fd := fr.hs.fd, md := fr.mdPrev, rs := fr.hs.rs }
    decide (fr.absPrev ≤ TopSpeed.top sy) && (fr.stBefore == 1 || fr.stBefore == 2) && (fr.mdPrev == 1 || fr.mdPrev == 2) && ([1, 2, 3] : List UInt8).contains fr.hs.fd && (Potential.rsVals sy).contains fr.hs.rs && decide (fr.abs = (peek (FastHop.move sy ctx c) sy.Player_XSpeedAbsolute).toNat) &&
      decide (fr.md = peek (FastHop.move sy ctx c) sy.Player_MovingDir)

/-- `PoleJoin.BoxFrame`, on one real frame, for every speed that stands for its sign -/
def joinBox (sy : Syms) (B : PoleJoin.Box) (fr : JoinFrame) : Bool :=
  let x0 := (peek B.m sy.Player_X_Position).toNat
  let y0 := (peek B.m sy.Player_Y_Position).toNat
  let c := fr.case
  let base := fr.P2 - 256 * (c.x.toNat : Int)
  ((List.range (2 * B.dx + 1)).any fun a => c.x == (x0 + a - B.dx).toUInt8) &&
  ((c.y == y0.toUInt8 && c.vy == 0 && c.st == 0) ||
    ((List.range (B.dy + 1)).any fun b => c.y == (y0 - b).toUInt8) && (SurfaceRun.vyStates sy).contains (c.vy, c.st)) &&
  (if fr.v2 > 0 then [(1 : UInt8), 8] else if fr.v2 < 0 then [0xFF, 0xF8] else [0]).all fun v =>
    let r := PoleJoin.noHitRun sy B.m c.x c.y v c.vy c.st
    decide (fr.P' = base + 256 * ((peek r sy.Player_X_Position).toNat : Int)) &&
      decide (fr.v' - fr.v2 = sbyte (peek r sy.Player_X_Speed) - sbyte v) && decide (fr.bits = peek r sy.Player_CollisionBits)

/-- `PoleJoin.Quiet`, on one real frame -/
def joinQuiet (fr : JoinFrame) : Bool := decide (fr.P' = fr.P2) && decide (fr.v' = fr.v2) && fr.bits == 0xFF

/-- `fall` of `PoleJoin.ApproachCases`: the frame the fall began on and how, the frames with the feet inside, and whether the frames follow `fallNext` up to `L − 1` -/
def joinFall (sy : Syms) (ctx : Machine) (frs : Array JoinFrame) (rows q L : Nat) : String := Id.run do
  let w? := (List.range L).reverse.find? fun j => j ≥ 1 && frs[j]!.stBefore == 0 && (frs[j]!.vs.st != 0 || frs[j]!.stAfter != 0)
  let some w := w? | return "no start"
  let fw := frs[w]!
  let takeoff := fw.vs.st != 0
  let u0 : Jump.VS := if takeoff then fw.vs else
    { y := fw.yAfter, mf := 0, vy := 0, dummy := fw.dummyAfter, vf := fw.vfdAfter, vfd := fw.vfdAfter, origin := 0, st := 2, prevA := false }
  let mut u := u0
  let mut path := true
  for j in [w + 1:L] do
    let n := frs[j]!
    let nx := PoleJoin.fallNext sy ctx u
    let t := if Jump.falling u || n.vs.prevA then nx.headD default else nx.getD 1 default
    if nx.isEmpty || t.y != n.vs.y || t.vy != n.vs.vy then path := false
    u := t
  let base := (PoleJoin.stepOffs sy ctx 1).contains u0 && decide (2 ≤ w) && decide (PoleJoin.feetP sy ctx ≤ frs[w - 1]!.P2)
  return s!"w = {w} ({if takeoff then "jump" else "step"}), w ≤ q: {decide (w ≤ q)}; in fallStarts: {(PoleJoin.fallStarts sy ctx rows).contains u0}, off the base: {base}; follows fallNext: {path}"

/-- the hypotheses of `PoleJoin.Run`, on a movie's frames from control above ground, `c0` frames after its first controllable frame. From frame `at_` on the inputs are `hex`, then none. -/
def poleJoinCheck (sy : Syms) (romPath fm2Path : String) (c0 : Nat) (at_ : Nat := 0) (hex : List UInt8 := []) : IO UInt32 := do
  let movie := parseFm2 (← IO.FS.readFile fm2Path)
  let inputs := alignInputs movie fceuxSkip
  let cart ← loadCart romPath
  let ctx := smb11Start sy cart
  let mut m := powerOn cart 0
  let mut first : Option Nat := none
  let mut k0 : Nat := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if first.isNone && controllable sy m then first := some k
    if first == some (k - c0) && k ≥ c0 then
      k0 := k
      break
  let T := 233
  let N := 31
  let s0 := Potential.startHS sy ctx
  let PA := posP sy m
  let topI : Int := (TopSpeed.top sy : Int)
  let X : Int := Potential.hdist sy ctx s0 SurfaceRun.freeWitness - 16 * topI * 9
  let am := amax sy ctx
  let P0 := SurfaceRun.poleP sy ctx
  let Pf := PoleJoin.feetP sy ctx
  let Ps := PoleJoin.sideP sy ctx
  IO.println s!"control: {controllable sy m}; horizontal state = 1-1 start: {decide (Potential.startHS sy m = s0)}; position = `above`: {decide (PA = posP sy (SurfaceRun.above ctx 982))}"
  let t0 ← IO.monoMsNow
  let jc ← IO.lazyPure fun _ => PoleJoin.joinCheck sy ctx X N 9 T 9 126 160 176
  let t1 ← IO.monoMsNow
  IO.println s!"P₀ − P_s = {P0 - Ps}, P₀ − P_f = {P0 - Pf}; joinCheck: {jc} ({t1 - t0} ms)"
  let mut frs : Array JoinFrame := #[default]
  let mut flags : Array Bool := #[false]
  let mut d : Int := 0
  let mut hsm := s0
  let mut hFirst : Option Nat := none
  let mut allIn := true
  let mut bad := 0
  let mut gOpt : Option Nat := none
  let mut touchY : UInt8 := 0
  let mut touchVy : UInt8 := 0
  let mut mt := m
  let mut touchM := m
  let mut touchPad : UInt8 := 0
  for j in [1:520] do
    let pad := if at_ != 0 && c0 + j > at_ then smbToPad ((hex.drop (c0 + j - at_ - 1)).headD 0) else inputs[k0 + j]!
    let p := PState.read sy mt
    let hs : Potential.HS := ⟨p.speed, p.fricMF, p.faceDir, p.movDir, if p.runSpd == 0 then 0 else sy.RunSpeedMin.toUInt8⟩
    let mn := runFrame mt pad
    let st := peek mt sy.Player_State
    let jump := st == 0 && peek mn sy.Player_State == 1
    let saved := peek mn sy.SavedJoypadBits
    let i : Potential.HIn := { st := if st == 0 then 0 else 1, jump, joy := saved &&& 0x7F, rt := if p.runTmr ≤ 1 then 0 else 1 }
    flags := flags.push (CastleWalk.castle sy mn)
    let before := gOpt.isNone
    if before && (peek mn sy.GameEngineSubroutine).toUInt16 != sy.Eng_PlayerCtrl then
      gOpt := some j
      touchY := peek mn sy.Player_Y_Position
      touchVy := peek mn sy.Player_Y_Speed
      touchM := mt
      touchPad := pad
    if before then
      unless Potential.inputs.contains i do allIn := false
      let u := joinStep sy (poke ctx sy.Player_CollisionBits (peek mt sy.Player_CollisionBits)) hs (Potential.norm i) p.absSpd
      let v2 := sbyte u.v
      let f2 := (peek mn sy.Player_X_MoveForce).toNat
      let P := posP sy mt
      let P2 := P + 16 * v2
      let P' := posP sy mn
      let v' := sbyte (peek mn sy.Player_X_Speed)
      let vm := Jump.vstep sy ctx ⟨peek mt sy.Player_Y_Position, peek mt sy.Player_Y_MoveForce, peek mt sy.Player_Y_Speed,
        peek mt sy.Player_YMF_Dummy, peek mt sy.VerticalForce, peek mt sy.VerticalForceDown,
        peek mt sy.JumpOrigin_Y_Position, st, (peek mt sy.A_B_Buttons &&& 0x80) != 0⟩ ((saved &&& 0x80) != 0) p.absSpd
      let c : PoleGrab.Case := { x := (P2 / 256 % 256).toNat.toUInt8, y := vm.y, v := u.v, md := peek mn sy.Player_MovingDir, vy := vm.vy, st := vm.st, fd := peek mn sy.PlayerFacingDir }
      let lr0 := saved &&& 3
      frs := frs.push ⟨P, sbyte hs.v, P2, v2, P', v', c, hs, i, vm, peek mn sy.Player_State, st,
        p.absSpd.toNat, (peek mn sy.Player_XSpeedAbsolute).toNat, p.movDir, peek mn sy.Player_MovingDir,
        peek mt sy.Player_CollisionBits, peek mn sy.Player_CollisionBits,
        if saved &&& 4 != 0 && st == 0 && !jump && lr0 != 0 then 0 else lr0,
        peek mn sy.FrictionAdderLow, peek mn sy.FrictionAdderHigh, peek mn sy.MaximumRightSpeed, peek mn sy.MaximumLeftSpeed,
        peek mn sy.Player_Y_Position, peek mn sy.Player_YMF_Dummy, peek mn sy.VerticalForceDown⟩
      -- the fields of `TopSpeed.Frame`; on the touch frame only those up to `P₂`
      let ok := decide (-topI ≤ v2 ∧ v2 ≤ topI) && decide (256 * v2 + f2 ≤ max (256 * sbyte hs.v + hs.f.toNat) 0 + am) &&
        (!gOpt.isNone || (decide (v' = v2 ∨ v' = 0) && decide (P' = P2 ∨ P' = P2 - 256 ∨ (P' ≤ P + 256 ∧ v2 ≤ 0))))
      unless ok do
        bad := bad + 1
        IO.println s!"frame {j}: a field of `Frame` fails: v {sbyte hs.v} v₂ {v2} v' {v'} P {P} P₂ {P2} P' {P'}"
      if hFirst.isNone then
        let u0 := Potential.hstep sy ctx hsm i
        let d' := d + 16 * sbyte u0.v
        if PA + d' != P' then
          hFirst := some j
          let line := PA + X + 16 * topI * ((j - N : Nat) : Int)
          IO.println s!"first frame off the model: h = {j}: P' ≤ d − 256: {decide (P' ≤ PA + d' - 256)}; P' ≤ d(before) + 256: {decide (P' ≤ PA + d + 256)}; v' ≤ 0: {decide (v' ≤ 0)}; line at h − P' = {line - P'}"
        d := d'
        hsm := u0
    mt := mn
  let g := gOpt.getD 0
  let c := (List.range flags.size).find? (fun i => flags[i]!)
  IO.println s!"inputs in `inputs`: {allIn}; frames failing a field of `Frame`: {bad}; h = {hFirst}; touch g = {g}, y {touchY}, vy {sbyte touchVy}; castle c = {c}; inRange: {decide (P0 ≤ frs[g]!.P2)} (P₂(g) − P₀ = {frs[g]!.P2 - P0})"
  IO.println s!"(fr 1).P = PA: {decide (frs[1]!.P = PA)}, (fr 1).v = 0: {decide (frs[1]!.v = 0)}"
  IO.println s!"noCastle: no castle flag up to the touch: {(List.range (g + 1)).all fun j => !flags[j]!} (at control: {CastleWalk.castle sy m})"
  IO.println s!"fracStep: frames before the touch moving P by a multiple of 1/16 px: {(List.range (g - 1)).all fun i => decide ((frs[i + 1]!.P' - frs[i + 1]!.P) % 16 = 0)}; fracCheck: {PoleJoin.fracCheck sy (SurfaceRun.above ctx 982)}; the fraction of P₂(g): {frs[g]!.P2 % 256}, in fracs: {CastleWalk.fracs.contains (PoleJoin.fracOf frs[g]!.P2)}"
  let (rTouch, _) := PoleEntryRule.scanFrame sy (PoleEntryRule.spots sy ctx) (PipeEntryRule.envOf ctx) touchM touchPad {}
  let fTouch := frs[g]!.P2 - 256 * (rTouch.pxs.headD 0 : Int)
  IO.println s!"touches, pass, pos on frame g: {rTouch.show}; P₂(g) = 256·px + f with f = {fTouch}: {decide (0 ≤ fTouch)}"
  IO.println s!"Touches (an instruction writes the pole's routine): {decide (0 < rTouch.touches)}; the frame ends with the routine {(PipeEntryRule.rt sy (PipeTransition.frame touchM touchPad)).toNat} (the pole's {PoleEntryRule.vf sy}, the end of the level {sy.EngEndLevel})"
  let B : PoleJoin.Box := ⟨SurfaceRun.above ctx 982, 4, 40, 8⟩
  let hJ := hFirst.getD 0
  IO.println s!"box: frames 1 to 8 in the box: {(List.range 8).map fun i => joinBox sy B frs[i + 1]!}; off: {hFirst.isNone || (List.range hJ).any fun i => !joinQuiet frs[i + 1]!}"
  let direct := decide (0x80 ≤ touchVy) && decide (sy.FlagGrabY.toNat ≤ touchY.toNat) && decide (touchY.toNat < Jump.cornerY sy 1)
  IO.println s!"IsDirect: {direct}"
  let cJ := c.getD 0
  let b := CastleWalk.beside ctx
  let vs := CastleWalk.beforeGrab sy ctx
  let flagsAgree := fun (E : Machine) (n : Nat) => Id.run do
    let mut x := E
    let mut ok := true
    for k in [1:n + 1] do
      x := PipeTransition.frame x 0
      if CastleWalk.castle sy x != flags[g + k]! then ok := false
    return ok
  if direct then
    let mp := PoleGrab.withPole sy ctx
    let T' := g - (List.range g).reverse.findIdx (fun j => frs[j]!.inp.jump) - 1
    let L := (List.range T').reverse.find? (fun j => j ≥ 1 && frs[j]!.inp.st != 0 && frs[j]!.stAfter == 0)
    let L' := L.getD 0
    let q := ((List.range L').reverse.find? (fun j => j ≥ 1 && decide (frs[j]!.P' < Pf))).getD 0
    IO.println s!"takeoff T = {T'}, landing L = {L'}, q = {q}; frames {(List.range (g - T' + 1)).map (fun i => frs[T' + i]!.vs.y)}"
    let mut arcs := (Jump.arcStart sy ctx (Jump.groundY sy) 1).filter (fun a => a.s == frs[T']!.vs)
    let fast := arcs.map (·.fast)
    for j in [T' + 1:g + 1] do
      arcs := (arcs.flatMap (Jump.arcSucc sy ctx 1)).filter (fun a => a.s == frs[j]!.vs)
    IO.println s!"JumpPath: {arcs.length} arc on the path to g; fast {fast}; riseOk {arcs.map (Jump.riseOk sy 1 2 1)}; k {arcs.map (·.k)}"
    let fallOk := (List.range (L' - q - 1)).map (fun i =>
      let fr := frs[q + 1 + i]!
      (decide (fr.P2 < Pf) && decide (fr.P' < Pf)) || (decide (Pf ≤ fr.P2) && joinCollides sy mp fr && PoleJoin.inBlockCase sy fr.case))
    IO.println s!"left: {decide (frs[q]!.P' < Pf)}; air: {fallOk}"
    let besideOk := fun (fr : JoinFrame) =>
      (decide (fr.P2 < Ps) && decide (fr.P' < Ps)) || (joinCollides sy mp fr && PoleJoin.lowCase sy fr.case)
    IO.println s!"land: {besideOk frs[L']!}; hop: {(List.range (g - L' - 1)).map (fun i => besideOk frs[L' + 1 + i]!)}"
    for i in List.range (g - L' - 1) do
      let fr := frs[L' + 1 + i]!
      IO.println s!"  hop {L' + 1 + i}: x {fr.case.x} y {fr.case.y} vy {fr.case.vy} v {fr.case.v} md {fr.case.md} P₂−Ps {fr.P2 - Ps} P'−Ps {fr.P' - Ps} v' {fr.v'} incases {joinInCases sy fr.case} collides {joinCollides sy mp fr} low {PoleJoin.lowCase sy fr.case}"
    let fL := frs[L' - 1]!
    let fN := frs[L']!
    IO.println s!"MaskStep: push to the right on L − 1: {decide (fL.P' = fL.P2 + 256)}; v₂(L) {fN.v2} = hstep with Left blocked {sbyte (Potential.hstep sy (poke ctx sy.Player_CollisionBits sy.noLeft) fN.hs fN.inp).v}; v(L) {fN.v}"
    let rowsOk := (List.range (L' - q - 1)).all (fun i =>
      let e := q + 1 + i
      !(decide (e ≤ T + 1) && (List.range (L' - e)).all (fun d => decide (Pf ≤ frs[e + d]!.P2))) || decide (L' ≤ e + 3))
    IO.println s!"rows: {rowsOk}"
    IO.println s!"fall: {joinFall sy ctx frs 8 q L'}"
    IO.println s!"reads: A ≤ stored speed before the takeoff: {decide (sy.AirFastSpeed.toNat ≤ frs[T']!.absPrev)}; onGround: T > L + 1: {decide (T' > L' + 1)}, Imposes on T − 1: {joinImposes sy ctx frs[T' - 1]!}"
    IO.println s!"stopped: StopStep on the frames from q + 1 to L with speed 0: {(List.range (L' - q)).all fun i => !decide (frs[q + 1 + i]!.v = 0) || joinStop sy ctx frs[q + 1 + i]!}"
    let E := CastleWalk.touchAt sy b (CastleWalk.firstX sy) (PoleJoin.fracOf frs[g]!.P2) (vs.headD default)
    IO.println s!"flagTight premise: v₂(g − 1) < 0: {decide (frs[g - 1]!.v2 < 0)}, P₂(g) < P₀ + 176: {decide (frs[g]!.P2 < P0 + 176)}; flags agree with touchAt for 125 frames: {flagsAgree E 125}, 124 frames: {flagsAgree E 124}; c − g = {cJ - g}"
  else
    let Es := (CastleWalk.otherYs sy).map fun y =>
      CastleWalk.touchAt sy b (PoleGrab.colX sy - 9).toUInt8 CastleWalk.bigFrac { (vs.headD default) with y := y + 3 }
    IO.println s!"OtherFlag: flags agree with the touch at another height for 131 frames: {Es.map fun E => flagsAgree E 131}; c − g = {cJ - g}"
  IO.println s!"the theorem: c ≥ 366: {decide (366 ≤ cJ)}"
  return 0

/-- what `poleFracCheck` counts on real frames -/
structure FracCount where
  runs : Nat := 0
  frames : Nat := 0
  touches : Nat := 0
  /-- frames whose move is not `16·v` of the speed they end with: a push, a stop at a wall or at the screen's left edge -/
  pushes : Nat := 0
  /-- such frames with Left held, no side collision and the speed 0 at the end: the screen's left edge -/
  edge : Nat := 0
  bad : Nat := 0
  /-- touches whose fraction is not in `CastleWalk.fracs` -/
  badTouch : Nat := 0
  /-- touches whose frame ends with the end of the level, not the pole's routine: `PoleEntryRule.EndsTouch` fails, `Touches` holds -/
  endLevel : Nat := 0
  fracs : List Nat := []
  /-- the other routines that end a run -/
  ends : List Nat := []
  /-- machines with the castle flag up to the touch (`PoleJoin.Run.noCastle`) -/
  castleBad : Nat := 0
  /-- touches at a height of `FlagGrabY` or lower: those that end with the pole's routine, and all -/
  lowPole : Nat := 0
  low : Nat := 0

def FracCount.str (c : FracCount) : String :=
  s!"runs {c.runs}, frames {c.frames}, touches {c.touches} (ending with the end of the level {c.endLevel}; fractions {c.fracs.mergeSort}), frames with a push or a stop {c.pushes}, at the left edge {c.edge}; other ends {c.ends}; bad {c.bad}, touches off the fractions {c.badTouch}, the castle flag up to the touch {c.castleBad}; touches at FlagGrabY or lower {c.low}, of these ending with the pole's routine {c.lowPole}"

/-- the frames of `w` from `start`, up to the frame on which the routine is not the player's control: on each, `16 ∣ P' − P` (`PoleJoin.Run.fracStep`) -/
def fracRun (sy : Syms) (start : Machine) (w : Array UInt8) (c0 : FracCount) (pads : Bool := false) : FracCount := Id.run do
  if (peek start sy.GameEngineSubroutine).toUInt16 != sy.Eng_PlayerCtrl then return c0
  let mut c := { c0 with runs := c0.runs + 1, castleBad := c0.castleBad + (if CastleWalk.castle sy start then 1 else 0) }
  let mut a := start
  for i in w do
    let pad := if pads then i else smbToPad i
    let b := runFrame a pad
    let d := posP sy b - posP sy a
    c := { c with frames := c.frames + 1 }
    if d % 16 != 0 then c := { c with bad := c.bad + 1 }
    if CastleWalk.castle sy b then c := { c with castleBad := c.castleBad + 1 }
    if d != 16 * sbyte (peek b sy.Player_X_Speed) then
      c := { c with pushes := c.pushes + 1 }
      if !pads && i &&& 2 != 0 && peek b sy.Player_X_Speed == 0 && peek b sy.SideCollisionTimer == 0 then c := { c with edge := c.edge + 1 }
    a := b
    if (peek b sy.GameEngineSubroutine).toUInt16 != sy.Eng_PlayerCtrl then
      let e := (peek b sy.GameEngineSubroutine).toUInt16
      if e == sy.EngFlagpole || e == sy.EngEndLevel then
        let fr := (posP sy b % 256).toNat
        c := { c with touches := c.touches + 1, fracs := if c.fracs.contains fr then c.fracs else c.fracs ++ [fr],
                      endLevel := c.endLevel + (if e == sy.EngEndLevel then 1 else 0) }
        if sy.FlagGrabY.toNat ≤ (peek b sy.Player_Y_Position).toNat then
          c := { c with low := c.low + 1, lowPole := c.lowPole + (if e == sy.EngFlagpole then 1 else 0) }
        unless CastleWalk.fracs.contains fr.toUInt8 do c := { c with badTouch := c.badTouch + 1 }
      else
        let e := (peek b sy.GameEngineSubroutine).toNat
        unless c.ends.contains e do c := { c with ends := c.ends ++ [e] }
      break
  return c

/-- own inputs: runs of held buttons, mostly Right, with B, A, Left at the seed's rates -/
def fracInputs (seed : UInt64) (n : Nat) : Array UInt8 := Id.run do
  let nx := fun (s : UInt64) => let x := s ^^^ (s <<< 13); let y := x ^^^ (x >>> 7); y ^^^ (y <<< 17)
  let mut s := nx (seed * 6364136223846793005 + 1442695040888963407)
  let pR := [90, 70, 45, 20].getD ((s >>> 9).toNat % 4) 0
  s := nx s
  let pL := [3, 15, 35, 70].getD ((s >>> 9).toNat % 4) 0
  s := nx s
  let pB := (s >>> 11).toNat % 101
  s := nx s
  let pA := (s >>> 11).toNat % 50
  let mut out : Array UInt8 := #[]
  let mut cur : UInt8 := 0
  let mut hold := 0
  for _ in [0:n] do
    if hold == 0 then
      let mut x : UInt8 := 0
      for (b, k) in [((1 : UInt8), pR), (2, pL), (0x40, pB), (0x80, pA), (4, 3)] do
        s := nx s
        if (s >>> 20).toNat % 100 < k then x := x ||| b
      cur := x
      s := nx s
      hold := (s >>> 30).toNat % 14
    else hold := hold - 1
    out := out.push cur
  return out

/-- `PoleJoin.Run.fracStep`, `PoleJoin.fracCheck` and `PoleJoin.Run.noCastle` on real frames: the fraction at control, on each frame from control above ground up to the touch the position moves by a
multiple of 1/16 px, and no machine up to the touch has the castle flag. The movie, random inputs from control and from the movie's frames, and runs into the screen's left edge. -/
def poleFracCheck (sy : Syms) (romPath fm2Path : String) (n : Nat) : IO UInt32 := do
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2Path)) fceuxSkip
  let cart ← loadCart romPath
  let ctx := smb11Start sy cart
  let mut m := powerOn cart 0
  let mut first : Option Nat := none
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if first.isNone && controllable sy m then first := some k
    if first.isSome && k ≥ first.getD 0 + 852 then
      k0 := k
      break
  let own := SurfaceRun.above ctx 982
  let fc := PoleJoin.fracCheck sy own
  IO.println s!"the fraction at control: the movie {posP sy m % 256}, the machine of the proof {posP sy own % 256}; fracCheck: {fc}"
  let mut tas : Array Machine := #[m]
  let mut a := m
  for j in [1:400] do
    a := runFrame a inputs[k0 + j]!
    tas := tas.push a
  let mut bad := if fc then 0 else 1
  let c := fracRun sy m ((List.range 399).map (fun j => inputs[k0 + 1 + j]!)).toArray {} true
  IO.println s!"the movie: {c.str}"
  bad := bad + c.bad + c.badTouch + c.castleBad
  let mut r : FracCount := {}
  for sd in [1:n + 1] do
    r := fracRun sy (if sd % 2 == 0 then m else own) (fracInputs sd.toUInt64 420) r
  IO.println s!"random, from control: {r.str}"
  bad := bad + r.bad + r.badTouch + r.castleBad
  let mut l : FracCount := {}
  for sd in [1:4 * n + 1] do
    let at_ := 150 + (sd * 7919) % 90
    l := fracRun sy tas[at_]! (fracInputs (sd.toUInt64 + 7777) 160) l
  IO.println s!"random, from the movie's frames 1002 to 1091: {l.str}"
  bad := bad + l.bad + l.badTouch + l.castleBad
  let mut e : FracCount := {}
  for k in [0:40] do
    for b0 in [(0x00 : UInt8), 0x01, 0x41] do
      for b1 in [(0x02 : UInt8), 0x42, 0x03, 0x43, 0x82, 0xC2] do
        e := fracRun sy own (Array.replicate k b0 ++ Array.replicate 90 b1 ++ #[0x01, 0x01, 0x00, 0x00, 0x41, 0x41] ++ fracInputs k.toUInt64 200) e
  IO.println s!"into the screen's left edge: {e.str}"
  bad := bad + e.bad + e.badTouch + e.castleBad
  IO.println s!"bad: {bad}"
  return if bad == 0 then 0 else 1

/-- the two change bounds' numbers, read from the disassembly and the ROM -/
structure ChangeLefts where
  pn : PipeTransitionAll.Names
  nm₁ : PipeTransitionAll.Names
  nm₂ : PipeTransitionAll.Names
  nx₂ : PipeTransitionAll.Names
  e₁ : Machine
  e₂ : Machine
  lf₁ : Machine → Nat
  lf₂ : Machine → Nat

def changeLefts (sy : Syms) (romPath : String) : IO ChangeLefts := do
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm₁ := PipeChangeBound.namesOf txt
  let nm₂ := SideChangeBound.namesOf txt
  let m0 := smb11Start sy (← loadCart romPath)
  let e₁ := PipeTransition.entry m0
  let e₂ := SideTransition.entry m0
  -- the tables once: `Route.left₁`, `Route.left₂`
  let t₁ := PipeChangeBound.tableOf sy nm₁ e₁ 48 43
  let t₂ := SideChangeBound.tableFrom sy nm₂ 122 (PipeTransition.run e₂ (PipeTransition.zeros 160))
  IO.println s!"rows of the tables: {t₁.length}, {t₂.length}"
  return ⟨PipeTransitionAll.namesFrom txt, nm₁, nm₂, SideChangeEnd.namesOf txt, e₁, e₂, PipeChangeBound.leftOf sy nm₁ sy.EngVerticalPipe t₁ 43, PipeChangeBound.leftOf sy nm₂ sy.EngSidePipe t₂ 122⟩

/-- the fields of `Route.Changes` on a movie's frames, with the inputs changed by `edit`. In a change, a frame whose phase stays is the `setup` frame if `left` falls on it, else a `lag` frame. -/
def changesCheck (sy : Syms) (romPath fm2Path : String) (edit : (Nat → UInt8) → Nat → UInt8 := id) : IO UInt32 := do
  let L ← changeLefts sy romPath
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2Path)) fceuxSkip
  let mut x := powerOn (← loadCart romPath) 0
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    let y := runFrame x inputs[k]
    if controllable sy y then
      k0 := k
      break
    x := y
  let inp := edit fun k => inputs.getD (k0 + k) 0
  -- `st`: 0 before the first entry, 1 in the first change, 2 in the room, 3 in the second change, 4 after it
  let mut st := 0
  let mut r := 0
  let mut idx : Array Nat := #[]
  let mut counts : Array Nat := #[]
  let mut setups : Array Nat := #[]
  let mut lags := 0
  let mut bad : Array Nat := #[]
  let mut starts : Array (Nat × Bool) := #[]
  let E₂ := SideChangeBound.sideEnv L.nm₂ L.e₂
  let V₂ := SideChangeEnd.refs2 L.nm₂ L.nx₂ L.e₂
  let refx := SideChangeEnd.refExit L.e₂ 160
  let xb := SideChangeBound.exitBytes sy L.nm₂ refx
  let qb := SideChangeEnd.quietBytes L.nx₂ L.e₂ 160
  let mut starts₂ := 0
  let mut loud := 0
  -- the first change's fields: the known bytes at the entry, the places on the pipe's frames, no Start after the pipe, the bytes, the song and the screen buffer at the exit
  let txt₁ ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nx₁ := PipeChangeEnd.namesOf txt₁
  let m0₁ := smb11Start sy (← loadCart romPath)
  let T₁ ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx₁ m0₁
  let d₁ := PipeChangeEnd.assemble sy nx₁ m0₁ (PipeChangeEnd.songTable nx₁ m0₁ 5327) T₁.2.1 T₁.1 T₁.2.2.1 T₁.2.2.2 0 0
  let xq₁ := PipeChangeEnd.exitQ sy L.nm₁ L.e₁
  let mut starts₁ := 0
  let mut loud₁ := 0
  let mut places₁ := 0
  -- `paused₁`: the `lag` frames of the first change end paused
  let mut unpaused₁ := 0
  for n in [0:4000] do
    if st == 4 then break
    let y := runFrame x (inp n)
    if st == 1 then
      if SideChangeEnd.coreFrame sy sy.EngVerticalPipe x && !SideChangeEnd.noStart (inp n) then starts₁ := starts₁ + 1
      if PipeChangeBound.inPipe sy sy.EngVerticalPipe x && !PipeChangeEnd.placesOK d₁.places x (inp n) then places₁ := places₁ + 1
      if xq₁.all (fun p => y.ram.get! p.1 == p.2) && !((PipeChangeEnd.quietQ d₁ L.e₁).all (fun p => y.ram.get! p.1 == p.2) && d₁.song.any (fun q => q.all fun p => y.ram.get! p.1 == p.2) &&
          d₁.xshape.any (fun q => q.all fun p => y.ram.get! p.1 == p.2)) then loud₁ := loud₁ + 1
    if st == 3 then
      if SideChangeEnd.coreFrame sy sy.EngSidePipe x && !SideChangeEnd.noStart (inp n) then starts₂ := starts₂ + 1
      if xb.all (fun p => y.ram.get! p.1 == p.2) && !qb.all (fun p => y.ram.get! p.1 == p.2) then loud := loud + 1
    let still := CastleToLevel.phaseOf L.pn y == CastleToLevel.phaseOf L.pn x
    let inChange := st == 1 || st == 3
    let lf := if st == 1 then L.lf₁ else L.lf₂
    let setup := inChange && still && decide (lf y < lf x)
    if inChange then
      if decide (lf x > lf y + 1) then bad := bad.push n
      if setup then setups := setups.push r
      if still && !setup then lags := lags + 1
      if st == 1 && still && !setup && !PipeChangeEnd.pausedB d₁ y then unpaused₁ := unpaused₁ + 1
    if !still || setup then r := r + 1
    x := y
    let eng := (peek y sy.GameEngineSubroutine).toUInt16
    if (st == 0 && eng == sy.EngVerticalPipe) || (st == 2 && eng == sy.EngSidePipe) || (inChange && controllable sy y) then
      idx := idx.push (n + 1)
      counts := counts.push (r - 1)
      if st == 0 then
        starts := starts.push (L.lf₁ y, PipeChangeEnd.entryOKp d₁ L.e₁ y)
      if st == 2 then
        starts := starts.push (L.lf₂ y, SideChangeBound.entryOK E₂ V₂ 160 y)
      st := st + 1
  IO.println s!"Changes: a₁, b₁, a₂, b₂ = {idx}; the same frames counted without `lag`, less one: pipe.E, room.C, room.E, Cs = {counts}"
  IO.println s!"Changes: at the entries, left and the condition: {starts}; the frames with the phase still and left falling, counted (z₁, z₂): {setups}; other frames with the phase still in the changes (`lag`, left kept): {lags}; frames where left falls by more than one: {bad}; frames against `noStart₂`: {starts₂}; against `quiet₂`: {loud}; against `noStart₁`: {starts₁}; against `quiet₁` (sound bytes, song, screen buffer): {loud₁}; frames against `places₁`: {places₁}; `lag` frames against `paused₁`: {unpaused₁}"
  return if st == 4 && bad.isEmpty && setups.size == 2 && starts.all (·.2) && starts₂ == 0 && loud == 0 && starts₁ == 0 && loud₁ == 0 && places₁ == 0 && unpaused₁ == 0 then 0 else 1

/-- `left` on frames: from each entry, no input, random inputs with and without Start, Start pressed and pressed again, and six objects written at a frame so that frames run over. On each run: the frames with the phase still where `left` falls, at most one; the others keep `left`; the frames where the phase moves take at most one off. -/
def changeScenes (sy : Syms) (romPath fm2Path : String) : IO UInt32 := do
  let L ← changeLefts sy romPath
  let m0 := smb11Start sy (← loadCart romPath)
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2Path))
  let entryOf := fun (eng : UInt16) (start : Machine) => Id.run do
    let mut t := start
    let mut seen := false
    let mut k := 0
    while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != eng) do
      t := runFrame t inputs[k]!
      seen := seen || controllable sy t
      k := k + 1
    return t
  let start := powerOn (← loadCart romPath) 0
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let ss := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let real₂ := (ss.filterMap (sideWalkToEntry sy 300)).map fun p => PipeTransition.frame p SideTransition.walkIn
  let groups : List (String × (Machine → Nat) × Nat × List Nat × List Machine) :=
    [("into the room", L.lf₁, 91, [0, 20, 46, 47, 48, 49, 50, 52, 60, 70, 80, 88], L.e₁ :: entryOf sy.EngVerticalPipe start :: (PipeTransitionAll.realEntries sy m0 25 13).map (·.2)),
     ("out of the side pipe", L.lf₂, 282, [0, 20, 50, 100, 158, 159, 160, 161, 162, 170, 200, 240, 270, 280], L.e₂ :: entryOf sy.EngSidePipe start :: real₂)]
  let mut ok := true
  let mut seed : UInt64 := 4242
  let scenes : List (List String × Nat) := [(List.replicate 6 "Goomba", 0), (List.replicate 6 "GreenKoopa", 4), (List.replicate 6 "HammerBro", 4)]
  for (name, lf, least, fs, es) in groups do
    let mut runs := 0
    let mut frames := 0
    let mut overran := 0
    let mut lagFrames := 0
    let mut badLag := 0
    let mut badFall := 0
    let mut noCtl := 0
    let mut fewest := 100000
    let mut allFrames := 100000
    -- what happens in a run: input of frame `n`, what is written before frame `n`
    let mut plans : List ((Nat → UInt8 → UInt8) × Option (List String × Nat × Nat)) :=
      [(fun _ _ => 0, none), (fun _ r => r &&& 0xEF, none), (fun _ r => r, none)]
    for f in fs do
      plans := (fun n _ => if n == f || n == f + 60 then 0x10 else 0, none) :: plans
      for (ids, sp) in scenes do
        plans := (fun _ _ => 0, some (ids, sp, f)) :: plans
    -- the first four entries with every plan, the others with the first three: no input and random inputs
    let mut i := 0
    for m in es do
      i := i + 1
      for (pl, wr) in if i ≤ 4 then plans else plans.reverse.take 3 do
        let mut c := m
        let mut n := 0
        let mut done := false
        let mut moved := 0
        let mut falls := 0
        let mut still := 0
        let mut runBadLag := 0
        while !done && n < 900 do
          seed := seed ^^^ (seed <<< 13)
          seed := seed ^^^ (seed >>> 7)
          seed := seed ^^^ (seed <<< 17)
          let c1 := match wr with
            | some (ids, sp, f) => if n == f then PipeTransition.applyChange c (PipeTransitionAll.enemies sy L.pn c ids sp) else c
            | none => c
          let y := PipeTransition.frame c1 (pl n (seed >>> 13).toUInt8)
          let (a, b) := (lf c1, lf y)
          if CastleToLevel.phaseOf L.pn y == CastleToLevel.phaseOf L.pn c1 then
            still := still + 1
            if decide (b < a) then
              falls := falls + 1
              if falls > 1 then runBadLag := runBadLag + 1
          else
            moved := moved + 1
          if decide (a > b + 1) then badFall := badFall + 1
          c := y
          n := n + 1
          done := controllable sy c
        runs := runs + 1
        frames := frames + n
        lagFrames := lagFrames + (still - falls)
        badLag := badLag + runBadLag
        if wr.isSome && still > 1 then overran := overran + 1
        if done then
          if moved + falls < fewest then fewest := moved + falls
          if n < allFrames then allFrames := n
          if lf c != 0 then badFall := badFall + 1
        else noCtl := noCtl + 1
    IO.println s!"{name}: {runs} runs, {frames} frames; runs where frames ran over {overran}; lag frames {lagFrames}, of them where left falls {badLag}; frames where left falls by more than one {badFall}; runs with no control in 900 frames {noCtl}; least frames to control {allFrames}, counted without lag frames {fewest}"
    if badLag != 0 || badFall != 0 || fewest < least then ok := false
  return if ok then 0 else 1

/-- the first time this frame reaches `pc`: the machine there -/
def framesAt (m : Machine) (pad : UInt8) (pc : UInt16) : Option Machine := Id.run do
  let mut x := { m with pad := pad }
  let t := m.frame + 1
  for _ in [0:40000] do
    if x.pc == pc then return some x
    if x.frame ≥ t || x.halted then return none
    x := (step.run x).2
  return none

/-- what `surface-frames-check` counts -/
structure FramesCount where
  frames : Nat := 0
  noCtl : Nat := 0
  lag : Nat := 0
  lagMoved : Nat := 0
  unclean : Nat := 0
  one : Nat := 0
  mid : Nat := 0
  move : Nat := 0
  gain : Nat := 0
  impV : Nat := 0
  impF : Nat := 0
  impP : Nat := 0
  clamp : Nat := 0
  quiet : Nat := 0
  blockL : Nat := 0
  hit : Nat := 0
  maskStop : Nat := 0
  edgeV : Int := 0
  boxN : Nat := 0
  boxBad : Nat := 0
  /-- the fields of `OnFrames` on the real machine: the frame's end, frames with the pressed side masked, `Moves` failing and why, the box from the scroll handler failing -/
  ends : Nat := 0
  masked : Nat := 0
  moves : Nat := 0
  movesBad : Nat := 0
  why : List (String × Nat) := []
  boxM : Nat := 0

def FramesCount.bad (c : FramesCount) : Nat := c.lagMoved + c.one + c.mid + c.move + c.gain + c.impV + c.impF + c.impP + c.boxBad + c.ends + c.movesBad + c.boxM

def FramesCount.str (c : FramesCount) : String :=
  s!"frames {c.frames} (not in control {c.noCtl}, lag {c.lag}, moved on a lag frame {c.lagMoved}, not clean {c.unclean}); FAILS: OneFrame {c.one}, mid {c.mid}, `Frame` move {c.move} gain {c.gain} impedeV {c.impV} impedeF {c.impF} impedeP {c.impP}; kinds: quiet {c.quiet}, block of Left {c.blockL}, hit {c.hit}, mask stop {c.maskStop}; P' held at the edge {c.clamp}; a hit moving right with no push: largest v₂ {c.edgeV}; frames before J {c.boxN}, FAILS {c.boxBad}; OnFrames: Moves {c.moves}, masked {c.masked}, FAILS: end {c.ends}, Moves {c.movesBad} {c.why}, box from the scroll handler {c.boxM}"

/-- One frame from `cur` to `b`, as `SurfaceFrames` states it, where `a` is the machine when the routine of the frame before it ended: `cur` is `a`, or later by `lag` frames. `j` is the frame's number from control, or 0 -/
def framesOne (sy : Syms) (nm : PipeTransitionAll.Names) (m0 : Machine) (B : PoleJoin.Box) (a cur b : Machine) (pad : UInt8) (j : Nat) (c0 : FramesCount) : FramesCount := Id.run do
  let mut c := { c0 with frames := c0.frames + 1 }
  if !controllable sy cur || !controllable sy b then return { c with noCtl := c.noCtl + 1 }
  if CastleToLevel.kindOf sy nm cur b == .lag then
    c := { c with lag := c.lag + 1 }
    if Potential.startHS sy cur != Potential.startHS sy b || posP sy cur != posP sy b || SurfaceFrames.vsOf sy cur != SurfaceFrames.vsOf sy b ||
        peek cur sy.Player_XSpeedAbsolute != peek b sy.Player_XSpeedAbsolute || peek cur sy.Player_CollisionBits != peek b sy.Player_CollisionBits || peek cur sy.Player_State != peek b sy.Player_State ||
        peek cur sy.RunningTimer != peek b sy.RunningTimer then c := { c with lagMoved := c.lagMoved + 1 }
    return c
  let some e := framesAt cur pad sy.MoveObjectHorizontally | return { c with move := c.move + 1 }
  let v := sbyte (peek a sy.Player_X_Speed)
  let f : Int := (peek a sy.Player_X_MoveForce).toNat
  let P := posP sy a
  let v2 := sbyte (peek e sy.Player_X_Speed)
  let f2 : Int := (peek e sy.Player_X_MoveForce).toNat
  let P2 := P + 16 * v2
  let v' := sbyte (peek b sy.Player_X_Speed)
  let P' := posP sy b
  if !(decide (256 * v2 + f2 ≤ max (256 * v + f) 0 + amax sy m0)) then c := { c with gain := c.gain + 1 }
  if !(decide (v' = v2 ∨ v' = 0)) then c := { c with impV := c.impV + 1 }
  if ((peek b sy.Player_X_MoveForce).toNat : Int) != f2 then c := { c with impF := c.impF + 1 }
  if !(decide (P' = P2 ∨ P' = P2 - 256 ∨ (P' ≤ P + 256 ∧ v2 ≤ 0))) then c := { c with impP := c.impP + 1 }
  if !(decide (P' = P2 ∨ P' = P2 - 256 ∨ P' = P2 + 256)) then c := { c with clamp := c.clamp + 1 }
  if !decide (SurfaceFrames.Clean sy a) then return { c with unclean := c.unclean + 1 }
  -- the fields `ends`, `moves`, `masked`, `box` of `OnFrames`, on the real machine
  let ms := SurfaceFrames.movesScan sy m0 B a cur (smbToPad pad) (1 ≤ j && j < 9)
  if !(ms.next.ram.data == b.ram.data && ms.next.pc == b.pc && ms.next.frame == b.frame) then c := { c with ends := c.ends + 1 }
  if decide (SurfaceFrames.Masked sy a b) then c := { c with masked := c.masked + 1 }
  else
    c := { c with moves := c.moves + 1 }
    if !ms.fails.isEmpty then
      c := { c with movesBad := c.movesBad + 1 }
      for w in ms.fails do
        c := { c with why := match c.why.lookup w with
          | some k => (w, k + 1) :: c.why.filter (·.1 != w)
          | none => (w, 1) :: c.why }
  if !ms.boxFails.isEmpty then c := { c with boxM := c.boxM + 1 }
  let t2 := sbyte (SurfaceFrames.modelS sy m0 a b).v
  if SurfaceFrames.bitsOf sy a == 0xFF && v2 != t2 then c := { c with mid := c.mid + 1 }
  if !decide (SurfaceFrames.OneFrame sy m0 a b) then c := { c with one := c.one + 1 }
  if P' == P + 16 * t2 && v' == t2 && SurfaceFrames.bitsOf sy b == 0xFF then c := { c with quiet := c.quiet + 1 }
  else if decide (0 < t2) && P' == P + 16 * t2 && v' == t2 && SurfaceFrames.bitsOf sy b == sy.noLeft then c := { c with blockL := c.blockL + 1 }
  else if decide (SurfaceFrames.Hit sy m0 a b) then
    c := { c with hit := c.hit + 1 }
    if decide (0 < t2) && P' == P + 16 * t2 then c := { c with edgeV := max c.edgeV t2 }
  else if decide (SurfaceFrames.MaskStop sy a b) then c := { c with maskStop := c.maskStop + 1 }
  -- the frames before `J`: the vertical step, and the collision routine as on the machine at control
  if 1 ≤ j && j < 9 then
    c := { c with boxN := c.boxN + 1 }
    let u := SurfaceFrames.vNext sy m0 a b
    let some e2 := framesAt cur pad sy.PlayerBGCollision | return { c with boxBad := c.boxBad + 1 }
    let y := peek e2 sy.Player_Y_Position
    let vy := peek e2 sy.Player_Y_Speed
    let st := peek e2 sy.Player_State
    let P₂ := posP sy e2
    let x := SurfaceFrames.pix P₂
    let reps : List UInt8 := if v2 > 0 then [1, 8] else if v2 < 0 then [0xFF, 0xF8] else [0]
    let okRun := reps.all fun w =>
      let r := PoleJoin.noHitRun sy B.m x y w vy st
      decide (P' = P₂ - 256 * (x.toNat : Int) + 256 * ((peek r sy.Player_X_Position).toNat : Int)) && decide (v' - v2 = sbyte (peek r sy.Player_X_Speed) - sbyte w) &&
        peek b sy.Player_CollisionBits == peek r sy.Player_CollisionBits
    unless u == SurfaceFrames.vsOf sy b && y == u.y && vy == u.vy && st == u.st && SurfaceFrames.boxVB sy B u && x == peek e2 sy.Player_X_Position && decide (P₂ = P2) && okRun do
      c := { c with boxBad := c.boxBad + 1 }
  return c

/-- inputs of a run: a random style, buttons held for some frames, in the game's layout -/
def framesInputs (seed : UInt64) (n : Nat) (sel start : Nat) : Array UInt8 := Id.run do
  let nx := fun (s : UInt64) => let x := s ^^^ (s <<< 13); let y := x ^^^ (x >>> 7); y ^^^ (y <<< 17)
  let pct := fun (s : UInt64) (k : Nat) => decide ((s >>> 20).toNat % 100 < k)
  let mut s := nx (seed * 2654435761 + 88172645463325252)
  let style := (s >>> 11).toNat % 5
  let pR := [95, 70, 40, 10, 50].getD style 0
  let pL := [2, 15, 40, 80, 30].getD style 0
  s := nx s
  let pB := (s >>> 11).toNat % 101
  s := nx s
  let pA := (s >>> 11).toNat % 40
  let mut out : Array UInt8 := #[]
  let mut cur : UInt8 := 0
  let mut hold := 0
  for _ in [0:n] do
    if hold == 0 then
      let bits : List (UInt8 × Nat) := [(1, pR), (2, pL), (0x40, pB), (0x80, pA), (4, 4), (8, 3), (0x20, sel), (0x10, start)]
      let mut x : UInt8 := 0
      for (b, k) in bits do
        s := nx s
        if pct s k then x := x ||| b
      cur := x
      s := nx s
      hold := (s >>> 30).toNat % 12
    else hold := hold - 1
    out := out.push cur
  return out

/-- a run of frames from `start` -/
def framesRun (sy : Syms) (nm : PipeTransitionAll.Names) (m0 : Machine) (B : PoleJoin.Box) (start : Machine) (w : Array UInt8) (j0 : Nat) (c0 : FramesCount) : FramesCount := Id.run do
  let mut c := c0
  let mut a := start
  let mut cur := start
  let mut j := j0
  for i in w do
    let pad := smbToPad i
    let b := runFrame cur pad
    c := framesOne sy nm m0 B a cur b pad j c
    if CastleToLevel.kindOf sy nm cur b != .lag then
      a := b
      if j != 0 then j := j + 1
    cur := b
    if (peek b sy.GameEngineSubroutine).toUInt16 != sy.Eng_PlayerCtrl then break
  return c

/-- The one-frame fields of `SurfaceFrames` on real frames: the movie from control, own runs, random inputs from control and from the movie's frames, Select, Start, into the screen's left edge, and overwritten states around the stairs. Then the start from the change: on real runs of the change, `left` is not 0 before control, and the state at control is that of the machine of the proof. -/
def surfaceFramesCheck (sy : Syms) (romPath fm2 : String) (n : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := CastleToLevel.namesFrom text
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2)) fceuxSkip
  let ctlOwn := SurfaceRun.above m0 982
  let B : PoleJoin.Box := ⟨ctlOwn, 4, 40, 8⟩
  let t0 ← IO.monoMsNow
  let rN ← IO.lazyPure fun _ => SurfaceFrames.numbersCheck sy m0 B 9
  IO.println s!"numbersCheck: {rN} ({(← IO.monoMsNow) - t0} ms)"
  let mut m := powerOn cart 0
  let mut first : Option Nat := none
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if first.isNone && controllable sy m then first := some k
    if first.isSome && k ≥ (first.getD 0) + 852 then
      k0 := k
      break
  let ctlM := m
  IO.println s!"the movie at 852: control {controllable sy m}, the state of the machine of the proof {decide (Potential.startHS sy m = Potential.startHS sy ctlOwn) && decide (posP sy m = posP sy ctlOwn) && decide (SurfaceFrames.vsOf sy m = SurfaceFrames.vsOf sy ctlOwn)}"
  let mut tas : Array Machine := #[m]
  let mut bad := 0
  let mut c : FramesCount := {}
  let mut a := m
  for j in [1:300] do
    let pad := inputs[k0 + j]!
    let b := runFrame a pad
    c := framesOne sy nm m0 B a a b pad j c
    tas := tas.push b
    a := b
    if !controllable sy b then break
  IO.println s!"the movie: {c.str}"
  bad := bad + c.bad
  let mut d : FramesCount := {}
  d := framesRun sy nm m0 B tas[1089 - 852]! #[0x02, 0x80, 0x80, 0x80, 0, 0, 0, 0, 0, 0] 0 d
  d := framesRun sy nm m0 B tas[1036 - 852]! (Array.replicate 30 0x81) 0 d
  IO.println s!"the late touch and the long jump: {d.str}"
  bad := bad + d.bad
  let mut r : FramesCount := {}
  for sd in [1:n + 1] do
    r := framesRun sy nm m0 B (if sd % 2 == 0 then ctlM else ctlOwn) (framesInputs sd.toUInt64 240 0 0) 1 r
  IO.println s!"random, from control: {r.str}"
  bad := bad + r.bad
  let mut l : FramesCount := {}
  for sd in [1:n + 1] do
    let at_ := (sd * 7919) % tas.size
    l := framesRun sy nm m0 B tas[at_]! (framesInputs (sd.toUInt64 + 7777) 80 0 0) 0 l
  IO.println s!"random, from the movie's frames: {l.str}"
  bad := bad + l.bad
  let mut s : FramesCount := {}
  for sd in [1:n / 2 + 1] do
    s := framesRun sy nm m0 B ctlOwn (framesInputs (sd.toUInt64 + 99) 120 10 0) 1 s
  IO.println s!"with Select: {s.str}"
  bad := bad + s.bad
  let mut p : FramesCount := {}
  for sd in [1:n / 2 + 1] do
    p := framesRun sy nm m0 B ctlOwn (framesInputs (sd.toUInt64 + 555) 240 0 5) 1 p
  IO.println s!"with Start: {p.str}"
  bad := bad + p.bad
  let mut e : FramesCount := {}
  for k in [0:40] do
    for b0 in [(0x01 : UInt8), 0x41] do
      for b1 in [(0x02 : UInt8), 0x42, 0x03, 0x43, 0x82, 0xC2] do
        e := framesRun sy nm m0 B ctlOwn (Array.replicate (k + 8) b0 ++ Array.replicate 90 b1 ++ #[0x01, 0x01, 0x00, 0x00, 0x41, 0x41]) 0 e
  IO.println s!"into the screen's left edge: {e.str}"
  bad := bad + e.bad
  -- overwritten states around the stairs
  let mut o : FramesCount := {}
  let base := tas[200]!
  let px := posP sy base / 256
  for dx in [0:48] do
    for y in [0:30] do
      for v in [(1 : UInt8), 8, 0xFF, 0xF8] do
        for (vy, st) in [((0 : UInt8), (2 : UInt8)), (3, 1), (0xFD, 1)] do
          for pad in [(0x01 : UInt8), 0x02, 0x00] do
            let q := (px - 48 + 2 * dx).toNat
            let m1 := poke base sy.Player_X_Position q.toUInt8
            let m1 := poke m1 sy.Player_PageLoc (q / 256).toUInt8
            let m1 := poke m1 sy.Player_Y_Position (60 + 4 * y).toUInt8
            let m1 := poke m1 sy.Player_X_Speed v
            let m1 := poke m1 sy.Player_XSpeedAbsolute (TopSpeed.absB v)
            let m1 := poke m1 sy.Player_MovingDir (if v < 0x80 then 1 else 2)
            let m1 := poke m1 sy.Player_Y_Speed vy
            let m1 := poke m1 sy.Player_State st
            let m1 := poke m1 sy.Player_CollisionBits 0xFF
            o := framesRun sy nm m0 B m1 #[pad, pad] 0 o
  IO.println s!"overwritten states around the stairs: {o.str}"
  bad := bad + o.bad
  -- the start: the change on real frames
  let L ← changeLefts sy romPath
  let mut t := powerOn cart 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let mut runs := 0
  let mut zeros := 0
  let mut noStart := 0
  let mut least := 100000
  for sd in [0:n + 1] do
    let w := framesInputs (sd.toUInt64 + 4242) 400 0 0
    let mut x := if sd % 2 == 0 then t else L.e₂
    let mut f := 0
    let mut done := false
    while f < 400 && !done do
      if controllable sy x then
        done := true
        least := min least f
        unless decide (Potential.startHS sy x = Potential.startHS sy ctlOwn) && decide (posP sy x = posP sy ctlOwn) && decide (SurfaceFrames.vsOf sy x = SurfaceFrames.vsOf sy ctlOwn) &&
            peek x sy.Player_XSpeedAbsolute == peek ctlOwn sy.Player_XSpeedAbsolute && peek x sy.Player_CollisionBits == peek ctlOwn sy.Player_CollisionBits do
          noStart := noStart + 1
      else
        if L.lf₂ x == 0 then zeros := zeros + 1
        x := PipeTransition.frame x (if sd == 0 then 0 else w[f]!)
        f := f + 1
    if done then runs := runs + 1
  IO.println s!"the change: {runs} runs reach control, least {least} frames; a frame before control with `left` 0: {zeros}; control not in the state of `Start`: {noStart}"
  return if bad == 0 && rN && zeros == 0 && noStart == 0 then 0 else 1

/-- the numbers of `Route.Run` on a movie's frames, from frame `at_` on the inputs `hex`, then none: the frames of the parts, the timer, the grid and the level change -/
def routeCheck (sy : Syms) (romPath fm2Path : String) (at_ : Nat := 0) (hex : List UInt8 := []) : IO UInt32 := do
  let movie := parseFm2 (← IO.FS.readFile fm2Path)
  let inputs := alignInputs movie fceuxSkip
  let cart ← loadCart romPath
  let nm := CastleToLevel.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let mstart := smb11Start sy cart
  let q := CastleToLevel.subOf nm mstart
  let t0 := CastleToLevel.timerOf nm mstart + 1
  let mut m := powerOn cart 0
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if controllable sy m then
      k0 := k
      break
  -- the frames where control changes, then the touch, the castle and the level change
  let mut changes : Array Nat := #[]
  let mut was := true
  let mut g : Option Nat := none
  let mut E : Option (Nat × Nat × Nat) := none
  let mut L : Option Nat := none
  for f in [1:2400] do
    let i := if at_ != 0 && at_ < f then smbToPad (hex.getD (f - at_ - 1) 0) else inputs.getD (k0 + f) 0
    m := runFrame m i
    let c := controllable sy m
    -- after the two pipes, the next frame out of control is the touch
    if g.isNone && changes.size == 4 && !c then g := some f
    if g.isNone && c != was then
      changes := changes.push f
      was := c
    if E.isNone && peek m sy.StarFlagTaskControl != 0 then
      E := some (f, CastleToLevel.timerOf nm m, CastleToLevel.phaseOf nm m)
    if CastleToLevel.level sy m then
      L := some f
      break
  IO.println s!"control changes at {changes}; touch {g}; castle, timer, phase {E}; level change {L}"
  match changes.toList, g, E, L with
  | [ea, c1, eb, c3], some gf, some (e, t, c), some l =>
    let p1 := ea
    let x1 := c1 - ea
    let p2 := eb - c1
    let x2 := c3 - eb
    let p3 := gf - c3
    let w := e - gf
    let d := CastleToLevel.fireD t
    IO.println s!"P1 {p1}, X1 {x1}, P2 {p2}, X2 {x2}, P3 {p3}, W {w}; E = sum: {decide (e = p1 + x1 + p2 + x2 + p3 + w)}"
    IO.println s!"bounds of the parts: 368 ≤ P1 {decide (368 ≤ p1)}, 91 ≤ X1 {decide (91 ≤ x1)}, 111 ≤ P2 {decide (111 ≤ p2)}, 282 ≤ X2 {decide (282 ≤ x2)}"
    IO.println s!"the touch's cases: {decide (234 ≤ p3 ∧ 132 ≤ w) || decide (240 ≤ p3 ∧ p3 ≤ 241 ∧ 126 ≤ w) || decide (242 ≤ p3 ∧ 125 ≤ w)}"
    IO.println s!"T {t}: t0 ≤ T + ticks: {decide (t0 ≤ t + (CastleToLevel.ticks q p1 + CastleToLevel.ticks q p2 + CastleToLevel.ticks q p3))}; E + T = {e + t}"
    IO.println s!"grid: (c + E) mod 21 = {(c + e) % 21}; D {d}; formula {e + CastleToLevel.formula c t d} = L: {decide (e + CastleToLevel.formula c t d = l)}; L {l}"
  | _, _, _, _ => IO.println "not this route"
  changesCheck sy romPath fm2Path fun i k => if at_ != 0 && at_ < k then smbToPad (hex.getD (k - at_ - 1) 0) else i k

/-- the rules of `CastleToLevel.Frames` and `CastleToLevel.Flag` on a movie's frames up to the level change, with the inputs changed by `edit`: the rule on each frame, the segments read from the frames, and the facts of the rules -/
def framesCheck (sy : Syms) (romPath fm2Path : String) (edit : (Nat → UInt8) → Nat → UInt8 := id) : IO UInt32 := do
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2Path)) fceuxSkip
  let cart ← loadCart romPath
  let nm := CastleToLevel.namesFrom (← IO.FS.readFile (← (← Config.load none).path "disasm"))
  let mstart := smb11Start sy cart
  let q := CastleToLevel.subOf nm mstart
  let t0 := CastleToLevel.timerOf nm mstart + 1
  -- the machine before frame 0
  let mut x := powerOn cart 0
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    let y := runFrame x inputs[k]
    if controllable sy y then
      k0 := k
      break
    x := y
  let inp := edit fun k => inputs.getD (k0 + k) 0
  -- the ends of the segments: e₁, z₁, c₂, e₂, z₂, c₃, g
  let mut ends : Array Nat := #[]
  let mut r := 0
  let mut j := 0
  let mut bad : Array Nat := #[]
  let mut E : Option Nat := none
  for n in [0:4000] do
    let y := runFrame x (inp n)
    if !CastleToLevel.ruleOK sy nm q x y then bad := bad.push n
    let k := CastleToLevel.kindOf sy nm x y
    let st := ends.size
    let inPlay := st == 0 || st == 3 || st == 6
    let inChange := st == 1 || st == 4
    let lastChange := st == 2 || st == 5
    if (inPlay && k == .auto) || (inChange && k == .lag) || (lastChange && k == .play) then ends := ends.push r
    else if (inChange && k == .play) || (st == 7 && k == .play) then bad := bad.push n
    if k == .lag && !inChange then j := j + 1 else r := r + 1
    x := y
    if peek y sy.StarFlagTaskControl != 0 then
      E := some n
      break
  match ends.toList, E with
  | [e₁, z₁, c₂, e₂, z₂, c₃, g], some e =>
    let T := CastleToLevel.timerOf nm x
    let c := CastleToLevel.phaseOf nm x
    let last := r - 1
    IO.println s!"segments {[e₁, z₁, c₂, e₂, z₂, c₃, g, last]}; E {e}, T {T}, c {c}, j {j}; frames against the rule {bad}"
    IO.println s!"hE {decide (e = last + j)}; hT {decide (t0 ≤ T + (CastleToLevel.ticks q e₁ + CastleToLevel.ticks q (e₂ - c₂) + CastleToLevel.ticks q (g - c₃)))}; hc {decide ((c + e) % 21 = (3 + j) % 21)}"
    -- the frames after the castle entry, up to the level change
    let lim := sy.StarFlagTopY.toNat
    let a0 := CastleToLevel.flagOf sy nm x
    let mut early := 0
    let mut lag := 0
    let mut bad2 : Array Nat := #[]
    let mut L : Option Nat := none
    let mut seen : Array (Nat × Nat) := #[]
    for n in [e + 1:e + 4000] do
      let y := runFrame x (inp n)
      let a := CastleToLevel.flagOf sy nm x
      if seen.back?.map (·.2) != some a.task then seen := seen.push (n, a.task)
      if CastleToLevel.level sy y then
        if a.task != 5 then bad2 := bad2.push n
        L := some n
        break
      if !CastleToLevel.flagRuleOK sy nm x y then
        if bad2.size < 8 then IO.println s!"against the rule, frame {n}: {repr a} -> {repr (CastleToLevel.flagOf sy nm y)}"
        bad2 := bad2.push n
      if CastleToLevel.flagLag nm x y then lag := lag + 1
      else if a.task ≤ 3 then early := early + 1
      x := y
    let Df := early - T
    IO.println s!"at the entry: task {a0.task}, y {a0.y}, y_E {decide (lim + 30 ≤ a0.y)}; the frames where each task begins {seen}"
    IO.println s!"D {Df}, frames that do not run after E {lag}, L {L}; frames against the rule {bad2}"
    match L with
    | some l =>
      IO.println s!"hD {decide (33 ≤ Df)}; hL {decide (e + T + Df + 107 + CastleToLevel.wait c (T + Df) ≤ l)}; L - (E + T + D + 107 + wait) = {(l : Int) - (e + T + Df + 107 + CastleToLevel.wait c (T + Df) : Nat)}"
    | none => IO.println "no level change"
    return 0
  | l, _ =>
    IO.println s!"not this route: ends {l}, castle {E}, frames against the rule {bad}"
    return 1

/-! ## Runs with the hurry-up music, and the machine when frame 0 begins -/

/-- what `hurryScan` counts on real frames -/
structure HurryScan where
  frames : Nat := 0
  /-- frames that start the hurry-up music: the frame, and the timer when it begins -/
  starts : Array (Nat × Nat) := #[]
  /-- of them, those that begin with the timer above `u`: against `HurryMusic.Run.music` -/
  high : Nat := 0
  /-- frames that end with the music -/
  on : Nat := 0
  /-- frames before the castle entry against the rule `Step`, with the kind read as `frames-check` reads it -/
  against : Nat := 0
  /-- the routines (`GameEngineSubroutine`) at the start and the end of those frames -/
  againstAt : Array (Nat × Nat) := #[]

/-- `n` real frames from `m`: the field `HurryMusic.Run.music` with `u`, and the rule `Step` -/
def hurryScan (sy : Syms) (cnm hnm : PipeTransitionAll.Names) (q u : Nat) (m : Machine) (inp : Nat → UInt8) (n : Nat) (r : HurryScan) : HurryScan := Id.run do
  let mut x := m
  let mut r := r
  for k in [0:n] do
    let y := runFrame x (inp k)
    r := { r with frames := r.frames + 1 }
    if !HurryMusic.hurryOn hnm x && HurryMusic.hurryOn hnm y then
      r := { r with starts := r.starts.push (k, CastleToLevel.timerOf hnm x) }
      if decide (u < CastleToLevel.timerOf hnm x) then r := { r with high := r.high + 1 }
    if HurryMusic.hurryOn hnm y then r := { r with on := r.on + 1 }
    if peek x sy.StarFlagTaskControl == 0 && !CastleToLevel.ruleOK sy cnm q x y then
      r := { r with against := r.against + 1, againstAt := r.againstAt.push ((peek x sy.GameEngineSubroutine).toNat, (peek y sy.GameEngineSubroutine).toNat) }
    x := y
  return r

/-- random inputs from a seed: any buttons but Select and Start, and a pause of 50 frames every 300 frames -/
def hurryInputs (seed : UInt64) (k : Nat) : UInt8 := Id.run do
  if k % 300 == 150 || k % 300 == 200 then return 0x08
  let mut s := seed + 0x9E3779B97F4A7C15 * (k.toUInt64 + 1)
  s := s ^^^ (s >>> 30)
  s := s * 0xBF58476D1CE4E5B9
  s := s ^^^ (s >>> 27)
  s := s * 0x94D049BB133111EB
  s := s ^^^ (s >>> 31)
  return (s >>> 17).toUInt8 &&& 0xF3

/-- The fields of `HurryMusic.Run` and `Route.Run.zero` on real frames. The machine when frame 0 of the movie begins, and when frame 0 begins after Start at other frames of
the title. The movie up to its level change. The timer written near 100 when frames of the movie begin, then the movie's inputs or random inputs with pauses. -/
def hurryCheck (sy : Syms) (romPath fm2Path : String) : IO UInt32 := do
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let cnm := CastleToLevel.namesFrom text
  let fnm := FlagRule.namesFrom text
  let hnm := HurryMusic.namesFrom text
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2Path)) fceuxSkip
  let cart ← loadCart romPath
  let mstart := smb11Start sy cart
  let q := CastleToLevel.subOf cnm mstart
  let t0 := CastleToLevel.timerOf cnm mstart + 1
  let u := 100
  IO.println s!"the names read: {hnm.map (·.1)}; q {q}, t0 {t0}, u {u}"
  -- the machine when frame 0 of the movie begins
  let mut x := powerOn cart 0
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    let y := runFrame x inputs[k]
    if controllable sy y then
      k0 := k
      break
    x := y
  let x0 := x
  let inp := fun k => inputs.getD (k0 + k) 0
  let zeroOK := fun (b : Machine) => CastleToLevel.timerOf fnm b == t0 && CastleToLevel.phaseOf fnm b == 2 && !HurryMusic.hurryOn hnm b
  IO.println s!"the movie, when frame 0 begins: timer {CastleToLevel.timerOf fnm x0}, phase {CastleToLevel.phaseOf fnm x0}, hurry-up music {HurryMusic.hurryOn hnm x0}: zero {zeroOK x0}"
  -- Start at other frames of the title
  let mut ok := 0
  let mut notOk : Array Nat := #[]
  let mut ignored := 0
  let mut ignoredAt : Array Nat := #[]
  for i in [0:100] do
    let kk := 30 + 6 * i
    -- from power-on with Start on frame `kk`: the machine one frame before the first control after it
    let mut m := powerOn cart 0
    let mut found : Option (Machine × Machine) := none
    for k in [0:kk + 1200] do
      let y := runFrame m (if k == kk then 0x08 else 0)
      if k > kk && controllable sy y then
        found := some (m, y)
        break
      m := y
    match found with
    | some (b, y) =>
      if !CastleToLevel.level sy y && zeroOK b then ok := ok + 1 else notOk := notOk.push kk
    | none =>
      ignored := ignored + 1
      ignoredAt := ignoredAt.push kk
  IO.println s!"Start at 100 frames of the title, 30 to 624: zero holds {ok}, fails {notOk}, no control in 1200 frames {ignored} (Start on {ignoredAt.toList})"
  flush
  -- the movie up to its level change
  let r := hurryScan sy cnm hnm q u x0 inp 1760 {}
  IO.println s!"the movie, {r.frames} frames: frames that start the music {r.starts.size}, frames with the music {r.on}, frames before the castle against the rule {r.against}"
  flush
  -- the timer written near 100
  let mut tm : HurryScan := {}
  let mut tr : HurryScan := {}
  let mut runs := 0
  let mut noMusic := 0
  let mut late : Array (Nat × Nat × Nat) := #[]
  let mut atSide := 0
  for f in [100, 300, 380, 420, 500, 540, 560, 600, 700, 900, 1050, 1100] do
    let mut m := x0
    for k in [0:f] do m := runFrame m (inp k)
    for v in [100, 101, 102, 103, 105, 110, 124] do
      let mv := CastleToLevel.setTimer cnm m v
      let a := hurryScan sy cnm hnm q u mv (fun k => inp (f + k)) 600 {}
      let b := hurryScan sy cnm hnm q u mv (hurryInputs (f * 1000 + v).toUInt64) 600 {}
      runs := runs + 2
      if a.on == 0 then noMusic := noMusic + 1
      if b.on == 0 then noMusic := noMusic + 1
      for (k, t) in a.starts ++ b.starts do
        if k > 200 then late := late.push (f, v, k)
        let _ := t
      tm := { frames := tm.frames + a.frames, starts := tm.starts ++ a.starts, high := tm.high + a.high, on := tm.on + a.on, against := tm.against + a.against, againstAt := tm.againstAt ++ a.againstAt }
      tr := { frames := tr.frames + b.frames, starts := tr.starts ++ b.starts, high := tr.high + b.high, on := tr.on + b.on, against := tr.against + b.against, againstAt := tr.againstAt ++ b.againstAt }
      -- the side pipe's entry of the movie, frame 571 when it begins
      if f ≤ 560 then
        let mut y := mv
        for k in [f:571] do y := runFrame y (inp k)
        if HurryMusic.hurryOn hnm y then atSide := atSide + 1
  IO.println s!"timer written to 100..124 on 12 frames of the movie, {runs} runs of 600 frames: runs without the music {noMusic}; starts more than 200 frames in {late.size}"
  IO.println s!"  the movie's inputs: {tm.frames} frames, frames that start the music {tm.starts.size}, of them with the timer above {u}: {tm.high}; the timers there {(tm.starts.map (·.2)).toList.eraseDups}; frames against the rule {tm.against}"
  IO.println s!"  random inputs and pauses: {tr.frames} frames, frames that start the music {tr.starts.size}, of them with the timer above {u}: {tr.high}; the timers there {(tr.starts.map (·.2)).toList.eraseDups}; frames against the rule {tr.against}, routines there {tr.againstAt.toList.eraseDups}"
  IO.println s!"  runs from frames up to 560 with the music at the side pipe's entry of the movie (frame 571): {atSide}"
  return (if zeroOK x0 && notOk.isEmpty && r.starts.isEmpty && tm.high == 0 && tr.high == 0 then 0 else 1)

/-- as `endPoke`, but print the best input sequence and replay it frame by frame -/
def endPokeTrace (sy : Syms) (romPath fm2Path : String) (a y : Nat) (dx : Int) (fd d : Nat) : IO UInt32 := do
  let (m0, _, _) ← movieAt sy romPath fm2Path a
  let p := posP sy m0 + dx
  let m := poke m0 sy.SprObject_X_MoveForce (p % 256).toNat.toUInt8
  let m := poke m sy.Player_X_Position ((p / 256) % 256).toNat.toUInt8
  let m := poke m sy.Player_PageLoc ((p / 65536) % 256).toNat.toUInt8
  let m := poke m sy.Player_Y_Position y.toUInt8
  let m := poke m sy.Player_Y_Speed sy.MaxFallSpeed.toUInt8
  let m := poke m sy.Player_Y_MoveForce 0
  let m1 := poke m sy.PlayerFacingDir fd.toUInt8
  let ins : List UInt8 := [0x41, 0xC1, 0x01, 0x81, 0x03, 0x83, 0x00, 0x80]
  let mut layer : Array (Machine × List UInt8) := #[(m1, [])]
  let mut best : Option (Nat × List UInt8) := none
  for k in [0:d] do
    let mut nxt : Std.HashMap (Array UInt8) (Machine × List UInt8) := {}
    for (m, path) in layer do
      for i in ins do
        let m' := runFrame m (smbToPad i)
        let eng := peek m' sy.GameEngineSubroutine
        if eng.toUInt16 == sy.Eng_PlayerCtrl then nxt := nxt.insert (ramKey sy m') (m', path ++ [i])
        else if sy.inFlag eng then
          match toCastle sy m' with
          | some c =>
            let f := k + 1 + c
            if (match best with | some (b, _) => decide (f < b) | none => true) then best := some (f, path ++ [i])
          | none => pure ()
    layer := nxt.valuesArray
  match best with
  | none => IO.println "no castle entry"
  | some (f, path) =>
    IO.println s!"castle after {f} frames, inputs {path.map hex2}"
    let mut mm := m1
    for i in path ++ List.replicate 140 (0 : UInt8) do
      mm := runFrame mm (smbToPad i)
      IO.println s!"  in {hex2 i} x {peek mm sy.Player_X_Position} pg {peek mm sy.Player_PageLoc} y {peek mm sy.Player_Y_Position} st {peek mm sy.Player_State} eng {peek mm sy.GameEngineSubroutine} castle {peek mm sy.StarFlagTaskControl}"
      if peek mm sy.StarFlagTaskControl != 0 then break
  return 0

/-! ## The star flag's rule on real frames -/

/-- the context of the star flag's check: the castle entry of the route of `CastleWalk` with no delay and the real timer -/
def flagCtxOf (sy : Syms) (text : String) (m0 : Machine) : FlagRule.Ctx :=
  let cnm := CastleToLevel.namesFrom text
  let p : CastleToLevel.Params :=
    ⟨126, CastleToLevel.subOf cnm m0, CastleToLevel.timerOf cnm m0 + 1, CastleToLevel.phaseOf cnm m0, CastleToLevel.phaseOf cnm m0 + 2⟩
  FlagRule.ctxOf sy (FlagRule.namesFrom text) (CastleToLevel.entryAt sy cnm p m0 0 none) p.t0

/-- the machine when frame `E + 1` begins on a movie with the inputs changed by `edit`, with `E`, and the inputs from frame 0 -/
def flagEntryOf (sy : Syms) (romPath fm2Path : String) (edit : (Nat → UInt8) → Nat → UInt8 := id) : IO (Option (Machine × Nat × (Nat → UInt8))) := do
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2Path)) fceuxSkip
  let cart ← loadCart romPath
  let mut x := powerOn cart 0
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    let y := runFrame x inputs[k]
    if controllable sy y then
      k0 := k
      break
    x := y
  let inp := edit fun k => inputs.getD (k0 + k) 0
  for n in [0:4000] do
    x := runFrame x (inp n)
    if peek x sy.StarFlagTaskControl != 0 then return some (x, n, inp)
  return none

/-- the frames after a castle entry `x0` on frame `e`, up to the level change: the condition of `FlagRule.After`, `Good` and the rule on each frame -/
def flagRunReport (c : FlagRule.Ctx) (d : FlagRule.Data) (name : String) (x0 : Machine) (e : Nat) (inp : Nat → UInt8) : IO Unit := do
  let task := fun (m : Machine) => (m.ram.get! c.task).toNat
  let entry := FlagRule.goodOK c d x0
  let mut x := x0
  let mut n := e + 1
  let mut notGood := 0
  let mut against := 0
  let mut starts := 0
  let mut first5 : Option Nat := none
  let mut L : Option Nat := none
  while n < e + 4000 do
    let y := runFrame x (inp n)
    if inp n &&& 0x08 != 0 then starts := starts + 1
    if first5.isNone then
      if task x == 5 then first5 := some n
      else
        if !FlagRule.goodOK c d x then notGood := notGood + 1
        if !decide (CastleToLevel.FlagRun c.lim c.w0 (CastleToLevel.flagOf c.sy c.nm x) (CastleToLevel.flagOf c.sy c.nm y)) then against := against + 1
    if CastleToLevel.level c.sy y then
      L := some n
      break
    x := y
    n := n + 1
  if !entry then
    let best := d.B0.foldl (fun (acc : Option (List Nat)) S =>
      let dl := FlagRule.coverDiff S x0
      match acc with
      | some b => if dl.length < b.length then some dl else acc
      | none => some dl) none
    IO.println s!"  {name}: bytes of the nearest start state that differ: {(best.getD []).map fun i => hex4 i.toUInt16}"
  IO.println s!"{name}: E {e}; at E + 1: Good {entry}, task 2 {task x0 == 2}, height {x0.ram.get! c.y == c.r.ram.get! c.y}, timer {CastleToLevel.timerOf c.nm x0}; first frame of task 5 {first5}; level change after frame {L}; frames not in Good {notGood}, against the rule {against}, frames with Start {starts}"
  flush

/-- the star flag's check on the ROM, and its condition on real frames, as a program -/
def flagRuleCheck (sy : Syms) (romPath fm2 : String) (args : List String) : IO UInt32 := do
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let m0 ← startM sy romPath
  let c := flagCtxOf sy text m0
  let r := c.r
  IO.println s!"reference entry: task {r.ram.get! c.task}, timer {CastleToLevel.timerOf c.nm r}, phase {CastleToLevel.phaseOf c.nm r}, known bytes {c.K.length}"
  let timed := fun (name : String) (b : Unit → Bool) => do
    let t0 ← IO.monoMsNow
    let v ← IO.lazyPure b
    IO.println s!"{name}: {v} ({(← IO.monoMsNow) - t0} ms)"
    flush
  let t0 ← IO.monoMsNow
  let d ← IO.lazyPure fun _ => FlagRule.dataOf c
  IO.println s!"data: starts {d.B0.length}, stages {d.pl.length}, Mario's numbers {d.Q.length}, moves {d.tbl.length} ({(← IO.monoMsNow) - t0} ms)"
  flush
  if !args.contains "real" then
    for j in [0:13] do
      timed s!"stage {j}" fun _ => FlagRule.stageOK c d j
    timed "end stage" fun _ => FlagRule.endStageOK c d
    timed "Mario" fun _ => FlagRule.marioCheck c d.Q d.tbl
    timed "basic" fun _ => FlagRule.basicOK c d
  -- real frames
  let rand := fun (k : Nat) => ((k * 1103515245 + 12345) / 65536 % 256).toUInt8 &&& 0xF7
  let some (_, eT, _) ← flagEntryOf sy romPath fm2 id | return 1
  let edits : List (String × ((Nat → UInt8) → Nat → UInt8)) := [
    ("movie", id),
    ("insert 96", fun i n => if n < 96 then 0 else i (n - 96)),
    ("insert 168", fun i n => if n < 168 then 0 else i (n - 168)),
    ("insert 216", fun i n => if n < 216 then 0 else i (n - 216)),
    ("late touch", fun i k => let w : List UInt8 := [0x02, 0x80, 0x80, 0x80]; if 1089 < k then smbToPad (w.getD (k - 1089 - 1) 0) else i k),
    ("random, no Start", fun i k => if k ≤ eT then i k else rand k),
    ("random 2, no Start", fun i k => if k ≤ eT then i k else rand (k * 7 + 3)),
    ("every button but Start", fun i k => if k ≤ eT then i k else 0xF7),
    ("pause at E + 60", fun i k => if k == eT + 60 || k == eT + 60 + 80 then 0x08 else i k),
    ("pause at E + 300", fun i k => if k == eT + 300 || k == eT + 300 + 80 then 0x08 else i k)]
  for (nm, ed) in edits do
    match ← flagEntryOf sy romPath fm2 ed with
    | some (x0, e, inp) => flagRunReport c d nm x0 e inp
    | none => IO.println s!"{nm}: no castle entry"
  -- the reference entry with no input, and with the timer overwritten at the entry
  flagRunReport c d "reference, no input" r 0 fun _ => 0
  for t in [0, 1, 3, 6, 60, 100, 120, 200, 400] do
    flagRunReport c d s!"reference, timer {t}" (CastleToLevel.setTimer c.nm r t) 0 fun _ => 0
  return 0

