")

/-- round 24: the private file of `BufferCoin`: the walks from the control at 6, page 0, and each piece of the position from 16 to 180 px (about 3 min natively) -/
def genBufferCoin (dir : String) : IO Unit :=
  IO.FS.writeFile s!"{dir}/BufferCoin.lean" ("import Proof.ScreenPage\nimport Theorems.BufferCoin\n" ++ s!"/-! {privateNote} -/\n" ++ "
open Smbrta Smbrta.Rom
set_option maxHeartbeats 0

/-- a frame of the room that starts with the control of the screen's buffers at 6, on page 0, with the position in a piece from 16 to 180 px, comes to the end of
the move only left of the mouth's left end -/
theorem buffer_coin_check : BufferCoin.coinCheck sy screenNames ctx = true := by native_decide
")

/-- round 25: the private file of `BufferEnd`: the walks from the control of the screen's buffers at 0 and at 6 -/
def genBufferEnd (dir : String) : IO Unit :=
  IO.FS.writeFile s!"{dir}/BufferEnd.lean" ("import Proof.ScreenPage\nimport Theorems.BufferEnd\n" ++ s!"/-! {privateNote} -/\n" ++ "
open Smbrta Smbrta.Rom
set_option maxHeartbeats 0

/-- a frame of the room that starts with the control of the screen's buffers at 0 or 6 and ends with it at 6 ends with the position from 16 to 180 px -/
theorem buffer_end_check : BufferEnd.endCheck sy screenNames ctx = true := by native_decide
")

/-- the private file of `LandDist`: a big player's slow takeoff on the first frame after the fall in the bonus room (`RoomJoin.Checks.slowLand`), with the slow pairs
of the jump table (`roomNums.slow`) -/
def genLandDist (sy : Syms) (romPath dir : String) : IO Unit := do
