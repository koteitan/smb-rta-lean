import Smbrta
import Config
import Theorems.FastAccel
import Theorems.TasFastAccel

open Smbrta

/-! # Command line

`smbrta [--config FILE] COMMAND ...` — paths come from `smbrta.json` (see `Config.lean`):
the ROM, the symbol file made by `tools/extract_syms.py`, the private proof directory, test data. -/

def hex2 (v : UInt8) : String :=
  let d := "0123456789ABCDEF".toList
  String.ofList [d[(v >>> 4).toNat]!, d[(v &&& 15).toNat]!]

def hex4 (v : UInt16) : String := hex2 (v >>> 8).toUInt8 ++ hex2 v.toUInt8

def flush : IO Unit := do (← IO.getStdout).flush

/-- `--poke NAME=VALUE` options: RAM bytes (by symbol name) to change in the 1-1 start -/
initialize pokes : IO.Ref (List (String × Nat)) ← IO.mkRef []

def loadCart (romPath : String) : IO Machine := do
  match Machine.ofINes (← IO.FS.readBinFile romPath) with
  | .ok m => pure m
  | .error e => throw (IO.userError e)

def lst (w : List UInt8) : String := "[" ++ ", ".intercalate (w.map fun b => s!"0x{hex2 b}") ++ "]"

/-- the first controllable frame of 1-1, with the `--poke` changes -/
def startM (sy : Syms) (romPath : String) : IO Machine := do
  let m := smb11Start sy (← loadCart romPath)
  (← pokes.get).foldlM (fun m (n, v) => match Syms.fields.lookup n with
    | some f => pure (poke m (f sy) v.toUInt8)
    | none => throw (IO.userError s!"--poke: unknown name {n}")) m

/-! ## nestest: the CPU against the reference log -/

def traceKey (m : Machine) : String :=
  s!"{hex4 m.pc} A:{hex2 m.a} X:{hex2 m.x} Y:{hex2 m.y} P:{hex2 m.p} SP:{hex2 m.s} CYC:{m.cyc}"

def logKey (line : String) : String :=
  let cs := line.toList
  s!"{String.ofList (cs.take 4)} {String.ofList ((cs.drop 48).take 25)} {String.ofList ((cs.drop 86).takeWhile (· != '\r'))}"

def runNestest (romPath logPath : String) : IO UInt32 := do
  let lines := (← IO.FS.lines logPath).filter (· != "")
  let mut m := { (← loadCart romPath) with pc := 0xC000, cyc := 7, fdot := 21 }
  let mut n := 0
  for line in lines do
    if logKey line != traceKey m then
      IO.println s!"MISMATCH at line {n + 1}\n  want: {logKey line}\n  got : {traceKey m}"
      return 1
    m := (step.run m).2
    n := n + 1
  IO.println s!"nestest: all {n} lines match"
  return 0

/-! ## Movies -/

def runMovie (sy : Syms) (romPath fm2Path : String) (skip : Nat) : IO UInt32 := do
  let movie := parseFm2 (← IO.FS.readFile fm2Path)
  let inputs := alignInputs movie skip
  let mut m := powerOn (← loadCart romPath) 0
  let mut last := (255, 255, 255)
  let mut cleared : Option Nat := none
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    let now := (peek m sy.OperMode, peek m sy.WorldNumber, peek m sy.LevelNumber)
    if now != last then
      IO.println s!"frame {k}: mode {now.1} world {now.2.1.toNat + 1}-{now.2.2.toNat + 1}"
      last := now
    if cleared.isNone && smbCleared sy m then cleared := some k
  match cleared with
  | some k => IO.println s!"CLEARED after emulator frame {k} (movie frame {k + skip})"; return 0
  | none => IO.println "not cleared"; return 1

/-! ## Generated private proof files (they embed the ROM or the movie: keep them private) -/

def privateNote : String := "Generated by `smbrta`. Contains data taken from the ROM: keep it private."

/-- `Proof/Rom.lean`: the ROM, the symbol values, and the first controllable frame of 1-1 -/
def genRom (sy : Syms) (romPath dir : String) : IO UInt32 := do
  let rom ← IO.FS.readBinFile romPath
  IO.FS.writeFile s!"{dir}/Rom.lean" s!"import Smbrta
/-! {privateNote} -/
namespace Smbrta.Rom

def romHex : String := \"{hexEncode rom}\"

/-- symbol values (from `tools/extract_syms.py`) -/
def sy : Syms := {sy.toLean}

def cart : Machine :=
  match Machine.ofINes (hexDecode romHex) with
  | .ok m => m
  | .error _ => default

/-- the machine at the first controllable frame of 1-1 -/
def ctx : Machine := smb11Start sy cart

end Smbrta.Rom
"
  IO.println s!"wrote {dir}/Rom.lean"
  return 0

/-- the theorem files that only apply `native_decide` to the public statements -/
def genProofs (dir : String) : IO UInt32 := do
  let head := fun (mods : List String) => "\n".intercalate (("import Proof.Rom" :: mods.map (s!"import Theorems.{·}"))) ++ s!"
/-! {privateNote} -/
open Smbrta Smbrta.Rom

set_option maxHeartbeats 0
"
  -- one file per land area (built in parallel), and one file that combines them
  let parts := [("FastAccel", "fast_accel", "padInputsA", "relaxInputs", 33, 34, "witness",
      "fast accel, real controller: relaxed lower bound 33, emulator witness of 34 frames"),
    ("TasFastAccel", "tas_fast_accel", "lrInputsA", "relaxInputsLR", 30, 32, "TasFastAccel.witness",
      "TAS fast accel (Left+Right): relaxed lower bound 30, emulator witness of 32 frames")]
  for (file, thm, eins, rins, lo, n, wit, doc) in parts do
    let mods := if file == "FastAccel" then ["FastAccel"] else ["FastAccel", "TasFastAccel"]
    for a in [1, 2, 3] do
      IO.FS.writeFile s!"{dir}/{file}Area{a}.lean" (head mods ++ s!"
open Smbrta.FastAccel in
/-- {doc}; `AreaType` = {a} -/
theorem {thm}_area{a} : Bounds sy (inArea sy ctx {a}) {eins} {rins} {lo} {n} :=
  ⟨lower_of_check sy (inArea sy ctx {a}) {rins} {lo} (by native_decide), {wit}, by native_decide, by native_decide⟩
")
    IO.FS.writeFile s!"{dir}/{file}.lean" ("\n".intercalate ([1, 2, 3].map (s!"import Proof.{file}Area{·}")) ++ s!"
/-! {privateNote} -/
open Smbrta Smbrta.Rom

open Smbrta.FastAccel in
/-- {doc}, in every land area -/
theorem {thm} : BoundsAllAreas sy ctx {eins} {rins} {lo} {n} :=
  allAreas_of {thm}_area1 {thm}_area2 {thm}_area3
")
  IO.println s!"wrote {dir}/FastAccel*.lean, TasFastAccel*.lean"
  return 0

/-! ## Ground physics -/

def physValidate (sy : Syms) (romPath : String) (runs len : Nat) (bias : UInt8) (pct : Nat) :
    IO UInt32 := do
  let m0 := (← startM sy romPath)
  let s0 := PState.read sy m0
  let ins := groundInputs.toArray
  let mut seed : Nat := 12345
  let mut bad := 0
  for r in [0:runs] do
    let mut m := m0
    let mut s := s0
    for k in [0:len] do
      seed := (seed * 1103515245 + 12345) % 2147483648
      let inp := if (seed / 4096) % 100 < pct then bias else ins[(seed / 65536) % ins.size]!
      let x0 := playerX sy m
      let (s', dx) := stepFull sy m0 s inp
      m := runFrame m (smbToPad inp)
      s := s'
      if PState.read sy m != s || playerX sy m - x0 != dx then
        bad := bad + 1
        if bad ≤ 3 then IO.println s!"run {r} frame {k}: model and emulator differ at x={playerX sy m}"
        break
  IO.println s!"validate: {runs} runs x {len} frames, differing runs: {bad}"
  return if bad == 0 then 0 else 1

/-- RAM bytes the ground step reads and writes over the search up to `depth`. -/
def physLive (sy : Syms) (romPath : String) (depth : Nat) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let mut rd := ByteArray.mk (Array.replicate 2048 0)
  let mut wr := ByteArray.mk (Array.replicate 2048 0)
  let mut io := false
  let mut layer : List PState := [dropPos (PState.read sy m0)]
  for _ in [0:depth] do
    for s in layer do
      for i in padInputs do
        for p in [0, 0x80] do
          let (_, r, w, o) := stepTracked sy m0 { s with posMF := p.toUInt8 } i
          for k in [0:2048] do
            if r.get! k != 0 then rd := rd.set! k 1
            if w.get! k != 0 then wr := wr.set! k 1
          io := io || o
    layer := Cert.next (fun s i => dropPos (stepP sy m0 s i)) padInputs layer
  let name := fun (k : Nat) => match Syms.fields.find? (fun (_, f) => (f sy).toNat == k) with
    | some (n, _) => n
    | none => s!"(unnamed {k})"
  let live := (flagged rd).filter fun k => wr.get! k != 0
  let readOnly := (flagged rd).filter fun k => wr.get! k == 0
  IO.println s!"I/O read: {io}"
  IO.println s!"carried between frames: {live.map name}"
  IO.println s!"read only (constant or injected): {readOnly.map name}"
  return 0

/-- Vary the dropped bytes (x, page, position fraction) on every search step up to `depth`. -/
def physIndep (sy : Syms) (romPath : String) (depth : Nat) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let variants : List (UInt8 × UInt8 × UInt8) := [(0xF0, 0xFF, 0x00), (0x80, 0x7F, 0x01), (0x10, 0x00, 0x02)]
  let ctxs := variants.map fun (p, x, pg) =>
    (poke (poke m0 sy.Player_X_Position x) sy.Player_PageLoc pg, p)
  let stepR := fun s i => dropPos (stepP sy m0 s i)
  let mut layer : List PState := [dropPos (PState.read sy m0)]
  let mut steps := 0
  let mut bad := 0
  for _ in [0:depth] do
    for s in layer do
      for i in padInputs do
        let t := stepR s i
        for (c, p) in ctxs do
          steps := steps + 1
          if dropPos (stepP sy c { s with posMF := p } i) != t then bad := bad + 1
    layer := Cert.next stepR padInputs layer
  IO.println s!"independence: {steps} varied steps, {bad} differences"
  return if bad == 0 then 0 else 1

/-! ## Jumping -/

/-- open area of 1-1 used by the jump searches -/
def openLo : Int := 0x18
def openHi : Int := 0xE0

def jumpDiscover (sy : Syms) (romPath : String) (walks len : Nat) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let (carried, io) := discoverCarried sy m0 walks len openLo openHi
  let name := fun (a : UInt16) => match Syms.fields.find? (fun (_, f) => f sy == a) with
    | some (n, _) => n
    | none => s!"(unnamed {a.toNat})"
  IO.println s!"I/O read: {io}; carried between frames ({carried.length}): {carried.map name}"
  let md : Model := { sy, ctx := m0, vars := movementVars sy carried }
  -- compare with the full emulator on the movement bytes
  let ins := padInputsA.toArray
  let mut seed : Nat := 4242
  let mut bad := 0
  let mut frames := 0
  for _ in [0:walks] do
    let mut s := md.read m0
    let mut m := m0
    let mut inp : UInt8 := 0
    for _ in [0:len] do
      seed := (seed * 1103515245 + 12345) % 2147483648
      if (seed / 65536) % 4 == 0 then inp := ins[(seed / 256) % ins.size]!
      s := md.step s inp
      m := runFrame m (smbToPad inp)
      frames := frames + 1
      if md.read m != s then bad := bad + 1
      let x := playerX sy m
      if x > openHi || x < openLo then break
  IO.println s!"model vs full emulator on the {md.vars.size} movement bytes: {frames} frames, {bad} differing"
  return if bad == 0 then 0 else 1

def relaxLayers (sy : Syms) (romPath : String) (depth : Nat) (rins : List (UInt8 × Bool)) :
    IO UInt32 := do
  let m0 := (← startM sy romPath)
  let top := sy.RunTopSpeed.toNat
  let mut layer : List RState := [{ h := dropPos (PState.read sy m0), air := false }]
  for d in [1:depth + 1] do
    layer := Cert.next (stepRelax sy m0) rins layer
    let best := layer.foldl (fun b s => max b s.h.speedInt) (-1000)
    IO.println s!"depth {d}: {layer.length} states, best speed {best}"; flush
    if best ≥ top then IO.println s!"top speed first reached at depth {d}"; return 0
  return 0

/-- Exact search for `depth` frames, pruned by relaxed reachability (loses no real path). -/
def realize (sy : Syms) (romPath : String) (depth : Nat) (rins : List (UInt8 × Bool))
    (eins : List UInt8) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let top := sy.RunTopSpeed.toNat
  let goalR := fun (s : RState) => s.h.speedInt ≥ top
  let mut layers : Array (List RState) := #[[{ h := dropPos (PState.read sy m0), air := false }]]
  for _ in [0:depth] do
    layers := layers.push (Cert.next (stepRelax sy m0) rins layers.back!)
  let mut good : Array (Std.HashSet RState) := Array.replicate (depth + 1) {}
  good := good.set! depth (Std.HashSet.ofList (layers[depth]!.filter goalR))
  for j in [0:depth] do
    let k := depth - 1 - j
    let ng := good[k + 1]!
    good := good.set! k (Std.HashSet.ofList (layers[k]!.filter fun s =>
      goalR s || rins.any fun c => ng.contains (stepRelax sy m0 s c)))
  IO.println s!"relaxed good-state counts: {good.map (·.size)}"; flush
  let (carried, _) := discoverCarried sy m0 300 150 openLo openHi
  let md : Model := { sy, ctx := m0, vars := movementVars sy carried }
  let mut layer : Array (GState × List UInt8) := #[(md.read m0, [])]
  for k in [0:depth] do
    let mut seen : Std.HashSet GState := {}
    let mut next : Array (GState × List UInt8) := #[]
    for (s, path) in layer do
      for i in eins do
        let t := md.step s i
        if !seen.contains t && good[k + 1]!.contains (md.toRelax t) then
          seen := seen.insert t
          next := next.push (t, i :: path)
    layer := next
    IO.println s!"exact depth {k + 1}: {layer.size} states"; flush
    if layer.isEmpty then IO.println s!"no real sequence of {depth} frames"; return 1
  match layer.find? (fun (s, _) => (md.toRelax s).h.speedInt ≥ top) with
  | none => IO.println s!"no real sequence of {depth} frames"; return 1
  | some (_, path) =>
    let path := path.reverse
    IO.println s!"FOUND {depth} frames: {path.map hex2}"
    let m := playFull m0 path
    IO.println s!"full emulator after these inputs: at top speed = {decide ((PState.read sy m).speedInt ≥ top)}"
    return 0

/-- On every relaxed search step up to `depth`, change vertical bytes (or the position) in the
context and check that the relaxed result does not change. -/
def relaxIndep (sy : Syms) (romPath : String) (depth : Nat) (posMode : Bool)
    (rins : List (UInt8 × Bool)) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let vert : List (List (UInt16 × UInt8)) := [
    [(sy.Player_Y_Position, 0x70), (sy.Player_Y_HighPos, 1), (sy.Player_Y_Speed, 0xFC), (sy.Player_YMF_Dummy, 0x40),
     (sy.Player_Y_MoveForce, 0x80), (sy.JumpOrigin_Y_Position, 0xB0), (sy.DiffToHaltJump, 1),
     (sy.VerticalForce, 0x20), (sy.VerticalForceDown, 0x70)],
    [(sy.Player_Y_Position, 0x98), (sy.Player_Y_HighPos, 1), (sy.Player_Y_Speed, 0x04), (sy.Player_YMF_Dummy, 0xC0),
     (sy.Player_Y_MoveForce, 0x10), (sy.JumpOrigin_Y_Position, 0xB0), (sy.DiffToHaltJump, 1),
     (sy.VerticalForce, 0x28), (sy.VerticalForceDown, 0x90)],
    [(sy.Player_Y_Position, 0x40), (sy.Player_Y_HighPos, 1), (sy.Player_Y_Speed, 0x00), (sy.Player_YMF_Dummy, 0x00),
     (sy.Player_Y_MoveForce, 0x00), (sy.JumpOrigin_Y_Position, 0x90), (sy.DiffToHaltJump, 1),
     (sy.VerticalForce, 0x1E), (sy.VerticalForceDown, 0x60)]]
  let posv : List (List (UInt16 × UInt8)) := [
    [(sy.Player_X_Position, 0xFF), (sy.Player_PageLoc, 0)], [(sy.Player_X_Position, 0x7F), (sy.Player_PageLoc, 1)],
    [(sy.Player_X_Position, 0x00), (sy.Player_PageLoc, 2)]]
  let ctxs := (if posMode then posv else vert).map fun l => l.foldl (fun m (a, v) => poke m a v) m0
  let fracs : List UInt8 := if posMode then [0xF0, 0x80, 0x10] else [0, 0, 0]
  let mut layer : List RState := [{ h := dropPos (PState.read sy m0), air := false }]
  let mut steps := 0
  let mut bad := 0
  for _ in [0:depth] do
    for s in layer do
      for c in rins do
        let t := stepRelax sy m0 s c
        for (cx, p) in ctxs.zip fracs do
          steps := steps + 1
          if stepRelax sy cx { s with h := { s.h with posMF := p } } c != t then bad := bad + 1
    layer := Cert.next (stepRelax sy m0) rins layer
  IO.println s!"relax independence: {steps} varied steps, {bad} differences"
  return if bad == 0 then 0 else 1

/-- On every relaxed search step up to `depth`, record the RAM bytes the step reads before
writing them: the bytes the relaxed model depends on. -/
def relaxReads (sy : Syms) (romPath : String) (depth : Nat) (rins : List (UInt8 × Bool)) : IO UInt32 := do
  let m0 := (← startM sy romPath)
  let mut rd := ByteArray.mk (Array.replicate 2048 0)
  let mut io := false
  let mut layer : List RState := [{ h := dropPos (PState.read sy m0), air := false }]
  let z := ByteArray.mk (Array.replicate 2048 0)
  for _ in [0:depth] do
    for s in layer do
      for (inp, _) in rins do
        let m := poke m0 sy.Player_State (if s.air then 1 else 0)
        let m := poke m sy.PreviousA_B_Buttons 0
        let m := prepare sy m s.h inp
        let m := { m with trk := true, trkRead := z, trkWrite := z, trkIO := false }
        let m := callRange m sy.PlayerCtrlRoutine sy.PlayerSubs
        for k in [0:2048] do
          if m.trkRead.get! k != 0 then rd := rd.set! k 1
        io := io || m.trkIO
    layer := Cert.next (stepRelax sy m0) rins layer
  let name := fun (k : Nat) => match Syms.fields.find? (fun (_, f) => (f sy).toNat == k) with
    | some (n, _) => n
    | none => s!"(unnamed {k})"
  IO.println s!"I/O read: {io}"
  IO.println s!"bytes read by the relaxed step: {(flagged rd).map name}"
  return 0

/-! ## main -/

def usage : String := "usage: smbrta [--config FILE] [--poke NAME=VALUE]... COMMAND
  (--poke changes a RAM byte, named as in tools/smb-symbols.txt, in the 1-1 start)
  nestest                            the CPU against the nestest log
  run FM2 [skip]                     play a movie, report level changes and the clear
  gen-rom                            private: Rom.lean (ROM, symbols, 1-1 start)
  gen-proofs                         private: the theorem files
  phys-validate RUNS LEN [BIAS PCT]  ground model vs emulator
  phys-live DEPTH                    RAM bytes the ground step uses
  phys-indep DEPTH                   position does not affect the ground step
  jump-discover WALKS LEN            carried bytes with jumping; model vs emulator
  relax-layers DEPTH [pad|lr]
  realize DEPTH [pad|lr]             exact search for a DEPTH-frame sequence
  relax-reads DEPTH [pad|lr]         RAM bytes the relaxed step reads
  check-witness [pad|lr]             play a theorem's witness on the full emulator
  relax-indep DEPTH [vert|pos] [pad|lr]"

/-- play a theorem's witness on the full emulator; print the speed per frame -/
def checkWitness (sy : Syms) (romPath : String) (w : List UInt8) : IO UInt32 := do
  let m0 ← startM sy romPath
  let top := (sy.RunTopSpeed.toNat : Int)
  let mut m := m0
  let mut out := ""
  let mut first : Option Nat := none
  for h : k in [0:w.length] do
    m := runFrame m (smbToPad w[k])
    let v := (PState.read sy m).speedInt
    out := out ++ s!"{v} "
    if first.isNone && v ≥ top then first := some (k + 1)
  IO.println s!"speeds: {out}"
  IO.println s!"top speed first reached after frame {first} of {w.length}"
  return if first == some w.length then 0 else 1

def main (args : List String) : IO UInt32 := do
  let rec opts (cfg : Option String) : List String → IO (Option String × List String)
    | "--config" :: p :: rest => opts (some p) rest
    | "--poke" :: kv :: rest => do
      match kv.splitOn "=" with
      | [k, v] => pokes.modify (· ++ [(k, v.toNat!)]); opts cfg rest
      | _ => throw (IO.userError s!"--poke NAME=VALUE, got {kv}")
    | rest => pure (cfg, rest)
  let (cfgPath, args) ← opts none args
  let cfg ← Config.load cfgPath
  let lr := fun (s : String) => s == "lr"
  match args with
  | ["nestest"] => runNestest (← cfg.path "nestestRom") (← cfg.path "nestestLog")
  | _ =>
  let sy ← Syms.load (← cfg.path "syms")
  let rom ← cfg.path "rom"
  let dir := (System.FilePath.mk (← cfg.path "proofProject") / "Proof").toString
  match args with
  | ["run", fm2] => runMovie sy rom fm2 fceuxSkip
  | ["run", fm2, k] => runMovie sy rom fm2 k.toNat!
  | ["gen-rom"] => genRom sy rom dir
  | ["gen-proofs"] => genProofs dir
  | ["phys-validate", r, l] => physValidate sy rom r.toNat! l.toNat! 0 0
  | ["phys-validate", r, l, b, p] =>
    physValidate sy rom r.toNat! l.toNat! ((hexDecode b).toList.headD 0) p.toNat!
  | ["phys-live", d] => physLive sy rom d.toNat!
  | ["phys-indep", d] => physIndep sy rom d.toNat!
  | ["jump-discover", w, l] => jumpDiscover sy rom w.toNat! l.toNat!
  | ["relax-layers", d] => relaxLayers sy rom d.toNat! relaxInputs
  | ["relax-layers", d, m] => relaxLayers sy rom d.toNat! (if lr m then relaxInputsLR else relaxInputs)
  | ["realize", d] => realize sy rom d.toNat! relaxInputs padInputsA
  | ["realize", d, m] =>
    if lr m then realize sy rom d.toNat! relaxInputsLR lrInputsA else realize sy rom d.toNat! relaxInputs padInputsA
  | ["check-witness"] => checkWitness sy rom FastAccel.witness
  | ["check-witness", m] => checkWitness sy rom (if lr m then TasFastAccel.witness else FastAccel.witness)
  | ["relax-reads", d] => relaxReads sy rom d.toNat! relaxInputs
  | ["relax-reads", d, m] => relaxReads sy rom d.toNat! (if lr m then relaxInputsLR else relaxInputs)
  | ["relax-indep", d] => relaxIndep sy rom d.toNat! false relaxInputs
  | ["relax-indep", d, v] => relaxIndep sy rom d.toNat! (v == "pos") relaxInputs
  | ["relax-indep", d, v, m] =>
    relaxIndep sy rom d.toNat! (v == "pos") (if lr m then relaxInputsLR else relaxInputs)
  | _ => IO.println usage; return 2
