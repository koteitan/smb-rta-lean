  IO.FS.writeFile s!"{dir}/EntryHeadHeight.lean" ("import Proof.ScreenPage\nimport Theorems.EntryHeadHeight\n" ++ s!"/-! {privateNote} -/\n" ++ "
open Smbrta Smbrta.Rom
