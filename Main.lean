  IO.FS.writeFile s!"{dir}/SizeKeep.lean" ("import Proof.ScreenPage\nimport Proof.PipeChangeEnd\nimport Theorems.SizeKeep\n" ++ s!"/-! {privateNote} -/\n" ++ "
open Smbrta Smbrta.Rom
