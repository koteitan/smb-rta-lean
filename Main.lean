theorem room_blocks_run (R : runOfRoute%) :
    ∀ n, R.base.b₁ sy ≤ n → n ≤ R.base.a₂ sy screenNames ctx → RoomBlocks.SolidR sy screenNames ctx (R.base.seq n) :=
