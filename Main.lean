    m := runFrame m inputs[k]
    if first.isNone && controllable sy m then first := some k
    if first.isSome && k ≥ (first.getD 0) + 852 then
      k0 := k
      break
  let ctlM := m
  let t := collRun sy ctlM ((List.range 300).toArray.map fun j => inputs[k0 + 1 + j]!) {} true
  IO.println s!"the movie from 852: {t.str}"
  (← IO.getStdout).flush
  let mut r : CollCount := {}
  for sd in [1:n + 1] do
    r := collRun sy (if sd % 2 == 0 then ctlM else ctlOwn) (framesInputs sd.toUInt64 240 0 0) r
  IO.println s!"random, from control: {r.str}"
  (← IO.getStdout).flush
  let mut s : CollCount := {}
  for sd in [1:n / 2 + 1] do
    s := collRun sy ctlOwn (framesInputs (sd.toUInt64 + 99) 120 10 0) s
  IO.println s!"with Select: {s.str}"
  let mut p : CollCount := {}
  for sd in [1:n / 2 + 1] do
    p := collRun sy ctlOwn (framesInputs (sd.toUInt64 + 555) 240 0 5) p
  IO.println s!"with Start: {p.str}"
  let bad := [t, r, s, p].foldl (fun n c => n + c.spareC + c.kept + c.endBad) 0
  return if bad == 0 then 0 else 1

/-- **`CollideKeep`, as a program**: the first walk's search of `AfterKeep`, the searches of the walks of the speed and the subspeed from the scroll handler, then
`vCheck` -/
def collideKeepProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let v : UInt8 := peek (SurfaceRun.above m0 982) sy.AreaType
  let q := CtrlKeep.cutTable sy m0 true
  let cuts := CtrlKeep.cutsOf (CtrlKeep.cfgPz sy m0 q)
  let t0 ← IO.monoMsNow
  let P ← IO.lazyPure fun _ => AfterKeep.q1Search sy m0 v cuts
  IO.println s!"from the cut to the scroll handler: {P.X.steps} steps, {P.X.fails} failures, table {P.X.multi.size}, states at the scroll handler {P.stops.size}; {(← IO.monoMsNow) - t0} ms"
  let rkF := fun (B : TaintRun.AS) => B.rk && !B.spent
  let sp := CollideKeep.spI sy
  let sf := CollideKeep.sfI sy
  let st := CollideKeep.stI sy
  let three := [sp, sf, st]
  for (b, name, prot, fin) in [(sp, "the speed (the walk of vCheck)", [sp], CollideKeep.finV sp),
      (sf, "the subspeed, the speed, the subspeed and the state protected, followed or the state not 0, 1, 2", three, fun B => rkF B || CollideKeep.stateBad sy B)] do
    let t1 ← IO.monoMsNow
    let P2 ← IO.lazyPure fun _ => CollideKeep.searchWith sy m0 prot fin b P.stops.toList
    IO.println s!"{name}: {P2.X.steps} steps, {P2.X.fails} failures at {P2.X.failPcs.toList}, table {P2.X.multi.size}, no longer followed at {(P2.stops.toList.map (·.pc.toNat)).eraseDups}, dropped by a store with a target not known at {P2.drops.toList}, cut at {P2.cutHits.toList}; {(← IO.monoMsNow) - t1} ms"
    for (k, A) in P2.failAt.toList.take 4 do
      IO.println s!"  failure at {A.pc}: followed {A.rk}, the state {(A.getK (CollideKeep.stI sy)).v} known {(A.getK (CollideKeep.stI sy)).k}; the path {PrevKeep.pathOf P2 k [] 400}"
    (← IO.getStdout).flush
  -- variants of the protected bytes and of the end (an experiment)
  let vars : List (String × List Nat × (TaintRun.AS → Bool) × Nat) :=
    [("the speed, the speed and the state protected, followed or 0 or the state not 0, 1, 2", [sp, st], fun B => rkF B || CollideKeep.zeroAt sp B || CollideKeep.stateBad sy B, sp),
     ("the subspeed, only the subspeed protected, followed", [sf], rkF, sf),
     ("the subspeed, the three protected, followed or the state not 0, 1, 2 or the speed and the subspeed 0", three,
       fun B => rkF B || CollideKeep.stateBad sy B || (CollideKeep.zeroAt sp B && CollideKeep.zeroAt sf B), sf)]
  for (name, prot, fin, b) in vars do
    let t1 ← IO.monoMsNow
    let P2 ← IO.lazyPure fun _ => CollideKeep.searchWith sy m0 prot fin b P.stops.toList
    IO.println s!"{name}: {P2.X.steps} steps, {P2.X.fails} failures at {P2.X.failPcs.toList}, table {P2.X.multi.size}, no longer followed at {(P2.stops.toList.map (·.pc.toNat)).eraseDups}, dropped at {P2.drops.toList}; {(← IO.monoMsNow) - t1} ms"
    (← IO.getStdout).flush
  let t2 ← IO.monoMsNow
  let c ← IO.lazyPure fun _ => CollideKeep.vCheck sy m0 v
  IO.println s!"vCheck: {c}, {(← IO.monoMsNow) - t2} ms"
  return if c then 0 else 1

/-- what `collide-real` counts on real frames above ground before the touch -/
structure CollideCount where
  frames : Nat := 0
  arrivals : Nat := 0
  /-- frames with an instruction that fails `CollideKeep.SpareV` -/
  spareV : Nat := 0
  /-- arrivals at the scroll handler where the speed at the end is neither that there nor 0, or the subspeed not that there -/
  speed : Nat := 0
  sub : Nat := 0
  /-- frames that end with the player's state not 0, 1 or 2 -/
  state : Nat := 0
  /-- arrivals where the speed at the end is 0 and not that there -/
  zeroed : Nat := 0
  /-- arrivals of a frame that ends with the speed 0 and the subspeed 0 (where `CollideS.f` asks the subspeed at the scroll handler), and of them those with a
  subspeed not 0 at the scroll handler (`CollideS.f` false) -/
  zero2 : Nat := 0
  subRes : Nat := 0
  /-- arrivals where `SurfaceFrames.collideSB` is false -/
  collS : Nat := 0
  /-- frames where the field `edge` of `OnFrames` (`SurfaceFrames.edgeB`) is false (round 24) -/
  edgeF : Nat := 0
  /-- arrivals where the facing at the end is not that at the scroll handler; where `SurfaceFrames.keepZB` is false (what `FaceKeep.keepZ_end` proves) -/
  faceCh : Nat := 0
  keepZ : Nat := 0
  /-- arrivals of a frame that starts with the collision bits `FF` or those of a block of Left and has the speed's sign bit 0 at the scroll handler; of them those
  where `SurfaceFrames.bitsEndB` is false (what `FaceKeep.bits_end` proves) -/
  right : Nat := 0
  bitsE : Nat := 0
  /-- arrivals of a frame from a clean state; of them those where `SurfaceFrames.afterPB` is false (the field `after` of `Moves`) -/
  clean : Nat := 0
  afterP : Nat := 0

def CollideCount.str (c : CollideCount) : String :=
  s!"frames in control {c.frames}, arrivals at the scroll handler {c.arrivals} (the speed set to 0 after it {c.zeroed}; ending with the speed 0 and the subspeed 0 {c.zero2}; the facing changed after it {c.faceCh}; starting with the bits of nothing or a block of Left and moving right or not at all there {c.right}; from a clean state {c.clean}); FAILS: an instruction not SpareV {c.spareV}, the speed {c.speed}, the subspeed {c.sub}, the state at the end {c.state}, CollideS.f {c.subRes}, CollideS {c.collS}, edge {c.edgeF}, keepZ_end {c.keepZ}, bits_end {c.bitsE}, AfterP from a clean state {c.afterP}"

/-- a run of frames from `start`, up to a frame that does not start in control or that stores to the routine, the mode or the task -/
def collideRun (sy : Syms) (start : Machine) (w : Array UInt8) (c0 : CollideCount) (raw : Bool := false) : CollideCount := Id.run do
  let mut c := c0
  let mut cur := start
  for i in w do
    let pad := if raw then i else smbToPad i
    if !controllable sy cur then break
    if stepFails cur pad (fun x => !FrameKeep.CtlStore sy x) != 0 then break
    let b := runFrame cur pad
    c := { c with frames := c.frames + 1 }
    if stepFails cur pad (CollideKeep.spareVB sy) != 0 then c := { c with spareV := c.spareV + 1 }
    for Q in subsAfter sy cur pad do
      c := { c with arrivals := c.arrivals + 1 }
      let vb := peek b sy.Player_X_Speed
      let vq := peek Q sy.Player_X_Speed
      if !(vb == vq || vb == 0) then c := { c with speed := c.speed + 1 }
      if vb == 0 && vq != 0 then c := { c with zeroed := c.zeroed + 1 }
      if peek b sy.Player_X_MoveForce != peek Q sy.Player_X_MoveForce then c := { c with sub := c.sub + 1 }
      if vb == 0 && peek b sy.Player_X_MoveForce == 0 then
        c := { c with zero2 := c.zero2 + 1 }
        if peek Q sy.Player_X_MoveForce != 0 then c := { c with subRes := c.subRes + 1 }
      if !SurfaceFrames.collideSB sy cur Q b true then c := { c with collS := c.collS + 1 }
      if peek b sy.PlayerFacingDir != peek Q sy.PlayerFacingDir then c := { c with faceCh := c.faceCh + 1 }
      if !SurfaceFrames.keepZB sy Q b then c := { c with keepZ := c.keepZ + 1 }
      if peek cur sy.Player_CollisionBits &&& sy.noLeft == sy.noLeft && vq &&& 0x80 == 0 then
        c := { c with right := c.right + 1 }
        if !SurfaceFrames.bitsEndB sy Q b then c := { c with bitsE := c.bitsE + 1 }
      if decide (SurfaceFrames.Clean sy cur) then
        c := { c with clean := c.clean + 1 }
        if !SurfaceFrames.afterPB sy cur Q b then c := { c with afterP := c.afterP + 1 }
    if peek b sy.Player_State > 2 then c := { c with state := c.state + 1 }
    if !SurfaceFrames.edgeB sy cur b then c := { c with edgeF := c.edgeF + 1 }
    cur := b
  return c

/-- **`CollideKeep.SpareV` and the speed and subspeed after the scroll handler on real frames above ground**: the movie from 852 for 300 frames, `n` random runs from
control (from the movie's machine and from the machine of the private proof), runs into the screen's left edge, with Select, with Start -/
def collideRealProg (sy : Syms) (romPath fm2 : String) (n : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2)) fceuxSkip
  let ctlOwn := SurfaceRun.above m0 982
  let mut m := powerOn cart 0
  let mut first : Option Nat := none
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if first.isNone && controllable sy m then first := some k
    if first.isSome && k ≥ (first.getD 0) + 852 then
      k0 := k
      break
  let ctlM := m
  let t := collideRun sy ctlM ((List.range 300).toArray.map fun j => inputs[k0 + 1 + j]!) {} true
  IO.println s!"the movie from 852: {t.str}"
  (← IO.getStdout).flush
  let mut r : CollideCount := {}
  for sd in [1:n + 1] do
    r := collideRun sy (if sd % 2 == 0 then ctlM else ctlOwn) (framesInputs sd.toUInt64 240 0 0) r
  IO.println s!"random, from control: {r.str}"
  (← IO.getStdout).flush
  let mut e : CollideCount := {}
  for k in [0:20] do
    for b0 in [(0x00 : UInt8), 0x41] do
      for b1 in [(0x02 : UInt8), 0x42, 0x82] do
        e := collideRun sy ctlOwn (Array.replicate k b0 ++ Array.replicate 90 b1 ++ #[0x01, 0x01, 0x00, 0x00, 0x41, 0x41] ++ fracInputs k.toUInt64 200) e
  IO.println s!"into the screen's left edge: {e.str}"
  (← IO.getStdout).flush
  -- the frames before a touch: from the movie's frames 1002 to 1091, random inputs
  let mut tas : Array Machine := #[ctlM]
  let mut a := ctlM
  for j in [1:400] do
    a := runFrame a inputs[k0 + j]!
    tas := tas.push a
  let mut l : CollideCount := {}
  for sd in [1:2 * n + 1] do
    l := collideRun sy tas[150 + (sd * 7919) % 90]! (fracInputs (sd.toUInt64 + 7777) 160) l
  IO.println s!"random, from the movie's frames 1002 to 1091: {l.str}"
  (← IO.getStdout).flush
  let mut s : CollideCount := {}
  for sd in [1:n / 2 + 1] do
    s := collideRun sy ctlOwn (framesInputs (sd.toUInt64 + 99) 120 10 0) s
  IO.println s!"with Select: {s.str}"
  let mut p : CollideCount := {}
  for sd in [1:n / 2 + 1] do
    p := collideRun sy ctlOwn (framesInputs (sd.toUInt64 + 555) 240 0 5) p
  IO.println s!"with Start: {p.str}"
  let bad := [t, r, e, l, s, p].foldl (fun n c => n + c.spareV + c.speed + c.sub + c.state + c.subRes + c.collS + c.edgeF + c.keepZ + c.bitsE + c.afterP) 0
  return if bad == 0 then 0 else 1

/-! ## Above ground: the vertical bytes after the scroll handler on frames 1 to 8 (`OnFrames.vAfter`; measurements, no part of the proof) -/

/-- the bytes of `SurfaceFrames.vKeep` and A and B, with their names -/
def vertAfterBytes (sy : Syms) : List (String × UInt16) :=
  [("Player_Y_Position", sy.Player_Y_Position), ("Player_Y_MoveForce", sy.Player_Y_MoveForce), ("Player_Y_Speed", sy.Player_Y_Speed),
   ("Player_YMF_Dummy", sy.Player_YMF_Dummy), ("VerticalForce", sy.VerticalForce), ("VerticalForceDown", sy.VerticalForceDown),
   ("JumpOrigin_Y_Position", sy.JumpOrigin_Y_Position), ("Player_State", sy.Player_State), ("DiffToHaltJump", sy.DiffToHaltJump), ("A_B_Buttons", sy.A_B_Buttons)]

/-- `vert-after-bytes`: from the scroll handler to the frame's end above ground, one search for each vertical byte, followed as the counter of `TaintRun` and protected
besides the bytes of `keep.cleanE`, with the stores to the routine, the mode and the task by address cut: where a step fails (a store to the byte by its address, or a
step the walk cannot take) and where a store through an index or a pointer drops it -/
def vertAfterBytesProg (sy : Syms) (romPath : String) (which : String := "prot") : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let q := CtrlKeep.cutTable sy m0 true
  let v : UInt8 := peek (SurfaceRun.above m0 982) sy.AreaType
  let cuts := CtrlKeep.cutsOf (CtrlKeep.cfgPz sy m0 q)
  let W := CtrlKeep.watchA sy m0 v
  let V := CtrlKeep.valA sy v
  let l := FrameKeep.ctlI sy
  let E0 := PipeEntryRule.envOf m0
  let base := FrameKeep.spareE sy ++ FrameKeep.collE sy ++ FrameKeep.speedE sy ++ CtrlKeep.spareI sy m0
  let t0 ← IO.monoMsNow
  let P1 ← IO.lazyPure fun _ => PrevKeep.searchFrom sy m0 E0 (CtrlKeep.spareI sy m0) [] W l (fun A => A.pc == sy.PlayerSubs) (cuts.map (CtrlKeep.toA W V))
  IO.println s!"from the cut to the scroll handler: {P1.X.steps} steps, {P1.X.fails} failures, states at the scroll handler {P1.stops.size}; {(← IO.monoMsNow) - t0} ms"
  (← IO.getStdout).flush
  let starts := P1.stops.toList.map fun A => ({ A with rk := true, spent := false } : TaintRun.AS)
  let mut ok := true
  for (name, x) in vertAfterBytes sy do
    let b := (x &&& 0x7FF).toNat
    let E := { E0 with rkI := b }
    let t2 ← IO.monoMsNow
    let P ← IO.lazyPure fun _ => PrevKeep.searchFrom sy m0 E (if which == "prot" then base ++ [b] else base) [] W l (fun _ => false) starts
    IO.println s!"{name}: {P.X.steps} steps, table {P.X.multi.size}, {P.X.fails} failures at {P.X.failPcs.toList}; dropped at {P.drops.toList}; cut at {P.cutHits.toList}; {(← IO.monoMsNow) - t2} ms"
    (← IO.getStdout).flush
    ok := ok && P.X.fails == 0 && P.drops.isEmpty
  -- the vertical force: followed, no longer followed before a store by its address (`CollideKeep.rkOff`); at the end still followed, or the jumpspring's animation
  -- byte known not 0 (the field `state` excludes it at the frame's end)
  let vf := (sy.VerticalForce &&& 0x7FF).toNat
  let js := (sy.JumpspringAnimCtrl &&& 0x7FF).toNat
  let finJ : TaintRun.AS → Bool := fun B => (B.rk && !B.spent) || ((B.getK js).isK && (B.getK js).v != 0)
  for (name, prot) in [("VerticalForce, the jumpspring's byte protected", [vf, js]), ("VerticalForce, the jumpspring's byte not protected", [vf])] do
    let t3 ← IO.monoMsNow
    let P2 ← IO.lazyPure fun _ => CollideKeep.searchWith sy m0 (FrameKeep.spareE sy ++ FrameKeep.collE sy ++ FrameKeep.speedE sy ++ prot) finJ vf P1.stops.toList
    IO.println s!"{name}: {P2.X.steps} steps, {P2.X.fails} failures at {P2.X.failPcs.toList}, table {P2.X.multi.size}, no longer followed at {(P2.stops.toList.map (·.pc.toNat)).eraseDups}, dropped at {P2.drops.toList}; {(← IO.monoMsNow) - t3} ms"
    (← IO.getStdout).flush
  -- the check of `VertKeep.keep_end` (a part of `numbersCheck`)
  let t4 ← IO.monoMsNow
  let kc ← IO.lazyPure fun _ => VertKeep.kCheck sy m0 v
  IO.println s!"VertKeep.kCheck: {kc}, {(← IO.monoMsNow) - t4} ms"
  return if ok then 0 else 1

/-- what `vert-after-real` counts on the frames 1 to 8 from control -/
structure VertAfterCount where
  frames : Nat := 0
  /-- frames whose end has a byte of `vKeep`, or bit 7 of A and B, other than at the scroll handler (`vAfter` false) -/
  bad : Nat := 0
  /-- frames where one of the ten bytes changes between the scroll handler and the end -/
  moved : Nat := 0
  /-- (pc, byte) → the steps after the scroll handler that change the byte -/
  writes : Std.HashMap (Nat × Nat) Nat := {}
  /-- the states at the scroll handler: (the state, bit 7 of the vertical speed, the height's low 4 bits 0, the vertical fraction 0, the vertical speed 0) -/
  classes : Std.HashMap (Nat × Bool × Bool × Bool × Bool) Nat := {}
  /-- the order of the changes of a frame, as lists of (pc, byte) -/
  paths : Std.HashMap (List (Nat × Nat)) Nat := {}

/-- one frame of `m` with the pad `pad`, from the scroll handler to its end -/
def vertAfterFrame (sy : Syms) (m : Machine) (pad : UInt8) (c0 : VertAfterCount) : VertAfterCount := Id.run do
  let idx := (vertAfterBytes sy).map fun (_, a) => (a &&& 0x7FF).toNat
  let get := fun (x : Machine) => idx.map fun i => x.ram.get! i
  let mut c := { c0 with frames := c0.frames + 1 }
  let mut x := { m with pad := pad }
  let t := m.frame + 1
  let mut arr := false
  let mut q : Option (List UInt8) := none
  let mut path : List (Nat × Nat) := []
  for _ in [0:40000] do
    if x.frame ≥ t || x.halted then break
    if x.pc == sy.PlayerCtrlRoutine then arr := true
    if arr && q.isNone && x.pc == sy.PlayerSubs then
      q := some (get x)
      let key := ((peek x sy.Player_State).toNat, peek x sy.Player_Y_Speed &&& 0x80 != 0, peek x sy.Player_Y_Position &&& 0x0F == 0,
        peek x sy.Player_Y_MoveForce == 0, peek x sy.Player_Y_Speed == 0)
      c := { c with classes := c.classes.insert key (c.classes.getD key 0 + 1) }
    let before := get x
    let pc := x.pc.toNat
    x := (step.run x).2
    if q.isSome then
      let after := get x
      for k in [0:idx.length] do
        if before[k]! != after[k]! then
          path := path ++ [(pc, k)]
          c := { c with writes := c.writes.insert (pc, k) (c.writes.getD (pc, k) 0 + 1) }
  match q with
  | some vq =>
    let ve := get x
    let ok := (List.range 9).all (fun k => ve[k]! == vq[k]!) && (ve[9]! &&& (0x80 : UInt8)) == (vq[9]! &&& (0x80 : UInt8))
    if !ok then c := { c with bad := c.bad + 1 }
    if !path.isEmpty then c := { c with moved := c.moved + 1, paths := c.paths.insert path (c.paths.getD path 0 + 1) }
  | none => pure ()
  return c

/-- the first `k` frames of a run from control, up to a frame that does not start in control or that stores to the routine, the mode or the task -/
def vertAfterRun (sy : Syms) (start : Machine) (w : Array UInt8) (c0 : VertAfterCount) (raw : Bool := false) (k : Nat := 8) : VertAfterCount := Id.run do
  let mut c := c0
  let mut cur := start
  let mut j := 0
  for i in w do
    if j ≥ k then break
    let pad := if raw then i else smbToPad i
    if !controllable sy cur then break
    if stepFails cur pad (fun x => !FrameKeep.CtlStore sy x) != 0 then break
    c := vertAfterFrame sy cur pad c
    cur := runFrame cur pad
    j := j + 1
  return c

def VertAfterCount.str (sy : Syms) (c : VertAfterCount) : String :=
  let names := (vertAfterBytes sy).map (·.1)
  let ws := (c.writes.toList.mergeSort (fun a b => a.1.1 ≤ b.1.1)).map fun ((pc, k), n) => s!"{pc}:{names.getD k "?"}×{n}"
  let cs := c.classes.toList.map fun ((st, up, al, mf, z), n) => s!"(st {st}, up {up}, aligned {al}, fraction 0 {mf}, speed 0 {z})×{n}"
  let ps := ((c.paths.toList.mergeSort (fun a b => a.2 ≥ b.2)).take 12).map fun ((p : List (Nat × Nat)), n) =>
    s!"{p.map fun ((pc, k) : Nat × Nat) => s!"{pc}:{names.getD k "?"}"}×{n}"
  s!"frames {c.frames}; FAILS (vAfter false) {c.bad}; frames with a change after the scroll handler {c.moved}\n  at the scroll handler: {cs}\n  changes: {ws}\n  orders: {ps}"

/-- **`OnFrames.vAfter` on real frames 1 to 8**: the movie from 852, `n` random runs from control (from the movie's machine and from the machine of the private proof),
with Select; the bytes that change after the scroll handler, where, and in which order -/
def vertAfterRealProg (sy : Syms) (romPath fm2 : String) (n : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2)) fceuxSkip
  let ctlOwn := SurfaceRun.above m0 982
  let mut m := powerOn cart 0
  let mut first : Option Nat := none
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if first.isNone && controllable sy m then first := some k
    if first.isSome && k ≥ (first.getD 0) + 852 then
      k0 := k
      break
  let ctlM := m
  let t := vertAfterRun sy ctlM ((List.range 30).toArray.map fun j => inputs[k0 + 1 + j]!) {} true
  IO.println s!"the movie from 852: {t.str sy}"
  (← IO.getStdout).flush
  let mut r : VertAfterCount := {}
  for sd in [1:n + 1] do
    r := vertAfterRun sy (if sd % 2 == 0 then ctlM else ctlOwn) (framesInputs sd.toUInt64 240 0 0) r
  IO.println s!"random, from control: {r.str sy}"
  (← IO.getStdout).flush
  let mut f : VertAfterCount := {}
  for sd in [1:n + 1] do
    f := vertAfterRun sy (if sd % 2 == 0 then ctlM else ctlOwn) (fracInputs (sd.toUInt64 + 31) 40) f
  IO.println s!"random taps, from control: {f.str sy}"
  (← IO.getStdout).flush
  let mut s : VertAfterCount := {}
  for sd in [1:n / 2 + 1] do
    s := vertAfterRun sy ctlOwn (framesInputs (sd.toUInt64 + 99) 120 10 0) s
  IO.println s!"with Select: {s.str sy}"
  let bad := [t, r, f, s].foldl (fun n c => n + c.bad) 0
  return if bad == 0 then 0 else 1

/-- `AfterKeep`: the searches of the two walks after the cut, then the check `hCheck` -/
def afterKeepProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let v : UInt8 := peek (SurfaceRun.above m0 982) sy.AreaType
  let q := CtrlKeep.cutTable sy m0 true
  let cuts := CtrlKeep.cutsOf (CtrlKeep.cfgPz sy m0 q)
  let t0 ← IO.monoMsNow
  let P ← IO.lazyPure fun _ => AfterKeep.q1Search sy m0 v cuts
  let t1 ← IO.monoMsNow
  IO.println s!"from the cut to the scroll handler: {P.X.steps} steps, {P.X.fails} failures at {P.X.failPcs.toList}, table {P.X.multi.size}, states at the scroll handler {P.stops.size}, cut at {P.cutHits.toList}; {t1 - t0} ms"
  for b in AfterKeep.hI sy do
    let E := { PipeEntryRule.envOf m0 with rkI := b }
    let P2 ← IO.lazyPure fun _ => PrevKeep.searchFrom sy m0 E (b :: CtrlKeep.spareI sy m0) [] [] (FrameKeep.ctlI sy) (fun A => A.pc == sy.PlayerSubs) (P.stops.toList.map AfterKeep.rkOn)
    IO.println s!"byte {b}: {P2.X.steps} steps, {P2.X.fails} failures at {P2.X.failPcs.toList}, table {P2.X.multi.size}, dropped at {P2.drops.toList}, at the scroll handler again {P2.stops.size}"
  (← IO.getStdout).flush
  let t2 ← IO.monoMsNow
  let c ← IO.lazyPure fun _ => AfterKeep.hCheck sy m0 v
  IO.println s!"hCheck: {c}, {(← IO.monoMsNow) - t2} ms"
  return if c then 0 else 1

/-- the two walks of `SubsOnce` on the ROM: the searches and the check, with their times -/
def subsOnceProg (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let t0 ← IO.monoMsNow
  let P ← IO.lazyPure fun _ => SubsOnce.s1Search sy m0
  let t1 ← IO.monoMsNow
  IO.println s!"from the frame's start to the scroll handler: {P.X.steps} steps, {P.X.fails} failures at {P.X.failPcs.toList.take 12}, table {P.X.multi.size}, states at the scroll handler {P.stops.size}; {t1 - t0} ms"
  (← IO.getStdout).flush
  let P2 ← IO.lazyPure fun _ => PrevKeep.searchFrom sy m0 (PipeEntryRule.envOf m0) [] [] [] [] (fun A => A.pc == sy.PlayerSubs) P.stops.toList
  let t2 ← IO.monoMsNow
  IO.println s!"from there to the frame's end: {P2.X.steps} steps, {P2.X.fails} failures at {P2.X.failPcs.toList.take 12}, table {P2.X.multi.size}, at the scroll handler again {P2.stops.size}; {t2 - t1} ms"
  (← IO.getStdout).flush
  let c ← IO.lazyPure fun _ => SubsOnce.subsCheck sy m0
  IO.println s!"subsCheck: {c}, {(← IO.monoMsNow) - t2} ms"
  return if c then 0 else 1

/-! ## Above ground: the facing, the subspeed and the collision bits after the scroll handler (`FaceKeep`), and the vertical force (a measurement) -/

/-- `face-keep-check [ADDR...]`: the searches of the walks of `FaceKeep` and its checks `zCheck`, `bCheck` and `vfCheck`, with their times; and searches that are
no part of the proof: the facing with the end "still followed" only, and the vertical force with the end "still followed, or the jumpspring's byte known not 0", with
the RAM bytes `ADDR...` protected too. It prints each failing state and a path to it. The exit code is that of the three checks. -/
def faceKeepProg (sy : Syms) (romPath : String) (extra : List String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let v : UInt8 := peek (SurfaceRun.above m0 982) sy.AreaType
  let q := CtrlKeep.cutTable sy m0 true
  let cuts := CtrlKeep.cutsOf (CtrlKeep.cfgPz sy m0 q)
  let sp := CollideKeep.spI sy
  let sf := CollideKeep.sfI sy
  let st := CollideKeep.stI sy
  let fd := FaceKeep.fdI sy
  let bi := CollKeep.bitsI sy
  let vf := (sy.VerticalForce &&& 0x7FF).toNat
  let js := (sy.JumpspringAnimCtrl &&& 0x7FF).toNat
  let show1 := fun (B : TaintRun.AS) (i : Nat) => s!"{(B.getK i).v}/{(B.getK i).k}"
  let dump := fun (A : TaintRun.AS) => s!"pc {A.pc} followed {A.rk}, value/known bits: speed {show1 A sp} subspeed {show1 A sf} state {show1 A st} facing {show1 A fd} bits {show1 A bi} vertical force {show1 A vf} jumpspring {show1 A js}"
  let P ← IO.lazyPure fun _ => AfterKeep.q1Search sy m0 v cuts
  IO.println s!"from the cut to the scroll handler: {P.X.steps} steps, {P.X.fails} failures, states at the scroll handler {P.stops.size}"
  for (name, b) in [("the facing", fd), ("the subspeed", sf)] do
    let t1 ← IO.monoMsNow
    let P2 ← IO.lazyPure fun _ => FaceKeep.zSearch sy m0 b P.stops.toList
    IO.println s!"{name}, followed or the speed and the subspeed 0: {P2.X.steps} steps, {P2.X.fails} failures at {P2.X.failPcs.toList}, table {P2.X.multi.size}, no longer followed at {(P2.stops.toList.map (·.pc.toNat)).eraseDups}, dropped at {P2.drops.toList}, cut at {P2.cutHits.toList}; {(← IO.monoMsNow) - t1} ms"
    for (k, A) in P2.failAt.toList.take 4 do
      IO.println s!"  failure: {dump A}; the path {PrevKeep.pathOf P2 k [] 600}"
  (← IO.getStdout).flush
  let t2 ← IO.monoMsNow
  let zc ← IO.lazyPure fun _ => FaceKeep.zCheck sy m0 v
  IO.println s!"zCheck: {zc}, {(← IO.monoMsNow) - t2} ms"
  (← IO.getStdout).flush
  let t3 ← IO.monoMsNow
  let Pb ← IO.lazyPure fun _ => FaceKeep.b1Search sy m0 v cuts
  IO.println s!"the collision bits, from the cut to the scroll handler: {Pb.X.steps} steps, {Pb.X.fails} failures, table {Pb.X.multi.size}, states at the scroll handler {Pb.stops.size}, the bits there {(Pb.stops.toList.map fun A => show1 A bi).eraseDups}; {(← IO.monoMsNow) - t3} ms"
  IO.println s!"  the splits: X at {CollKeep.splitPc sy m0}, Y at {FaceKeep.cpy1 sy m0} and {FaceKeep.cpy2 sy m0}; noLeftOK {FaceKeep.noLeftOK sy}"
  let t4 ← IO.monoMsNow
  let Pb2 ← IO.lazyPure fun _ => FaceKeep.b2Search sy m0 Pb.stops.toList
  IO.println s!"the collision bits, from the scroll handler with the speed's sign bit 0: {Pb2.X.steps} steps, {Pb2.X.fails} failures at {Pb2.X.failPcs.toList}, table {Pb2.X.multi.size}, dropped at {Pb2.drops.toList}, cut at {Pb2.cutHits.toList}; {(← IO.monoMsNow) - t4} ms"
  for (k, A) in Pb2.failAt.toList.take 4 do
    IO.println s!"  failure: {dump A}; the path {PrevKeep.pathOf Pb2 k [] 600}"
  (← IO.getStdout).flush
  let t5 ← IO.monoMsNow
  let bc ← IO.lazyPure fun _ => FaceKeep.bCheck sy m0 v
  IO.println s!"bCheck: {bc}, {(← IO.monoMsNow) - t5} ms"
  (← IO.getStdout).flush
  -- no part of the proof
  let rkF := fun (B : TaintRun.AS) => B.rk && !B.spent
  let base := FrameKeep.faceE sy ++ FrameKeep.spareE sy ++ FrameKeep.collE sy ++ FrameKeep.speedE sy ++ FrameKeep.vertE sy
  let ex := extra.map fun s => s.toNat! % 2048
  let finJ : TaintRun.AS → Bool := fun B => rkF B || ((B.getK js).isK && (B.getK js).v != 0)
  for (name, b, prot, fin) in [("the facing, followed", fd, [fd], rkF),
      ("the vertical force, the jumpspring's byte protected, followed or that byte known not 0", vf, [vf, js], finJ),
      (s!"the same, with {ex} protected too", vf, [vf, js] ++ ex, finJ)] do
    let t6 ← IO.monoMsNow
    let P2 ← IO.lazyPure fun _ => CollideKeep.searchWith sy m0 (base ++ prot) fin b P.stops.toList
    IO.println s!"(no part of the proof) {name}: {P2.X.steps} steps, {P2.X.fails} failures at {P2.X.failPcs.toList}, table {P2.X.multi.size}, no longer followed at {(P2.stops.toList.map (·.pc.toNat)).eraseDups}, dropped at {P2.drops.toList}; {(← IO.monoMsNow) - t6} ms"
    for (k, A) in P2.failAt.toList.take 4 do
      IO.println s!"  failure: {dump A}; the path {PrevKeep.pathOf P2 k [] 600}"
    (← IO.getStdout).flush
  -- the walk of the vertical force (`FaceKeep.vf_end`)
  let t7 ← IO.monoMsNow
  let cv := FaceKeep.vfC sy m0 v
  let P3 ← IO.lazyPure fun _ => FaceKeep.vfSearch sy m0 cv P.stops.toList
  IO.println s!"the vertical force, the state protected, followed or (the value of the store and the state known 0 or 3): {P3.X.steps} steps, {P3.X.fails} failures at {P3.X.failPcs.toList}, table {P3.X.multi.size}, no longer followed at {(P3.stops.toList.map (·.pc.toNat)).eraseDups}, dropped at {P3.drops.toList}; {(← IO.monoMsNow) - t7} ms"
  for (k, A) in P3.failAt.toList.take 4 do
    IO.println s!"  failure: {dump A}; the path {PrevKeep.pathOf P3 k [] 600}"
  let t8 ← IO.monoMsNow
  let vc ← IO.lazyPure fun _ => FaceKeep.vfCheck sy m0 v cv
  IO.println s!"vfCheck: {vc}, {(← IO.monoMsNow) - t8} ms"
  return if zc && bc && vc then 0 else 1

/-! ## Above ground: the position after the scroll handler on real frames (`OnFrames.collide`, `Moves.stop`; a measurement, no part of the proof) -/

/-- what `pos-after-real` counts on real frames above ground before the touch -/
structure PosAfterCount where
  frames : Nat := 0
  /-- (pc, byte) → the steps after the scroll handler that change the byte -/
  writes : Std.HashMap (Nat × Nat) Nat := {}
  /-- (the sign of the speed at the scroll handler, the position at the end less that there, the speed at the end is that there) → frames -/
  classes : Std.HashMap (Int × Int × Bool) Nat := {}
  /-- frames where the position's fraction at the end is not that at the scroll handler -/
  frac : Nat := 0
  calls : Nat := 0
  callBad : Nat := 0
  goodBad : Nat := 0
  callOpen : Nat := 0
  marginOff : Nat := 0
  clamps : Nat := 0
  clampBad : Nat := 0
  clampOpen : Nat := 0
  clampRangeOff : Nat := 0
  clampSelectors : Std.HashMap Nat Nat := {}
  outsideStores : Std.HashMap (Nat × Nat) Nat := {}
  deltas : Std.HashMap Int Nat := {}
  outside : Std.HashMap (Nat × Nat) Nat := {}
  examples : List String := []

/-- the three bytes of the position -/
def posAfterBytes (sy : Syms) : List (String × UInt16) :=
  [("Player_X_Position", sy.Player_X_Position), ("Player_PageLoc", sy.Player_PageLoc), ("SprObject_X_MoveForce", sy.SprObject_X_MoveForce)]

/-- one frame of `m` with the pad `pad`, from the scroll handler to its end -/
def posAfterFrame (sy : Syms) (m : Machine) (pad : UInt8) (c0 : PosAfterCount) : PosAfterCount := Id.run do
  let idx := (posAfterBytes sy).map fun (_, a) => (a &&& 0x7FF).toNat
  let get := fun (x : Machine) => idx.map fun i => x.ram.get! i
  let mut c := { c0 with frames := c0.frames + 1 }
  let mut x := { m with pad := pad }
  let t := m.frame + 1
  let mut arr := false
  let mut q : Option Machine := none
  let D := ImpedePosition.sites sy m
  let P := ScreenClamp.places sy m
  let mut clamp : Option Machine := none
  let mut clampSteps := 0
  let mut call : Option Machine := none
  let mut callSteps := 0
  for _ in [0:40000] do
    if x.frame ≥ t || x.halted then break
    if x.pc == sy.PlayerCtrlRoutine then arr := true
    if arr && q.isNone && x.pc == sy.PlayerSubs then q := some x
    if q.isSome && x.pc == sy.ImpedePlayerMove && call.isNone then
      call := some x
      callSteps := 0
      c := { c with calls := c.calls + 1 }
      if !(x.prg == m.prg && x.prgMask == m.prgMask && !x.nmiPending && !x.halted && !x.trk && x.ram.size == 2048 && x.ppuCtrl &&& 0x80 == 0) then
        c := { c with goodBad := c.goodBad + 1 }
    if q.isSome && x.pc == P.entry && clamp.isNone then
      clamp := some x
      clampSteps := 0
      c := { c with clamps := c.clamps + 1, clampSelectors := c.clampSelectors.insert x.y.toNat (c.clampSelectors.getD x.y.toNat 0 + 1) }
      if !(x.prg == m.prg && x.prgMask == m.prgMask && !x.nmiPending && !x.halted && !x.trk && x.ram.size == 2048 && x.ppuCtrl &&& 0x80 == 0) then
        c := { c with goodBad := c.goodBad + 1 }
    let inside := call.isSome || clamp.isSome
    let locs := if q.isSome && !inside then StepWrites.stepLocs x else []
    let before := get x
    let pc := x.pc.toNat
    x := (step.run x).2
    if let some A := call then
      callSteps := callSteps + 1
      if x.pc == ImpedePosition.returnPc A && x.s == A.s + 1 + 1 then
        let v := peek A sy.Player_X_Speed
        let side := A.ram.get! D.side
        let d := ImpedePosition.delta side v
        c := { c with deltas := c.deltas.insert d (c.deltas.getD d 0 + 1) }
        let margin := decide (256 ≤ posP sy A ∧ posP sy A + 256 < 0x1000000)
        if !margin then c := { c with marginOff := c.marginOff + 1 }
        let ok := callSteps ≤ 65 && peek x sy.Player_X_Speed == (if ImpedePosition.pushes side v then 0 else v) &&
          peek x sy.SprObject_X_MoveForce == peek A sy.SprObject_X_MoveForce && peek x sy.Player_X_MoveForce == peek A sy.Player_X_MoveForce &&
          decide ((posP sy x - posP sy A - 256*d) % 0x1000000 = 0) &&
          (!margin || decide (posP sy x = posP sy A + 256*d)) && (!decide (0 < d) || decide (sbyte v ≤ 0))
        if !ok then c := { c with callBad := c.callBad + 1, examples := if c.examples.length < 6 then s!"side {side}, v {sbyte v}, shift {posP sy x-posP sy A}, steps {callSteps}" :: c.examples else c.examples }
        call := none
      else if callSteps > 65 then
        c := { c with callBad := c.callBad + 1, examples := if c.examples.length < 6 then "call exceeded65 instructions" :: c.examples else c.examples }
        call := none
    if let some A := clamp then
      clampSteps := clampSteps + 1
      if x.pc == ImpedePosition.returnPc A && x.s == A.s + 1 + 1 then
        let t := ScreenClamp.target (FrameModel.Rom.of m) P A A.y
        let range := decide (0 ≤ t ∧ t < 0x1000000)
        if !range then c := { c with clampRangeOff := c.clampRangeOff + 1 }
        let ok := clampSteps ≤ 37 && (A.y == 0 || A.y == 1) &&
          peek x sy.SprObject_X_MoveForce == peek A sy.SprObject_X_MoveForce &&
          decide ((posP sy x-t) % 0x1000000 = 0) && (!range || decide (posP sy x=t))
        if !ok then c := { c with clampBad := c.clampBad + 1, examples := if c.examples.length < 6 then s!"clamp selector {A.y}, target {t}, actual {posP sy x}, steps {clampSteps}" :: c.examples else c.examples }
        clamp := none
      else if clampSteps > 37 then
        c := { c with clampBad := c.clampBad + 1, examples := if c.examples.length < 6 then "clamp exceeded37 instructions" :: c.examples else c.examples }
        clamp := none
    if q.isSome then
      let after := get x
      for k in [0:idx.length] do
        if locs.contains idx[k]! then c := { c with outsideStores := c.outsideStores.insert (pc,k) (c.outsideStores.getD (pc,k) 0 + 1) }
      for k in [0:idx.length] do
        if before[k]! != after[k]! then
          c := { c with writes := c.writes.insert (pc, k) (c.writes.getD (pc, k) 0 + 1) }
          if !inside then c := { c with outside := c.outside.insert (pc,k) (c.outside.getD (pc,k) 0 + 1) }
  if call.isSome then c := { c with callOpen := c.callOpen + 1 }
  if clamp.isSome then c := { c with clampOpen := c.clampOpen + 1 }
  match q with
  | some Q =>
    let vq := SurfaceFrames.vOf sy Q
    let key := ((if vq > 0 then 1 else if vq < 0 then -1 else 0 : Int), posP sy x - posP sy Q, peek x sy.Player_X_Speed == peek Q sy.Player_X_Speed)
    c := { c with classes := c.classes.insert key (c.classes.getD key 0 + 1) }
    if peek x sy.SprObject_X_MoveForce != peek Q sy.SprObject_X_MoveForce then c := { c with frac := c.frac + 1 }
  | none => pure ()
  return c

/-- a run of frames from `start`, up to a frame that does not start in control or that stores to the routine, the mode or the task -/
def posAfterRun (sy : Syms) (start : Machine) (w : Array UInt8) (c0 : PosAfterCount) (raw : Bool := false) : PosAfterCount := Id.run do
  let mut c := c0
  let mut cur := start
  for i in w do
    let pad := if raw then i else smbToPad i
    if !controllable sy cur then break
    if stepFails cur pad (fun x => !FrameKeep.CtlStore sy x) != 0 then break
    c := posAfterFrame sy cur pad c
    cur := runFrame cur pad
  return c

def PosAfterCount.str (sy : Syms) (c : PosAfterCount) : String :=
  let names := (posAfterBytes sy).map (·.1)
  let ws := (c.writes.toList.mergeSort (fun a b => a.1.1 ≤ b.1.1)).map fun ((pc, k), n) => s!"{pc}:{names.getD k "?"}×{n}"
  let cs := (c.classes.toList.mergeSort (fun a b => a.2 ≥ b.2)).map fun ((sg, d, kept), n) => s!"(v sign {sg}, P(b) − P(Q) {d}, speed kept {kept})×{n}"
  let outside := (c.outside.toList.mergeSort (fun a b => a.1.1 ≤ b.1.1)).map fun ((pc,k),n) => s!"{pc}:{names.getD k "?"}×{n}"
  let stores := (c.outsideStores.toList.mergeSort (fun a b => a.1.1 ≤ b.1.1)).map fun ((pc,k),n) => s!"{pc}:{names.getD k "?"}×{n}"
  s!"frames {c.frames}; the fraction changed {c.frac}\n  changes after the scroll handler: {ws}\n  frames: {cs}\n  Impede calls {c.calls}, bad {c.callBad}, Good failures {c.goodBad}, unfinished {c.callOpen}, margin off {c.marginOff}, deltas {c.deltas.toList}, examples {c.examples.reverse}\n  writes outside summarized calls: {outside}\n  clamp calls {c.clamps}, bad {c.clampBad}, unfinished {c.clampOpen}, target range off {c.clampRangeOff}, selectors {c.clampSelectors.toList}\n  stores outside summarized calls (including unchanged bytes): {stores}"

/-- **The position after the scroll handler on real frames above ground**: the movie from 852 for 300 frames, `n` random runs from control (from the movie's machine and
from the machine of the private proof), runs into the screen's left edge, runs from the movie's frames 1002 to 1091, with Select: which instructions change the three
bytes of the position after the scroll handler, and how far the position at the frame's end is from that at the scroll handler -/
def posAfterRealProg (sy : Syms) (romPath fm2 : String) (n : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let ct ← IO.monoMsNow
  let ck ← IO.lazyPure fun _ => ImpedePosition.check sy m0
  IO.println s!"ImpedePosition.check {ck}, {(← IO.monoMsNow)-ct} ms"
  if !ck then return 1
  let st ← IO.monoMsNow
  let sc ← IO.lazyPure fun _ => ScreenClamp.check sy m0
  IO.println s!"ScreenClamp.check {sc}, {(← IO.monoMsNow)-st} ms"
  if !sc then return 1
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2)) fceuxSkip
  let ctlOwn := SurfaceRun.above m0 982
  let mut m := powerOn cart 0
  let mut first : Option Nat := none
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if first.isNone && controllable sy m then first := some k
    if first.isSome && k ≥ (first.getD 0) + 852 then
      k0 := k
      break
  let ctlM := m
  let t := posAfterRun sy ctlM ((List.range 300).toArray.map fun j => inputs[k0 + 1 + j]!) {} true
  IO.println s!"the movie from 852: {t.str sy}"
  (← IO.getStdout).flush
  let mut r : PosAfterCount := {}
  for sd in [1:n + 1] do
    r := posAfterRun sy (if sd % 2 == 0 then ctlM else ctlOwn) (framesInputs sd.toUInt64 240 0 0) r
  IO.println s!"random, from control: {r.str sy}"
  (← IO.getStdout).flush
  let mut e : PosAfterCount := {}
  for k in [0:20] do
    for b0 in [(0x00 : UInt8), 0x41] do
      for b1 in [(0x02 : UInt8), 0x42, 0x82] do
        e := posAfterRun sy ctlOwn (Array.replicate k b0 ++ Array.replicate 90 b1 ++ #[0x01, 0x01, 0x00, 0x00, 0x41, 0x41] ++ fracInputs k.toUInt64 200) e
  IO.println s!"into the screen's left edge: {e.str sy}"
  (← IO.getStdout).flush
  let mut tas : Array Machine := #[ctlM]
  let mut a := ctlM
  for j in [1:400] do
    a := runFrame a inputs[k0 + j]!
    tas := tas.push a
  let mut l : PosAfterCount := {}
  for sd in [1:2 * n + 1] do
    l := posAfterRun sy tas[150 + (sd * 7919) % 90]! (fracInputs (sd.toUInt64 + 7777) 160) l
  IO.println s!"random, from the movie's frames 1002 to 1091: {l.str sy}"
  (← IO.getStdout).flush
  let mut sl : PosAfterCount := {}
  for sd in [1:n / 2 + 1] do
    sl := posAfterRun sy ctlOwn (framesInputs (sd.toUInt64 + 99) 120 10 0) sl
  IO.println s!"with Select: {sl.str sy}"
  return if t.callBad+r.callBad+e.callBad+l.callBad+sl.callBad+t.goodBad+r.goodBad+e.goodBad+l.goodBad+sl.goodBad+t.callOpen+r.callOpen+e.callOpen+l.callOpen+sl.callOpen+t.clampBad+r.clampBad+e.clampBad+l.clampBad+sl.clampBad+t.clampOpen+r.clampOpen+e.clampOpen+l.clampOpen+sl.clampOpen == 0 then 0 else 1

/-! ## Above ground: the conditions of `PositionKeep` on real frames (`OnFrames.posW`, `OnFrames.clampR`; a measurement, no part of the proof) -/

/-- what `pos-keep-real` counts on real frames above ground before the touch -/
structure PosKeepCount where
  frames : Nat := 0
  /-- instructions from the scroll handler on, outside the push and the clamp -/
  steps : Nat := 0
  /-- of them, those that write a byte of the position (`PositionKeep.PosW` fails), by pc -/
  wBad : Std.HashMap Nat Nat := {}
  clamps : Nat := 0
  /-- clamp entries with the speed positive -/
  clampPos : Nat := 0
  /-- of them, those with the target not the position (`PositionKeep.ClampR` fails) -/
  clampBad : Nat := 0
  /-- frames with `0 < v(Q)` that end with the speed of `Q`, and of them those that do not end with the position of `Q` -/
  keepFrames : Nat := 0
  keepBad : Nat := 0
  /-- the entries of the push (I) and the clamp (C) in the order they come, from the scroll handler to the frame's end -/
  seqs : Std.HashMap String Nat := {}
  /-- frames with `0 < v(Q)` that end with the speed 0: (P(b) − P(Q), P(b) ≤ P(a) + 256) -/
  stops : Std.HashMap (Int × Bool) Nat := {}
  examples : List String := []

/-- one frame of `m` with the pad `pad`, from the scroll handler to its end -/
def posKeepFrame (sy : Syms) (a m : Machine) (pad : UInt8) (c0 : PosKeepCount) : PosKeepCount := Id.run do
  let idx := [FrameModel.I sy.Player_X_Position, FrameModel.I sy.Player_PageLoc, FrameModel.I sy.SprObject_X_MoveForce]
  let P := ScreenClamp.places sy m
  let mut c := { c0 with frames := c0.frames + 1 }
  let mut x := { m with pad := pad }
  let t := m.frame + 1
  let mut arr := false
  let mut q : Option Machine := none
  let mut sq := ""
  for _ in [0:40000] do
    if x.frame ≥ t || x.halted then break
    if x.pc == sy.PlayerCtrlRoutine then arr := true
    if arr && q.isNone && x.pc == sy.PlayerSubs then q := some x
    if q.isSome then
      if x.pc == sy.ImpedePlayerMove then sq := sq ++ "I"
      if x.pc == P.entry then
        sq := sq ++ "C"
        c := { c with clamps := c.clamps + 1 }
        if 0 < sbyte (peek x sy.Player_X_Speed) then
          c := { c with clampPos := c.clampPos + 1 }
          let tg := ScreenClamp.target (FrameModel.Rom.of m) P x x.y
          if tg != posP sy x then
            let msg := s!"clamp: v {sbyte (peek x sy.Player_X_Speed)}, y {x.y}, target {tg}, P {posP sy x}"
            c := { c with clampBad := c.clampBad + 1, examples := if c.examples.length < 8 then msg :: c.examples else c.examples }
      if !PositionWriters.innerP sy m x.pc then
        c := { c with steps := c.steps + 1 }
        let locs := StepWrites.stepLocs x
        if idx.any (locs.contains ·) then
          c := { c with wBad := c.wBad.insert x.pc.toNat (c.wBad.getD x.pc.toNat 0 + 1) }
    x := (step.run x).2
  match q with
  | some Q =>
    c := { c with seqs := c.seqs.insert sq (c.seqs.getD sq 0 + 1) }
    let vq := SurfaceFrames.vOf sy Q
    if vq > 0 && peek x sy.Player_X_Speed == peek Q sy.Player_X_Speed then
      c := { c with keepFrames := c.keepFrames + 1 }
      if posP sy x != posP sy Q then c := { c with keepBad := c.keepBad + 1 }
    if vq > 0 && peek x sy.Player_X_Speed == 0 then
      let key := (posP sy x - posP sy Q, decide (posP sy x ≤ posP sy a + 256))
      c := { c with stops := c.stops.insert key (c.stops.getD key 0 + 1) }
  | none => pure ()
  return c

/-- a run of frames from `start`, up to a frame that does not start in control or that stores to the routine, the mode or the task -/
def posKeepRun (sy : Syms) (start : Machine) (w : Array UInt8) (c0 : PosKeepCount) (raw : Bool := false) : PosKeepCount := Id.run do
  let mut c := c0
  let mut cur := start
  for i in w do
    let pad := if raw then i else smbToPad i
    if !controllable sy cur then break
    if stepFails cur pad (fun x => !FrameKeep.CtlStore sy x) != 0 then break
    c := posKeepFrame sy cur cur pad c
    cur := runFrame cur pad
  return c

def PosKeepCount.str (c : PosKeepCount) : String :=
  let sq := (c.seqs.toList.mergeSort (fun a b => a.2 ≥ b.2)).map fun (s, n) => s!"\"{s}\"×{n}"
  let st := (c.stops.toList.mergeSort (fun a b => a.2 ≥ b.2)).map fun ((d, l), n) => s!"(P(b) − P(Q) {d}, P(b) ≤ P(a) + 256 {l})×{n}"
  s!"frames {c.frames}; steps outside the push and the clamp {c.steps}, PosW fails {c.wBad.toList}; clamps {c.clamps}, with v > 0 {c.clampPos}, ClampR fails {c.clampBad}; keep frames {c.keepFrames}, keep fails {c.keepBad}\n  call sequences {sq}\n  frames that move right and end with the speed 0: {st}\n  examples {c.examples.reverse}"

def PosKeepCount.bad (c : PosKeepCount) : Nat := c.wBad.size + c.clampBad + c.keepBad

/-- **The conditions of `PositionKeep` on real frames above ground**: the runs of `pos-after-real` (the movie from 852, `n` random runs from control, runs into the
screen's left edge, runs from the movie's frames 1002 to 1091, with Select): `PosW` at each instruction from the scroll handler on, `ClampR` at each clamp's entry, and
`AfterP.keep` on each frame -/
def posKeepRealProg (sy : Syms) (romPath fm2 : String) (n : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2)) fceuxSkip
  let ctlOwn := SurfaceRun.above m0 982
  let mut m := powerOn cart 0
  let mut first : Option Nat := none
  let mut k0 := 0
  for h : k in [0:inputs.size] do
    m := runFrame m inputs[k]
    if first.isNone && controllable sy m then first := some k
    if first.isSome && k ≥ (first.getD 0) + 852 then
      k0 := k
      break
  let ctlM := m
  let t := posKeepRun sy ctlM ((List.range 300).toArray.map fun j => inputs[k0 + 1 + j]!) {} true
  IO.println s!"the movie from 852: {t.str}"
  (← IO.getStdout).flush
  let mut r : PosKeepCount := {}
  for sd in [1:n + 1] do
    r := posKeepRun sy (if sd % 2 == 0 then ctlM else ctlOwn) (framesInputs sd.toUInt64 240 0 0) r
  IO.println s!"random, from control: {r.str}"
  (← IO.getStdout).flush
  let mut e : PosKeepCount := {}
  for k in [0:20] do
    for b0 in [(0x00 : UInt8), 0x41] do
      for b1 in [(0x02 : UInt8), 0x42, 0x82] do
        e := posKeepRun sy ctlOwn (Array.replicate k b0 ++ Array.replicate 90 b1 ++ #[0x01, 0x01, 0x00, 0x00, 0x41, 0x41] ++ fracInputs k.toUInt64 200) e
  IO.println s!"into the screen's left edge: {e.str}"
  (← IO.getStdout).flush
  let mut tas : Array Machine := #[ctlM]
  let mut a := ctlM
  for j in [1:400] do
    a := runFrame a inputs[k0 + j]!
    tas := tas.push a
  let mut l : PosKeepCount := {}
  for sd in [1:2 * n + 1] do
    l := posKeepRun sy tas[150 + (sd * 7919) % 90]! (fracInputs (sd.toUInt64 + 7777) 160) l
  IO.println s!"random, from the movie's frames 1002 to 1091: {l.str}"
  (← IO.getStdout).flush
  let mut sl : PosKeepCount := {}
  for sd in [1:n / 2 + 1] do
    sl := posKeepRun sy ctlOwn (framesInputs (sd.toUInt64 + 99) 120 10 0) sl
  IO.println s!"with Select: {sl.str}"
  return if t.bad + r.bad + e.bad + l.bad + sl.bad == 0 then 0 else 1

/-! ## Above ground: the screen's left edge and the position at each frame's start, and the conditions of `OnFrames` on every frame (a measurement, no part of the
proof) -/

/-- what `edge-real` counts -/
structure EdgeCount where
  frames : Nat := 0
  /-- frame starts by pixel(M) − left(M), in whole pixels (pixel and left edge with their pages) -/
  ds : Std.HashMap Int Nat := {}
  /-- frame starts with right(M) − left(M) ≠ 255 -/
  rightBad : Nat := 0
  /-- frames that do not start clean (`SurfaceFrames.Clean`) -/
  unclean : Nat := 0
  /-- the conditions of `SurfaceFrames.movesScan` that fail: (name, the frame starts clean) → frames -/
  fails : Std.HashMap (String × Bool) Nat := {}
  /-- frames that start with pixel(M) < left(M), and of them those that call the clamp and those with a call sequence ending in a push -/
  below : Nat := 0
  /-- a few frames that start below the left edge, and a few frames where a field fails -/
  belowEx : List String := []
  /-- frames that start below the left edge but not 1 px below it with the speed 0 and bit 0 of the collision bits 0 (Right blocked) -/
  belowOther : Nat := 0
  /-- the most P(b) − P(a) on a frame that starts below the left edge, and over that frame and the one before it -/
  belowMove : Int := -100000
  belowMove2 : Int := -100000
  examples : List String := []
  /-- round 24: on the frames that call the clamp, the most P(b) − P(a) and P(b) − P(Q); on the frames that call the push or the clamp and do not move right at the
  scroll handler, the most P(b) − baseOf(a) (the new `collide` asks at most 256); on the frames after one that starts below the edge, the most P(b) − P(a); on every
  frame the most edgeOf(b) − max(baseOf(a), P(b)) (the field `edge` asks at most 0); frames that call the clamp -/
  clampN : Nat := 0
  clampMove : Int := -100000
  clampQ : Int := -100000
  baseMove : Int := -100000
  afterBelow : Int := -100000
  edgeGap : Int := -100000
  /-- round 25: frames on which the left edge moves (left(b) ≠ left(a)), of them those where it moves back, the most left(b) − left(a), the least P(b) − edgeOf(b)
  on them (the field `edge` needs at least 0 there) and the least pixel(Q) − left(Q) on them -/
  scrollN : Nat := 0
  scrollBack : Nat := 0
  scrollMax : Int := -100000
  scrollMargin : Int := 100000
  scrollQ : Int := 100000
  /-- round 25: on the frames where the left edge moves, the most left(b) − left(a) − (pixel(Q) − pixel(a)): the scroll against his move in whole pixels -/
  scrollOver : Int := -100000
  /-- round 25: frame starts (not the first of a run) where the byte the scroll reads for his place on the screen is not pixel(M) − left(M) mod 256, and the least
  pixel(M) − left(M) at the frame starts where that byte is at least the scroll's first threshold (`forScrollThr`) and the side collision's timer is 0 -/
  forBad : Nat := 0
  forMin : Int := 100000
  /-- round 25: the most calls of the push and of the clamp in one frame, and the frames with two calls or more -/
  pushMax : Nat := 0
  clampMax : Nat := 0
  calls2 : Nat := 0
  /-- round 26: arrivals at the scroll handler where the scroll is allowed (`ScrollRule.Allows`), and on them the least pixel16(Q) − left16(Q) − X(Q) − 2 (the field
  `near` asks at least 0), the most X(Q), the least pixel16(Q) − left16(Q) -/
  nearN : Nat := 0
  nearMin : Int := 100000
  nearMaxX : Nat := 0
  nearMinD : Int := 100000

/-- the screen's left edge and right edge, in whole pixels with the page, read at the clamp's two operands (`ScreenClamp.places`) -/
def edgeLeft (P : ScreenClamp.Places) (m : Machine) : Int := (peek m P.edgeP).toNat * 256 + (peek m P.edgeX).toNat
def edgeRight (P : ScreenClamp.Places) (m : Machine) : Int := (peek m (P.edgeP + 1)).toNat * 256 + (peek m (P.edgeX + 1)).toNat
def edgePix (sy : Syms) (m : Machine) : Int := (peek m sy.Player_PageLoc).toNat * 256 + (peek m sy.Player_X_Position).toNat

/-- the instructions of the frame of `m` with the pad `pad` at `p` and at `q` -/
def countPc2 (m : Machine) (pad : UInt8) (p q : UInt16) : Nat × Nat := Id.run do
  let mut x := { m with pad := pad }
  let t := m.frame + 1
  let mut a := 0
  let mut b := 0
  for _ in [0:40000] do
    if x.frame ≥ t || x.halted then return (a, b)
    if x.pc == p then a := a + 1
    if x.pc == q then b := b + 1
    x := (step.run x).2
  return (a, b)

/-- round 25: the byte that the scroll handler reads for his place on the screen: the operand of its third `LDA` absolute (after the scroll's amount and the
scroll lock), found from the call at the player's routine's end as `ScreenClamp.places` finds the clamp (a measurement, no part of the proof) -/
def forScrollAd (sy : Syms) (m0 : Machine) : UInt16 :=
  let E := FrameModel.Rom.of m0
  let scroll := E.w (sy.PlayerSubs + 1)
  let p1 := PipeEntryRule.findOp m0 scroll 0xAD 8
  let p2 := PipeEntryRule.findOp m0 (p1 + 3) 0xAD 16
  let p3 := PipeEntryRule.findOp m0 (p2 + 3) 0xAD 16
  E.w (p3 + 1)

/-- round 25: the immediate of the compare after that load: the scroll handler's first threshold of his place on the screen (a measurement) -/
def forScrollThr (sy : Syms) (m0 : Machine) : UInt8 :=
  let E := FrameModel.Rom.of m0
  let scroll := E.w (sy.PlayerSubs + 1)
  let p1 := PipeEntryRule.findOp m0 scroll 0xAD 8
  let p2 := PipeEntryRule.findOp m0 (p1 + 3) 0xAD 16
  let p3 := PipeEntryRule.findOp m0 (p2 + 3) 0xAD 16
  E.b (p3 + 4)

/-- a run of frames from `start` with the pads `w` (the machine's layout), up to a frame that does not start in control or that stores to the routine, the mode or
the task: at each frame's start the edge and the position, and the conditions of `movesScan` on the frame -/
def edgeRun (sy : Syms) (m0 : Machine) (tag : String) (start : Machine) (w : Array UInt8) (c0 : EdgeCount) : EdgeCount := Id.run do
  let P := ScreenClamp.places sy m0
  let B : PoleJoin.Box := ⟨m0, 0, 0, 0⟩
  let mut c := c0
  let mut cur := start
  let mut prev := start
  let mut k := 0
  for pad in w do
    if !controllable sy cur then break
    if stepFails cur pad (fun x => !FrameKeep.CtlStore sy x) != 0 then break
    let d := edgePix sy cur - edgeLeft P cur
    c := { c with frames := c.frames + 1, ds := c.ds.insert d (c.ds.getD d 0 + 1) }
    if edgeRight P cur - edgeLeft P cur != 255 then c := { c with rightBad := c.rightBad + 1 }
    let clean := decide (SurfaceFrames.Clean sy cur)
    if !clean then c := { c with unclean := c.unclean + 1 }
    if d < 0 then
      c := { c with below := c.below + 1 }
      if !(d == -1 && peek cur sy.Player_X_Speed == 0 && peek cur sy.Player_CollisionBits &&& 1 == 0) then c := { c with belowOther := c.belowOther + 1 }
      let Pn := posP sy (runFrame cur pad)
      c := { c with belowMove := max c.belowMove (Pn - posP sy cur), belowMove2 := max c.belowMove2 (Pn - posP sy prev) }
      if c.belowEx.length < 4 then
        c := { c with belowEx := s!"{tag} frame {k}: starts with pixel {edgePix sy cur} < left edge {edgeLeft P cur}, speed {sbyte (peek cur sy.Player_X_Speed)}, collision bits {peek cur sy.Player_CollisionBits}" :: c.belowEx }
    let ms := SurfaceFrames.movesScan sy m0 B cur cur (smbToPad pad) false
    -- the move of `TopSpeed.Frame` that `OnFrames.readE` builds from `collide` on every frame: P' = P₂, P₂ − 256, or P' ≤ P + 256 with v₂ ≤ 0 (as `impP` of
    -- `surface-frames-check`, which looks only at clean frames)
    match framesAt cur pad sy.MoveObjectHorizontally with
    | some e =>
      let v2 := sbyte (peek e sy.Player_X_Speed)
      let P := posP sy cur
      let P2 := P + 16 * v2
      let P' := posP sy (runFrame cur pad)
      if !(decide (P' = P2 ∨ P' = P2 - 256 ∨ (P' ≤ SurfaceRead.baseOf sy cur + 256 ∧ v2 ≤ 0))) then
        c := { c with fails := c.fails.insert ("Frame move", clean) (c.fails.getD ("Frame move", clean) 0 + 1) }
        if c.examples.length < 16 then
          c := { c with examples := s!"{tag} frame {k}: the Frame move fails (clean {clean}), pixel − left {d}, P {P}, v₂ {v2}, P' {P'}" :: c.examples }
    | none => pure ()
    -- round 24: the clamp's frames, the base, the edge
    let bN := runFrame cur pad
    let qs := framesAt cur pad sy.PlayerSubs
    let cl := (framesAt cur pad P.entry).isSome
    let pu := (framesAt cur pad sy.ImpedePlayerMove).isSome
    if cl then
      c := { c with clampN := c.clampN + 1, clampMove := max c.clampMove (posP sy bN - posP sy cur) }
      match qs with
      | some q => c := { c with clampQ := max c.clampQ (posP sy bN - posP sy q) }
      | none => pure ()
    match qs with
    | some q =>
      if (cl || pu) && decide (sbyte (peek q sy.Player_X_Speed) ≤ 0) then
        c := { c with baseMove := max c.baseMove (posP sy bN - SurfaceRead.baseOf sy cur) }
    | none => pure ()
    if edgePix sy prev - edgeLeft P prev < 0 && k > 0 then c := { c with afterBelow := max c.afterBelow (posP sy bN - posP sy cur) }
    c := { c with edgeGap := max c.edgeGap (SurfaceRead.edgeOf sy bN - max (SurfaceRead.baseOf sy cur) (posP sy bN)) }
    -- round 25: the scroll, the byte it reads, the calls
    if edgeLeft P bN != edgeLeft P cur then
      c := { c with scrollN := c.scrollN + 1, scrollMax := max c.scrollMax (edgeLeft P bN - edgeLeft P cur),
                    scrollMargin := min c.scrollMargin (posP sy bN - SurfaceRead.edgeOf sy bN) }
      if edgeLeft P bN < edgeLeft P cur then c := { c with scrollBack := c.scrollBack + 1 }
      match qs with
      | some q => c := { c with scrollQ := min c.scrollQ (edgePix sy q - edgeLeft P q),
                                scrollOver := max c.scrollOver (edgeLeft P bN - edgeLeft P cur - (edgePix sy q - edgePix sy cur)) }
      | none => pure ()
    let fs := peek cur (forScrollAd sy m0)
    if k > 0 && fs.toNat != (d % 256).toNat then c := { c with forBad := c.forBad + 1 }
    if fs ≥ forScrollThr sy m0 && peek cur sy.SideCollisionTimer == 0 then c := { c with forMin := min c.forMin d }
    -- round 26: the field `near` at the scroll handler
    match qs with
    | some q =>
      let SP := ScrollRule.places sy m0
      let X := (ScrollRule.amountOf SP q).toNat
      if q.ram.get! SP.lockB == 0 && decide (SP.thr1 ≤ q.ram.get! SP.pfs) && q.ram.get! SP.sideB == 0 && ScrollRule.xOK (ScrollRule.amountOf SP q) then
        let dq : Int := (EdgeStep.pixel16 sy q : Int) - (ScrollRule.left16 SP q : Int)
        c := { c with nearN := c.nearN + 1, nearMin := min c.nearMin (dq - X - 2), nearMaxX := max c.nearMaxX X, nearMinD := min c.nearMinD dq }
    | none => pure ()
    let (np, nc) := countPc2 cur pad sy.ImpedePlayerMove P.entry
    c := { c with pushMax := max c.pushMax np, clampMax := max c.clampMax nc, calls2 := c.calls2 + (if np + nc ≥ 2 then 1 else 0) }
    for f in ms.fails do
      c := { c with fails := c.fails.insert (f, clean) (c.fails.getD (f, clean) 0 + 1) }
      if c.examples.length < 16 && (f == "collideS" || f == "afterP" || f == "clampR" || f == "posW" || f == "edge" || f == "near") then
        c := { c with examples := s!"{tag} frame {k}: {f} fails (clean {clean}), pixel − left {d}, P(a) {posP sy cur}, P(Q) {(framesAt cur pad sy.PlayerSubs).map (posP sy)}, P(b) {posP sy ms.next}, v(a) {sbyte (peek cur sy.Player_X_Speed)}, v(Q) {(framesAt cur pad sy.PlayerSubs).map fun q => sbyte (peek q sy.Player_X_Speed)}, v(b) {sbyte (peek ms.next sy.Player_X_Speed)}, pad {pad}" :: c.examples }
    prev := cur
    cur := runFrame cur pad
    k := k + 1
  return c

def EdgeCount.str (c : EdgeCount) : String :=
  let ds := (c.ds.toList.mergeSort (fun a b => a.1 ≤ b.1)).map fun (d, n) => s!"{d}×{n}"
  let fs := (c.fails.toList.mergeSort (fun a b => a.2 ≥ b.2)).map fun ((f, cl), n) => s!"{f} (clean {cl})×{n}"
  s!"frames {c.frames} (not clean {c.unclean}); pixel(M) − left(M) at the frame starts: {ds}; right(M) − left(M) ≠ 255: {c.rightBad}; starts below the left edge {c.below} {c.belowEx.reverse}, of them not 1 px below with the speed 0 and Right blocked {c.belowOther}, the most P(b) − P(a) on them {c.belowMove}, over them and the frame before {c.belowMove2}\n  round 24: clamp frames {c.clampN}, the most P(b) − P(a) on them {c.clampMove}, P(b) − P(Q) {c.clampQ}; the most P(b) − baseOf(a) on frames that call and do not move right at the scroll handler {c.baseMove} (at most 256); after a start below the edge, the most P(b) − P(a) {c.afterBelow}; the most edgeOf(b) − max(baseOf(a), P(b)) {c.edgeGap} (at most 0)\n  round 25: frames where the left edge moves {c.scrollN} (back {c.scrollBack}), the most it moves {c.scrollMax} px, the least P(b) − edgeOf(b) on them {c.scrollMargin}, the least pixel(Q) − left(Q) on them {c.scrollQ}, the most left(b) − left(a) − (pixel(Q) − pixel(a)) on them {c.scrollOver}; frame starts where the scroll's byte of his place on the screen is not pixel − left mod 256: {c.forBad}; the least pixel(M) − left(M) where that byte is at least the scroll's threshold and the side timer 0: {c.forMin}; the most pushes in a frame {c.pushMax}, clamps {c.clampMax}, frames with two calls or more {c.calls2}\n  round 26: arrivals at the scroll handler where the scroll is allowed {c.nearN}, the least pixel16(Q) − left16(Q) − X(Q) − 2 on them {c.nearMin} (`near` asks at least 0), the most X(Q) {c.nearMaxX}, the least pixel16(Q) − left16(Q) {c.nearMinD}\n  conditions of movesScan that fail: {fs}\n  examples {c.examples.reverse}"

/-- the fields that `OnFrames` asks of every counted frame before the touch: `collide` (`CollideS`), `posW`, `clampR`; and `Moves.stop` (`AfterP`) on the clean ones -/
def EdgeCount.bad (c : EdgeCount) : Nat :=
  c.fails.fold (fun n (f, cl) k => if f == "collideS" || f == "posW" || f == "clampR" || f == "Frame move" || f == "edge" || f == "near" || (cl && f == "afterP") then n + k else n) 0

/-- inputs of my own for `edge-real`, in the machine's layout: buttons held for 1 to 12 frames; Left with the probability `pL` %, else Right with `pR` %, A with
`pA` %, B with 50 % -/
def edgeInputs (seed : UInt64) (n pL pR pA : Nat) : Array UInt8 := Id.run do
  let nx := fun (s : UInt64) => let x := s ^^^ (s <<< 13); let y := x ^^^ (x >>> 7); y ^^^ (y <<< 17)
  let mut s := nx (seed * 2654435761 + 1013904223)
  let mut out : Array UInt8 := #[]
  let mut hold := 0
  let mut cur : UInt8 := 0
  for _ in [0:n] do
    if hold == 0 then
      s := nx s
      hold := 1 + (s >>> 20).toNat % 12
      s := nx s
      let l := decide ((s >>> 20).toNat % 100 < pL)
      s := nx s
      let r := decide ((s >>> 20).toNat % 100 < pR)
      s := nx s
      let a := decide ((s >>> 20).toNat % 100 < pA)
      s := nx s
      let b := decide ((s >>> 20).toNat % 100 < 50)
      cur := (if l then 0x40 else if r then 0x80 else 0) ||| (if a then 0x01 else 0) ||| (if b then 0x02 else 0)
    hold := hold - 1
    out := out.push cur
  return out

