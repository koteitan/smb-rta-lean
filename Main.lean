")
  IO.FS.writeFile s!"{dir}/RoomBlocksRun.lean" ("import Lean\nimport Proof.Route\nimport Proof.RoomBlocks\n" ++ s!"/-! {privateNote} -/
open Smbrta Smbrta.Rom

" ++ "
