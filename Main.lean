  t := prevRun sy ctlM ((List.range 300).toArray.map fun j => inputs[k0 + 1 + j]!) t true
  IO.println s!"the movie from 852: {t.str}"
  (← IO.getStdout).flush
  let mut r : PrevCount := {}
  for sd in [1:n + 1] do
