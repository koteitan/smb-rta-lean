  let slow := (Jump.summary sy m0 3).slow
  IO.FS.writeFile s!"{dir}/LandDist.lean" ("import Proof.Rom\nimport Theorems.LandDist\n" ++ s!"/-! {privateNote} -/
open Smbrta Smbrta.Rom

set_option maxHeartbeats 0

/-- for a big player's slow takeoff on the first frame after the fall in the bonus room (`RoomJoin.Checks.slowLand`): one pass of `hstep` over every state and
input, the table of the frames after the landing, and the search from the room's first frame; about 45 s natively -/
theorem land_dist : LandDist.slowCheck sy ctx (FastTakeoff.bonusRoom sy 34 6 8 64) {slow} 34 98 = true := by native_decide
")

/-- the private file of `EntryHeight`, `EntryHeightBig` and `EntryBuffer`: the walks of the room's frame that follow the height (`EntryHeight` with a small player,
`EntryHeightBig` with a big one) and the references' height; the walk with the control of the screen's buffers known, and the references' other bytes -/
def genEntryHeight (dir : String) : IO Unit :=
  IO.FS.writeFile s!"{dir}/EntryHeight.lean" ("import Proof.ScreenPage\nimport Proof.Rom\nimport Proof.RoomBlocks\nimport Proof.SizeKeep\nimport Proof.BufferControl\nimport Proof.BufferCoin\nimport Proof.BufferEnd\nimport Proof.SideFrame\nimport Theorems.EntryHeight\nimport Theorems.EntryHeightBig\nimport Theorems.EntryBuffer\nimport Theorems.Route\n" ++ s!"/-! {privateNote} -/
open Smbrta Smbrta.Rom

set_option maxHeartbeats 0
" ++ "
/-- a frame of the room that starts with the reference's size ends with the routine known not to be the side pipe's, or with the height of the reference entry -/
theorem entry_height_walk : EntryHeight.heightCheck sy screenNames ctx = true := by native_decide

/-- a frame of the room that starts with a big player ends with the routine known not to be the side pipe's, or with the height of the reference entry -/
theorem entry_height_big : EntryHeightBig.checkB sy screenNames ctx = true := by native_decide

/-- each reference of the side pipe's entry that lists the height has the height of the reference entry -/
theorem entry_height_refs : EntryHeight.refsCheck sy ctx (SideChangeEnd.refs2 sideBoundNames sideEndNames (SideTransition.entry ctx)) = true := by native_decide

/-- what the checks give for the height, with the checks of `RoomBlocks`, and the room's frames with the player's size (`Proof.SizeKeep`) -/
theorem height_facts : SizeKeep.Facts sy pipeBoundNames pipeEndData screenNames ctx (SideChangeEnd.refs2 sideBoundNames sideEndNames (SideTransition.entry ctx)) :=
  SizeKeep.factsOf (EntryHeightBig.factsOf (EntryHeight.factsOf entry_height_walk entry_height_refs) entry_height_big room_blocks room_blocks_rows)
    size_keep_ref size_keep_zero size_rows

/-- a frame of the room that starts with the reference's control of the screen's buffers ends with the routine known not to be the side pipe's, or with the five
bytes of the first screen buffer of a reference of the entry -/
theorem entry_buffer_walk : EntryBuffer.bufferCheck sy screenNames ctx (SideChangeEnd.refs2 sideBoundNames sideEndNames (SideTransition.entry ctx)) = true := by
  native_decide

/-- the references of the side pipe's entry agree on the bytes that the entry still asks -/
theorem entry_buffer_agree : EntryBuffer.agreeCheck (SideChangeEnd.refs2 sideBoundNames sideEndNames (SideTransition.entry ctx)) (Route.restIdxB sy screenNames ctx) = true := by
  native_decide

/-- what the checks give for the screen's buffer, with the control through the room (`Proof.BufferControl`), the walks of `Proof.BufferCoin`, the walk of
one whole frame (`Proof.SideFrame`) and the walks of `Proof.BufferEnd` -/
theorem buffer_facts : BufferEnd.FactsE sy pipeBoundNames pipeEndData screenNames ctx (SideChangeEnd.refs2 sideBoundNames sideEndNames (SideTransition.entry ctx))
    (Route.restIdxB sy screenNames ctx) :=
  { EntryBuffer.factsOf entry_buffer_walk entry_buffer_agree with ctl := buffer_control_facts, coin := buffer_coin_check, side := side_frame_check, ends := buffer_end_check }
")

/-- the music bytes of `RoomMusic` on real runs: the table at each frame start in the room and at the side pipe's entries, and `EntryRestM`, `EntryRest` at the entries.
The runs are those of `roomPauseReal`: first controls from real entries into the vertical pipe (Start at random on the pipe's frames), random inputs with Start at random in
the room, walks into the side pipe from states near it, and the movie. -/
def roomMusicReal (sy : Syms) (romPath fm2 : String) (runs rate : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let nm2 := SideChangeBound.namesOf txt
  let nx2 := SideChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let T0 ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T0.2.1 T0.1 T0.2.2.1 T0.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let rT ← IO.lazyPure fun _ => PipeChangeEnd.timeRows (PipeChangeEnd.timeCtx sy nm d e) d e
  let cs := RoomStart.ctlStates sy rT
  let t0 : StepWrites.SState := (RoomMusic.tabIdx nmS).filterMap fun i =>
    match cs.map (·.getK i) with
    | a :: l => some (i, l.foldl TaintRun.AB.join a)
    | [] => none
  let T ← musicTable sy m0 nmS t0 false
  IO.println s!"the table: {T.length} states"
  let inT := fun (m : Machine) => T.any (sInB · m)
  let V := SideChangeEnd.refs2 nm2 nx2 (SideTransition.entry m0)
  let restM := fun (m : Machine) => V.any fun v => v.2.all fun i => !(RoomMusic.restIdxM nmS).contains i || m.ram.get! i == v.1.ram.get! i
  let rest := fun (m : Machine) => V.any fun v => v.2.all fun i => !(ScreenPage.restIdx nmS).contains i || m.ram.get! i == v.1.ram.get! i
  let rt0 := peek (SideTransition.pre m0) sy.GameEngineSubroutine
  let mut s : UInt64 := 4242
  let reals := PipeTransitionAll.realEntries sy m0 25 13
  let mut ctls : Array Machine := #[]
  -- the condition `quiet₁` of the first change at the vertical pipe's exit, as `pipeSoundReal` reads it
  let xq := PipeChangeEnd.exitQ sy nm e
  let songOK := fun (m : Machine) => d.song.any fun q => q.all fun p => m.ram.get! p.1 == p.2
  let shapeOK := fun (m : Machine) => d.xshape.any fun q => q.all fun p => m.ram.get! p.1 == p.2
  let oldQ := fun (m : Machine) => (PipeChangeEnd.quietQ d e).all (fun p => m.ram.get! p.1 == p.2) && songOK m && shapeOK m
  let mut notT := 0
  let mut notTq := 0
  for q in reals do
    for k in [0:runs] do
      let mut c := q.2
      let mut j := 0
      let mut q1 := true
      while j < 400 && !controllable sy c do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let st := k > 0 && PipeChangeBound.inPipe sy sy.EngVerticalPipe c && (s >>> 40) % rate.toUInt64 == 0
        c := PipeTransition.frame c (if st then 0x10 else 0)
        if xq.all (fun p => c.ram.get! p.1 &&& 0xFF == p.2) && !oldQ c then q1 := false
        j := j + 1
      if controllable sy c then
        ctls := ctls.push c
        if !inT c then
          notT := notT + 1
          if q1 then notTq := notTq + 1
          IO.println s!"  first control not in the table: music bytes {(RoomMusic.tabIdx nmS).map fun i => hex2 (c.ram.get! i)}; quiet₁ at the exit {q1}"
  IO.println s!"first controls in the room {ctls.size}: music bytes in the table {(ctls.toList.filter inT).length}; not in it {notT}, of them with quiet₁ at the exit {notTq}"
  flush
  let mut frames := 0
  let mut inF := 0
  let mut entries := 0
  let mut entT := 0
  let mut entM := 0
  let mut entR := 0
  let mut entDer := 0
  let mut entTm := 0
  let mut entKeep := 0
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let near := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let starts := ctls.toList.map (fun c => (c, false)) ++ (near.flatMap fun m => (List.range runs).map fun _ => (m, true))
  let r := ScreenPage.refR m0
  for (m, walk) in starts do
    let mut c := m
    let mut j := 0
    let mut done := false
    while !done && j < 600 do
      frames := frames + 1
      if inT c then inF := inF + 1
      s := s ^^^ (s <<< 13)
      s := s ^^^ (s >>> 7)
      s := s ^^^ (s <<< 17)
      let ri := if walk then SideTransition.walkIn else (s >>> 13).toUInt8
      let i := if (s >>> 40) % rate.toUInt64 == 0 then ri ||| 0x10 else ri &&& 0xEF
      let c2 := PipeTransition.frame c i
      if peek c2 sy.GameEngineSubroutine != rt0 then
        done := true
        if (peek c2 sy.GameEngineSubroutine).toUInt16 == sy.EngSidePipe then
          entries := entries + 1
          if inT c2 then entT := entT + 1
          if restM c2 then entM := entM + 1
          if rest c2 then entR := entR + 1
          if (RoomMusic.derivedIdx nmS).all fun i => c2.ram.get! i == r.ram.get! i then entDer := entDer + 1
          -- the game timer: not 000 at the entry, and the same digits on every frame to the one before control (the pipe's frames, random inputs)
          let dg := (SideChangeEnd.digitsOf nx2).map fun i => c2.ram.get! i
          if dg.any (· != 0) then entTm := entTm + 1
          let mut c3 := c2
          let mut same := true
          let mut f := 0
          while f < 800 && !controllable sy c3 do
            if (SideChangeEnd.digitsOf nx2).map (fun i => c3.ram.get! i) != dg then same := false
            s := s ^^^ (s <<< 13)
            s := s ^^^ (s >>> 7)
            s := s ^^^ (s <<< 17)
            c3 := PipeTransition.frame c3 ((s >>> 13).toUInt8)
            f := f + 1
          if same && controllable sy c3 then entKeep := entKeep + 1
      c := c2
      j := j + 1
  IO.println s!"frame starts in the room {frames}: music bytes in the table {inF}"
  IO.println s!"side pipe entries {entries}: in the table {entT}, EntryRestM {entM}, EntryRest {entR}, the five bytes as the reference {entDer}"
  IO.println s!"  the game timer not 000 at the entry {entTm}; the digits the same from the entry to the frame before control (random inputs) {entKeep}"
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn cart 0
  let mut k := 0
  let mut seenPipe := false
  while k < inputs.size && !(seenPipe && controllable sy t) do
    t := runFrame t inputs[k]!
    k := k + 1
    if (peek t sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then seenPipe := true
  let mut ok := inT t
  while k < inputs.size && peek t sy.GameEngineSubroutine == rt0 do
    ok := ok && inT t
    t := runFrame t inputs[k]!
    k := k + 1
  IO.println s!"the movie: each frame in the room in the table {ok}; at the entry (movie frame {k}) in the table {inT t}, EntryRestM {restM t}, EntryRest {rest t}"
  let dgM := (SideChangeEnd.digitsOf nx2).map fun i => t.ram.get! i
  let mut sameM := true
  while k < inputs.size && !controllable sy t do
    if (SideChangeEnd.digitsOf nx2).map (fun i => t.ram.get! i) != dgM then sameM := false
    t := runFrame t inputs[k]!
    k := k + 1
  IO.println s!"  the movie's timer at the entry {dgM}, not 000 {dgM.any (· != 0)}; the same digits to the frame before control (movie frame {k}) {sameM}"
  return 0

/-- the walk of `RoomPause.walkP` with a budget of steps: the result, and the steps used (a program, to find where a walk grows) -/
partial def walkBudgetP (G : RoomPause.Reg) (C : ScreenPage.CfgS) (budget : Nat) (A : TaintRun.AS) (used : Nat) : Bool × Nat := Id.run do
  if used > budget then return (false, used)
  let mut u := used + 1
  for r in RoomPause.pstep C.P C.E C.ops G A do
    match r with
    | none => return (false, u)
    | some B =>
      if B.k == A.k then
        let W := ScreenPage.weaken C B
        if C.cut.get! W.pc.toNat != 0 && ScreenPage.coverS C (ScreenPage.clampS C.P W) then continue
        let (ok, u2) := walkBudgetP G C budget W u
        u := u2
        if !ok then return (false, u)
      else if !(B.k == A.k + 1 && C.fin B) then return (false, u)
  return (true, u)

/-- the walks of the table of `RoomPause` with a budget: the states whose walk is long -/
def roomPauseWalks (sy : Syms) (romPath : String) (budget : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nmS := ScreenPage.namesOf txt
  let nx2 := SideChangeEnd.namesOf txt
  let G := RoomPause.regOf sy m0 nx2
  let C ← IO.lazyPure fun _ => RoomPause.cfgR sy nmS nx2 m0
  let ix := SideChangeSound.pauseIdx nx2
  let pb := SidePause.pauseBytesOf nx2
  IO.println s!"table {C.t.size}"
  flush
  let mut long := 0
  let mut bad := 0
  let mut tot := 0
  let mut hist : Std.HashMap Nat Nat := {}
  for D in C.t.toList ++ ScreenPage.startsR (ScreenPage.refR m0) (ScreenPage.knownOf nmS) do
    let (ok, u) := walkBudgetP G C budget D 0
    tot := tot + u
    if !ok then
      if u > budget then
        long := long + 1
        hist := hist.insert D.pc.toNat (hist.getD D.pc.toNat 0 + 1)
        if long ≤ 8 then IO.println s!"  long: pc {hex4 D.pc} spent {D.spent} q {abS (D.getK ix.q)} b {abS (D.getK ix.b)} f {abS (D.getK ix.f)} c {abS (D.getK ix.c)} t {abS (D.getK pb.t)} g {abS (D.getK pb.g)}"
      else
        bad := bad + 1
        if bad ≤ 8 then IO.println s!"  fails: pc {hex4 D.pc} spent {D.spent}"
  IO.println s!"walks over the budget {long}, failing {bad}, steps {tot}; pcs over the budget: {(hist.toList.map fun p => (hex4 p.1.toUInt16, p.2)).take 40}"
  return 0

/-- `RoomPause` on real runs. At the room's first control (real entries into the vertical pipe, Start at random on the pipe's frames, no input after them): bits 1 to 6
of the pause byte (`pauseBits₂`) and a class. On each frame in the room (random inputs from control, and walks into the side pipe from states near it, Start at random
once in `rate` frames): a class at the frame's start. At the side pipe's entry: bit 0 of the pause byte and `PauseE`. The movie's room too. -/
def roomPauseReal (sy : Syms) (romPath fm2 : String) (runs rate : Nat) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nx := SideChangeEnd.namesOf text
  let pb := SidePause.pauseBytesOf nx
  let ix := SideChangeSound.pauseIdx nx
  let cls := SidePause.classesP sy ix pb
  let rt0 := peek (SideTransition.pre m0) sy.GameEngineSubroutine
  let inCls := fun (m : Machine) => cls.any (sInB · m)
  let mut s : UInt64 := 77777
  -- the first control in the room
  let reals := PipeTransitionAll.realEntries sy m0 25 13
  let mut ctls : Array Machine := #[]
  for q in reals do
    for k in [0:runs] do
      let mut c := q.2
      let mut j := 0
      while j < 400 && !controllable sy c do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let st := k > 0 && PipeChangeBound.inPipe sy sy.EngVerticalPipe c && (s >>> 40) % rate.toUInt64 == 0
        c := PipeTransition.frame c (if st then 0x10 else 0)
        j := j + 1
      if controllable sy c then ctls := ctls.push c
  let bitsOK := ctls.toList.filter fun c => c.ram.get! pb.g &&& 0x7E == 0
  let gs := (ctls.toList.map fun c => c.ram.get! pb.g).eraseDups
  IO.println s!"first controls in the room {ctls.size} (from {reals.length} real entries): pause byte's bits 1 to 6 clear {bitsOK.length}, in a class {(ctls.toList.filter inCls).length}; pause bytes seen {gs}"
  flush
  -- frames in the room, and entries
  let mut frames := 0
  let mut inC := 0
  let mut bad : List (List UInt8) := []
  let mut entries := 0
  let mut pe := 0
  let mut low0 := 0
  let mut other := 0
  let mut paused := 0
  let mut visited : Array Bool := Array.replicate cls.length false
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let near := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let starts := ctls.toList.map (fun c => (c, false)) ++ (near.flatMap fun m => (List.range runs).map fun _ => (m, true))
  for (m, walk) in starts do
    let mut c := m
    let mut j := 0
    let mut done := false
    while !done && j < 600 do
      frames := frames + 1
      if c.ram.get! pb.g &&& 1 == 1 then paused := paused + 1
      if inCls c then inC := inC + 1 else bad := [c.ram.get! ix.q, c.ram.get! ix.b, c.ram.get! ix.f, c.ram.get! ix.c, c.ram.get! pb.t, c.ram.get! pb.g] :: bad
      for (cl, ci) in cls.zipIdx do
        if sInB cl c then visited := visited.set! ci true
      s := s ^^^ (s <<< 13)
      s := s ^^^ (s >>> 7)
      s := s ^^^ (s <<< 17)
      let r := if walk then SideTransition.walkIn else (s >>> 13).toUInt8
      let i := if (s >>> 40) % rate.toUInt64 == 0 then r ||| 0x10 else r &&& 0xEF
      let c2 := PipeTransition.frame c i
      if peek c2 sy.GameEngineSubroutine != rt0 then
        done := true
        if (peek c2 sy.GameEngineSubroutine).toUInt16 == sy.EngSidePipe then
          entries := entries + 1
          if pauseEOK sy ix pb c2 then pe := pe + 1
          if c2.ram.get! pb.g &&& 1 == 0 then low0 := low0 + 1
          if inCls c2 then inC := inC + 1
          frames := frames + 1
        else other := other + 1
      c := c2
      j := j + 1
  IO.println s!"frame starts in the room {frames} (paused {paused}): in a class {inC}; against the classes {bad.eraseDups.take 10}; classes seen {(visited.toList.filter id).length} of {cls.length}"
  IO.println s!"side pipe entries {entries}: PauseE {pe}, bit 0 of the pause byte clear {low0}; other routines {other}"
  -- the movie
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn cart 0
  let mut k := 0
  let mut seenPipe := false
  while k < inputs.size && !(seenPipe && controllable sy t) do
    t := runFrame t inputs[k]!
    k := k + 1
    if (peek t sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then seenPipe := true
  let b1 := t.ram.get! pb.g &&& 0x7E == 0 && inCls t
  let mut ok := true
  while k < inputs.size && peek t sy.GameEngineSubroutine == rt0 do
    ok := ok && inCls t
    t := runFrame t inputs[k]!
    k := k + 1
  IO.println s!"the movie: at the room's first control bits clear and a class {b1}; each frame in a class {ok}; at the entry (movie frame {k}) PauseE {pauseEOK sy ix pb t}"
  return 0

/-! ## The pause through the vertical pipe's frames (`PipeChangeEnd.pipeCheckV`) -/

/-- the entries of the vertical pipe for the pause: the reference, the movie's, the real entries, the reference's way with a pause of `d` frames pressed `k` frames
before its last frame, and the real entries after standing with Start at random -/
def pipePauseEntries (sy : Syms) (romPath fm2 : String) (runs rate : Nat) : IO (List (String × Machine)) := do
  let m0 := smb11Start sy (← loadCart romPath)
  let e := PipeTransition.entry m0
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngVerticalPipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let real := (PipeTransitionAll.realEntries sy m0 25 13 ++ PipeTransitionAll.realEntries sy m0 7 40)
  let mut out : List (String × Machine) := [("reference", e), ("movie", t)] ++ real.map fun p => ("real", p.2)
  -- the reference's way with a pause: Start on frame `f`, nothing for `d - 1` frames, then frame `f`'s input with Start
  let w := PipeTransition.witness
  let inPipe := fun (m : Machine) => (peek m sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe
  for back in [0:60] do
    for d in [44, 45, 60] do
      if back < w.length then
        let f := w.length - 1 - back
        let w' := w.take f ++ [w[f]! ||| 0x10] ++ PipeTransition.zeros (d - 1) ++ [w[f]! ||| 0x10] ++ w.drop (f + 1)
        let mut c := m0
        let mut j := 0
        let mut done := false
        while !done && j < w'.length do
          c := PipeTransition.frame c w'[j]!
          j := j + 1
          if inPipe c then done := true
        if done then out := out ++ [(s!"pause{back}", c)]
  -- standing on the pipe with Start at random, then Down (also with Start)
  let mut s : UInt64 := 777
  for p in real do
    for _ in [0:runs] do
      let mut c := p.1
      let mut j := 0
      let mut done := false
      s := s ^^^ (s <<< 13)
      s := s ^^^ (s >>> 7)
      s := s ^^^ (s <<< 17)
      let wait := (s >>> 20) % 120
      while !done && j < 400 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let st : UInt8 := if (s >>> 40) % rate.toUInt64 == 0 then 0x10 else 0
        let i := if j.toUInt64 < wait then st else PipeTransition.downIn ||| st
        c := PipeTransition.frame c i
        j := j + 1
        if inPipe c then done := true
      if done then out := out ++ [("stand", c)]
  return out

/-- the conditions of the pause through the vertical pipe on real runs (`PipeChangeEnd.PauseV`, `classesV`, `QuietV`): at the entry `Entry` and `PauseV`; on each frame of the pipe, with Start at random, the bytes of a class; at the exit
`QuietV`, `QuietP`, the queue of the pause sound as the reference's, the song and the effects' buffers -/
def pipePauseReal (sy : Syms) (romPath fm2 : String) (runs rate : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let x := PipeChangeEnd.refX e
  let ix := SideChangeSound.pauseIdx nx
  let pb := SidePause.pauseBytesOf nx
  let s1 := SideChangeEnd.adI nx "Square1SoundBuffer"
  let s2 := SideChangeEnd.adI nx "Square2SoundBuffer"
  IO.println s!"the reference at the exit: q {x.ram.get! ix.q} b {x.ram.get! ix.b} f {x.ram.get! ix.f} c {x.ram.get! ix.c} t {x.ram.get! pb.t} g {x.ram.get! pb.g} s1 {x.ram.get! s1} s2 {x.ram.get! s2}"
  IO.println s!"the reference at the entry: q {e.ram.get! ix.q} b {e.ram.get! ix.b} f {e.ram.get! ix.f} c {e.ram.get! ix.c} t {e.ram.get! pb.t} g {e.ram.get! pb.g} s1 {e.ram.get! s1} s2 {e.ram.get! s2}"
  flush
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let cls := PipeChangeEnd.classesV sy d
  let entries ← pipePauseEntries sy romPath fm2 runs rate
  let six := fun (m : Machine) => [m.ram.get! ix.q, m.ram.get! ix.b, m.ram.get! ix.f, m.ram.get! ix.c, m.ram.get! pb.t, m.ram.get! pb.g]
  let mut s : UInt64 := 4242
  let mut nE := 0
  let mut entryOK := 0
  let mut pv := 0
  let mut failE : List (String × List UInt8) := []
  let mut kindE : Array Nat := #[0, 0, 0]
  let mut frames := 0
  let mut inCls := 0
  let mut failF : List (List UInt8) := []
  let mut visited : Array Bool := Array.replicate cls.length false
  let mut exits := 0
  let mut qv := 0
  let mut qp := 0
  let mut qx := 0
  let mut songX := 0
  let mut effX := 0
  let mut kindX : Array Nat := #[0, 0, 0, 0]
  let mut rest := 0
  for (nmE, m) in entries do
    nE := nE + 1
    if PipeChangeEnd.entryOKp d e m then entryOK := entryOK + 1
    if PipeChangeEnd.pauseVB sy d m then pv := pv + 1 else failE := (nmE, six m) :: failE
    let kE := if m.ram.get! ix.b == sy.UnpauseSfxValue.toUInt8 then 1 else if m.ram.get! ix.q == sy.UnpauseSfxValue.toUInt8 then 2 else 0
    kindE := kindE.set! kE (kindE[kE]! + 1)
    for pr in [3, 9, 40] do
      let mut c := m
      let mut j := 0
      let mut done := false
      while !done && j < 3000 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let i := if (s >>> 40) % pr == 0 then r ||| 0x10 else r &&& 0xEF
        let c2 := PipeTransition.frame c i
        if PipeChangeBound.inPipe sy sy.EngVerticalPipe c2 then
          frames := frames + 1
          if cls.any (sInB · c2) then inCls := inCls + 1
          else failF := six c2 :: failF
          for (cl, ci) in cls.zipIdx do
            if sInB cl c2 then visited := visited.set! ci true
        else
          done := true
          exits := exits + 1
          let q := c2.ram.get! ix.q
          let b := c2.ram.get! ix.b
          let L := sy.PauseSfxLength.toNat
          let U := sy.UnpauseSfxValue.toUInt8
          let ok1 := q == 0 && b == 0 && c2.ram.get! ix.f == 0
          let ok2 := q == 0 && b == U && c2.ram.get! ix.f == U && decide (1 ≤ (c2.ram.get! ix.c).toNat) && decide ((c2.ram.get! ix.c).toNat < L)
          let ok3 := q == U && b == 0 && c2.ram.get! ix.f == sy.PauseSfxValue.toUInt8
          if ok1 || ok2 || ok3 then qv := qv + 1
          let kX := if ok1 then 0 else if ok2 then 1 else if ok3 then 2 else 3
          kindX := kindX.set! kX (kindX[kX]! + 1)
          if PipeChangeEnd.quietPB sy d x c2 then qp := qp + 1
          if q == x.ram.get! ix.q then qx := qx + 1
          if PipeChangeEnd.quietRestB d x c2 && d.xshape.any (fun r => r.all fun p => c2.ram.get! p.1 == p.2) then rest := rest + 1
          if d.song.any fun r => r.all fun p => c2.ram.get! p.1 == p.2 then songX := songX + 1
          if c2.ram.get! s1 == x.ram.get! s1 && c2.ram.get! s2 == x.ram.get! s2 then effX := effX + 1
        c := c2
        j := j + 1
  IO.println s!"classes {cls.length}; entries {nE}: Entry {entryOK}, PauseV {pv}; silent / unpause sound / unpause pressed {kindE}"
  IO.println s!"  against PauseV (name, q b f c t g): {failE.eraseDups.take 20}"
  IO.println s!"frames of the pipe {frames}: in a class {inCls}; classes seen {(visited.toList.filter id).length} of {cls.length}; against: {failF.eraseDups.take 20}"
  IO.println s!"exits {exits}: QuietV {qv} (silent, unpause sound, unpause pressed, other: {kindX}), QuietP {qp}, the queue as the reference {qx}, a song row {songX}, effects as the reference {effX}, QuietRest and the screen buffer {rest}"
  return (if pv == nE && inCls == frames && qv == exits then 0 else 1)

/-- the first failing step of `PipeChangeEnd.pwalk` from `A`, for a report: the state, and whether no successor, a failing successor, or a bad frame's end -/
partial def pwalkWhy (C : PipeChangeEnd.ZCfg) (R : PipeChangeEnd.PR) (T : List StepWrites.SState) (fin : TaintRun.AS → Bool) (n : Nat) (A : TaintRun.AS) :
    Option (String × TaintRun.AS) :=
  if n == 0 then some ("fuel", A) else
  let rs := PipeChangeEnd.psuccs C.places C.jump C.E C.ops R T A
  rs.foldl (fun acc r => match acc with
    | some x => some x
    | none => match r with
      | none => some ("none", A)
      | some B =>
        if B.k == A.k then (if C.cut.get! B.pc.toNat != 0 && PipeChangeEnd.pcover C R B then none else pwalkWhy C R T fin (n - 1) B)
        else if B.k == A.k + 1 && fin B then none else some ("end", B)) none

/-- the check of the pause through the vertical pipe as a program (`PipeChangeEnd.pipeCheckV`): the old walk of the pipe's frames and the walk with the class beside it, with their times and tables -/
def pipePauseCheck (sy : Syms) (romPath : String) (old : Bool) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let R := PipeChangeEnd.prOf sy d e
  let cls := PipeChangeEnd.classesV sy d
  let jsrTo := fun (a : UInt16) => if romByte e a == 0x20 then some (hex4 ((romByte e (a + 2)).toUInt16 * 256 + (romByte e (a + 1)).toUInt16)) else none
  IO.println s!"call {hex4 R.call} sb {R.sb}: the calls {jsrTo R.call} {jsrTo (R.call + 3)} {jsrTo (R.call + 6)} {jsrTo (R.call + 9)}; SoundEngine {hex4 sy.SoundEngine}, ReadJoypads {hex4 sy.ReadJoypads}; classes {cls.length}"
  flush
  let E := PipeChangeEnd.envOf d e
  let st := PipeChangeEnd.startsP d e
  let x := PipeChangeEnd.refX e
  if old then
    let t0 ← IO.monoMsNow
    let Cr ← IO.lazyPure fun _ => PipeChangeEnd.cfgRp d e
    let Co ← IO.lazyPure fun _ => PipeChangeEnd.cfgOp d e
    IO.println s!"old tables {Cr.t.size} {Co.t.size} ({(← IO.monoMsNow) - t0} ms)"
    flush
    let t1 ← IO.monoMsNow
    let ok ← IO.lazyPure fun _ => PipeChangeEnd.zcheck Cr Co E (PipeChangeEnd.pauseI d) st (PipeChangeEnd.baseK d e) [] (SideChangeBound.exitBytes sy nm x)
    IO.println s!"old zcheck {ok} ({(← IO.monoMsNow) - t1} ms)"
    flush
  -- the six bytes at the entry from the title and the frames from control (`EntryKeep`): the watched bytes, and what a frame's start state of the walk knows
  let ix := SideChangeSound.pauseIdx nx
  let pb := SidePause.pauseBytesOf nx
  let six := [("q", ix.q), ("b", ix.b), ("f", ix.f), ("c", ix.c), ("t", pb.t), ("g", pb.g)]
  let W := EntryKeep.kept sy d e
  let At := EntryKeep.atEntry d e
  let G := EntryKeep.guardOf sy m0 d e
  let S0 := FrameKeep.startK G W false
  IO.println s!"EntryKeep: the six bytes (kept from control, at the entry, known at a frame's start): {six.map fun p => (p.1, W.any (·.1 == p.2), At.any (·.1 == p.2), abS (S0.getK p.2))}"
  flush
  let t2 ← IO.monoMsNow
  let Cr ← IO.lazyPure fun _ => PipeChangeEnd.cfgRq sy d e
  IO.println s!"new table, counter followed: {Cr.t.size} ({(← IO.monoMsNow) - t2} ms)"
  flush
  let t3 ← IO.monoMsNow
  let Co ← IO.lazyPure fun _ => PipeChangeEnd.cfgOq sy d e
  IO.println s!"new table, counter at 1: {Co.t.size} ({(← IO.monoMsNow) - t3} ms)"
  flush
  -- where the states of the tables are: before the routine, in the sound routine, in the reading of the pads, in the pause routine (and the body), after
  for (C, name) in [(Cr, "Cr"), (Co, "Co")] do
    let mut cnt : Array Nat := #[0, 0, 0, 0, 0]
    for A in C.t do
      let r := if !PipeChangeEnd.inR R A then (if A.s == R.sb + 3 || (A.pc ≥ sy.NonMaskableInterrupt && A.pc ≤ R.call) then 0 else 4)
        else if A.pc ≥ sy.SoundEngine then 1 else if A.pc ≥ sy.ReadJoypads && A.pc < sy.ReadJoypads + 0x60 then 2 else 3
      cnt := cnt.set! r (cnt[r]! + 1)
    IO.println s!"{name}: before the routine or in the idle loop {cnt[0]!}, sound {cnt[1]!}, pads {cnt[2]!}, pause routine and body {cnt[3]!}, after {cnt[4]!}"
  flush
  let g := PipeChangeEnd.pauseI d
  let fr := PipeChangeEnd.finRkP g st
  let fo := PipeChangeEnd.finXP g (st.map (TaintRun.toOne E)) (PipeChangeEnd.baseK d e) [] (SideChangeBound.exitBytes sy nm x)
  let t4 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => PipeChangeEnd.pcheck Cr Co R cls E g st (PipeChangeEnd.baseK d e) [] (SideChangeBound.exitBytes sy nm x)
  IO.println s!"new pcheck {ok} ({(← IO.monoMsNow) - t4} ms)"
  flush
  if !ok then
    let ix := SideChangeSound.pauseIdx nx
    let pb := SidePause.pauseBytesOf nx
    let showB := fun (B : TaintRun.AS) => s!"pc {hex4 B.pc} s {B.s} k {B.k} rk {B.rk} spent {B.spent} inR {PipeChangeEnd.inR R B} q {abS (B.getK ix.q)} b {abS (B.getK ix.b)} f {abS (B.getK ix.f)} c {abS (B.getK ix.c)} t {abS (B.getK pb.t)} g {abS (B.getK pb.g)}"
    let mut shown := 0
    for (C, fin, name) in [(Cr, fr, "Cr"), (Co, fo, "Co")] do
      let froms := C.t.toList ++ (if name == "Cr" then st else st.map (TaintRun.toOne E))
      for A in froms do
        if shown < 12 && !PipeChangeEnd.pwalk C R cls fin TaintRun.walkFuel A then
          match pwalkWhy C R cls fin 3000 A with
          | some (why, B) => IO.println s!"{name}: from {showB A}: {why} at {showB B}"
          | none => IO.println s!"{name}: from {showB A}: (no failure found within 3000)"
          shown := shown + 1
          flush
  return (if ok then 0 else 1)

/-- **the vertical pipe's walk with the pause's class and the game timer's digits** (round 13, part b): `PipeChangeEnd.pipeCheckV` with the digits as the walk's bytes `D`,
`dg` at the start and at the exit, as a program; on a failure, the first failing states -/
def pipeTimeCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := PipeChangeBound.namesOf txt
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d0 := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let dd ← IO.lazyPure fun _ => PipeChangeEnd.dotsOf d0 e
  let d : PipeChangeEnd.Data := { d0 with dl := dd.1, dh := dd.2 }
  let R := PipeChangeEnd.prOf sy d e
  let cls := PipeChangeEnd.classesV sy d
  let E := PipeChangeEnd.timeEnv d e
  let st := PipeChangeEnd.startsPT d e
  let x := PipeChangeEnd.refX e
  IO.println s!"digits {E.D}; start states {st.length}, dg off before: {(PipeChangeEnd.startsP d e).all (fun S => !S.dg)}, base {(PipeChangeEnd.baseK d e).length} dg off: {(PipeChangeEnd.baseK d e).all (fun S => !S.dg)}"
  flush
  let t2 ← IO.monoMsNow
  let Cr ← IO.lazyPure fun _ => PipeChangeEnd.cfgRqT sy d e
  IO.println s!"table with dg, counter followed: {Cr.t.size} ({(← IO.monoMsNow) - t2} ms), without dg {(Cr.t.toList.filter (!·.dg)).length}"
  flush
  let t3 ← IO.monoMsNow
  let Co ← IO.lazyPure fun _ => PipeChangeEnd.cfgOqT sy d e
  IO.println s!"table with dg, counter at 1: {Co.t.size} ({(← IO.monoMsNow) - t3} ms), without dg {(Co.t.toList.filter (!·.dg)).length}"
  flush
  let g := PipeChangeEnd.pauseI d
  let bx := PipeChangeEnd.baseKT d e
  let fr := PipeChangeEnd.finRkP g st
  let fo := PipeChangeEnd.finXP g (st.map (TaintRun.toOne E)) bx [] (SideChangeBound.exitBytes sy nm x)
  let t4 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => PipeChangeEnd.pcheck Cr Co R cls E g st bx [] (SideChangeBound.exitBytes sy nm x)
  IO.println s!"pcheck with dg {ok} ({(← IO.monoMsNow) - t4} ms)"
  flush
  let okV := PipeChangeEnd.dgOff d e
  IO.println s!"dgOff {okV}"
  flush
  if !ok then
    let showB := fun (B : TaintRun.AS) => s!"pc {hex4 B.pc} s {B.s} k {B.k} rk {B.rk} spent {B.spent} dg {B.dg} digits {E.D.map fun i => abS (B.getK i)}"
    let mut shown := 0
    for (C, fin, name) in [(Cr, fr, "Cr"), (Co, fo, "Co")] do
      let froms := C.t.toList ++ (if name == "Cr" then st else st.map (TaintRun.toOne E))
      for A in froms do
        if shown < 12 && !PipeChangeEnd.pwalk C R cls fin TaintRun.walkFuel A then
          match pwalkWhy C R cls fin 3000 A with
          | some (why, B) => IO.println s!"{name}: from {showB A}: {why} at {showB B}"
          | none => IO.println s!"{name}: from {showB A}: (no failure found within 3000)"
          shown := shown + 1
          flush
  return (if ok && okV then 0 else 1)

/-- **the game timer at the vertical pipe's entry and through its frames, on real runs** (round 13, part b): the entries of `pipe-pause-real`; the timer at the entry, the
digits on each frame of the pipe and at the exit, with random inputs and Start. Then runs that stand at control for `k` frames before the reference's way: the timer at the
entry, and whether `Entry`, `PauseV` and the kept bytes hold there although the timer is 000. -/
def pipeTimeReal (sy : Syms) (romPath fm2 : String) (runs rate : Nat) (k0 k1 : Nat) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let ls := txt.splitOn "\n"
  let nx := PipeChangeEnd.namesOf txt
  let e := PipeTransition.entry m0
  let digits := SideChangeEnd.digitsOf nx
  let ctlT := ((PipeTransitionAll.asmValue ls "GameTimerCtrlTimer").getD 0) % 2048
  let dg := fun (m : Machine) => digits.map fun i => m.ram.get! i
  let okT := fun (m : Machine) => digits.any fun i => m.ram.get! i != 0
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let song ← IO.lazyPure fun _ => PipeChangeEnd.songTable nx m0 5327
  let d := PipeChangeEnd.assemble sy nx m0 song T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let entries ← pipePauseEntries sy romPath fm2 runs rate
  let mut s : UInt64 := 4243
  let mut nE := 0
  let mut tE := 0
  let mut frames := 0
  let mut same := 0
  let mut exits := 0
  let mut sameX := 0
  let mut tX := 0
  let mut minT := 1000
  for (_, m) in entries do
    nE := nE + 1
    if okT m then tE := tE + 1
    let v := dg m
    let tv := v[0]!.toNat * 100 + v[1]!.toNat * 10 + v[2]!.toNat
    if tv < minT then minT := tv
    for pr in [3, 9, 40] do
      let mut c := m
      let mut j := 0
      let mut done := false
      while !done && j < 3000 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let i := if (s >>> 40) % pr == 0 then r ||| 0x10 else r &&& 0xEF
        let c2 := PipeTransition.frame c i
        if PipeChangeBound.inPipe sy sy.EngVerticalPipe c2 then
          frames := frames + 1
          if dg c2 == v then same := same + 1
        else
          done := true
          exits := exits + 1
          if dg c2 == v then sameX := sameX + 1
          if okT c2 then tX := tX + 1
        c := c2
        j := j + 1
  IO.println s!"entries {nE}: timer not 000 {tE} (least timer {minT}); frames of the pipe {frames}, with the digits of the entry {same}; exits {exits}, with the digits of the entry {sameX}, timer not 000 {tX}"
  flush
  -- stand at control for k frames, then the reference's way to the entry
  let W := EntryKeep.kept sy d e
  let wOK := fun (m : Machine) => W.all fun w => (m.ram.get! w.1 &&& w.2.1) == (w.2.2 &&& w.2.1)
  -- the frame at which the digits become 000 when standing, and the time-up
  let mut c := m0
  let mut n := 0
  let mut z0 := 0
  let mut dead := 0
  while n < 12000 && dead == 0 do
    c := PipeTransition.frame c 0
    n := n + 1
    if z0 == 0 && !okT c then
      z0 := n
      IO.println s!"standing: the digits are 000 after frame {n}, the timer's control byte {c.ram.get! ctlT}, control {controllable sy c}"
    if z0 != 0 && !controllable sy c then
      dead := n
      IO.println s!"standing: no control after frame {n}, the routine {peek c sy.GameEngineSubroutine}, the digits {dg c}"
  flush
  let w := PipeTransition.witness
  let mut late := 0
  let mut lateEntry := 0
  for k in [k0:k1] do
    let mut cl := m0
    let mut allW := true
    let mut allCtl := true
    for _ in [0:k] do
      cl := PipeTransition.frame cl 0
      if !wOK cl then allW := false
      if !controllable sy cl then allCtl := false
    let mut j := 0
    let mut inP := false
    while j < w.length && !inP do
      let c2 := PipeTransition.frame cl w[j]!
      j := j + 1
      if PipeChangeBound.inPipe sy sy.EngVerticalPipe c2 then inP := true
      else
        if !wOK c2 then allW := false
        if !controllable sy c2 then allCtl := false
      cl := c2
    if inP && !okT cl then
      late := late + 1
      let eOK := PipeChangeEnd.entryOKp d e cl
      let pOK := PipeChangeEnd.pauseVB sy d cl
      let nameOf := fun (i : Nat) => (((nx.filter fun p => p.2 < 0x800 && p.2 ≤ i && i < p.2 + 16).foldl (fun (b : Option (String × Nat)) p => match b with
        | some q => if p.2 > q.2 then some p else b
        | none => some p) none).map fun p => s!"{p.1}+{i - p.2}").getD s!"{i}"
      let offK := (d.known.filter fun i => cl.ram.get! i != e.ram.get! i).map fun i => (nameOf i, (EntryKeep.restIdx d.nx).contains i)
      let offB := (d.bits.filter fun b => (cl.ram.get! b.1 &&& b.2) != (e.ram.get! b.1 &&& b.2)).map fun b => (nameOf b.1, (EntryKeep.restIdx d.nx).contains b.1)
      IO.println s!"  the bytes of Entry that differ (name, in Rest): {offK} {offB}"
      if eOK && pOK && allW && allCtl then lateEntry := lateEntry + 1
      -- after the entry, no input: control within 100 frames?
      let mut c3 := cl
      let mut ctlAt := 0
      let mut q := 0
      while q < 100 && ctlAt == 0 do
        c3 := PipeTransition.frame c3 0
        q := q + 1
        if controllable sy c3 then ctlAt := q
      IO.println s!"k {k}: entry after frame {k + j} with the digits {dg cl}; Entry {eOK}, PauseV {pOK}, the kept bytes on every frame {allW}, control on every frame before {allCtl}; after the entry: control at frame {ctlAt} (0: none in 100), the routine at frame 91 {peek (PipeTransition.run cl (PipeTransition.zeros 91)) sy.GameEngineSubroutine}, the digits at the exit {dg (PipeTransition.run cl (PipeTransition.zeros 48))}"
      flush
  IO.println s!"late runs {k1 - k0}: entries with the digits 000 {late}, of them with Entry, PauseV, the kept bytes and control before the entry {lateEntry}"
  return (if tE == nE && same == frames && sameX == exits then 0 else 1)

/-! ## The game timer and the saved song on the frames from control (round 14, part b) -/

/-- the value of a name of the disassembly, written in binary (`%`) or in hexadecimal (`$`) -/
def asmValueB (lines : List String) (n : String) : Option Nat :=
  (PipeTransitionAll.asmValue lines n) <|> lines.findSome? fun l =>
    match (l.splitOn "=").map (fun x => (x.splitOn ";").headD "") with
    | a :: b :: _ =>
      if a.trimAscii.toString == n then
        match b.trimAscii.toString.toList with
        | '%' :: ds => some (ds.foldl (fun v c => 2 * v + (if c == '1' then 1 else 0)) 0)
        | _ => none
      else none
    | _ => none

/-- what real frames from control do to the game timer and the music's bytes -/
structure TSCount where
  runs : Nat := 0
  frames : Nat := 0
  paused : Nat := 0
  /-- frame starts in control with the hundreds digit 0 -/
  low : Nat := 0
  /-- frame starts against `I0`: the saved song has the entry's value, and the hundreds digit is 0 -/
  bad0 : Nat := 0
  /-- frame starts against `I1`: as `bad0`, and the event music's queue is not the hurry-up music -/
  bad1 : Nat := 0
  /-- frames from a start with the hundreds digit not 0 to an end with it 0; of them with the hurry-up music in the queue at the end, and with the area music's buffer
  at the entry's saved song at the end -/
  cross : Nat := 0
  crossQ : Nat := 0
  crossA : Nat := 0
  /-- frames that load the hurry-up music (the queue at the start), and of them with the saved song at the end not the entry's -/
  loads : Nat := 0
  loadsS : Nat := 0
  /-- stores through an index or a pointer to each byte of the list, and their places (the byte's number, the pc) -/
  st : Array Nat := #[]
  pcs : List (Nat × UInt16) := []
  /-- entries into the vertical pipe; with the timer 000; of those, with `Rest` -/
  entries : Nat := 0
  ent0 : Nat := 0
  ent0R : Nat := 0
  /-- the least timer at a frame start in control -/
  minT : Nat := 1000
  /-- frame starts in control with the timer exactly 100 and the saved song of the entry -/
  at100 : Nat := 0
  /-- entries with the timer below 100; of those, with `Rest`; entries against `I1` -/
  entLow : Nat := 0
  entLowR : Nat := 0
  entBad1 : Nat := 0
  deriving Inhabited

def TSCount.str (c : TSCount) : String :=
  s!"runs {c.runs}, frames {c.frames} (paused {c.paused}), starts below 100 {c.low} (least timer {c.minT}), at 100 with the entry's saved song {c.at100}; against I0 {c.bad0}, against I1 {c.bad1}; frames to below 100 {c.cross}: hurry-up queued at the end {c.crossQ}, area music buffer = the entry's saved song {c.crossA}; frames loading the hurry-up music {c.loads}, saved song not the entry's after {c.loadsS}; indexed stores per byte {c.st.toList}, places {c.pcs.reverse.map fun p => (p.1, hex4 p.2)}; entries {c.entries}, with 000 {c.ent0}, with 000 and Rest {c.ent0R}, below 100 {c.entLow}, below 100 and Rest {c.entLowR}, against I1 {c.entBad1}"

/-- one real frame instruction by instruction: the stores through an index or a pointer to the bytes of `L` -/
def tsFrame (L : List Nat) (m : Machine) (pad : UInt8) (r0 : TSCount) : TSCount × Machine := Id.run do
  let t := m.frame + 1
  let mut c : Machine := { m with pad }
  let mut r := r0
  let mut n := 0
  while n < fuelPerFrame && !(decide (c.frame ≥ t) || c.halted) do
    match PipeWrites.wTarget (PipeWrites.opAt c) c with
    | some tg =>
      if tg < 0x2000 then
        match L.idxOf? (tg &&& 0x7FF).toNat with
        | some j =>
          r := { r with st := r.st.modify j (· + 1), pcs := if r.pcs.length < 40 && !r.pcs.contains (j, c.pc) then (j, c.pc) :: r.pcs else r.pcs }
        | none => pure ()
    | none => pure ()
    c := (PipeTransitionAll.go step c).2
    n := n + 1
  return (r, c)

/-- **the game timer and the saved song on real frames from control** (round 14, part b). The bytes: their places in the guard of `upClean₁`, in `kept`, in `Rest`, and the
entry's values; how many states of the walk's table (`EntryKeep.cfgOf`) know them. Then real runs from control: `k` frames of inputs that keep the player's place (A, B, up,
down, and Start pressed twice 40 frames apart), then the reference's way. On each frame start in control, two candidate invariants (`H`: the hundreds digit is not 0):
`I0 : saved = e.saved → H` and `I1 : H ∨ saved ≠ e.saved ∨ queue = hurry-up`; the stores through an index or a pointer to the bytes; at the entry, the timer and `Rest`. -/
def timerSong (sy : Syms) (romPath : String) (k0 k1 step' : Nat) (table : Bool) : IO UInt32 := do
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let ls := text.splitOn "\n"
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let e := PipeTransition.entry m0
  let nx := PipeChangeEnd.namesOf text
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let d := PipeChangeEnd.assemble sy nx m0 (PipeChangeEnd.songTable nx m0 5327) T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let G := EntryKeep.guardOf sy m0 d e
  let W := EntryKeep.kept sy d e
  let ad := fun (n : String) => ((asmValueB ls n).getD 0) % 2048
  let digits := SideChangeEnd.digitsOf nx
  let names := ["GameTimerDisplay+0", "GameTimerDisplay+1", "GameTimerDisplay+2", "AreaMusicBuffer_Alt", "AreaMusicBuffer", "EventMusicQueue", "EventMusicBuffer",
    "AreaMusicQueue", "NoteLengthTblAdder", "GameTimerCtrlTimer"]
  let L := digits ++ ["AreaMusicBuffer_Alt", "AreaMusicBuffer", "EventMusicQueue", "EventMusicBuffer", "AreaMusicQueue", "NoteLengthTblAdder", "GameTimerCtrlTimer"].map ad
  let tro := ((asmValueB ls "TimeRunningOutMusic").getD 0).toUInt8
  let rest := EntryKeep.restIdx d.nx
  IO.println s!"hurry-up music value read: {tro != 0}"
  for (nmI, i) in names.zip L do
    IO.println s!"{nmI}: in the guard's prot {G.prot.contains i}, kept {W.any (·.1 == i)}, in Rest {rest.contains i}, entry's value {e.ram.get! i}, at control (m0) {m0.ram.get! i}"
  flush
  if table then
    let t0 ← IO.monoMsNow
    let C ← IO.lazyPure fun _ => EntryKeep.cfgOf sy m0 d e
    let kn := L.map fun i => (C.t.toList.filter fun A => (A.getK i).k != 0).length
    IO.println s!"the walk's table: {C.t.size} states ({(← IO.monoMsNow) - t0} ms); states that know any bit of each byte: {kn}"
    let inT := C.t.toList.filter fun A => decide (sy.RunGameTimer ≤ A.pc) && decide (A.pc < sy.RunGameTimer + 0x60)
    IO.println s!"table states in the game timer's routine (its first 96 bytes): {inT.length}, at distinct places {(inT.map (·.pc)).eraseDups.length}"
    flush
    flush
  let sv := e.ram.get! L[3]!
  let hi := fun (m : Machine) => m.ram.get! L[0]! != 0
  let tv := fun (m : Machine) => (m.ram.get! L[0]!).toNat * 100 + (m.ram.get! L[1]!).toNat * 10 + (m.ram.get! L[2]!).toNat
  let gps := SideChangeEnd.adI nx "GamePauseStatus"
  let w := PipeTransition.witness
  let mut r : TSCount := { st := Array.replicate L.length 0 }
  let mut s : UInt64 := 88172645463325252
  let mut k := k0
  while k < k1 do
    -- the inputs: k frames that keep the place, 60 frames of standing, the reference's way
    let mut inp : Array UInt8 := #[]
    let mut j := 0
    while j < k do
      s := s ^^^ (s <<< 13)
      s := s ^^^ (s >>> 7)
      s := s ^^^ (s <<< 17)
      if (s >>> 20) % 1500 == 0 && j + 50 < k then
        inp := inp.push 0x10 ++ Array.replicate 40 0 ++ #[0x10, 0]
        j := j + 43
      else
        let b := (s >>> 30).toUInt8 &&& 0xCC
        let n := 1 + ((s >>> 40) % 30).toNat
        inp := inp ++ Array.replicate n b
        j := j + n
    r := { r with runs := r.runs + 1 }
    let mut a := m0
    -- after the inputs that keep the place: Start while paused, then 60 frames of standing not paused, then the reference's way
    let mut settle := 0
    let mut still := 0
    let mut wi := 0
    let mut ii := 0
    let mut fuel := k + 2000 + w.length
    while fuel > 0 do
      fuel := fuel - 1
      if !controllable sy a then break
      let mut i : UInt8 := 0
      if ii < inp.size then
        i := inp[ii]!
        ii := ii + 1
      else if still < 60 then
        settle := settle + 1
        if a.ram.get! gps &&& 1 == 1 then
          still := 0
          i := if settle % 2 == 0 then 0x10 else 0
        else
          still := still + 1
      else if wi < w.length then
        i := w[wi]!
        wi := wi + 1
      else break
      let paused := a.ram.get! gps &&& 1 == 1
      r := { r with frames := r.frames + 1, paused := r.paused + (if paused then 1 else 0), minT := Nat.min r.minT (tv a) }
      let h0 := hi a
      if !h0 then r := { r with low := r.low + 1 }
      if a.ram.get! L[3]! == sv && !h0 then r := { r with bad0 := r.bad0 + 1 }
      if a.ram.get! L[3]! == sv && tv a == 100 then r := { r with at100 := r.at100 + 1 }
      if a.ram.get! L[3]! == sv && !h0 && a.ram.get! L[5]! != tro then r := { r with bad1 := r.bad1 + 1 }
      let q0 := a.ram.get! L[5]!
      let (r1, b) := tsFrame L a (smbToPad i) r
      r := r1
      if h0 && !hi b then
        r := { r with cross := r.cross + 1, crossQ := r.crossQ + (if b.ram.get! L[5]! == tro then 1 else 0), crossA := r.crossA + (if b.ram.get! L[4]! == sv then 1 else 0) }
      if q0 == tro && !paused then
        r := { r with loads := r.loads + 1, loadsS := r.loadsS + (if b.ram.get! L[3]! != sv then 1 else 0) }
      if (peek b sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then
        let z := digits.all fun i => b.ram.get! i == 0
        r := { r with entries := r.entries + 1, ent0 := r.ent0 + (if z then 1 else 0), ent0R := r.ent0R + (if z && EntryKeep.restOK d e b then 1 else 0) }
        let lo := !hi b
        let lr : Nat := if lo && EntryKeep.restOK d e b then 1 else 0
        let l1 : Nat := if lo && b.ram.get! L[3]! == sv && b.ram.get! L[5]! != tro then 1 else 0
        r := { r with entLow := r.entLow + (if lo then 1 else 0), entLowR := r.entLowR + lr, entBad1 := r.entBad1 + l1 }
      a := b
    IO.println s!"k {k}: {r.str}"
    flush
    k := k + step'
  IO.println s!"all: {r.str}"
  return (if r.bad1 == 0 && r.ent0R == 0 && r.entLowR == 0 && r.entBad1 == 0 then 0 else 1)

/-- experiment (round 14, part b): `EntryKeep.runE` that also counts, at the place `p`, the visits where `Y` is known (with its values) and where it is not -/
partial def runEY (S : FrameKeep.Spot) (G : PipeWrites.Guard) (E : TaintRun.Env) (tI : Nat) (fin : TaintRun.AS → Bool) (ops : Array (TaintRun.AM Unit)) (p : UInt16) (X0 : PipeWrites.SG)
    (yk0 : List UInt8 × Nat) (cl0 : List (Option UInt16)) (A0 : TaintRun.AS) : PipeWrites.SG × (List UInt8 × Nat) × List (Option UInt16) := Id.run do
  let mut X := X0
  let mut yk := yk0
  let mut cl := cl0
  let mut cur := A0
  let mut run := 0
  while true do
    if cur.pc == p then
      yk := if cur.y.isK then ((cur.y.v :: yk.1).eraseDups, yk.2) else (yk.1, yk.2 + 1)
      if !cur.y.isK then
        let lo := cur.getK (0x100 + (cur.s + 1).toNat)
        let hi := cur.getK (0x100 + (cur.s + 2).toNat)
        let ret : Option UInt16 := if lo.isK && hi.isK then some (lo.v.toUInt16 + 256 * hi.v.toUInt16 - 2) else none
        cl := (ret :: cl).eraseDups
    let rs := (FrameKeep.preK S G cur).flatMap (FrameKeep.kstep S G E ops)
    X := { X with steps := X.steps + rs.length, forks := X.forks + (rs.length - 1) }
    let bad := rs.any fun r => match r with
      | none => true
      | some B => B.k != cur.k && !fin B
    if bad then
      X := { X with fails := X.fails + 1, firstFail := X.firstFail <|> some cur, failPcs := X.failPcs.insert cur.pc.toNat (X.failPcs.getD cur.pc.toNat 0 + 1) }
    let good := (rs.filterMap id).filter fun b => b.k == cur.k
    match good with
    | [b] =>
      if (X.leaders[b.pc.toNat]?).isNone && run < 64 && b.pc != G.je && b.pc != S.entry &&
          (b.pc.toNat == cur.pc.toNat + 1 || b.pc.toNat == cur.pc.toNat + 2 || b.pc.toNat == cur.pc.toNat + 3) then
        cur := b
        run := run + 1
        continue
      else pure ()
    | _ => pure ()
    for b in good do
      X := { X with leaders := X.leaders.insert b.pc.toNat () }
      X := EntryKeep.routeE E S G tI X b
    break
  return (X, yk, cl)

/-- experiment (round 14, part b): the search of `EntryKeep` (one frame from control), and at the place where real frames store the game timer's digits through `Y`
(found on the reference's way), how often the walk knows `Y`, and its values there -/
def timerStoreY (sy : Syms) (romPath : String) : IO UInt32 := do
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let m0 := smb11Start sy (← loadCart romPath)
  let e := PipeTransition.entry m0
  let nx := PipeChangeEnd.namesOf text
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let d := PipeChangeEnd.assemble sy nx m0 (PipeChangeEnd.songTable nx m0 5327) T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let W := EntryKeep.kept sy d e
  let G := EntryKeep.guardOf sy m0 d e
  let E := PipeEntryRule.envOf m0
  let ops := (TaintRun.aRows E).toArray
  let S := EntryKeep.spot
  let digits := SideChangeEnd.digitsOf nx
  -- the place: the stores through an index to a digit on the reference's way
  let mut a := m0
  let mut ps : List UInt16 := []
  for i in PipeTransition.witness do
    let t := a.frame + 1
    let mut c : Machine := { a with pad := smbToPad i }
    let mut n := 0
    while n < fuelPerFrame && !(decide (c.frame ≥ t) || c.halted) do
      match PipeWrites.wTarget (PipeWrites.opAt c) c with
      | some tg => if tg < 0x2000 && digits.contains (tg &&& 0x7FF).toNat && !ps.contains c.pc then ps := c.pc :: ps
      | none => pure ()
      c := (PipeTransitionAll.go step c).2
      n := n + 1
    a := c
    if (peek a sy.GameEngineSubroutine).toUInt16 == sy.EngVerticalPipe then break
  IO.println s!"places that store a digit through an index on the reference's way: {ps.length}"
  let p := ps.headD 0
  let fin := EntryKeep.finOf sy m0 d e
  let mut X : PipeWrites.SG := [FrameKeep.startK G W false, FrameKeep.startK G W true].foldl (EntryKeep.routeE E S G (EntryKeep.timerI d e)) {}
  let mut yk : List UInt8 × Nat := ([], 0)
  let mut cl : List (Option UInt16) := []
  let mut visits := 0
  while true do
    match X.pending.minEntry? with
    | none => break
    | some (key, A) =>
      X := { X with pending := X.pending.erase key }
      let r := runEY S G E (EntryKeep.timerI d e) fin ops p X yk cl A
      X := r.1
      visits := visits + (if r.2.1.2 != yk.2 || r.2.1.1.length != yk.1.length then 1 else 0)
      yk := r.2.1
      cl := r.2.2
  IO.println s!"the search: {X.steps} steps, {X.fails} failures, table {X.multi.size}; at the place: Y known with {yk.1.length} values ({yk.1.mergeSort (· ≤ ·)}), Y not known on {yk.2} visits"
  IO.println s!"  the calls (the jsr's place, from the stack) where Y is not known: {cl.map fun o => (o.map hex4).getD "?"}"
  return 0

/-- **the frames from control to the vertical pipe's entry with the pause's class beside the walk** (round 11, part b): the search of `EntryKeep.searchV`, the check
`EntryKeep.pauseCheck`, and the check of frame 0 `EntryKeep.nearPauseCheck`; on a failure, the first failing states and what they know of the six bytes -/
def entryPauseCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let e := PipeTransition.entry m0
  let nx := PipeChangeEnd.namesOf text
  let T ← IO.lazyPure fun _ => PipeChangeEnd.tablesOf sy nx m0
  let d := PipeChangeEnd.assemble sy nx m0 (PipeChangeEnd.songTable nx m0 5327) T.2.1 T.1 T.2.2.1 T.2.2.2 0 0
  let W := EntryKeep.kept sy d e
  let G := EntryKeep.guardOf sy m0 d e
  let E := PipeEntryRule.envOf m0
  let R := PipeChangeEnd.prOf sy d e
  let cls := PipeChangeEnd.classesV sy d
  let fin := EntryKeep.finV sy m0 d e
  IO.println s!"the routine: call {hex4 R.call} sb {R.sb}, idle s {G.s0}; classes {cls.length}; start states in the routine {PipeChangeEnd.inR R (FrameKeep.startK G W false)} {PipeChangeEnd.inR R (FrameKeep.startK G W true)}"
  flush
  let t0 ← IO.monoMsNow
  let X ← IO.lazyPure fun _ => EntryKeep.searchV EntryKeep.spot G E (EntryKeep.timerI d e) R cls fin W
  let fp := (X.failPcs.toList.mergeSort fun a b => a.2 ≥ b.2).take 12
  IO.println s!"the search: {X.steps} steps, {X.forks} forks, {X.fails} failures at {fp}, table {X.multi.size}; {(← IO.monoMsNow) - t0} ms"
  flush
  let ix := SideChangeSound.pauseIdx nx
  let pb := SidePause.pauseBytesOf nx
  let showB := fun (B : TaintRun.AS) => s!"pc {hex4 B.pc} s {B.s} k {B.k} inR {PipeChangeEnd.inR R B} q {abS (B.getK ix.q)} b {abS (B.getK ix.b)} f {abS (B.getK ix.f)} c {abS (B.getK ix.c)} t {abS (B.getK pb.t)} g {abS (B.getK pb.g)} rt {abS (B.getK G.rtI)}"
  match X.firstFail with
  | some A =>
    IO.println s!"  first failure from {showB A}"
    let ops := (TaintRun.aRows E).toArray
    for r in EntryKeep.vsuccs EntryKeep.spot G E ops R cls A do
      match r with
      | some B => IO.println s!"    -> {showB B} end {B.k != A.k} fin {fin B}"
      | none => IO.println "    -> a step that fails"
  | none => pure ()
  flush
  let t1 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => EntryKeep.pauseCheck sy m0 d e
  IO.println s!"pauseCheck: {ok} ({(← IO.monoMsNow) - t1} ms)"
  flush
  let c := TitleStart.ctxOf sy (TitleStart.namesFrom text) cart 39
  let t2 ← IO.monoMsNow
  let ok2 ← IO.lazyPure fun _ => EntryKeep.nearPauseCheck sy c d
  IO.println s!"nearPauseCheck: {ok2} ({(← IO.monoMsNow) - t2} ms)"
  flush
  return if ok && ok2 then 0 else 1

/-- **what frame 0 knows of the six bytes of the pause** (round 11, part b): for the near and held states of `TitleStart`'s set (the states at frame 0's start), and for
the ends of frame 0 with any input that have control (the first control), the values known of the queue, the buffer, the flag and the counter of the pause sound, the
pause timer and the pause byte. A measure for `chg.pause₁`; no part of a proof. -/
def titlePauseNear (sy : Syms) (romPath : String) : IO UInt32 := do
  let txt ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let cart ← loadCart romPath
  let tnm := TitleStart.namesFrom txt
  let nx := PipeChangeEnd.namesOf txt
  let c := TitleStart.ctxOf sy tnm cart 39
  let t0 ← IO.monoMsNow
  let s ← IO.lazyPure fun _ => TitleStart.setsOf sy c
  IO.println s!"the title's set: far {s.farP.R.length} + {s.farC.R.length}, near {s.near.R.length}, held {s.hold.R.length} ({(← IO.monoMsNow) - t0} ms)"
  flush
  let ix := SideChangeSound.pauseIdx nx
  let pb := SidePause.pauseBytesOf nx
  let six := [("q", ix.q), ("b", ix.b), ("f", ix.f), ("c", ix.c), ("t", pb.t), ("g", pb.g)]
  let tally := fun (l : List TaintRun.AS) => six.map fun p =>
    (p.1, ((l.map fun S => abS (S.getK p.2)).foldl (fun (acc : List (String × Nat)) k =>
      match acc.find? (·.1 == k) with
      | some _ => acc.map fun q => if q.1 == k then (q.1, q.2 + 1) else q
      | none => acc ++ [(k, 1)]) []))
  IO.println s!"near states: {tally s.near.R}"
  IO.println s!"held states: {tally s.hold.R}"
  flush
  -- frame 0 from the near and held states, any input: the ends with control
  let E := c.E
  let ops := (TaintRun.aRows E).toArray
  let mut ctlEnds : List TaintRun.AS := []
  let mut other := 0
  let mut fails := 0
  for S in s.near.R ++ s.hold.R do
    let X := SideChangeEnd.xsearch E ops (TitleStart.keepOf sy c.nm) [S]
    fails := fails + X.fails
    for B in X.ends do
      if TaintRun.actl sy B == some true then ctlEnds := B :: ctlEnds else other := other + 1
  IO.println s!"frame 0: ends with control {ctlEnds.length}, other ends {other}, failures {fails}"
  IO.println s!"ends with control: {tally ctlEnds}"
  flush
  return 0

/-- the last frames of the change out of the side pipe: the check, as a program, then real entries with inputs that have no Start after the pipe -/
def sideEndCheck (sy : Syms) (romPath fm2 : String) : IO UInt32 := do
  let m0 := smb11Start sy (← loadCart romPath)
  let text ← IO.FS.readFile (← (← Config.load none).path "disasm")
  let nm := SideChangeBound.namesOf text
  let nx := SideChangeEnd.namesOf text
  let pn := PipeTransitionAll.namesFrom text
  let e := SideTransition.entry m0
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => SideChangeEnd.endCheck sy nm nx e 160 122
  IO.println s!"the check: {ok} ({(← IO.monoMsNow) - t0} ms)"
  let o := PipeTransition.run m0 SideTransition.onBlock
  let st := PipeTransition.run o SideTransition.stand
  let starts := (List.range 21).flatMap fun d => [PipeTransition.run o (PipeTransition.zeros d), PipeTransition.run st (PipeTransition.zeros d)]
  let real := (starts.filterMap (sideWalkToEntry sy 300)).map fun p => PipeTransition.frame p SideTransition.walkIn
  let inputs := alignInputs (parseFm2 (← IO.FS.readFile fm2))
  let mut t := powerOn (← loadCart romPath) 0
  let mut seen := false
  let mut k := 0
  while k < inputs.size && (!seen || (peek t sy.GameEngineSubroutine).toUInt16 != sy.EngSidePipe) do
    t := runFrame t inputs[k]!
    seen := seen || controllable sy t
    k := k + 1
  let all := e :: t :: real
  let E2 := SideChangeBound.sideEnv nm e
  let V2 := SideChangeEnd.refs2 nm nx e
  IO.println s!"entries {all.length}; with the condition {(all.filter (SideChangeBound.entryOK E2 V2 160)).length}"
  let x := PipeTransition.run e (PipeTransition.zeros 160)
  let lf := PipeChangeBound.leftOf sy nm sy.EngSidePipe (SideChangeBound.tableFrom sy nm 122 x) 122
  let E3 := SideChangeEnd.rowsEnv nm nx e
  let K := SideChangeEnd.exitKnown nx
  let gps := SideChangeEnd.adI nx "GamePauseStatus"
  let mut bad := 0
  let mut exits := 0
  let mut frames := 0
  let mut stays : List Nat := []
  let mut least := 100000
  let mut s : UInt64 := 4242
  -- the time at the exit (`TimeOK`), and `left` 0 before control
  let timeOKb := fun (m : Machine) => m.ram.get! (SideChangeEnd.adI nx "PauseModeFlag") == 0 && (SideChangeEnd.digitsOf nx).any fun i => m.ram.get! i != 0
  let mut timeOk := 0
  -- `TimerOK`: the timer alone, which `EndRun.firstF` asks
  let timerB := fun (m : Machine) => (SideChangeEnd.digitsOf nx).any fun i => m.ram.get! i != 0
  let mut timerOk := 0
  let mut zeroBefore := 0
  -- the parts of `Route.Changes.time₂`, measured apart: at the exit the pause flag is 0, and the digits (`timerVal`) are those of the entry and those the frame rule reads (`CastleToLevel.timerOf`)
  let cnm := CastleToLevel.namesFrom text
  let mut flagOk := 0
  let mut sameT := 0
  for m in all do
    for kind in [0, 1, 2] do
      let mut c := m
      let mut j := 0
      let mut after := false
      let mut done := false
      let mut ps := 0
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        -- no input; random inputs without Start; Start only on the first 80 frames
        let c2 := PipeTransition.frame c (if kind == 0 then 0 else if kind == 1 || j ≥ 80 then r &&& 0xEF else r)
        if after && lf c != lf c2 + 1 then bad := bad + 1
        if after && CastleToLevel.phaseOf pn c2 == CastleToLevel.phaseOf pn c then ps := ps + 1
        if !after && !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
          after := true
          if SideChangeEnd.exitOK E3 x K gps c2 then exits := exits + 1 else bad := bad + 1
          if timeOKb c2 then timeOk := timeOk + 1
          if timerB c2 then timerOk := timerOk + 1
          if c2.ram.get! (SideChangeEnd.adI nx "PauseModeFlag") == 0 then flagOk := flagOk + 1
          if SideChangeEnd.timerVal nx c2 == SideChangeEnd.timerVal nx m && SideChangeEnd.timerVal nx c2 == CastleToLevel.timerOf cnm c2 then sameT := sameT + 1
        c := c2
        j := j + 1
        if controllable sy c then
          done := true
          if lf c != 0 then bad := bad + 1
          if j < least then least := j
        else if lf c == 0 then zeroBefore := zeroBefore + 1
      if !done then bad := bad + 1
      stays := ps :: stays
      frames := frames + j
  IO.println s!"runs {3 * all.length}, frames {frames}; the condition at the exit holds on {exits}; bad frames (after the exit left does not fall by exactly one, the condition fails, no control or control with left not 0): {bad}; least frames to control {least}; frames after the exit where the timers do not run, in one run: {stays.eraseDups}"
  IO.println s!"the time at the exit (pause flag 0, timer not 000) holds on {timeOk} of {3 * all.length} runs, the timer not 000 on {timerOk}; frames before control with left 0: {zeroBefore}"
  IO.println s!"at the exit: the pause flag 0 on {flagOk} of {3 * all.length} runs; the digits those of the entry and of the frame rule's reading on {sameT}"
  -- Start on the frames of the pipe: where the condition at the exit holds, the time at the exit holds too
  let mut q3 := 0
  let mut t3 := 0
  let mut f3 := 0
  let mut x3 := 0
  -- and the frames where the timers do not run (`lag`, and the one `setup` frame after the exit): do they end paused (`Paused`)?
  let pausedB := fun (m : Machine) => m.ram.get! gps &&& 1 == 1
  let mut lagPipe := 0
  let mut lagPipeNot := 0
  let mut pausedPipe := 0
  let mut pausedFall := 0
  let mut lagAfter := 0
  let mut lagAfterPaused := 0
  for m in all do
    for _ in [0:6] do
      let mut c := m
      let mut j := 0
      let mut after := false
      let mut done := false
      while !done && j < 1500 do
        s := s ^^^ (s <<< 13)
        s := s ^^^ (s >>> 7)
        s := s ^^^ (s <<< 17)
        let r := (s >>> 13).toUInt8
        let c2 := PipeTransition.frame c (if !after && (s >>> 40) % 9 == 0 then r ||| 0x10 else r &&& 0xEF)
        let still := CastleToLevel.phaseOf pn c2 == CastleToLevel.phaseOf pn c
        if !after then
          if still then
            lagPipe := lagPipe + 1
            if !pausedB c2 then lagPipeNot := lagPipeNot + 1
          if pausedB c2 && PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
            pausedPipe := pausedPipe + 1
            if lf c > lf c2 then pausedFall := pausedFall + 1
        else if still then
          lagAfter := lagAfter + 1
          if pausedB c2 then lagAfterPaused := lagAfterPaused + 1
        if !after && !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
          after := true
          x3 := x3 + 1
          if c2.ram.get! (SideChangeEnd.adI nx "PauseModeFlag") != 0 then f3 := f3 + 1
          if SideChangeEnd.exitOK E3 x K gps c2 then
            q3 := q3 + 1
            if timeOKb c2 then t3 := t3 + 1
          else done := true
        c := c2
        j := j + 1
        if controllable sy c then done := true
  IO.println s!"Start at random on the frames of the pipe: exits {x3}, with the pause flag not 0 {f3}, with the condition at the exit {q3}, of these with the time at the exit {t3}"
  IO.println s!"  frames of the pipe where the timers do not run {lagPipe}, of these not paused at the end {lagPipeNot}; frames of the pipe that end paused {pausedPipe}, of these with left falling {pausedFall}"
  IO.println s!"  after an exit with the condition, frames where the timers do not run {lagAfter} (one per run is the setup frame), of these paused at the end {lagAfterPaused}"
  -- the time up: entries with the game timer at 000, or at 001
  let mut upRows : List String := []
  for (name, d) in [("000", (0 : UInt8)), ("001", 1)] do
    for m in (all.take 6) do
      let gt := nx.ad "GameTimerDisplay"
      let mut c := poke (poke (poke m gt 0) (gt + 1) 0) (gt + 2) d
      let mut j := 0
      let mut after := false
      let mut tOK := false
      let mut zero : Option (Nat × Bool × UInt8) := none
      while zero.isNone && j < 600 do
        let c2 := PipeTransition.frame c 0
        if !after && !PipeChangeBound.inPipe sy sy.EngSidePipe c2 then
          after := true
          tOK := timeOKb c2
        c := c2
        j := j + 1
        if after && lf c == 0 then zero := some (j, controllable sy c, peek c sy.GameEngineSubroutine)
      upRows := s!"{name}: time at the exit {tOK}, first left 0 (frame, control, routine) {zero}" :: upRows
  IO.println s!"the game timer written at the entry: {upRows.reverse.eraseDups}"
  return if ok && bad == 0 && zeroBefore == 0 && timeOk == 3 * all.length && flagOk == 3 * all.length && sameT == 3 * all.length && t3 == q3 && lagPipeNot == 0 && pausedFall == 0 && lagAfterPaused == 0 && lagAfter == q3 then 0 else 1

/-- the vertical model on the ROM: the detours, then each case, and why it fails -/
def vertModelCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let S := FrameModel.ctrlStack sy m0
  let E := FrameModel.Rom.of m0
  let ds := VertModel.detours sy E S
  for d in ds do
    IO.println s!"detour {d.c.pc} -> {d.c'.pc}: {d.ok E}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => VertModel.vertOK sy m0 S
  IO.println s!"the check on the ROM: {ok}, {(← IO.monoMsNow) - t0} ms; stack at the player's routine {S}"
  let pBad := VertModel.pCases.filter fun c => !VertModel.prefixOK sy E S c
  IO.println s!"the first piece: {VertModel.pCases.length - pBad.length} of {VertModel.pCases.length} cases; the return to {VertModel.retPc sy E S}; the last piece {VertModel.lastOK sy E S}"
  for c in pBad.take 5 do
    let cP := c.cP sy E S
    IO.println s!"  first piece fails: st {c.st} area {c.area} raw {c.raw} prevA {c.prevA}: end {cP.pc} s {cP.s} known {cP.K.length}"
  let mut bad := 0
  for c in VertModel.vCases do
    let w := VertModel.caseWhy sy m0 S c
    if !w.isEmpty then
      bad := bad + 1
      if bad ≤ 24 then IO.println s!"case st {c.st} ab {c.ab} prevA {c.prevA}: {w}"
  IO.println s!"cases that fail: {bad} of {VertModel.vCases.length}"
  return if ok then 0 else 1

/-- the frames with the pressed side masked: the check on the ROM of `FrameModel.move_masked`, part by part, with where a walk fails -/
def maskModelCheck (sy : Syms) (romPath : String) : IO UInt32 := do
  let cart ← loadCart romPath
  let m0 := smb11Start sy cart
  let S := FrameModel.ctrlStack sy m0
  let E := FrameModel.Rom.of m0
  let sp := FrameModel.spM m0
  let r := FrameModel.fricRet sy m0
  IO.println s!"noLeft {sy.noLeft}, bits of the model {FrameModel.bits0 sy m0}, the friction's return {r} ({FrameModel.isRts E r}), GetPlayerAnimSpeed's return {FrameModel.gpasRet sy m0} ({FrameModel.isRts E (FrameModel.gpasRet sy m0)}), RghtFrict {sy.RghtFrict}"
  IO.println s!"GetPlayerAnimSpeed writes only 0 to the speed: {FrameModel.gpasOK sy m0}"
  for lr in [(0 : UInt8), 1, 2, 3] do
    let masked := FrameModel.maskedLr sy lr
    IO.println s!"Left/Right {lr}: masked {masked}, the model's walks {FrameModel.maskModelOK sy m0 lr}"
    if masked then
      let bT := (FrameModel.I sy.Player_CollisionBits, FrameModel.Tag.kn sy.noLeft (FrameModel.bits0 sy m0))
      let st := FrameModel.mStop r sp
      if sy.noLeft &&& lr != 0 then
        IO.println s!"  both ways the same: {repr (FrameModel.walkDWhy E [] st (FrameModel.mGoal sy m0) FrameModel.fuelS (FrameModel.fricQ sy m0 lr [bT]))}"
      else
        let mut bad := 0
        for j in List.range 127 do
          let v := (j + 1).toUInt8
          let d := FrameModel.leftDetour sy m0 lr v
          let w := FrameModel.walkDWhy E [d] st (FrameModel.mGoal sy m0) FrameModel.fuelS (FrameModel.fricQ sy m0 lr [(FrameModel.I sy.Player_X_Speed, FrameModel.Tag.kn v v), bT])
          if !d.ok E || w.isSome then
            bad := bad + 1
            if bad ≤ 4 then IO.println s!"  speed {v}: detour {d.ok E}, walk {repr w}"
        IO.println s!"  speeds 1 to 127 that fail: {bad}"
        let z := FrameModel.walkDWhy E [] st (fun Q => (Q.ram (FrameModel.I sy.Player_X_Speed)).same == some 0 && FrameModel.stkKept m0 Q) FrameModel.fuelS
          (FrameModel.fricQ sy m0 lr [(FrameModel.I sy.Player_X_Speed, FrameModel.Tag.kn 0 0), (FrameModel.I sy.Player_CollisionBits, FrameModel.Tag.kn sy.noLeft sy.noLeft)])
        IO.println s!"  speed 0 stays 0: {repr z}"
  let cs := FrameModel.allCases.filter fun c => FrameModel.maskedLr sy (FrameModel.lrOf c.n)
  let cBad := cs.filter fun c => !FrameModel.maskCaseOK sy m0 S c
  IO.println s!"masked cases: {cs.length} of {FrameModel.allCases.length}; the real friction next to the model's with the real bits fails in {cBad.length}"
  let t0 ← IO.monoMsNow
  let ok ← IO.lazyPure fun _ => FrameModel.maskOK sy m0 S
  IO.println s!"the check on the ROM: {ok}, {(← IO.monoMsNow) - t0} ms"
  return if ok then 0 else 1

